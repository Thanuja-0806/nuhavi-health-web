---
/**
 * src/pages/en/resources/index.astro
 * Nuhavi Health Knowledge Centre & Patient Resources Hub
 * Complete with:
 * - 10-specialty knowledge centre directory (105 patient education articles)
 * - 10 explainer video scripts (90s audiovisual breakdown)
 * - Practical travel and clinical guides
 * - Three printable interactive checklists with live counters
 * - Core patient FAQ accordion
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { specialtyCategories, knowledgeArticles } from '../../../data/knowledgeData';
import { explainerScriptsList } from '../../../data/explainerScripts';
import SpecialtyIcon from '../../../components/common/SpecialtyIcon.astro';
import { getSpecialtyMeta, getSpecialtyImage } from '../../../data/unifiedSpecialties';
---

<BaseLayout
  title="Patient Knowledge Centre & Resources | Nuhavi Health"
  description="105 clinical education articles across 10 medical specialties, 10 explainer video scripts, practical travel guides, and interactive checklists."
  lang="en"
>
  <main class="page-container" id="main-content">
    <div class="container main-content">
      <!-- Gold rule above page title -->
      <div class="gold-rule" aria-hidden="true"></div>

      <header class="page-header">
        <div class="badge-row">
          <span class="hub-badge">Medical Education & Patient Guidance</span>
        </div>
        <h1 class="page-title">Patient Knowledge Centre</h1>
        <p class="page-deck">
          Clear, plain-language clinical resources, 105 specialty education articles, 90-second explainer video scripts, and printable checklists — designed to help international patients make informed decisions before traveling.
        </p>

        <!-- Quick Jump Bar -->
        <nav class="hub-nav-pills" aria-label="Knowledge Centre navigation">
          <a href="#specialty-articles" class="hub-pill">105 Specialty Articles</a>
          <a href="#explainer-scripts" class="hub-pill">10 Explainer Video Scripts</a>
          <a href="#patient-guides" class="hub-pill">Planning Guides</a>
          <a href="#checklists" class="hub-pill">Printable Checklists</a>
          <a href="#faqs" class="hub-pill">Patient FAQs</a>
        </nav>
      </header>

      <!-- Section: 105 Clinical Articles Directory by Specialty -->
      <section class="specialty-directory-section" id="specialty-articles">
        <div class="section-title-wrap">
          <h2 class="section-title">Specialty Knowledge Directory (105 Articles)</h2>
          <p class="section-subtext">
            Plain-language condition guides across our medical specialties. Every article is published as a <em>DRAFT — For Specialist Review</em> until signed off by an accredited hospital specialist.
          </p>

          <!-- Search & Filter Bar -->
          <div class="hub-search-container">
            <div class="hub-search-input-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <input
                type="text"
                id="hub-articles-search"
                class="hub-search-input"
                placeholder="Search across all 105 articles: conditions, symptoms, tests, treatments..."
                aria-label="Search all 105 clinical articles"
              />
            </div>
            
            <div class="specialty-filter-pills" id="specialty-filter-pills">
              <button type="button" class="spec-filter-btn active" data-filter="all">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="chip-spec-icon">
                  <rect x="3" y="3" width="7" height="7"></rect>
                  <rect x="14" y="3" width="7" height="7"></rect>
                  <rect x="14" y="14" width="7" height="7"></rect>
                  <rect x="3" y="14" width="7" height="7"></rect>
                </svg>
                <span>All Specialties ({knowledgeArticles.length})</span>
              </button>
              {specialtyCategories.filter(c => c.articleCount > 0).map(cat => {
                const count = knowledgeArticles.filter(a => a.specialtySlug === cat.slug).length;
                return (
                  <button type="button" class="spec-filter-btn" data-filter={cat.slug}>
                    <img src={getSpecialtyImage(cat.slug)} alt="" class="chip-spec-photo" width="16" height="16" loading="lazy" />
                    <span>{cat.title} ({count})</span>
                  </button>
                );
              })}
            </div>
          </div>
        </div>

        <div class="specialty-accordion-stack" id="specialty-accordion-stack">
          {specialtyCategories.map((cat, catIdx) => {
            const articlesInCat = knowledgeArticles.filter((a) => a.specialtySlug === cat.slug || (cat.aliases && cat.aliases.includes(a.specialtySlug)));
            const meta = getSpecialtyMeta(cat.slug);
            return (
              <details class="specialty-hub-card" open={catIdx < 3} data-specialty={cat.slug}>
                <summary class="specialty-summary">
                  <div class="summary-left">
                    <span class="cat-num">{catIdx + 1}</span>
                    <div class="cat-summary-icon" style={`border: 1px solid ${meta.borderColor};`}>
                      <img src={meta.image} alt={cat.title} class="cat-summary-photo" width="24" height="24" loading="lazy" />
                    </div>
                    <div>
                      <h3 class="cat-title">{cat.title}</h3>
                      <span class="cat-count">{articlesInCat.length} comprehensive articles</span>
                    </div>
                  </div>
                  <div class="summary-right">
                    <a href={`/en/resources/${cat.slug}/`} class="view-pill" onclick="event.stopPropagation()">View Hub</a>
                    <svg class="chevron-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </div>
                </summary>

                <div class="specialty-articles-grid">
                  <p class="cat-desc">{cat.description}</p>
                  {articlesInCat.length > 0 ? (
                    <ul class="articles-sublist">
                      {articlesInCat.map((art) => {
                        const artMeta = getSpecialtyMeta(art.specialtySlug);
                        return (
                          <li class="article-li" data-title={art.title.toLowerCase()} data-overview={art.overview.toLowerCase()}>
                            <a href={`/en/resources/${art.specialtySlug}/${art.slug}/`} class="article-link-card">
                              <!-- Specialty Tag Row -->
                              <div class="art-card-spec-meta">
                                <span class="art-card-spec-name" style={`color: ${artMeta.color};`}>{artMeta.name}</span>
                                <span class="art-card-meta-dot">•</span>
                                <span class="art-read-time">{art.readingTime}</span>
                                {art.diagram && <span class="diagram-tag">Diagram</span>}
                              </div>

                              <div class="article-link-header">
                                <h4 class="article-card-title">{art.title}</h4>
                              </div>
                              <p class="article-card-snippet">{art.overview.substring(0, 140)}...</p>
                              <span class="read-link-span">
                                <span>Read guide & questions</span>
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                  <line x1="5" y1="12" x2="19" y2="12"></line>
                                  <polyline points="12 5 19 12 12 19"></polyline>
                                </svg>
                              </span>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                  ) : (
                    <div class="draft-placeholder-note">
                      <p>Clinical draft guides for {cat.title} are currently under specialist review.</p>
                      <a href={`/en/resources/${cat.slug}/`} class="btn-subtle">Explore {cat.title} Hub</a>
                    </div>
                  )}
                </div>
              </details>
            );
          })}
        </div>

        <div id="hub-no-results" class="hub-no-results" style="display: none;">
          <p>No articles found matching your search. Please check the spelling or explore our specialty categories above.</p>
        </div>
      </section>

      <!-- Section: 10 Explainer Video Scripts (90s Format) -->
      <section class="video-scripts-section" id="explainer-scripts">
        <div class="section-title-wrap">
          <div class="badge-row">
            <span class="script-badge">Audiovisual Coordination Roadmap</span>
          </div>
          <h2 class="section-title">10 Explainer Video Scripts (90-Second Format)</h2>
          <p class="section-subtext">
            Standardised, doctor-led scripts detailing the exact audiovisual coordination journey for each medical specialty. Read the complete storyboard breakdowns scene-by-scene.
          </p>
        </div>

        <div class="scripts-grid">
          {explainerScriptsList.map((script) => (
            <details class="script-card">
              <summary class="script-summary">
                <div class="script-meta-top">
                  <span class="script-time">{script.duration || '90 Seconds'}</span>
                  <span class="script-specialty">{script.specialtyTitle}</span>
                </div>
                <h3 class="script-title">{script.title || script.coreMessage}</h3>
                <div class="script-toggle-row">
                  <span class="toggle-text">View storyboard & scenes ({script.scenes.length} scenes)</span>
                  <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </div>
              </summary>

              <div class="script-scenes-body">
                <div class="audience-row">
                  <strong>Target Audience:</strong> {script.targetAudience}
                </div>

                <div class="scenes-timeline">
                  {script.scenes.map((scene, sIdx) => (
                    <div class="scene-item">
                      <div class="scene-time-col">
                        <span class="scene-time-tag">{scene.timestamp}</span>
                        <span class="scene-idx">Scene {sIdx + 1}</span>
                      </div>
                      <div class="scene-content-col">
                        <div class="scene-audio">
                          <strong>Voiceover:</strong>
                          <p>"{scene.audioVoiceover}"</p>
                        </div>
                        <div class="scene-visual">
                          <strong>Visual Direction:</strong>
                          <p>{scene.visualDirection}</p>
                        </div>
                        <div class="scene-graphics">
                          <strong>On-Screen Graphics:</strong>
                          <code>{scene.onScreenGraphics}</code>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </details>
          ))}
        </div>
      </section>

      <!-- Section: Guides (Page 26) -->
      <section class="guides-section" id="patient-guides">
        <h2 class="section-title">Essential Patient Planning Guides</h2>

        <div class="guides-grid">
          <a href="/en/resources/preparing-medical-records/" class="guide-item">
            <h3 class="guide-title">Preparing your medical records</h3>
            <p class="guide-desc">What to collect, how to scan it, and what not to send over public forms.</p>
          </a>

          <a href="/en/resources/questions-to-ask-hospital/" class="guide-item">
            <h3 class="guide-title">Questions to ask before choosing a hospital</h3>
            <p class="guide-desc">Specific clinical questions that help you compare hospitals on what matters.</p>
          </a>

          <a href="/en/resources/understanding-treatment-estimate/" class="guide-item">
            <h3 class="guide-title">Understanding a treatment estimate</h3>
            <p class="guide-desc">The difference between a preliminary estimate and a confirmed quotation.</p>
          </a>

          <div class="guide-item">
            <h3 class="guide-title">Medical second opinions</h3>
            <p class="guide-desc">When a second opinion helps, and what it can and cannot tell you.</p>
          </div>

          <div class="guide-item">
            <h3 class="guide-title">Travelling with a companion</h3>
            <p class="guide-desc">Planning accommodation, medical attendant visas, and airport logistics.</p>
          </div>

          <div class="guide-item">
            <h3 class="guide-title">After you return home</h3>
            <p class="guide-desc">Keeping continuity of care going through coordinated teleconsultations.</p>
          </div>
        </div>
      </section>

      <!-- Section: Checklists (PDF Page 26) -->
      <section class="checklists-section" id="checklists">
        <div class="checklist-top">
          <div class="checklist-intro">
            <h2 class="section-title">Printable Checklists</h2>
            <p class="checklist-subtext">Tick items off as you go, or print them. Nothing you tick is saved or transmitted over the internet.</p>
          </div>

          <div class="checklist-rows">
            <!-- Checklist 1: Cancer Care -->
            <details class="checklist-accordion" open>
              <summary class="checklist-row-card">
                <span class="checklist-name">Cancer care records checklist</span>
                <span class="checklist-counter" id="counter-cancer">0 of 8 ready</span>
              </summary>
              <div class="checklist-body">
                <ul class="interactive-checklist" id="list-cancer">
                  <li><label><input type="checkbox" /> <span>Biopsy or histopathology report</span></label></li>
                  <li><label><input type="checkbox" /> <span>Immunohistochemistry (IHC) report, if done</span></label></li>
                  <li><label><input type="checkbox" /> <span>Latest CT, MRI or PET-CT report</span></label></li>
                  <li><label><input type="checkbox" /> <span>Scan images (disc or download link)</span></label></li>
                  <li><label><input type="checkbox" /> <span>Blood tests from the last 4 weeks</span></label></li>
                  <li><label><input type="checkbox" /> <span>Summary of treatment so far, with dates</span></label></li>
                  <li><label><input type="checkbox" /> <span>Current medicines and allergies</span></label></li>
                  <li><label><input type="checkbox" /> <span>Passport copy (only when your coordinator asks, for the visa letter)</span></label></li>
                </ul>
                <div class="checklist-footer">
                  <button type="button" class="print-btn" onclick="window.print()">Print this checklist</button>
                </div>
              </div>
            </details>

            <!-- Checklist 2: Joint Replacement -->
            <details class="checklist-accordion">
              <summary class="checklist-row-card">
                <span class="checklist-name">Joint replacement records checklist</span>
                <span class="checklist-counter" id="counter-joints">0 of 6 ready</span>
              </summary>
              <div class="checklist-body">
                <ul class="interactive-checklist" id="list-joints">
                  <li><label><input type="checkbox" /> <span>Recent standing X-rays of the affected joint(s)</span></label></li>
                  <li><label><input type="checkbox" /> <span>MRI or CT scan report, if available</span></label></li>
                  <li><label><input type="checkbox" /> <span>Current walking ability and range of motion notes</span></label></li>
                  <li><label><input type="checkbox" /> <span>Previous surgery reports or implant details</span></label></li>
                  <li><label><input type="checkbox" /> <span>Blood tests and cardiac clearance, if done</span></label></li>
                  <li><label><input type="checkbox" /> <span>Current medicines and allergies</span></label></li>
                </ul>
                <div class="checklist-footer">
                  <button type="button" class="print-btn" onclick="window.print()">Print this checklist</button>
                </div>
              </div>
            </details>

            <!-- Checklist 3: Travel Checklist -->
            <details class="checklist-accordion">
              <summary class="checklist-row-card">
                <span class="checklist-name">Travel checklist</span>
                <span class="checklist-counter" id="counter-travel">0 of 8 ready</span>
              </summary>
              <div class="checklist-body">
                <ul class="interactive-checklist" id="list-travel">
                  <li><label><input type="checkbox" /> <span>Passport valid for at least six months</span></label></li>
                  <li><label><input type="checkbox" /> <span>e-Medical visa applied for (and e-Medical Attendant visa for companion)</span></label></li>
                  <li><label><input type="checkbox" /> <span>Hospital invitation letter</span></label></li>
                  <li><label><input type="checkbox" /> <span>Flights booked after visa approval</span></label></li>
                  <li><label><input type="checkbox" /> <span>Travel insurance checked</span></label></li>
                  <li><label><input type="checkbox" /> <span>Original medical records and scan discs packed in hand luggage</span></label></li>
                  <li><label><input type="checkbox" /> <span>Medicines for the journey</span></label></li>
                  <li><label><input type="checkbox" /> <span>Coordinator's phone number saved</span></label></li>
                </ul>
                <div class="checklist-footer">
                  <button type="button" class="print-btn" onclick="window.print()">Print this checklist</button>
                </div>
              </div>
            </details>
          </div>
        </div>
      </section>

      <!-- Section: Frequently Asked Questions (Page 27) -->
      <section class="faq-section" id="faqs">
        <h2 class="section-title">Frequently Asked Questions</h2>

        <div class="faq-accordion">
          <details class="faq-item">
            <summary class="faq-question">
              <span>Is Nuhavi a hospital?</span>
              <span class="faq-toggle" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <p>No. Nuhavi Health is an independent doctor-led medical travel coordination company based in Hyderabad. We organise reviews, hospital options, and travel logistics. Clinical decisions and treatments stay with the accredited hospital teams.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Who pays Nuhavi?</span>
              <span class="faq-toggle" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <p>Patients pay us a transparent coordination fee agreed upon in writing before committing. We do not accept referral fees, secret commissions, or marketing payments from hospitals, doctors, or their agents.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Do you promote particular doctors?</span>
              <span class="faq-toggle" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <p>No. We present hospitals by their infrastructure, technology, multidisciplinary team review, and published accreditations, rather than by promoting individual celebrity physicians.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Can you guarantee a result, a saving or a visa?</span>
              <span class="faq-toggle" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <p>No. Medical outcomes cannot be guaranteed by anyone ethical. Visa issuance is determined solely by the Government of India. We help ensure your documentation is complete and verifiable.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>How do I send my medical records?</span>
              <span class="faq-toggle" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <p>After you submit a short enquiry, we email you a secure, private upload link valid for 48 hours. Never paste medical records into public web forms or chat apps.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>Which languages do you support?</span>
              <span class="faq-toggle" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <p>We coordinate primarily in English and Russian, with Uzbek, Arabic, French, and Swahili support currently expanding. We provide language-specific coordinators wherever available.</p>
            </div>
          </details>

          <details class="faq-item">
            <summary class="faq-question">
              <span>What if I have an emergency?</span>
              <span class="faq-toggle" aria-hidden="true">+</span>
            </summary>
            <div class="faq-answer">
              <p>Nuhavi Health coordinates scheduled, elective cross-border medical travel. We do not provide emergency services. If you have acute chest pain, severe bleeding, or acute trauma, contact your local emergency department immediately.</p>
            </div>
          </details>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  function setupResourceChecklists() {
    const accordions = document.querySelectorAll('.checklist-accordion');
    accordions.forEach((acc) => {
      const counter = acc.querySelector('.checklist-counter');
      const checkboxes = acc.querySelectorAll<HTMLInputElement>('input[type="checkbox"]');
      const total = checkboxes.length;

      function update() {
        const checked = Array.from(checkboxes).filter((cb) => cb.checked).length;
        if (counter) {
          counter.textContent = `${checked} of ${total} ready`;
        }
      }

      checkboxes.forEach((cb) => {
        cb.addEventListener('change', update);
      });
      update();
    });
  }

  document.addEventListener('DOMContentLoaded', setupResourceChecklists);
  setupResourceChecklists();
</script>

<style>
  .page-container {
    background-color: #FFFFFF;
    color: var(--color-ink);
    padding: 48px 0 96px;
  }

  .main-content {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .gold-rule {
    width: 72px;
    height: 3px;
    background-color: var(--color-brass);
    margin-bottom: 24px;
  }

  .page-header {
    margin-bottom: 56px;
  }

  .hub-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-navy);
    background-color: var(--color-ivory);
    border: 1px solid rgba(168, 139, 90, 0.3);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    margin-bottom: 12px;
  }

  .page-title {
    font-family: var(--font-family-heading);
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    color: var(--color-navy);
    line-height: 1.15;
    margin-bottom: 16px;
  }

  .page-deck {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--color-slate);
    max-width: 780px;
    margin-bottom: 24px;
  }

  .hub-nav-pills {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .hub-pill {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-navy);
    background-color: #F8FAFD;
    border: 1px solid var(--color-border);
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .hub-pill:hover {
    background-color: var(--color-navy);
    color: #FFFFFF;
    border-color: var(--color-navy);
  }

  .section-title-wrap {
    margin-bottom: 32px;
  }

  .section-title {
    font-family: var(--font-family-heading);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: var(--color-navy);
    margin-bottom: 8px;
  }

  .section-subtext {
    font-size: 1rem;
    color: var(--color-slate);
    max-width: 760px;
  }

  /* 105 Articles Accordion */
  .specialty-directory-section {
    margin-bottom: 72px;
  }

  .specialty-accordion-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .specialty-hub-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 2px 6px rgba(15, 35, 64, 0.03);
    transition: border-color 0.2s ease;
  }

  .specialty-hub-card:hover {
    border-color: var(--color-brass);
  }

  .specialty-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 24px;
    background-color: #FAFBFD;
    cursor: pointer;
    user-select: none;
  }

  .summary-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .cat-num {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: var(--color-ivory);
    color: var(--color-navy);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .cat-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0;
  }

  .cat-count {
    font-size: 0.8125rem;
    color: var(--color-slate);
  }

  .summary-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .view-pill {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-brass);
    background-color: rgba(168, 139, 90, 0.1);
    padding: 4px 10px;
    border-radius: 4px;
  }

  .chevron-icon {
    transition: transform 0.2s ease;
  }

  details[open] .chevron-icon {
    transform: rotate(180deg);
  }

  .specialty-articles-grid {
    padding: 24px;
    border-top: 1px solid var(--color-border);
  }

  .cat-desc {
    font-size: 0.9375rem;
    color: var(--color-slate);
    margin-bottom: 20px;
  }

  .articles-sublist {
    list-style: none;
    padding: 0;
