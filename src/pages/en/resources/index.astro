<script>
  // Hub search and specialty filtering
  const hubSearchInput = document.getElementById('hub-articles-search') as HTMLInputElement | null;
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.spec-filter-btn');
  const specialtyCards = document.querySelectorAll<HTMLDetailsElement>('.specialty-hub-card');
  const noResultsBox = document.getElementById('hub-no-results');

  let activeSpecialty = 'all';

  function filterKnowledgeBase() {
    const query = hubSearchInput ? hubSearchInput.value.toLowerCase().trim() : '';
    let totalVisible = 0;

    specialtyCards.forEach((catCard) => {
      const catSlug = catCard.getAttribute('data-specialty') || '';
      const articleItems = catCard.querySelectorAll<HTMLElement>('.article-li');
      
      const specialtyMatch = activeSpecialty === 'all' || activeSpecialty === catSlug;
      let catVisibleCount = 0;

      if (!specialtyMatch) {
        catCard.style.display = 'none';
        return;
      }

      articleItems.forEach((item) => {
        const title = item.getAttribute('data-title') || '';
        const overview = item.getAttribute('data-overview') || '';
        const matchesQuery = !query || title.includes(query) || overview.includes(query);

        if (matchesQuery) {
          item.style.display = '';
          catVisibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (catVisibleCount > 0 || (!query && articleItems.length === 0)) {
        catCard.style.display = '';
        totalVisible += catVisibleCount;
        if (query) {
          catCard.open = true;
        }
      } else {
        catCard.style.display = 'none';
      }
    });

    if (noResultsBox) {
      noResultsBox.style.display = totalVisible === 0 ? 'block' : 'none';
    }
  }

  if (hubSearchInput) {
    hubSearchInput.addEventListener('input', filterKnowledgeBase);
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeSpecialty = btn.getAttribute('data-filter') || 'all';
      filterKnowledgeBase();
    });
  });
</script>
