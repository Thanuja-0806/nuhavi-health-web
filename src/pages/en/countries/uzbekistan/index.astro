---
/**
 * src/pages/en/countries/uzbekistan/index.astro
 * Treatment in India from Uzbekistan (Pages 22, 23 & 24 of Nuhavi Health Look and Feel PDF)
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Treatment in India from Uzbekistan | Nuhavi Health"
  description="We help patients and families from Tashkent, Samarkand and across Uzbekistan plan cancer and joint-replacement care in Hyderabad, with coordinators who speak Russian."
>
  <div class="page-container">
    <div class="container main-content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/en/">Home</a></li>
          <li><a href="/en/countries/">Countries we serve</a></li>
          <li aria-current="page">Treatment in India from Uzbekistan</li>
        </ol>
      </nav>

      <!-- Gold 72x3 px rule above page title -->
      <div class="gold-rule" aria-hidden="true"></div>

      <header class="page-header">
        <h1 class="page-title">Treatment in India from Uzbekistan</h1>
        <p class="page-deck">
          We help patients and families from Tashkent, Samarkand and across Uzbekistan plan cancer and joint-replacement care in Hyderabad, with coordinators who speak Russian.
        </p>
      </header>

      <!-- 3-Column Summary Cards (Page 22) -->
      <section class="summary-cards-section">
        <div class="summary-grid">
          <div class="summary-card">
            <h3>Treatments</h3>
            <ul class="check-list">
              <li><a href="/en/treatments/oncology/">Cancer care (oncology)</a></li>
              <li>Orthopaedics and joint replacement</li>
              <li>Other specialties on request</li>
            </ul>
          </div>

          <div class="summary-card">
            <h3>Languages</h3>
            <p class="languages-title">Russian, Uzbek, English.</p>
            <p class="card-note">Tell us your preferred language in the enquiry form. We will say if we cannot yet support it.</p>
          </div>

          <div class="summary-card">
            <h3>How to enquire</h3>
            <p class="card-desc">
              Use the <a href="/en/request-opinion/">enquiry form</a>, Telegram or WhatsApp. Include your country code with your phone number. Do not send reports by chat — you will get a secure upload link.
            </p>
          </div>
        </div>
      </section>

      <!-- Sharing Records Section (Page 22) -->
      <section class="sharing-records-section">
        <div class="sharing-grid">
          <div class="sharing-left">
            <h2 class="section-title">Sharing your medical records</h2>
            <p class="sharing-desc">
              After your enquiry you can agree to secure storage, and we email you a private upload link that works for 48 hours and only for your case. Use only that link.
            </p>

            <div class="amber-warning-box">
              <span class="warning-title">Important for patients in Uzbekistan:</span>
              <p>
                If you have genetic test results (for example BRCA or NGS reports), do not upload them. Tell your coordinator instead: Uzbek law restricts where genetic data may be stored, and we will explain the options.
              </p>
            </div>
          </div>

          <div class="sharing-right">
            <div class="checklist-panel">
              <div class="checklist-header">
                <h3>Cancer care records checklist</h3>
                <span class="checklist-counter">0 of 8 ready</span>
              </div>
              <ul class="interactive-checklist">
                <li><label><input type="checkbox" /> <span>Biopsy or histopathology report</span></label></li>
                <li><label><input type="checkbox" /> <span>Immunohistochemistry (IHC) report, if done</span></label></li>
                <li><label><input type="checkbox" /> <span>Latest CT, MRI or PET-CT report</span></label></li>
                <li><label><input type="checkbox" /> <span>Scan images (disc or download link)</span></label></li>
                <li><label><input type="checkbox" /> <span>Blood tests from the last 4 weeks</span></label></li>
                <li><label><input type="checkbox" /> <span>Summary of treatment so far, with dates</span></label></li>
                <li><label><input type="checkbox" /> <span>Current medicines and allergies</span></label></li>
                <li><label><input type="checkbox" /> <span>Passport copy (only when your coordinator asks, for the visa letter)</span></label></li>
              </ul>
              <a href="javascript:window.print()" class="print-link">Print this checklist</a>
            </div>
          </div>
        </div>
      </section>

      <!-- Visa & Travel Section (Page 23) -->
      <section class="visa-travel-section">
        <h2 class="section-title">Visa and travel</h2>

        <div class="visa-grid">
          <div class="visa-left">
            <p>
              India offers an e-Medical visa for patients and an e-Medical Attendant visa for family members travelling with them. Eligibility, validity and fees are set by the Government of India and change from time to time, so always check the official portal before applying.
            </p>
            <p>
              A hospital invitation letter is usually needed. We help you request it once a hospital has reviewed your case. We cannot guarantee that any visa will be approved.
            </p>
            <p>
              <a href="https://indianvisaonline.gov.in" target="_blank" rel="noopener noreferrer" class="link-external">
                Official Indian visa portal (opens in a new tab)
              </a>
            </p>
            <p>
              Direct and one-stop flights connect Tashkent with Hyderabad. We confirm current schedules and the best option when we plan your trip.
            </p>

            <!-- Video placeholder Russian/Uzbek -->
            <div class="video-slot">
              <div class="video-overlay">
                <div class="play-button" aria-hidden="true">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </div>
                <span class="video-heading">Video to come</span>
                <span class="video-sub">Для пациентов из Узбекистана: как работает Nuhavi (90 секунд)</span>
              </div>
            </div>
            <p class="video-subtext">In Russian, with Uzbek subtitles.</p>

            <h3 class="subsection-title">Travelling with family</h3>
            <p>
              Most hospitals ask that an adult companion stays with you. We help plan their visa, stay and day-to-day needs too.
            </p>

            <h3 class="subsection-title">Payment</h3>
            <p>
              Hospital charges are paid to the hospital, normally by bank transfer or at the hospital. Nuhavi's coordination fee is invoiced separately. If you ask us to arrange accommodation or transport, we show what we charge for it before you agree.
            </p>
          </div>

          <div class="visa-right">
            <!-- Photo Slot -->
            <div class="photo-slot">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                <circle cx="12" cy="13" r="4"></circle>
              </svg>
              <span class="photo-label">Photo to come</span>
              <span class="photo-desc">A clean, quiet serviced apartment near the hospital</span>
            </div>
            <p class="photo-caption">Accommodation near the hospital, if you want us to arrange it.</p>

            <!-- Travel Checklist -->
            <div class="checklist-panel">
              <div class="checklist-header">
                <h3>Travel checklist</h3>
                <span class="checklist-counter">0 of 8 ready</span>
              </div>
              <ul class="interactive-checklist">
                <li><label><input type="checkbox" /> <span>Passport valid for at least six months</span></label></li>
                <li><label><input type="checkbox" /> <span>e-Medical visa applied for (and e-Medical Attendant visa for your companion)</span></label></li>
                <li><label><input type="checkbox" /> <span>Hospital invitation letter</span></label></li>
                <li><label><input type="checkbox" /> <span>Flights booked after visa approval</span></label></li>
                <li><label><input type="checkbox" /> <span>Travel insurance checked</span></label></li>
                <li><label><input type="checkbox" /> <span>Original medical records and scan discs packed in hand luggage</span></label></li>
                <li><label><input type="checkbox" /> <span>Medicines for the journey</span></label></li>
                <li><label><input type="checkbox" /> <span>Coordinator's phone number saved</span></label></li>
              </ul>
              <a href="javascript:window.print()" class="print-link">Print this checklist</a>
            </div>

            <!-- Emergency Warning Box (Red) -->
            <div class="emergency-box" role="alert">
              <div class="emergency-header">
                <span class="alert-icon">⚠</span>
                <strong>Is this an emergency?</strong>
              </div>
              <p>
                Chest pain, sudden weakness or numbness, difficulty speaking, severe bleeding, a seizure or difficulty breathing need care now. Go to the nearest emergency department or call your local emergency number. Do not wait for an enquiry reply.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- Coordination Process Accordion (Page 24) -->
      <section class="process-section">
        <h2 class="section-title">The coordination process</h2>
        <p class="process-sub">The same seven steps, wherever you live.</p>

        <div class="steps-compact-list">
          <details class="step-accordion" open>
            <summary><span class="step-idx">1</span> Send an enquiry</summary>
            <p class="step-summary-text">Tell us briefly what you need. A coordinator assigns your inquiry number.</p>
          </details>
          <details class="step-accordion">
            <summary><span class="step-idx">2</span> Share your records securely</summary>
            <p class="step-summary-text">Upload reports through an encrypted private link valid for 48 hours.</p>
          </details>
          <details class="step-accordion">
            <summary><span class="step-idx">3</span> Clinical review</summary>
            <p class="step-summary-text">Senior medical oncology and surgical teams evaluate case feasibility.</p>
          </details>
          <details class="step-accordion">
            <summary><span class="step-idx">4</span> Understand your options</summary>
            <p class="step-summary-text">Discuss hospital protocols in Russian or English with plain clinical terminology.</p>
          </details>
          <details class="step-accordion">
            <summary><span class="step-idx">5</span> Review estimates</summary>
            <p class="step-summary-text">Receive official hospital quotations with itemized inclusions and validity.</p>
          </details>
          <details class="step-accordion">
            <summary><span class="step-idx">6</span> Plan appointments and travel</summary>
            <p class="step-summary-text">Coordinate visa invitation letters, flights, and dedicated airport reception.</p>
          </details>
          <details class="step-accordion">
            <summary><span class="step-idx">7</span> Follow-up after you return home</summary>
            <p class="step-summary-text">Continuous communication and tele-consults after discharge back in Uzbekistan.</p>
          </details>
        </div>
      </section>
    </div>
  </div>

<script>
  function setupChecklists() {
    const panels = document.querySelectorAll('.checklist-panel');
    panels.forEach((panel) => {
      const counter = panel.querySelector('.checklist-counter');
      const checkboxes = panel.querySelectorAll('input[type="checkbox"]');
      const total = checkboxes.length;

      function update() {
        const checked = Array.from(checkboxes).filter(cb => cb.checked).length;
        if (counter) {
          counter.textContent = checked + ' of ' + total + ' ready';
        }
      }

      checkboxes.forEach(cb => {
        cb.addEventListener('change', update);
      });
      update();
    });
  }
  document.addEventListener('DOMContentLoaded', setupChecklists);
  setupChecklists();
</script>

</BaseLayout>

<style>
  .page-container {
    background-color: var(--color-paper);
    color: var(--color-ink);
    padding: var(--space-8) 0 var(--space-12);
  }

  .breadcrumb ol {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
    font-size: 0.8125rem;
    color: var(--color-slate);
  }

  .breadcrumb li + li::before {
    content: "/";
    margin-right: var(--space-1);
    color: var(--color-slate);
  }

  .breadcrumb a {
    color: var(--color-navy);
    text-decoration: none;
  }

  .gold-rule {
    width: 72px;
    height: 3px;
    background-color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1.15;
    margin: 0 0 var(--space-2);
  }

  .page-deck {
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-slate);
    max-width: 720px;
    margin: 0;
  }

  /* 3-Column Summary Grid */
  .summary-cards-section {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
    margin-bottom: var(--space-8);
  }

  .summary-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .summary-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .summary-card {
    background-color: var(--color-mist);
    border: 1px solid rgba(20, 41, 75, 0.1);
    border-radius: 14px;
    padding: var(--space-6);
  }

  .summary-card h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 var(--space-2);
  }

  .check-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.875rem;
  }

  .check-list li::before {
    content: "✓ ";
    color: var(--color-navy);
    font-weight: bold;
  }

  .check-list a {
    color: var(--color-navy);
    text-decoration: underline;
  }

  .languages-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-navy);
    margin: 0 0 6px;
  }

  .card-note {
    font-size: 0.8125rem;
    color: var(--color-slate);
    line-height: 1.45;
    margin: 0;
  }

  .card-desc {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-ink);
    margin: 0;
  }

  .card-desc a {
    color: var(--color-navy);
    font-weight: 600;
    text-decoration: underline;
  }

  /* Sharing Records */
  .sharing-records-section {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
    margin-bottom: var(--space-8);
  }

  .sharing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .sharing-grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-8);
    }
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0 0 var(--space-3);
  }

  .sharing-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink);
    margin: 0 0 var(--space-4);
  }

  /* Amber Marker Box */
  .amber-warning-box {
    background-color: #FFF6E5;
    border: 1px solid #C49A3C;
    border-radius: 8px;
    padding: 16px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #8A6726;
  }

  .warning-title {
    display: block;
    font-weight: 700;
    margin-bottom: 4px;
    color: #8A6726;
  }

  .amber-warning-box p {
    margin: 0;
  }

  /* Checklist Panel */
  .checklist-panel {
    background-color: var(--color-paper);
    border: 1px solid rgba(20, 41, 75, 0.12);
    border-radius: 14px;
    padding: var(--space-6);
    margin-bottom: var(--space-4);
  }

  .checklist-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-3);
  }

  .checklist-header h3 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0;
  }

  .checklist-counter {
    font-size: 0.75rem;
    color: var(--color-slate);
  }

  .interactive-checklist {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .interactive-checklist label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-ink);
    cursor: pointer;
  }

  .interactive-checklist input {
    margin-top: 2px;
  }

  .print-link {
    font-size: 0.75rem;
    color: var(--color-slate);
    text-decoration: underline;
  }

  /* Visa & Travel Section */
  .visa-travel-section {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
    margin-bottom: var(--space-8);
  }

  .visa-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .visa-grid {
      grid-template-columns: 6fr 6fr;
      gap: var(--space-8);
    }
  }

  .visa-left p {
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: var(--space-3);
  }

  .link-external {
    color: var(--color-navy);
    text-decoration: underline;
    font-weight: 600;
  }

  .subsection-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: var(--space-4) 0 var(--space-2);
  }

  /* Video slot placeholder */
  .video-slot {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--color-deep-navy);
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-paper);
    padding: var(--space-4);
    text-align: center;
    box-sizing: border-box;
    margin: var(--space-4) 0 var(--space-1);
  }

  .video-overlay {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    max-width: 320px;
  }

  .play-button {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-paper);
    margin-bottom: 2px;
  }

  .video-heading {
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .video-sub {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.35;
  }

  .video-subtext {
    font-size: 0.75rem;
    color: var(--color-slate);
    margin-bottom: var(--space-4);
  }

  /* Photo Slot */
  .photo-slot {
    width: 100%;
    aspect-ratio: 16 / 9;
    background-color: var(--color-deep-navy);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--color-paper);
    padding: var(--space-4);
    text-align: center;
    gap: 6px;
  }

  .photo-label {
    font-size: 0.875rem;
    font-weight: 700;
  }

  .photo-desc {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.75);
  }

  .photo-caption {
    font-size: 0.75rem;
    color: var(--color-slate);
    margin: var(--space-1) 0 var(--space-4);
  }

  /* Emergency Warning Box (Red) */
  .emergency-box {
    background-color: #FEF3F2;
    border: 1px solid #FECDCA;
    border-radius: 8px;
    padding: 16px;
    margin-top: var(--space-4);
  }

  .emergency-header {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--color-error);
    margin-bottom: 6px;
  }

  .emergency-header strong {
    font-size: 0.875rem;
  }

  .emergency-box p {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #55160C;
    margin: 0;
  }

  /* Process Steps (Page 24) */
  .process-sub {
    font-size: 0.9375rem;
    color: var(--color-slate);
    margin: 0 0 var(--space-4);
  }

  .steps-compact-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 680px;
  }

  .step-accordion {
    border: 1px solid rgba(20, 41, 75, 0.12);
    border-radius: 8px;
    padding: 12px 16px;
    background-color: var(--color-mist);
  }

  .step-accordion summary {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-navy);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .step-idx {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background-color: var(--color-navy);
    color: var(--color-paper);
    font-size: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .step-summary-text {
    font-size: 0.8125rem;
    color: var(--color-slate);
    margin: 8px 0 0 34px;
    line-height: 1.45;
  }
</style>

