---
/**
 * src/pages/en/countries/index.astro
 * Countries we serve (Page 21 of Nuhavi Health Look and Feel PDF)
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Countries we serve | Nuhavi Health"
  description="Wherever you start, the route ends at a hospital in Hyderabad and back home again. These are the countries we currently accept enquiries from."
>
  <div class="page-container">
    <div class="container main-content">
      <!-- Gold 72x3 px rule above page title -->
      <div class="gold-rule" aria-hidden="true"></div>

      <header class="page-header">
        <h1 class="page-title">Countries we serve</h1>
        <p class="page-deck">
          Wherever you start, the route ends at a hospital in Hyderabad and back home again. These are the countries we currently accept enquiries from.
        </p>
      </header>

      <div class="countries-grid">
        <!-- Uzbekistan leads as large navy card -->
        <a href="/en/countries/uzbekistan/" class="country-card-featured">
          <h2 class="featured-title">Uzbekistan</h2>
          <span class="featured-languages">Support in Russian, Uzbek, English</span>
          <p class="featured-text">
            We help patients and families from Tashkent, Samarkand and across Uzbekistan plan cancer and joint-replacement care in Hyderabad, with coordinators who speak Russian.
          </p>
        </a>

        <!-- Equal cards below -->
        <div class="sub-countries-row">
          <div class="country-card">
            <h3 class="card-title">Kenya</h3>
            <span class="card-languages">Support in English, Swahili (planned)</span>
            <p class="card-text">
              We accept enquiries from Kenya for cancer care and joint replacement in Hyderabad. Swahili support is planned.
            </p>
          </div>

          <div class="country-card">
            <h3 class="card-title">Tanzania</h3>
            <span class="card-languages">Support in English, Swahili (planned)</span>
            <p class="card-text">
              We accept enquiries from Tanzania, including Dar es Salaam, for cancer care and joint replacement in Hyderabad.
            </p>
          </div>

          <div class="country-card">
            <h3 class="card-title">Nigeria, Uganda, Ghana and Rwanda</h3>
            <span class="card-languages">Support in English</span>
            <p class="card-text">
              We accept enquiries from Nigeria, Uganda, Ghana and Rwanda. Dedicated country pages will follow as we add local language support.
            </p>
          </div>
        </div>
      </div>

      <p class="disclaimer-note">
        We do not have offices in these countries. Listing a country means we accept enquiries from it and can support you in the languages shown.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    background-color: var(--color-paper);
    color: var(--color-ink);
    padding: var(--space-8) 0 var(--space-12);
  }

  .gold-rule {
    width: 72px;
    height: 3px;
    background-color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1.15;
    margin: 0 0 var(--space-2);
  }

  .page-deck {
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-slate);
    max-width: 680px;
    margin: 0;
  }

  .countries-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Uzbekistan Large Navy Card */
  .country-card-featured {
    display: block;
    background-color: var(--color-deep-navy);
    color: var(--color-paper);
    padding: var(--space-6) var(--space-8);
    border-radius: 14px;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .country-card-featured:hover {
    filter: brightness(1.05);
    transform: translateY(-2px);
  }

  .featured-title {
    font-size: 1.875rem;
    font-weight: 800;
    color: var(--color-paper);
    margin: 0 0 6px;
  }

  .featured-languages {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .featured-text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
    max-width: 720px;
  }

  /* 3 Equal Cards */
  .sub-countries-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .sub-countries-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .country-card {
    background-color: var(--color-mist);
    border: 1px solid rgba(20, 41, 75, 0.12);
    border-radius: 14px;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 4px;
    line-height: 1.35;
  }

  .card-languages {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-slate);
    margin-bottom: var(--space-3);
  }

  .card-text {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-ink);
    margin: 0;
  }

  .disclaimer-note {
    font-size: 0.8125rem;
    color: var(--color-slate);
    line-height: 1.5;
    margin-top: var(--space-6);
  }
</style>
