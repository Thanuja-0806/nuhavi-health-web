---
/**
 * src/pages/en/countries/index.astro
 * Countries We Serve — Nuhavi Health
 *
 * Implements:
 * - Premium international medical-travel design inspired by Vaidam / Jus' Onco and the approved reference "Global Medical Access".
 * - Clean white background with deep navy blue (#0D1B33), soft medical mist, and restrained gold (#C49A3C) accents.
 * - Hero section:
 *   - Left side: small gold-tinted badge "Global Medical Access" with airplane icon, bold heading, deck, and gold rounded "Explore Countries" button.
 *   - Right side: large light-blue world map visual with India highlighted in gold, curved flight paths, and airplane visual.
 * - "Our International Support" section:
 *   - Four equal-width responsive country cards in one desktop row (tablet: 2 cols, mobile: 1 col).
 *   - 1. Uzbekistan (Tashkent / Samarkand) with Russian, Uzbek, English support, linking to /en/countries/uzbekistan/.
 *   - 2. Kenya with English, Swahili (planned) support, linking to /en/request-opinion/.
 *   - 3. Tanzania (Dar es Salaam) with English, Swahili (planned) support, linking to /en/request-opinion/.
 *   - 4. Nigeria, Uganda, Ghana & Rwanda with 4 accurate flags, English support, linking to /en/request-opinion/.
 *   - Equal card heights, white content areas, rounded corners, subtle shadows, and gold circular arrow buttons.
 * - Preserved full clinical transparency and operating presence disclaimer note.
 * - Wide dark navy bottom CTA banner with gold globe illustration on the left, dotted flight path and airplane visual, and gold rounded "Contact Us" button.
 * - Zero unverified medical claims or invented statistics.
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Medical Treatment Across the World | Nuhavi Health"
  description="Explore treatment options in India, with dedicated support for patients from around the globe. Multilingual coordination for cancer care and joint replacement."
>
  <div class="countries-page">
    <!-- Breadcrumb Bar -->
    <div class="breadcrumb-bar">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/en/">Home</a></li>
            <li aria-hidden="true"><span class="sep">/</span></li>
            <li aria-current="page">Countries we serve</li>
          </ol>
        </nav>
      </div>
    </div>

    <!-- 1. HERO SECTION: Medical Treatment Across the World -->
    <section class="countries-hero-section" aria-labelledby="hero-heading">
      <div class="container hero-container">
        <!-- Hero Text Column -->
        <div class="hero-content">
          <!-- Small gold-tinted badge "Global Medical Access" with airplane icon -->
          <div class="hero-badge" aria-label="Global Medical Access">
            <svg class="badge-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"/>
            </svg>
            <span>Global Medical Access</span>
          </div>

          <h1 id="hero-heading" class="hero-title">
            Medical Treatment Across the World
          </h1>

          <p class="hero-deck">
            Explore treatment options in India, with dedicated support for patients from around the globe.
          </p>

          <div class="hero-actions">
            <a href="#international-support" class="btn btn-gold btn-rounded explore-btn">
              <span>Explore Countries</span>
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <polyline points="19 12 12 19 5 12"></polyline>
              </svg>
            </a>
            <a href="/en/request-opinion/" class="btn btn-outline-navy btn-rounded">
              Request a Medical Opinion
            </a>
          </div>

          <!-- Trust highlights row -->
          <div class="hero-trust-row">
            <div class="trust-item">
              <span class="trust-icon" aria-hidden="true">&#10003;</span>
              <span>Multilingual Case Coordination</span>
            </div>
            <div class="trust-item">
              <span class="trust-icon" aria-hidden="true">&#10003;</span>
              <span>Guidance Before You Travel</span>
            </div>
            <div class="trust-item">
              <span class="trust-icon" aria-hidden="true">&#10003;</span>
              <span>Dedicated International Patient Support</span>
            </div>
          </div>
        </div>

        <!-- Hero Visual: Premium World Map Visual with India in Gold, Curved Flight Paths & Realistic Airplane -->
        <div class="hero-visual-wrapper">
          <div class="world-map-visual-card" role="img" aria-label="World map showing international flight paths converging toward India for medical travel coordination">
            <div class="map-image-container">
              <img
                src="/images/world-travel-map.jpg"
                alt="World map visual with India highlighted in gold and elegant curved flight paths converging towards India"
                class="world-map-img"
                width="1200"
                height="675"
                loading="eager"
              />
              <div class="map-soft-vignette" aria-hidden="true"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. OUR INTERNATIONAL SUPPORT: Four Responsive Country Cards -->
    <section id="international-support" class="support-section" aria-labelledby="support-heading">
      <div class="container">
        <!-- Section Header -->
        <div class="support-section-header">
          <span class="section-eyebrow">DEDICATED COUNTRY DESKS</span>
          <h2 id="support-heading" class="section-title">Our International Support</h2>
          <p class="section-deck">
            Dedicated support for patients from select countries, with multilingual assistance.
          </p>
        </div>

        <!-- 4-Column Responsive Country Cards Grid -->
        <div class="country-cards-grid">
          <!-- CARD 1: UZBEKISTAN -->
          <article class="country-card">
            <div class="card-image-wrap">
              <img
                src="/images/country-uzbekistan.jpg"
                alt="Modern city architectural skyline of Tashkent, Uzbekistan"
                class="card-img"
                loading="lazy"
                width="600"
                height="375"
              />
              <div class="card-image-overlay"></div>
              <div class="card-flag-badge" aria-label="Flag of Uzbekistan">
                <!-- Uzbekistan Flag SVG Badge -->
                <svg width="28" height="18" viewBox="0 0 28 18" fill="none" class="flag-svg" aria-hidden="true">
                  <rect width="28" height="18" rx="2" fill="#FFFFFF" />
                  <rect width="28" height="5.5" fill="#0099B5" />
                  <rect y="12.5" width="28" height="5.5" fill="#1EB53A" />
                  <rect y="5.5" width="28" height="0.8" fill="#CE1126" />
                  <rect y="11.7" width="28" height="0.8" fill="#CE1126" />
                  <circle cx="5" cy="2.8" r="1.6" fill="#FFFFFF" />
                  <circle cx="5.6" cy="2.8" r="1.3" fill="#0099B5" />
                </svg>
                <span class="flag-country-name">Uzbekistan</span>
              </div>
            </div>

            <div class="card-body">
              <div class="card-support-pill">
                <span class="pill-dot" aria-hidden="true"></span>
                <span>Support in Russian, Uzbek, English</span>
              </div>

              <h3 class="card-country-title">Uzbekistan</h3>

              <p class="card-description">
                We help patients and families from Tashkent, Samarkand and across Uzbekistan plan cancer and joint-replacement care in Hyderabad, with coordinators who speak Russian.
              </p>

              <div class="card-footer-action">
                <a
                  href="/en/countries/uzbekistan/"
                  class="btn-learn-more"
                  aria-label="Learn more about patient coordination for Uzbekistan"
                >
                  <span class="learn-more-text">Learn More</span>
                  <span class="gold-circle-arrow" aria-hidden="true">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </span>
                </a>
              </div>
            </div>
          </article>

          <!-- CARD 2: KENYA -->
          <article class="country-card">
            <div class="card-image-wrap">
              <img
                src="/images/country-kenya.jpg"
                alt="Modern city skyline of Nairobi, Kenya"
                class="card-img"
                loading="lazy"
                width="600"
                height="375"
              />
              <div class="card-image-overlay"></div>
              <div class="card-flag-badge" aria-label="Flag of Kenya">
                <!-- Kenya Flag SVG Badge -->
                <svg width="28" height="18" viewBox="0 0 28 18" fill="none" class="flag-svg" aria-hidden="true">
                  <rect width="28" height="18" rx="2" fill="#FFFFFF" />
                  <rect width="28" height="5" fill="#000000" />
                  <rect y="5" width="28" height="1" fill="#FFFFFF" />
                  <rect y="6" width="28" height="6" fill="#BB0000" />
                  <rect y="12" width="28" height="1" fill="#FFFFFF" />
                  <rect y="13" width="28" height="5" fill="#006600" />
                  <ellipse cx="14" cy="9" rx="2.5" ry="4" fill="#BB0000" stroke="#FFFFFF" stroke-width="0.6" />
                </svg>
                <span class="flag-country-name">Kenya</span>
              </div>
            </div>

            <div class="card-body">
              <div class="card-support-pill">
                <span class="pill-dot" aria-hidden="true"></span>
                <span>Support in English, Swahili (planned)</span>
              </div>

              <h3 class="card-country-title">Kenya</h3>

              <p class="card-description">
                We accept enquiries from Kenya for cancer care and joint replacement in Hyderabad. Swahili support is planned.
              </p>

              <div class="card-footer-action">
                <a
                  href="/en/request-opinion/"
                  class="btn-learn-more"
                  aria-label="Submit medical enquiry from Kenya"
                >
                  <span class="learn-more-text">Send an Enquiry</span>
                  <span class="gold-circle-arrow" aria-hidden="true">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </span>
                </a>
              </div>
            </div>
          </article>

          <!-- CARD 3: TANZANIA -->
          <article class="country-card">
            <div class="card-image-wrap">
              <img
                src="/images/country-tanzania.jpg"
                alt="Modern coastal city waterfront of Dar es Salaam, Tanzania"
                class="card-img"
                loading="lazy"
                width="600"
                height="375"
              />
              <div class="card-image-overlay"></div>
              <div class="card-flag-badge" aria-label="Flag of Tanzania">
                <!-- Tanzania Flag SVG Badge -->
                <svg width="28" height="18" viewBox="0 0 28 18" fill="none" class="flag-svg" aria-hidden="true">
                  <rect width="28" height="18" rx="2" fill="#1EB53A" />
                  <polygon points="0,18 28,0 28,18" fill="#00A3DD" />
                  <polygon points="0,18 28,0 28,4 4,18" fill="#FCD116" />
                  <polygon points="0,14 24,0 28,0 0,18" fill="#FCD116" />
                  <polygon points="0,16 26,0 28,0 28,1 2,18 0,18" fill="#000000" />
                </svg>
                <span class="flag-country-name">Tanzania</span>
              </div>
            </div>

            <div class="card-body">
              <div class="card-support-pill">
                <span class="pill-dot" aria-hidden="true"></span>
                <span>Support in English, Swahili (planned)</span>
              </div>

              <h3 class="card-country-title">Tanzania</h3>

              <p class="card-description">
                We accept enquiries from Tanzania, including Dar es Salaam, for cancer care and joint replacement in Hyderabad.
              </p>

              <div class="card-footer-action">
                <a
                  href="/en/request-opinion/"
                  class="btn-learn-more"
                  aria-label="Submit medical enquiry from Tanzania"
                >
                  <span class="learn-more-text">Send an Enquiry</span>
                  <span class="gold-circle-arrow" aria-hidden="true">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </span>
                </a>
              </div>
            </div>
          </article>

          <!-- CARD 4: NIGERIA, UGANDA, GHANA AND RWANDA -->
          <article class="country-card">
            <div class="card-image-wrap">
              <img
                src="/images/country-africa-regional.jpg"
                alt="Modern metropolitan business district skyline in West Africa"
                class="card-img"
                loading="lazy"
                width="600"
                height="375"
              />
              <div class="card-image-overlay"></div>
              <div class="card-flag-badge multi-flag-badge" aria-label="Flags of Nigeria, Uganda, Ghana, and Rwanda">
                <!-- Multi-Flag SVG Cluster for Nigeria, Uganda, Ghana, Rwanda -->
                <div class="flags-cluster" aria-hidden="true">
                  <!-- Nigeria Flag: Green / White / Green -->
                  <svg width="18" height="12" viewBox="0 0 18 12" fill="none" class="mini-flag" title="Nigeria">
                    <rect width="18" height="12" rx="1.5" fill="#FFFFFF" />
                    <rect width="6" height="12" fill="#008751" />
                    <rect x="12" width="6" height="12" fill="#008751" />
                  </svg>
                  <!-- Ghana Flag: Red / Yellow / Green + Black Star -->
                  <svg width="18" height="12" viewBox="0 0 18 12" fill="none" class="mini-flag" title="Ghana">
                    <rect width="18" height="4" fill="#CE1126" />
                    <rect y="4" width="18" height="4" fill="#FCD116" />
                    <rect y="8" width="18" height="4" fill="#006B3F" />
                    <polygon points="9,4.8 9.5,6.4 11,6.4 9.8,7.3 10.2,8.8 9,7.9 7.8,8.8 8.2,7.3 7,6.4 8.5,6.4" fill="#000000" />
                  </svg>
                  <!-- Uganda Flag: Black / Yellow / Red x2 -->
                  <svg width="18" height="12" viewBox="0 0 18 12" fill="none" class="mini-flag" title="Uganda">
                    <rect width="18" height="2" fill="#000000" />
                    <rect y="2" width="18" height="2" fill="#FCDC00" />
                    <rect y="4" width="18" height="2" fill="#D90000" />
                    <rect y="6" width="18" height="2" fill="#000000" />
                    <rect y="8" width="18" height="2" fill="#FCDC00" />
                    <rect y="10" width="18" height="2" fill="#D90000" />
                  </svg>
                  <!-- Rwanda Flag: Sky Blue / Yellow / Green with Sun -->
                  <svg width="18" height="12" viewBox="0 0 18 12" fill="none" class="mini-flag" title="Rwanda">
                    <rect width="18" height="6" fill="#00A1DE" />
                    <rect y="6" width="18" height="3" fill="#FAD201" />
                    <rect y="9" width="18" height="3" fill="#20603D" />
                    <circle cx="14" cy="3" r="1.2" fill="#E5BE01" />
                  </svg>
                </div>
                <span class="flag-country-name">West &amp; East Africa</span>
              </div>
            </div>

            <div class="card-body">
              <div class="card-support-pill">
                <span class="pill-dot" aria-hidden="true"></span>
                <span>Support in English</span>
              </div>

              <h3 class="card-country-title">Nigeria, Uganda, Ghana &amp; Rwanda</h3>

              <p class="card-description">
                We accept enquiries from Nigeria, Uganda, Ghana and Rwanda. Dedicated country pages will follow as we add local language support.
              </p>

              <div class="card-footer-action">
                <a
                  href="/en/request-opinion/"
                  class="btn-learn-more"
                  aria-label="Submit medical enquiry from Nigeria, Uganda, Ghana or Rwanda"
                >
                  <span class="learn-more-text">Send an Enquiry</span>
                  <span class="gold-circle-arrow" aria-hidden="true">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </span>
                </a>
              </div>
            </div>
          </article>
        </div>

        <!-- Geographic & Clinical Notice Box (Preserved for clinical governance) -->
        <div class="country-disclaimer-card">
          <div class="disclaimer-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
          </div>
          <div class="disclaimer-body">
            <strong>Operating Presence &amp; Coordination Note:</strong>
            <p>
              Nuhavi Health does not maintain physical branch offices in these countries. Listing a country confirms that our coordination team accepts enquiries from residents of that country and can support you in the stated languages. All clinical evaluations, consultations, and surgical care take place at accredited hospital partner facilities in Hyderabad, India.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. BOTTOM CTA SECTION: Wide Dark Navy Banner with Gold Globe, Dotted Flight Path & Airplane -->
    <section class="countries-cta-section" aria-labelledby="cta-heading">
      <div class="container">
        <div class="countries-cta-banner">
          <!-- Subtle Dotted Flight Path & Airplane Illustration -->
          <div class="cta-flight-visual" aria-hidden="true">
            <svg class="flight-path-svg" viewBox="0 0 1000 240" fill="none" preserveAspectRatio="none">
              <path d="M 60 190 Q 320 30 640 120 T 960 70" stroke="rgba(196, 154, 60, 0.32)" stroke-width="2" stroke-dasharray="7 7" fill="none" />
              <!-- Small Airplane along curved flight path -->
              <g transform="translate(680, 102) rotate(-14) scale(0.95)">
                <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z" fill="#C49A3C" opacity="0.95" />
              </g>
            </svg>
          </div>

          <div class="cta-banner-inner">
            <!-- Gold Globe Illustration on the Left -->
            <div class="cta-globe-wrapper" aria-hidden="true">
              <div class="cta-globe-glow"></div>
              <svg class="cta-globe-svg" width="130" height="130" viewBox="0 0 130 130" fill="none">
                <!-- Globe outer sphere -->
                <circle cx="65" cy="65" r="58" stroke="rgba(196, 154, 60, 0.45)" stroke-width="1.8" />
                <!-- Latitude ellipses -->
                <ellipse cx="65" cy="65" rx="58" ry="22" stroke="rgba(196, 154, 60, 0.35)" stroke-width="1.4" stroke-dasharray="3 3" />
                <ellipse cx="65" cy="65" rx="58" ry="42" stroke="rgba(196, 154, 60, 0.35)" stroke-width="1.4" stroke-dasharray="3 3" />
                <line x1="7" y1="65" x2="123" y2="65" stroke="rgba(196, 154, 60, 0.5)" stroke-width="1.6" />
                <!-- Longitude ellipses -->
                <ellipse cx="65" cy="65" rx="22" ry="58" stroke="rgba(196, 154, 60, 0.35)" stroke-width="1.4" stroke-dasharray="3 3" />
                <ellipse cx="65" cy="65" rx="42" ry="58" stroke="rgba(196, 154, 60, 0.35)" stroke-width="1.4" stroke-dasharray="3 3" />
                <line x1="65" y1="7" x2="65" y2="123" stroke="rgba(196, 154, 60, 0.5)" stroke-width="1.6" />
                <!-- India coordinate gold beacon -->
                <circle cx="78" cy="58" r="4.5" fill="#C49A3C" />
                <circle cx="78" cy="58" r="8.5" stroke="#C49A3C" stroke-width="1.2" opacity="0.6" />
              </svg>
            </div>

            <!-- CTA Content Column -->
            <div class="cta-content-column">
              <div class="cta-badge">DIRECT PATIENT ASSISTANCE</div>
              <h2 id="cta-heading" class="cta-title">
                Need Help from Your Country?
              </h2>
              <p class="cta-text">
                Our team is here to guide you through your medical journey to India.
              </p>
              <div class="cta-actions">
                <a href="/en/contact/" class="btn btn-gold btn-rounded cta-btn">
                  <span>Contact Us</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
                <a href="/en/request-opinion/" class="btn btn-outline-white btn-rounded">
                  Request a Medical Opinion
                </a>
              </div>
              <div class="cta-trust-strip">
                <span>Independent care coordination</span>
                <span class="bullet" aria-hidden="true">&bull;</span>
                <span>Multilingual patient support</span>
                <span class="bullet" aria-hidden="true">&bull;</span>
                <span>Guidance throughout your medical journey</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ==========================================================================
     GLOBAL PAGE WRAPPER & BREADCRUMBS
     ========================================================================== */
  .countries-page {
    background-color: var(--color-paper, #FFFFFF);
    color: var(--color-ink, #0D1B33);
    min-height: 100vh;
  }

  .breadcrumb-bar {
    padding: 18px 0 0;
    background-color: var(--color-paper, #FFFFFF);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
  }

  .breadcrumb a {
    color: var(--color-slate, #475569);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumb a:hover {
    color: var(--color-navy, #0D1B33);
  }

  .breadcrumb .sep {
    color: #94A3B8;
  }

  .breadcrumb [aria-current="page"] {
    color: var(--color-navy, #0D1B33);
    font-weight: 600;
  }

  /* ==========================================================================
     1. HERO SECTION: Medical Treatment Across the World
     ========================================================================== */
  .countries-hero-section {
    padding: 24px 0 56px;
    background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
    border-bottom: 1px solid #E2E8F0;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 36px;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr 1.28fr;
      gap: 48px;
    }
  }

  .hero-content {
    max-width: 580px;
  }

  /* Small gold-tinted badge "Global Medical Access" with airplane icon */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #8A6726;
    background-color: rgba(196, 154, 60, 0.12);
    border: 1px solid rgba(196, 154, 60, 0.35);
    padding: 6px 14px;
    border-radius: 9999px;
    margin-bottom: 18px;
  }

  .hero-badge .badge-icon {
    color: var(--color-gold, #C49A3C);
    flex-shrink: 0;
  }

  .hero-title {
