---
/**
 * src/pages/en/how-it-works/index.astro
 * How Nuhavi Health Works - Overview & Patient Journey
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PatientJourney from '../../../components/home/PatientJourney.astro';
import CoordinatorBenefits from '../../../components/home/CoordinatorBenefits.astro';
---

<BaseLayout
  title="How It Works | Nuhavi Health Coordination"
  description="Learn how Nuhavi Health guides you step-by-step through medical review, hospital selection, travel logistics, and hospital care in India."
>
  <div class="page-container">
    <!-- Header Hero -->
    <header class="page-header">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/en/">Home</a></li>
            <li aria-current="page">How it works</li>
          </ol>
        </nav>
        <span class="eyebrow">COORDINATION PROCESS</span>
        <h1 class="page-title">How Nuhavi Health Works</h1>
        <p class="page-deck">
          We act as your independent medical travel coordinator — organizing clinical evaluations, clarifying hospital estimates, and supporting you before departure, during hospital admission, and after returning home.
        </p>
      </div>
    </header>

    <!-- Transparent Costs Callout Card -->
    <section class="cost-callout-section">
      <div class="container">
        <div class="cost-banner">
          <div class="cost-banner-content">
            <span class="banner-badge">FINANCIAL TRANSPARENCY</span>
            <h2>Understanding treatment costs and coordination fees</h2>
            <p>
              We believe in total financial clarity. Review detailed hospital estimates, understand what is included, and see exactly how coordination and hospital billing work.
            </p>
          </div>
          <div class="cost-banner-action">
            <a href="/en/how-it-works/costs-and-fees/" class="btn-primary">
              Read Costs & Fees Guide
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- 7-Step Journey Component -->
    <PatientJourney />

    <!-- Coordinator Benefits Section -->
    <CoordinatorBenefits />

    <!-- Next Steps CTA -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-card">
          <h2>Ready to discuss your medical situation?</h2>
          <p>Send your medical records for a confidential review by qualified specialist teams in India.</p>
          <div class="cta-actions">
            <a href="/en/request-opinion/" class="btn-primary">Request a medical opinion</a>
            <a href="/en/contact/" class="btn-secondary">Contact our team</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-container {
    background-color: var(--color-paper);
    color: var(--color-ink);
  }

  .page-header {
    background: linear-gradient(180deg, var(--color-mist) 0%, var(--color-paper) 100%);
    padding: var(--space-8) 0 var(--space-6);
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
  }

  .breadcrumb ol {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3);
    font-size: 0.875rem;
    color: var(--color-slate);
  }

  .breadcrumb li + li::before {
    content: "/";
    margin-right: var(--space-1);
    color: var(--color-slate);
  }

  .breadcrumb a {
    color: var(--color-navy);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: var(--font-weight-subheading);
    letter-spacing: 0.08em;
    color: var(--color-gold-text);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: var(--font-weight-heading);
    color: var(--color-navy);
    line-height: var(--line-height-heading);
    margin: 0 0 var(--space-3);
  }

  .page-deck {
    font-size: 1.125rem;
    font-weight: var(--font-weight-deck);
    line-height: var(--line-height-body);
    color: var(--color-slate);
    max-width: 720px;
    margin: 0;
  }

  .cost-callout-section {
    padding: var(--space-6) 0;
    background-color: var(--color-paper);
  }

  .cost-banner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    background-color: var(--color-deep-navy);
    color: var(--color-paper);
    padding: var(--space-6);
    border-radius: var(--radius-card);
    border: 1px solid rgba(196, 154, 60, 0.3);
  }

  @media (min-width: 768px) {
    .cost-banner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: var(--space-6) var(--space-8);
    }

    .cost-banner-content {
      max-width: 650px;
    }
  }

  .banner-badge {
    display: inline-block;
    background-color: rgba(196, 154, 60, 0.2);
    color: var(--color-gold);
    font-size: 0.75rem;
    font-weight: var(--font-weight-subheading);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.06em;
    margin-bottom: var(--space-2);
  }

  .cost-banner h2 {
    color: var(--color-paper);
    font-size: 1.5rem;
    font-weight: var(--font-weight-subheading);
    margin: 0 0 var(--space-2);
  }

  .cost-banner p {
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .cost-banner-action {
    flex-shrink: 0;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-gold);
    color: var(--color-deep-navy);
    font-weight: var(--font-weight-subheading);
    padding: 12px 24px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: transform 0.15s ease, filter 0.15s ease;
  }

  .btn-primary:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  .cta-section {
    padding: var(--space-10) 0;
    background-color: var(--color-mist);
  }

  .cta-card {
    background-color: var(--color-paper);
    padding: var(--space-8);
    border-radius: var(--radius-card);
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
    border: 1px solid rgba(20, 41, 75, 0.08);
  }

  .cta-card h2 {
    color: var(--color-navy);
    font-size: 1.875rem;
    font-weight: var(--font-weight-heading);
    margin: 0 0 var(--space-2);
  }

  .cta-card p {
    color: var(--color-slate);
    font-size: 1rem;
    margin: 0 0 var(--space-4);
  }

  .cta-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1.5px solid var(--color-navy);
    color: var(--color-navy);
    font-weight: var(--font-weight-subheading);
    padding: 12px 24px;
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .btn-secondary:hover {
    background: rgba(20, 41, 75, 0.05);
  }
</style>
