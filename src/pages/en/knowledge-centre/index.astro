<script>
  // Client-Side Search for Specialties
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('kc-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('kc-search-clear');
    const specCards = document.querySelectorAll<HTMLAnchorElement>('.kc-spec-card');

    function runFilter() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      if (clearBtn) {
        clearBtn.style.display = query.length > 0 ? 'flex' : 'none';
      }

      specCards.forEach((card) => {
        const text = card.textContent?.toLowerCase() || '';
        if (!query || text.includes(query)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    searchInput?.addEventListener('input', runFilter);

    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const target = document.getElementById('specialties');
        if (target) {
          target.scrollIntoView({ behavior: 'smooth' });
        }
      }
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        runFilter();
        searchInput.focus();
      }
    });
  });
</script>
