---

<BaseLayout
  title="Nuhavi Health Knowledge Centre"
  description="Clear, doctor-led clinical guides to 145 conditions, treatments and procedures across 14 specialties. Written in plain language for patients and families."
  lang="en"
>
  <main class="kc-page-wrap" id="main-content">
    <!-- SECTION A: HERO SECTION (NAVY BACKGROUND) -->
    <section class="kc-hero-section">
      <div class="kc-container">
        <span class="kc-hero-kicker">NUHAVI HEALTH KNOWLEDGE CENTRE</span>
        <h1 class="kc-hero-title">Understand your condition before you decide on treatment</h1>
        <p class="kc-hero-deck">
          Clear, doctor-led guides to 145 conditions, treatments and procedures across 14 specialties. Written in plain language for patients and families.
        </p>

        <!-- Prominent Search Bar -->
        <div class="kc-hero-search-box">
          <svg class="kc-search-svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6B7280" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="text"
            id="kc-search-input"
            class="kc-hero-search-input"
            placeholder="Search a condition, symptom or treatment, e.g. knee pain, CAR-T, IVF"
            aria-label="Search all conditions, symptoms and treatments"
          />
          <button type="button" id="kc-search-clear" class="kc-search-clear-btn" style="display: none;" aria-label="Clear search">×</button>
        </div>

        <!-- 3 Trust Bullets -->
        <div class="kc-hero-bullets">
          <span class="kc-bullet-item"><span class="kc-bullet-dot">•</span> Reviewed by specialists before publication</span>
          <span class="kc-bullet-item"><span class="kc-bullet-dot">•</span> About 2 to 3 minutes per article</span>
          <span class="kc-bullet-item"><span class="kc-bullet-dot">•</span> Education first, never a sales pitch</span>
        </div>
      </div>
    </section>

    <!-- SECTION B: BROWSE BY SPECIALTY (14 SPECIALTIES) -->
    <section class="kc-section kc-browse-section" id="specialties">
      <div class="kc-container">
        <div class="kc-section-header-row">
          <h2 class="kc-section-heading">Browse by specialty</h2>
          <a href="/en/resources/" class="kc-header-link">See all 145 articles</a>
        </div>

        <div class="kc-specialties-grid">
          {displaySpecialties.map((spec) => (
            <a href={`/en/knowledge-centre/${spec.slug}/`} class="kc-spec-card" style={`--spec-accent: ${spec.border}`}>
              <div class="kc-spec-icon-wrap">
                <img src={spec.image} alt={spec.title} class="kc-spec-thumb-img" width="36" height="36" loading="lazy" />
              </div>
              <h3 class="kc-spec-name">{spec.title}</h3>
              <span class="kc-spec-count">{spec.count}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- SECTION C: FEATURED GUIDES (3 ILLUSTRATED CARDS) -->
    <section class="kc-section kc-featured-section" id="featured-guides">
      <div class="kc-container">
        <h2 class="kc-section-heading">Featured guides</h2>

        <div class="kc-featured-grid">
          {featuredGuides.map((guide) => (
            <a href={`/en/knowledge-centre/${guide.specialtySlug}/${guide.slug}/`} class="kc-feat-card">
              <!-- Visual Header with gradient & illustration -->
              <div class="kc-feat-visual" style={`background: ${guide.gradient}`}>
                <div class="kc-feat-illustration-wrap">
                  <img src={getSpecialtyImage(guide.specialtySlug)} alt={guide.specialtyTitle} class="kc-feat-spec-img" width="56" height="56" loading="lazy" />
                </div>
                <span class="kc-feat-tag">{guide.tag}</span>
              </div>

              <!-- Card Content -->
              <div class="kc-feat-content">
                <div class="kc-feat-meta">
                  <span class="kc-feat-spec-name" style={`color: ${guide.iconColor}`}>
                    {guide.specialtyTitle}
                  </span>
                  <span class="kc-meta-dot">•</span>
                  <span class="kc-feat-time">{guide.readingTime}</span>
                </div>
                <h3 class="kc-feat-title">{guide.title}</h3>
                <p class="kc-feat-overview">{guide.overview}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- SECTION D: MOST READ & LATEST ARTICLES (TWO-COLUMN SPLIT) -->
    <section class="kc-section kc-split-section">
      <div class="kc-container">
        <div class="kc-split-grid">
          <!-- Col 1: Most Read (10 items) -->
          <div class="kc-split-col">
            <h2 class="kc-section-heading">Most read</h2>
            <div class="kc-articles-card-box">
              {mostReadArticles.map((art) => (
                <a href={art.href} class="kc-num-row">
                  <span class="kc-row-num">{art.num}</span>
                  <div class="kc-row-body">
                    <h3 class="kc-row-title">{art.title}</h3>
                    <span class="kc-row-spec">{art.specialtyTitle}</span>
                  </div>
                  <span class="kc-row-time">{art.readingTime}</span>
                </a>
              ))}
            </div>
          </div>

          <!-- Col 2: Latest Articles (6 items) -->
          <div class="kc-split-col">
            <h2 class="kc-section-heading">Latest articles</h2>
            <div class="kc-articles-card-box">
              {latestArticles.map((art) => (
                <a href={art.href} class="kc-num-row">
                  <span class="kc-row-num">{art.num}</span>
                  <div class="kc-row-body">
                    <h3 class="kc-row-title">{art.title}</h3>
                    <span class="kc-row-spec">{art.specialtyTitle}</span>
                  </div>
                  <span class="kc-row-time">{art.readingTime}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION E: EXPLAINER VIDEOS (4 PREVIEW CARDS) & DOCTOR CTA BANNER -->
    <section class="kc-section kc-videos-section" id="videos">
      <div class="kc-container">
        <div class="kc-section-header-row">
          <h2 class="kc-section-heading">Explainer videos</h2>
          <span class="kc-header-link">All videos</span>
        </div>

        <!-- 4 Top Video Preview Cards matching Claude reference -->
        <div class="kc-video-cards-grid">
          {videoCards.map((video) => (
            <div class="kc-video-card">
              <div class="kc-video-play-circle" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="#92400E">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
              </div>
              <h3 class="kc-video-title">{video.title}</h3>
              <span class="kc-video-meta">{video.duration}</span>
              <div class="kc-video-badge-wrap">
                <span class="kc-video-status-badge">{video.badge}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- SPECIALIST CONSULTATION CALLOUT BANNER -->
        <div class="kc-doctor-cta-banner">
          <div class="kc-cta-banner-text">
            <h3 class="kc-cta-banner-title">Not sure which specialist you need?</h3>
            <p class="kc-cta-banner-deck">
              Share your reports with a Nuhavi doctor. We will help you understand your options and connect you with the right specialist.
            </p>
          </div>
          <a href="/en/request-opinion/" class="kc-cta-banner-btn">Talk to a doctor</a>
        </div>
      </div>
    </section>

    <!-- SECTION F: BOTTOM KNOWLEDGE CENTRE INTRODUCTION & MEDICAL DISCLAIMER -->
    <section class="kc-bottom-intro-disclaimer">
      <div class="kc-container">
        <div class="kc-intro-block">
          <h3 class="kc-intro-title">Nuhavi Health Knowledge Centre</h3>
          <p class="kc-intro-tagline">
            Doctor-led patient education. Every article is written in plain language and reviewed by a specialist before publication.
          </p>
          <p class="kc-intro-medical-notice">
            The information on this site is for general education and does not replace a consultation with a qualified doctor. In an emergency, call 108 or 112 in India, or your local emergency number.
          </p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* ==========================================================================
     NUHAVI HEALTH KNOWLEDGE CENTRE — STYLESHEET (CLAUDE REFERENCE EXACT MATCH)
     ========================================================================== */
  
  :root {
    --kc-navy-dark: #0B192C;
    --kc-navy-mid: #0F1E36;
    --kc-navy-light: #1E293B;
    --kc-gold: #D4AF37;
    --kc-gold-hover: #C5A028;
    --kc-gold-muted: #9A7B38;
    --kc-bg-light: #F8F9FA;
    --kc-card-bg: #FFFFFF;
    --kc-text-dark: #111827;
    --kc-text-body: #374151;
    --kc-text-muted: #6B7280;
    --kc-border: #E5E7EB;
    --kc-border-subtle: #F3F4F6;
  }

  .kc-page-wrap {
    background-color: var(--kc-bg-light);
    color: var(--kc-text-body);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.5;
  }

  .kc-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .kc-section {
    padding: 4.5rem 0;
  }

  .kc-section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .kc-section-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--kc-navy-mid);
    margin: 0;
    line-height: 1.2;
  }

  .kc-header-link {
    color: var(--kc-gold-muted);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s;
    user-select: none;
  }

  a.kc-header-link:hover {
    color: var(--kc-navy-mid);
    text-decoration: underline;
  }

  /* --------------------------------------------------------------------------
     SECTION A: HERO SECTION
     -------------------------------------------------------------------------- */
  .kc-hero-section {
    background-color: var(--kc-navy-dark);
    color: #FFFFFF;
    padding: 5rem 0 4.5rem;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .kc-hero-kicker {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--kc-gold);
    text-transform: uppercase;
    margin-bottom: 1.25rem;
  }

  .kc-hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.75rem;
    font-weight: 700;
    line-height: 1.15;
    color: #FFFFFF;
    max-width: 820px;
    margin: 0 0 1.25rem;
  }

  .kc-hero-deck {
    font-size: 1.125rem;
    line-height: 1.5;
    color: #CBD5E1;
    max-width: 680px;
    margin: 0 0 2.25rem;
  }

  .kc-hero-search-box {
    background: #FFFFFF;
    border-radius: 8px;
    display: flex;
    align-items: center;
    padding: 0.85rem 1.25rem;
    max-width: 680px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .kc-search-svg {
    flex-shrink: 0;
    stroke: #6B7280;
  }

  .kc-hero-search-input {
    border: none;
    outline: none;
    width: 100%;
    font-size: 1rem;
    color: var(--kc-text-dark);
    background: transparent;
    padding: 0 0.85rem;
  }

  .kc-hero-search-input::placeholder {
    color: #9CA3AF;
  }

  .kc-search-clear-btn {
    background: #E5E7EB;
    border: none;
    border-radius: 50%;
    width: 24px;
    height: 24px;
    font-size: 16px;
    line-height: 1;
    color: #4B5563;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .kc-hero-bullets {
    display: flex;
