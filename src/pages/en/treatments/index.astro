---
/**
 * src/pages/en/treatments/index.astro
 * Treatments Landing Page (Module 12)
 * Route: /en/treatments/
 * Reference: Page 11 of Nuhavi Health Look and Feel PDF (30 October 2026).
 *
 * Implements:
 * 1. Semantic page structure wrapped in BaseLayout.
 * 2. Page Header:
 *    - Eyebrow: TREATMENTS
 *    - Heading: "Treatments" (h1)
 *    - Supporting text: "Start with the area of care you need. Each page explains what is usually involved, which records to prepare and what to ask the treating team."
 * 3. 10 Treatment specialties:
 *    - 2 Accepting enquiries: Cancer care (oncology), Orthopaedics and joint replacement (deep navy cards).
 *    - 8 On request: Neurology and neurosurgery, IVF and fertility, General and laparoscopic surgery, Heart care, Gastroenterology, Urology and kidney care, Women's health, Children's care (white cards).
 * 4. 3 Functional filter buttons: All (10), Accepting enquiries (2), On request (8).
 * 5. White/paper page surface, consistent Manrope typography, 1200px max-width container, 3-col desktop / 2-col tablet / 1-col mobile grid.
 * 6. Accessibility & safeguards: keyboard focus, aria-pressed states, SSR fallback (all 10 visible without JS), no invented outcomes/prices/broken links.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SpecialtyExplorer from '../../../components/home/SpecialtyExplorer.astro';
---

<BaseLayout
  title="Treatments | Nuhavi Health"
  description="Start with the area of care you need. Each page explains what is usually involved, which records to prepare and what to ask the treating team."
>
  <SpecialtyExplorer
    eyebrow="TREATMENTS"
    heading="Treatments"
    headingLevel="h1"
    supportingText="Start with the area of care you need. Each page explains what is usually involved, which records to prepare and what to ask the treating team."
    variant="page"
  />
</BaseLayout>

