<script>
  /**
   * Interactive Checklist Controller
   * - Pure session-only state: resets on page refresh.
   * - Updates live counter ('X of 8 ready') and visual progress bar.
   * - Sets aria-valuenow for screen-reader accessibility.
   * - Handles 'Print this checklist' action via window.print().
   */
  function initRecordsChecklist() {
    const card = document.getElementById('checklist-card');
    if (!card || card.dataset.checklistInitialized === 'true') return;
    card.dataset.checklistInitialized = 'true';

    const checkboxes = card.querySelectorAll<HTMLInputElement>('.checklist-checkbox');
    const counter = document.getElementById('checklist-counter');
    const fill = document.getElementById('checklist-fill');
    const progressbar = document.getElementById('checklist-progressbar');
    const printBtn = document.getElementById('print-checklist-btn');

    const total = checkboxes.length;

    function updateProgress() {
      const checkedCount = Array.from(checkboxes).filter((cb) => cb.checked).length;
      if (counter) {
        counter.textContent = `${checkedCount} of ${total} ready`;
      }
      if (fill) {
        fill.style.width = `${(checkedCount / total) * 100}%`;
      }
      if (progressbar) {
        progressbar.setAttribute('aria-valuenow', checkedCount.toString());
      }
    }

    checkboxes.forEach((cb) => {
      cb.addEventListener('change', updateProgress);
    });

    if (printBtn) {
      printBtn.addEventListener('click', () => {
        window.print();
      });
    }

    updateProgress();
  }

  document.addEventListener('DOMContentLoaded', initRecordsChecklist);
  initRecordsChecklist();
</script>

