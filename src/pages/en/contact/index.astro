---
/**
 * src/pages/en/contact/index.astro
 * Contact / Talk to a care coordinator — Nuhavi Health
 *
 * Implements:
 * - Premium, clean navy, gold and white design.
 * - Channels (Telegram, WhatsApp, Email) with approved verification markers.
 * - Coordination hours (Monday to Saturday, 9:00 to 19:00 IST).
 * - Direct link to Request a Medical Opinion.
 * - Prominent clinical emergency warning notice.
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import ContactView from '../../../components/contact/ContactView.astro';
import { contactData } from '../../../data/contactData';

const data = contactData.en;
---

<BaseLayout
  title={data.metaTitle}
  description={data.metaDescription}
  lang="en"
  dir="ltr"
>
  <ContactView lang="en" />
</BaseLayout>
