---
/**
 * src/pages/en/contact/index.astro
 * Contact / Talk to a care coordinator (Page 30 of Nuhavi Health Look and Feel PDF)
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Talk to a care coordinator | Nuhavi Health"
  description="Choose whichever is easiest for you. A person replies — there is no chatbot. Please do not send medical reports in chat; use the private upload link we email you."
>
  <div class="page-container">
    <div class="container main-content">
      <!-- Gold 72x3 px rule above page title -->
      <div class="gold-rule" aria-hidden="true"></div>

      <header class="page-header">
        <h1 class="page-title">Talk to a care coordinator</h1>
        <p class="page-deck">
          Choose whichever is easiest for you. A person replies — there is no chatbot. Please do not send medical reports in chat; use the private upload link we email you.
        </p>
      </header>

      <!-- Channels Grid: 3 in Row 1, 2 in Row 2 -->
      <div class="channels-layout">
        <!-- Row 1: Telegram, WhatsApp, Email -->
        <div class="row-three">
          <div class="channel-card">
            <h2 class="card-title">Telegram</h2>
            <div class="amber-marker">
              [Needs confirmation: Telegram username (PUBLIC_TELEGRAM_USERNAME)]
            </div>
            <p class="card-note">The messenger most patients in Uzbekistan use.</p>
          </div>

          <div class="channel-card">
            <h2 class="card-title">WhatsApp</h2>
            <div class="amber-marker">
              [Needs confirmation: WhatsApp Business number (PUBLIC_WHATSAPP_NUMBER)]
            </div>
            <p class="card-note">The messenger most patients in Africa use.</p>
          </div>

          <div class="channel-card">
            <h2 class="card-title">Email</h2>
            <div class="amber-marker">
              [Needs confirmation: contact email (PUBLIC_CONTACT_EMAIL)]
            </div>
            <p class="card-note">For general questions. Do not attach medical records.</p>
          </div>
        </div>

        <!-- Row 2: Enquiry form & Hours -->
        <div class="row-two">
          <div class="channel-card">
            <h2 class="card-title">Enquiry form</h2>
            <p class="card-desc">The form gives you an enquiry reference straight away.</p>
            <div class="form-btn-wrap">
              <a href="/en/request-opinion/" class="btn-pill-outline">Request a medical opinion</a>
            </div>
          </div>

          <div class="channel-card">
            <h2 class="card-title">Hours</h2>
            <p class="hours-text">Monday to Saturday, 9:00 to 19:00 India time (UTC+5:30)</p>
            <div class="reply-promise">
              <span>We reply</span>
              <span class="amber-inline">[Needs confirmation: response-time promise the team can keep]</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Emergency notice at bottom (Red box) -->
      <div class="emergency-box" role="alert">
        <div class="emergency-header">
          <span class="alert-icon" aria-hidden="true">⚠</span>
          <strong>Is this an emergency?</strong>
        </div>
        <p>
          Chest pain, sudden weakness or numbness, difficulty speaking, severe bleeding, a seizure or difficulty breathing need care now. Go to the nearest emergency department or call your local emergency number. Do not wait for an enquiry reply.
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    background-color: var(--color-paper);
    color: var(--color-ink);
    padding: var(--space-8) 0 var(--space-12);
  }

  .gold-rule {
    width: 72px;
    height: 3px;
    background-color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1.15;
    margin: 0 0 var(--space-2);
  }

  .page-deck {
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-slate);
    max-width: 680px;
    margin: 0;
  }

  /* Channels Layout */
  .channels-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .row-three {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .row-three {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .row-two {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .row-two {
      grid-template-columns: 1fr 1fr;
    }
  }

  .channel-card {
    background-color: var(--color-paper);
    border: 1px solid rgba(20, 41, 75, 0.12);
    border-radius: 14px;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
  }

  .card-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0 0 var(--space-3);
  }

  .card-desc {
    font-size: 0.875rem;
    color: var(--color-slate);
    line-height: 1.5;
    margin: 0 0 var(--space-4);
  }

  .card-note {
    font-size: 0.8125rem;
    color: var(--color-slate);
    line-height: 1.45;
    margin: var(--space-2) 0 0;
  }

  .amber-marker {
    background-color: #FFF6E5;
    border: 1px solid #C49A3C;
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 0.75rem;
    line-height: 1.4;
    color: #8A6726;
    word-break: break-word;
  }

  .amber-inline {
    background-color: #FFF6E5;
    border: 1px solid #C49A3C;
    border-radius: 4px;
    padding: 2px 6px;
    font-size: 0.75rem;
    color: #8A6726;
  }

  .form-btn-wrap {
    margin-top: auto;
  }

  .btn-pill-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    border: 1px solid var(--color-navy);
    background-color: var(--color-paper);
    color: var(--color-navy);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .btn-pill-outline:hover {
    background-color: var(--color-mist);
  }

  .hours-text {
    font-size: 0.875rem;
    color: var(--color-ink);
    margin: 0 0 var(--space-3);
  }

  .reply-promise {
    font-size: 0.8125rem;
    color: var(--color-slate);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  /* Emergency Warning Box (Red) */
  .emergency-box {
    background-color: #FEF3F2;
    border: 1px solid #FECDCA;
    border-radius: 8px;
    padding: 16px 20px;
  }

  .emergency-header {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-error);
    margin-bottom: 6px;
  }

  .alert-icon {
    font-size: 1rem;
  }

  .emergency-header strong {
    font-size: 0.875rem;
  }

  .emergency-box p {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #55160C;
    margin: 0;
  }
</style>
