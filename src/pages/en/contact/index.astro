---
/**
 * src/pages/en/contact/index.astro
 * Contact Nuhavi Health - Patient Desk & Support
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us | Nuhavi Health Coordination"
  description="Get in touch with Nuhavi Health medical travel coordinators. Connect via inquiry form, email, or WhatsApp for hospital advice."
>
  <div class="page-container">
    <header class="page-header">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/en/">Home</a></li>
            <li aria-current="page">Contact</li>
          </ol>
        </nav>
        <span class="eyebrow">REACH OUR COORDINATORS</span>
        <h1 class="page-title">Contact Nuhavi Health</h1>
        <p class="page-deck">
          Have questions about medical travel, doctor second opinions, or hospital cost estimates? Our international patient desk is here to assist you.
        </p>
      </div>
    </header>

    <section class="contact-section">
      <div class="container">
        <div class="contact-grid">
          <!-- Contact Form -->
          <div class="form-wrapper">
            <h2>Send Us a Message</h2>
            <form id="contact-form" class="contact-form">
              <div class="form-group">
                <label for="contact-name">Your Full Name <span class="required">*</span></label>
                <input type="text" id="contact-name" name="name" required placeholder="Full name" />
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="contact-email">Email Address <span class="required">*</span></label>
                  <input type="email" id="contact-email" name="email" required placeholder="you@example.com" />
                </div>
                <div class="form-group">
                  <label for="contact-phone">Phone / WhatsApp <span class="required">*</span></label>
                  <input type="tel" id="contact-phone" name="phone" required placeholder="+1 234 567 8900" />
                </div>
              </div>

              <div class="form-group">
                <label for="contact-subject">Topic of Inquiry <span class="required">*</span></label>
                <select id="contact-subject" name="subject" required>
                  <option value="" disabled selected>Select an option...</option>
                  <option value="opinion">Medical Opinion & Doctor Review</option>
                  <option value="costs">Hospital Estimates & Costs</option>
                  <option value="visa">Medical Visa Assistance</option>
                  <option value="partnership">Hospital or Clinical Partnership</option>
                  <option value="other">General Question</option>
                </select>
              </div>

              <div class="form-group">
                <label for="contact-message">Message <span class="required">*</span></label>
                <textarea id="contact-message" name="message" rows="5" required placeholder="Please describe how we can assist you..."></textarea>
              </div>

              <button type="submit" class="btn-submit" id="contact-submit-btn">
                Send Message
              </button>

              <div id="contact-success" class="contact-success-banner" style="display: none;" role="alert">
                <h3>Message Sent Successfully</h3>
                <p>Thank you for reaching out. A coordinator will respond to your inquiry within 24 hours.</p>
              </div>
            </form>
          </div>

          <!-- Contact Details & Channels -->
          <aside class="channels-aside">
            <div class="channel-card">
              <h3>Fastest Response Channels</h3>
              <p class="channel-desc">For urgent medical queries or sharing existing diagnosis files:</p>
              
              <div class="channel-item">
                <div class="channel-icon">💬</div>
                <div>
                  <strong>WhatsApp Medical Desk</strong>
                  <p>Dedicated international coordinator assistance.</p>
                  <span class="channel-val">+91 (Coordination Desk)</span>
                </div>
              </div>

              <div class="channel-item">
                <div class="channel-icon">✉️</div>
                <div>
                  <strong>Email Inquiries</strong>
                  <p>Send complete scan reports and PDFs.</p>
                  <span class="channel-val">care@nuhavihealth.com</span>
                </div>
              </div>
            </div>

            <div class="channel-card hospital-hubs">
              <h3>On-Ground Hospital Hubs</h3>
              <p>Our patient coordination officers operate across major accredited hospital campuses in:</p>
              <ul class="hub-list">
                <li><strong>Delhi NCR:</strong> Gurugram, New Delhi, Noida</li>
                <li><strong>Mumbai:</strong> South Mumbai & Navi Mumbai</li>
                <li><strong>Bengaluru:</strong> Central & Whitefield Medical Hubs</li>
                <li><strong>Chennai & Hyderabad:</strong> Specialized Care Centers</li>
              </ul>
            </div>

            <div class="emergency-notice">
              <strong>Emergency Notice:</strong> Nuhavi Health does not provide acute emergency response. If you or a family member are experiencing a life-threatening medical emergency, please contact your local emergency services immediately.
            </div>
          </aside>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const contactForm = document.getElementById('contact-form');
  const contactSuccess = document.getElementById('contact-success');
  const contactSubmitBtn = document.getElementById('contact-submit-btn');

  if (contactForm && contactSuccess && contactSubmitBtn) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      contactSubmitBtn.setAttribute('disabled', 'true');
      contactSubmitBtn.textContent = 'Sending...';
      setTimeout(() => {
        contactForm.reset();
        contactSubmitBtn.style.display = 'none';
        contactSuccess.style.display = 'block';
        contactSuccess.scrollIntoView({ behavior: 'smooth' });
      }, 700);
    });
  }
</script>

<style>
  .page-container {
    background-color: var(--color-paper);
    color: var(--color-ink);
  }

  .page-header {
    background: linear-gradient(180deg, var(--color-mist) 0%, var(--color-paper) 100%);
    padding: var(--space-8) 0 var(--space-6);
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
  }

  .breadcrumb ol {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3);
    font-size: 0.875rem;
    color: var(--color-slate);
  }

  .breadcrumb li + li::before {
    content: "/";
    margin-right: var(--space-1);
    color: var(--color-slate);
  }

  .breadcrumb a {
    color: var(--color-navy);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: var(--font-weight-subheading);
    letter-spacing: 0.08em;
    color: var(--color-gold-text);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: var(--font-weight-heading);
    color: var(--color-navy);
    line-height: var(--line-height-heading);
    margin: 0 0 var(--space-3);
  }

  .page-deck {
    font-size: 1.125rem;
    font-weight: var(--font-weight-deck);
    line-height: var(--line-height-body);
    color: var(--color-slate);
    max-width: 720px;
    margin: 0;
  }

  .contact-section {
    padding: var(--space-8) 0 var(--space-12);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 992px) {
    .contact-grid {
      grid-template-columns: 3fr 2fr;
    }
  }

  .form-wrapper {
    background-color: var(--color-mist);
    padding: var(--space-6);
    border-radius: var(--radius-card);
    border: 1px solid rgba(20, 41, 75, 0.08);
  }

  @media (min-width: 768px) {
    .form-wrapper {
      padding: var(--space-8);
    }
  }

  .form-wrapper h2 {
    color: var(--color-navy);
    font-size: 1.5rem;
    margin: 0 0 var(--space-4);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 600px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .form-group label {
    font-size: 0.9375rem;
    font-weight: var(--font-weight-subheading);
    color: var(--color-navy);
  }

  .required {
    color: var(--color-error);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    font-family: inherit;
    font-size: 1rem;
    padding: 12px 16px;
    border: 1px solid rgba(20, 41, 75, 0.2);
    border-radius: 8px;
    background-color: var(--color-paper);
    color: var(--color-ink);
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-gold);
    box-shadow: 0 0 0 3px rgba(196, 154, 60, 0.2);
  }

  .btn-submit {
    background-color: var(--color-navy);
    color: var(--color-paper);
    font-size: 1rem;
    font-weight: var(--font-weight-subheading);
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    border: none;
    cursor: pointer;
    align-self: flex-start;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .btn-submit:hover {
    background-color: var(--color-deep-navy);
    transform: translateY(-1px);
  }

  .contact-success-banner {
    background-color: #EBF8F1;
    border: 1px solid var(--color-success);
    color: var(--color-success);
    padding: var(--space-6);
    border-radius: 8px;
  }

  .contact-success-banner h3 {
    margin: 0 0 var(--space-2);
    color: var(--color-success);
  }

  .contact-success-banner p {
    margin: 0;
    color: var(--color-ink);
  }

  .channels-aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .channel-card {
    background-color: var(--color-mist);
    padding: var(--space-6);
    border-radius: var(--radius-card);
    border: 1px solid rgba(20, 41, 75, 0.08);
  }

  .channel-card h3 {
    color: var(--color-navy);
    font-size: 1.125rem;
    margin: 0 0 var(--space-2);
  }

  .channel-desc {
    font-size: 0.875rem;
    color: var(--color-slate);
    margin-bottom: var(--space-4);
  }

  .channel-item {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .channel-item:last-child {
    margin-bottom: 0;
  }

  .channel-icon {
    font-size: 1.5rem;
  }

  .channel-item strong {
    display: block;
    color: var(--color-navy);
    font-size: 0.9375rem;
  }

  .channel-item p {
    font-size: 0.8125rem;
    color: var(--color-slate);
    margin: 2px 0 4px;
  }

  .channel-val {
    font-size: 0.875rem;
    font-weight: var(--font-weight-subheading);
    color: var(--color-gold-text);
  }

  .hub-list {
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: 0.875rem;
    color: var(--color-slate);
  }

  .emergency-notice {
    background-color: #FEF3F2;
    border: 1px solid #FECDCA;
    padding: var(--space-4);
    border-radius: 8px;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: #B42318;
  }
</style>

