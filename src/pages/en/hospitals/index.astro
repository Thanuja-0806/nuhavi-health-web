---
/**
 * src/pages/en/hospitals/index.astro
 * Hospital services (Pages 19 & 20 of Nuhavi Health Look and Feel PDF)
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Hospital services | Nuhavi Health"
  description="We present hospitals by what they can do for you — services, infrastructure and accreditation — not by individual doctors."
>
  <div class="page-container">
    <div class="container main-content">
      <!-- Gold 72x3 px rule above page title -->
      <div class="gold-rule" aria-hidden="true"></div>

      <header class="page-header">
        <h1 class="page-title">Hospital services</h1>
        <p class="page-deck">
          We present hospitals by what they can do for you — services, infrastructure and accreditation — not by individual doctors.
        </p>
      </header>

      <!-- Selection Standard Section (Page 19) -->
      <section class="selection-standard-section">
        <div class="standard-grid">
          <div class="standard-left">
            <h2 class="section-title">Our selection standard</h2>
            <p class="standard-subtext">
              A hospital must meet every point before we offer it to a patient or show it here.
            </p>
          </div>

          <div class="standard-right">
            <ol class="standard-list">
              <li>
                <span class="num-badge">1</span>
                <p>Current national accreditation (NABH) or international accreditation (JCI) for the hospital, with the certificate and expiry date on file</p>
              </li>
              <li>
                <span class="num-badge">2</span>
                <p>The specialty infrastructure your treatment needs — for example radiotherapy, intensive care or a joint-replacement theatre</p>
              </li>
              <li>
                <span class="num-badge">3</span>
                <p>A multidisciplinary team review (tumour board) for cancer cases</p>
              </li>
              <li>
                <span class="num-badge">4</span>
                <p>An international patient desk and access to interpreters</p>
              </li>
              <li>
                <span class="num-badge">5</span>
                <p>Written estimates with inclusions, exclusions and validity</p>
              </li>
              <li>
                <span class="num-badge">6</span>
                <p>Discharge summaries in English, shared with the patient</p>
              </li>
              <li>
                <span class="num-badge">7</span>
                <p>A signed agreement with Nuhavi that rules out referral payments</p>
              </li>
            </ol>
          </div>
        </div>
      </section>

      <!-- Hospital Capabilities Section (Page 20) -->
      <section class="capabilities-section">
        <h2 class="section-title">Hospital capabilities</h2>

        <div class="empty-state-box">
          <h3 class="empty-state-title">No hospital profiles are published yet.</h3>
          <p class="empty-state-text">
            Profiles appear here only after a signed agreement and a dated check of accreditation and services. When we share options for your case, we give you each hospital's name, accreditation and relevant facilities directly.
          </p>
        </div>

        <div class="comparison-block">
          <h3 class="compare-title">How profiles will compare</h3>
          <p class="compare-subtext">
            Each profile will show the same facts, so you can compare like with like. The column headings below are a layout example, not real hospitals.
          </p>

          <div class="table-wrapper">
            <table class="capabilities-table">
              <thead>
                <tr>
                  <th scope="col" class="th-check">What we check</th>
                  <th scope="col" class="th-hospital">Hospital A (example)</th>
                  <th scope="col" class="th-hospital">Hospital B (example)</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="td-label">Accreditation and expiry</td>
                  <td class="td-val">–</td>
                  <td class="td-val">–</td>
                </tr>
                <tr>
                  <td class="td-label">Specialty infrastructure</td>
                  <td class="td-val">–</td>
                  <td class="td-val">–</td>
                </tr>
                <tr>
                  <td class="td-label">Team review for cancer cases</td>
                  <td class="td-val">–</td>
                  <td class="td-val">–</td>
                </tr>
                <tr>
                  <td class="td-label">International patient desk</td>
                  <td class="td-val">–</td>
                  <td class="td-val">–</td>
                </tr>
                <tr>
                  <td class="td-label">Interpreters</td>
                  <td class="td-val">–</td>
                  <td class="td-val">–</td>
                </tr>
                <tr>
                  <td class="td-label">Rehabilitation</td>
                  <td class="td-val">–</td>
                  <td class="td-val">–</td>
                </tr>
                <tr>
                  <td class="td-label">Written estimates</td>
                  <td class="td-val">–</td>
                  <td class="td-val">–</td>
                </tr>
                <tr>
                  <td class="td-label">Last verified</td>
                  <td class="td-val">–</td>
                  <td class="td-val">–</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    background-color: var(--color-paper);
    color: var(--color-ink);
    padding: var(--space-8) 0 var(--space-12);
  }

  .gold-rule {
    width: 72px;
    height: 3px;
    background-color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1.15;
    margin: 0 0 var(--space-2);
  }

  .page-deck {
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-slate);
    max-width: 680px;
    margin: 0;
  }

  /* Selection Standard */
  .selection-standard-section {
    padding-bottom: var(--space-10);
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
    margin-bottom: var(--space-10);
  }

  .standard-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .standard-grid {
      grid-template-columns: 4fr 8fr;
      gap: var(--space-8);
    }
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0 0 var(--space-2);
  }

  .standard-subtext {
    font-size: 1rem;
    color: var(--color-slate);
    line-height: 1.5;
    margin: 0;
  }

  .standard-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .standard-list li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
  }

  .standard-list li:first-child {
    padding-top: 0;
  }

  .standard-list li:last-child {
    border-bottom: none;
  }

  .num-badge {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background-color: var(--color-mist);
    color: var(--color-navy);
    border: 1px solid rgba(20, 41, 75, 0.15);
    font-size: 0.75rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .standard-list p {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-ink);
    margin: 0;
  }

  /* Empty state card */
  .empty-state-box {
    background-color: var(--color-mist);
    border: 1px solid rgba(20, 41, 75, 0.1);
    border-radius: 14px;
    padding: var(--space-6);
    margin: var(--space-4) 0 var(--space-8);
  }

  .empty-state-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 var(--space-2);
  }

  .empty-state-text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-slate);
    margin: 0;
    max-width: 760px;
  }

  /* Comparison table */
  .comparison-block {
    margin-top: var(--space-6);
  }

  .compare-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 var(--space-1);
  }

  .compare-subtext {
    font-size: 0.875rem;
    color: var(--color-slate);
    margin: 0 0 var(--space-4);
  }

  .table-wrapper {
    overflow-x: auto;
    border-radius: 14px;
    border: 1px solid rgba(20, 41, 75, 0.12);
  }

  .capabilities-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
    text-align: left;
  }

  .capabilities-table thead tr {
    background-color: var(--color-navy);
    color: var(--color-paper);
  }

  .capabilities-table th {
    padding: 14px 20px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .th-check {
    width: 40%;
  }

  .th-hospital {
    width: 30%;
  }

  .capabilities-table tbody tr {
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
  }

  .capabilities-table tbody tr:last-child {
    border-bottom: none;
  }

  .capabilities-table td {
    padding: 14px 20px;
  }

  .td-label {
    color: var(--color-navy);
    font-weight: 600;
  }

  .td-val {
    color: var(--color-slate);
  }
</style>
