---
/**
 * src/pages/en/stories/index.astro
 * Patient stories (Page 25 of Nuhavi Health Look and Feel PDF)
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Patient stories | Nuhavi Health"
  description="Stories from real patients and families will appear here, told in their words and with their permission."
>
  <div class="page-container">
    <div class="container main-content">
      <!-- Gold 72x3 px rule above page title -->
      <div class="gold-rule" aria-hidden="true"></div>

      <header class="page-header">
        <h1 class="page-title">Patient stories</h1>
        <p class="page-deck">
          Stories from real patients and families will appear here, told in their words and with their permission.
        </p>
      </header>

      <div class="stories-grid">
        <!-- Left Box: Empty state by design -->
        <div class="story-box empty-state">
          <h2 class="box-title">No stories are published yet.</h2>
          <p class="box-text">
            We are a new company. Rather than show invented testimonials, we will wait for real ones.
          </p>
        </div>

        <!-- Right Box: Rules for patient stories -->
        <div class="story-box rules-box">
          <h2 class="box-title">Our rules for patient stories</h2>
          <ul class="rules-list">
            <li>Every story is published only with the patient's written consent (or a parent's or guardian's for a child).</li>
            <li>The patient approves the final words and photos, and can ask us to remove the story at any time.</li>
            <li>Stories describe the coordination experience. They do not promise that anyone else will have the same result.</li>
            <li>We do not name or promote individual doctors in stories.</li>
            <li>Identifying details are removed unless the patient chooses to include them.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    background-color: var(--color-paper);
    color: var(--color-ink);
    padding: var(--space-8) 0 var(--space-12);
  }

  .gold-rule {
    width: 72px;
    height: 3px;
    background-color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1.15;
    margin: 0 0 var(--space-2);
  }

  .page-deck {
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-slate);
    max-width: 680px;
    margin: 0;
  }

  .stories-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 800px) {
    .stories-grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-8);
    }
  }

  .story-box {
    background-color: var(--color-mist);
    border: 1px solid rgba(20, 41, 75, 0.12);
    border-radius: 14px;
    padding: var(--space-6);
  }

  @media (min-width: 768px) {
    .story-box {
      padding: var(--space-8);
    }
  }

  .box-title {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 var(--space-3);
    line-height: 1.3;
  }

  .box-text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-slate);
    margin: 0;
  }

  .rules-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .rules-list li {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-ink);
    padding-left: 20px;
    position: relative;
  }

  .rules-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-navy);
    font-weight: 700;
  }
</style>
