---
/**
 * src/pages/en/disclaimer/index.astro
 * Medical & Legal Disclaimer
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Medical Disclaimer | Nuhavi Health"
  description="Important medical advice disclaimer regarding Nuhavi Health's role as a coordination facilitator."
>
  <div class="page-container">
    <header class="page-header">
      <div class="container">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/en/">Home</a></li>
            <li aria-current="page">Disclaimer</li>
          </ol>
        </nav>
        <span class="eyebrow">IMPORTANT NOTICE</span>
        <h1 class="page-title">Medical Disclaimer</h1>
        <p class="page-deck">
          Please read this clinical notice carefully before utilizing our website or requesting coordination services.
        </p>
      </div>
    </header>

    <section class="legal-section">
      <div class="container">
        <div class="legal-content">
          <div class="disclaimer-callout">
            <h3>Not Medical Advice</h3>
            <p>
              The content published on this website — including treatment summaries, medical guide articles, procedure overviews, and estimated durations — is intended solely for general informational and educational purposes. It does not constitute medical advice, diagnosis, treatment, or clinical recommendations.
            </p>
          </div>

          <h2>1. Independent Physician-Patient Relationship</h2>
          <p>
            Any preliminary medical opinion, review, or estimate communicated by Nuhavi Health represents the clinical feedback of independent licensed doctors and hospitals in India. Antigravity and Nuhavi Health do not practice medicine or maintain a doctor-patient relationship with you.
          </p>

          <h2>2. Consult Your Primary Physician</h2>
          <p>
            Always seek the advice of your primary doctor, oncologist, or qualified health provider in your home country regarding any medical condition or before embarking on international travel for medical treatments.
          </p>

          <h2>3. Emergency Medical Situations</h2>
          <p>
            If you think you may have a medical emergency, call your doctor or emergency services immediately. Do not rely on electronic communications through this website for immediate, urgent medical needs.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page-container {
    background-color: var(--color-paper);
    color: var(--color-ink);
  }

  .page-header {
    background: linear-gradient(180deg, var(--color-mist) 0%, var(--color-paper) 100%);
    padding: var(--space-8) 0 var(--space-6);
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
  }

  .breadcrumb ol {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3);
    font-size: 0.875rem;
    color: var(--color-slate);
  }

  .breadcrumb li + li::before {
    content: "/";
    margin-right: var(--space-1);
    color: var(--color-slate);
  }

  .breadcrumb a {
    color: var(--color-navy);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: var(--font-weight-subheading);
    letter-spacing: 0.08em;
    color: var(--color-gold-text);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: var(--font-weight-heading);
    color: var(--color-navy);
    line-height: var(--line-height-heading);
    margin: 0 0 var(--space-3);
  }

  .page-deck {
    font-size: 1.125rem;
    font-weight: var(--font-weight-deck);
    line-height: var(--line-height-body);
    color: var(--color-slate);
    max-width: 720px;
    margin: 0;
  }

  .legal-section {
    padding: var(--space-8) 0 var(--space-12);
  }

  .legal-content {
    max-width: 760px;
  }

  .disclaimer-callout {
    background-color: #FEF3F2;
    border-left: 4px solid var(--color-error);
    padding: var(--space-6);
    border-radius: 0 8px 8px 0;
    margin-bottom: var(--space-6);
  }

  .disclaimer-callout h3 {
    color: var(--color-error);
    margin: 0 0 var(--space-2);
  }

  .disclaimer-callout p {
    color: #55160C;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .legal-content h2 {
    color: var(--color-navy);
    font-size: 1.375rem;
    margin: var(--space-6) 0 var(--space-2);
  }

  .legal-content p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink);
    margin-bottom: var(--space-4);
  }
</style>

