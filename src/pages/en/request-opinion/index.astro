---
/**
 * src/pages/en/request-opinion/index.astro
 * Request a medical opinion — Nuhavi Health
 *
 * Implements:
 * - Premium multi-step workflow (About you -> Your enquiry -> Contact & consent -> Success)
 * - Exact DOM IDs and field names for API Gateway integration
 * - Live AWS API Gateway POST integration
 * - Accessible validation error banner with anchor links
 * - Optional medical records upload link request
 * - Country-specific compliance (e.g. Uzbekistan genetic test disclaimer)
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import RequestOpinionView from '../../../components/request-opinion/RequestOpinionView.astro';
import { requestOpinionData } from '../../../data/contactData';

const data = requestOpinionData.en;
---

<BaseLayout
  title={data.metaTitle}
  description={data.metaDescription}
  lang="en"
  dir="ltr"
>
  <RequestOpinionView lang="en" />
</BaseLayout>
