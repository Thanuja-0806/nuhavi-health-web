---
/**
 * src/pages/en/about/commercial-relationships.astro
 * How Nuhavi is paid & Commercial relationships (Page 18 of Nuhavi Health Look and Feel PDF)
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Commercial relationships | Nuhavi Health"
  description="You pay us a coordination fee, agreed in writing before you commit. We do not accept referral fees or commissions from hospitals."
>
  <div class="page-container">
    <div class="container main-content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/en/">Home</a></li>
          <li><a href="/en/about/">About Nuhavi</a></li>
          <li aria-current="page">Commercial relationships</li>
        </ol>
      </nav>

      <!-- Gold 72x3 px rule above page title -->
      <div class="gold-rule" aria-hidden="true"></div>

      <header class="page-header">
        <h1 class="page-title">How Nuhavi is paid</h1>
        <p class="page-deck">
          You pay us a coordination fee, agreed in writing before you commit.
        </p>
      </header>

      <div class="paid-grid">
        <!-- Left: Policy Statement & Amber Confirmation -->
        <div class="paid-left">
          <div class="amber-statement-box">
            <span class="amber-label">Needs confirmation:</span>
            <p>
              Policy statement to confirm against signed hospital agreements: "Nuhavi Health is paid only by patients. We do not accept referral fees, commissions, marketing payments or any other money or benefit from hospitals, doctors or their agents. Our hospital agreements say so in writing."
            </p>
          </div>

          <div class="links-block">
            <a href="/en/how-it-works/costs-and-fees/" class="link-costs">Costs, estimates and our fee &rarr;</a>
          </div>
        </div>

        <!-- Right: Coordination Fee Panel with Gold Top Edge -->
        <div class="paid-right">
          <div class="fee-card">
            <div class="gold-card-edge" aria-hidden="true"></div>
            <h2 class="fee-card-title">Coordination fee</h2>

            <div class="amber-fee-box">
              <span class="amber-label">Needs confirmation:</span>
              <p>Fee amounts proposed in the business plan (US$450 oncology, US$350 orthopaedics). Founders to confirm before publishing.</p>
            </div>

            <h3 class="covers-heading">The fee covers</h3>
            <ul class="covers-list">
              <li>Coordinating the review of your records by a suitable hospital</li>
              <li>Organising written treatment options and estimates</li>
              <li>Help with the hospital invitation letter for your visa application</li>
              <li>A coordinator who speaks your language, before, during and after treatment</li>
              <li>Follow-up coordination after you return home (period to be confirmed)</li>
            </ul>

            <p class="fee-footer-note">
              Hospital charges are paid to the hospital. Travel and stay are paid to providers unless you ask us to arrange them, in which case we show our charge first.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    background-color: var(--color-paper);
    color: var(--color-ink);
    padding: var(--space-8) 0 var(--space-12);
  }

  .breadcrumb ol {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
    font-size: 0.8125rem;
    color: var(--color-slate);
  }

  .breadcrumb li + li::before {
    content: "/";
    margin-right: var(--space-1);
    color: var(--color-slate);
  }

  .breadcrumb a {
    color: var(--color-navy);
    text-decoration: none;
  }

  .gold-rule {
    width: 72px;
    height: 3px;
    background-color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1.15;
    margin: 0 0 var(--space-2);
  }

  .page-deck {
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-slate);
    max-width: 680px;
    margin: 0;
  }

  .paid-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 850px) {
    .paid-grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-8);
    }
  }

  .amber-statement-box {
    background-color: #FFF6E5;
    border: 1px solid #C49A3C;
    border-radius: 8px;
    padding: 16px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #8A6726;
  }

  .amber-label {
    display: block;
    font-weight: 700;
    margin-bottom: 4px;
    color: #8A6726;
  }

  .amber-statement-box p {
    margin: 0;
  }

  .links-block {
    margin-top: var(--space-6);
  }

  .link-costs {
    color: var(--color-navy);
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: underline;
  }

  /* Fee Card with Gold Top Edge */
  .fee-card {
    background-color: var(--color-paper);
    border: 1px solid rgba(20, 41, 75, 0.12);
    border-radius: 14px;
    padding: 0 var(--space-6) var(--space-6);
    position: relative;
    overflow: hidden;
  }

  .gold-card-edge {
    width: calc(100% + 48px);
    height: 4px;
    background-color: var(--color-gold);
    margin: 0 -24px 20px;
  }

  .fee-card-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0 0 var(--space-3);
  }

  .amber-fee-box {
    background-color: #FFF6E5;
    border: 1px solid #C49A3C;
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: #8A6726;
    margin-bottom: var(--space-4);
  }

  .amber-fee-box p {
    margin: 0;
  }

  .covers-heading {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 10px;
  }

  .covers-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .covers-list li {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-ink);
    padding-left: 20px;
    position: relative;
  }

  .covers-list li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-navy);
    font-weight: 700;
  }

  .fee-footer-note {
    font-size: 0.75rem;
    color: var(--color-slate);
    line-height: 1.45;
    margin: 0;
  }
</style>
