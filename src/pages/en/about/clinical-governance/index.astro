---
/**
 * src/pages/en/about/clinical-governance/index.astro
 * Clinical governance (Referenced on Pages 4, 10 & 29 of Nuhavi Health Look and Feel PDF)
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Clinical governance | Nuhavi Health"
  description="Who checks our clinical information, and where our role ends and the hospital's begins."
>
  <div class="page-container">
    <div class="container main-content">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/en/">Home</a></li>
          <li><a href="/en/about/">About Nuhavi</a></li>
          <li aria-current="page">Clinical governance</li>
        </ol>
      </nav>

      <div class="gold-rule" aria-hidden="true"></div>

      <header class="page-header">
        <h1 class="page-title">Clinical governance</h1>
        <p class="page-deck">
          Who checks our clinical information, and where our role ends and the hospital's begins.
        </p>
      </header>

      <div class="content-body">
        <section class="gov-section">
          <h2>1. Review of medical information</h2>
          <p>
            All medical summaries, condition guides, and records checklists on this site are written in consultation with licensed medical professionals and referenced against current international oncological and surgical guidelines.
          </p>
        </section>

        <section class="gov-section">
          <h2>2. Separation of roles</h2>
          <p>
            Nuhavi Health is a coordination company, not a hospital. We do not provide clinical diagnoses, prescribe treatment protocols, or perform medical procedures. Our doctors review submitted records solely to index them and identify suitable accredited hospital departments.
          </p>
        </section>

        <section class="gov-section">
          <h2>3. Clinical sign-off</h2>
          <p>
            Any condition page that includes procedure options or expected investigations carries an explicit verification requirement before publication. We never promise cure rates, surgical success percentages, or guaranteed outcomes.
          </p>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    background-color: var(--color-paper);
    color: var(--color-ink);
    padding: var(--space-8) 0 var(--space-12);
  }

  .breadcrumb ol {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
    font-size: 0.8125rem;
    color: var(--color-slate);
  }

  .breadcrumb li + li::before {
    content: "/";
    margin-right: var(--space-1);
    color: var(--color-slate);
  }

  .breadcrumb a {
    color: var(--color-navy);
    text-decoration: none;
  }

  .gold-rule {
    width: 72px;
    height: 3px;
    background-color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1.15;
    margin: 0 0 var(--space-2);
  }

  .page-deck {
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-slate);
    max-width: 680px;
    margin: 0;
  }

  .content-body {
    max-width: 720px;
  }

  .gov-section {
    margin-bottom: var(--space-6);
  }

  .gov-section h2 {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 var(--space-2);
  }

  .gov-section p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink);
    margin: 0;
  }
</style>

