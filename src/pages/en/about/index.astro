---
/**
 * src/pages/en/about/index.astro
 * About Nuhavi (Pages 28 & 29 of Nuhavi Health Look and Feel PDF)
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About Nuhavi | Nuhavi Health"
  description="Nuhavi Health Pvt. Ltd. is a doctor-led coordination company based in Hyderabad. We help international patients reach the right hospital with clear information — and we stay with them until they are home."
>
  <div class="page-container">
    <div class="container main-content">
      <!-- Gold 72x3 px rule above page title -->
      <div class="gold-rule" aria-hidden="true"></div>

      <header class="page-header">
        <h1 class="page-title">About Nuhavi</h1>
        <p class="page-deck">
          Nuhavi Health Pvt. Ltd. is a doctor-led coordination company based in Hyderabad. We help international patients reach the right hospital with clear information — and we stay with them until they are home.
        </p>
      </header>

      <!-- Why We Exist Section (Page 28) -->
      <section class="why-we-exist-section">
        <div class="why-grid">
          <div class="photo-col">
            <div class="founders-photo-slot">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                <circle cx="12" cy="13" r="4"></circle>
              </svg>
              <span class="photo-slot-title">Photo to come</span>
              <span class="photo-slot-sub">The founders of Nuhavi Health at the Hyderabad office</span>
            </div>
            <p class="photo-caption">The founders, Hyderabad</p>
          </div>

          <div class="text-col">
            <h2 class="section-title">Why we exist</h2>
            <p class="why-lead">Clarity before you travel. Care until you're home.</p>
            <p>
              Families travelling for treatment face three hard problems at once: understanding a diagnosis, choosing a hospital in another country, and organising a long stay away from home. Good information can be hard to find, and it is not always clear who is paying whom.
            </p>
            <p>
              We set Nuhavi up to do this differently: doctor-led review of what patients send, hospitals chosen on published standards, estimates in writing, and a fee paid by the patient so our advice is not bought by anyone else.
            </p>
          </div>
        </div>
      </section>

      <!-- What We Hold Ourselves To (Values in 2-col grid with gold top rules) -->
      <section class="values-section">
        <h2 class="section-title">What we hold ourselves to</h2>

        <div class="values-grid">
          <!-- Col 1 -->
          <div class="value-item">
            <div class="gold-top-rule" aria-hidden="true"></div>
            <h3>Clarity</h3>
            <p>Plain words, written down, in your language where we can.</p>
          </div>

          <div class="value-item">
            <div class="gold-top-rule" aria-hidden="true"></div>
            <h3>Safety</h3>
            <p>Clinical decisions stay with qualified treating teams; we never push a patient towards a choice.</p>
          </div>

          <div class="value-item">
            <div class="gold-top-rule" aria-hidden="true"></div>
            <h3>Accountability</h3>
            <p>A named contact for every case and a grievance officer for every complaint.</p>
          </div>

          <div class="value-item">
            <div class="gold-top-rule" aria-hidden="true"></div>
            <h3>Transparency</h3>
            <p>Our fee and our commercial relationships are published.</p>
          </div>

          <div class="value-item">
            <div class="gold-top-rule" aria-hidden="true"></div>
            <h3>Privacy</h3>
            <p>We collect only what we need, and share records only with hospitals you agree to.</p>
          </div>

          <div class="value-item">
            <div class="gold-top-rule" aria-hidden="true"></div>
            <h3>Continuity</h3>
            <p>Support continues after discharge, until you are settled at home.</p>
          </div>
        </div>
      </section>

      <!-- Governance & Relationships Cards (Page 29) -->
      <section class="governance-section">
        <div class="governance-grid">
          <a href="/en/about/clinical-governance/" class="gov-card">
            <h3>Clinical governance</h3>
            <p>Who checks our clinical information, and where our role ends and the hospital's begins.</p>
          </a>

          <a href="/en/about/commercial-relationships/" class="gov-card">
            <h3>Commercial relationships</h3>
            <p>How we are paid, and every relationship that could affect our advice.</p>
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .page-container {
    background-color: var(--color-paper);
    color: var(--color-ink);
    padding: var(--space-8) 0 var(--space-12);
  }

  .gold-rule {
    width: 72px;
    height: 3px;
    background-color: var(--color-gold);
    margin-bottom: var(--space-3);
  }

  .page-header {
    margin-bottom: var(--space-8);
  }

  .page-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1.15;
    margin: 0 0 var(--space-2);
  }

  .page-deck {
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-slate);
    max-width: 680px;
    margin: 0;
  }

  /* Why We Exist (Page 28) */
  .why-we-exist-section {
    padding-bottom: var(--space-10);
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
    margin-bottom: var(--space-10);
  }

  .why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 800px) {
    .why-grid {
      grid-template-columns: 4fr 8fr;
      gap: var(--space-8);
    }
  }

  .founders-photo-slot {
    width: 100%;
    aspect-ratio: 4 / 5;
    background-color: var(--color-deep-navy);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--color-paper);
    padding: var(--space-4);
    text-align: center;
    gap: 8px;
    box-sizing: border-box;
  }

  .photo-slot-title {
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .photo-slot-sub {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.4;
  }

  .photo-caption {
    font-size: 0.75rem;
    color: var(--color-slate);
    margin: var(--space-2) 0 0;
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0 0 var(--space-3);
  }

  .why-lead {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-navy);
    margin-bottom: var(--space-3);
  }

  .text-col p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink);
    margin-bottom: var(--space-4);
  }

  /* Values Grid */
  .values-section {
    padding-bottom: var(--space-10);
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
    margin-bottom: var(--space-10);
  }

  .values-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6) var(--space-8);
    margin-top: var(--space-6);
  }

  @media (min-width: 768px) {
    .values-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .value-item {
    display: flex;
    flex-direction: column;
  }

  .gold-top-rule {
    width: 100%;
    height: 2px;
    background-color: var(--color-gold);
    margin-bottom: var(--space-2);
  }

  .value-item h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 6px;
  }

  .value-item p {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-slate);
    margin: 0;
  }

  /* Governance Section (Page 29) */
  .governance-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .governance-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .gov-card {
    background-color: var(--color-mist);
    border: 1px solid rgba(20, 41, 75, 0.1);
    border-radius: 14px;
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .gov-card:hover {
    transform: translateY(-2px);
    border-color: rgba(20, 41, 75, 0.25);
  }

  .gov-card h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 6px;
  }

  .gov-card p {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-slate);
    margin: 0;
  }
</style>
