---
/**
 * src/components/about/AboutTrustPrinciples.astro
 * 6 Core Trust Principles Component for Nuhavi Health.
 *
 * Highlights the 6 mandatory trust principles:
 * 1. Hospital accreditation verification (NABH / JCI)
 * 2. Specialty-specific hospital selection
 * 3. Transparent itemized cost estimates
 * 4. No hospital referral commissions or kickbacks
 * 5. Direct communication and coordination
 * 6. Patient privacy and responsible handling of medical records
 *
 * Localized for EN, RU, and AR (RTL).
 */

import type { TrustPrinciple } from '../../data/aboutData';

interface Props {
  eyebrow: string;
  heading: string;
  deck: string;
  principles: TrustPrinciple[];
  lang?: 'en' | 'ru' | 'ar';
}

const { eyebrow, heading, deck, principles, lang = 'en' } = Astro.props;
---

<section class={`trust-principles-section lang-${lang}`} aria-labelledby="trust-principles-heading">
  <div class="principles-header">
    <span class="principles-eyebrow">{eyebrow}</span>
    <h2 id="trust-principles-heading" class="principles-title">{heading}</h2>
    <p class="principles-deck">{deck}</p>
  </div>

  <div class="principles-grid" role="list">
    {principles.map((p) => (
      <div class="principle-card" role="listitem">
        <div class="card-gold-accent" aria-hidden="true"></div>

        <div class="card-meta-row">
          <span class="principle-num" aria-hidden="true">{p.number}</span>
          <span class="principle-badge">{p.badge}</span>
        </div>

        <h3 class="principle-heading">{p.title}</h3>
        <p class="principle-summary">{p.summary}</p>
        <p class="principle-detail">{p.detail}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .trust-principles-section {
    width: 100%;
    margin-bottom: var(--space-12, 3rem);
  }

  .principles-header {
    margin-bottom: var(--space-8, 2rem);
    max-width: 820px;
  }

  .principles-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold-text, #967119);
    background-color: rgba(196, 154, 60, 0.1);
    padding: 4px 10px;
    border-radius: 4px;
    margin-bottom: var(--space-3, 0.75rem);
  }

  .principles-title {
    font-family: var(--font-serif, "Playfair Display", Georgia, serif);
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-navy, #14294B);
    margin: 0 0 var(--space-3, 0.75rem) 0;
  }

  .principles-deck {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-slate, #5B6A80);
    margin: 0;
  }

  /* 6 Principles Grid */
  .principles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6, 1.5rem);
  }

  @media (min-width: 640px) {
    .principles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .principles-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .principle-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: 12px;
    padding: var(--space-6, 1.5rem);
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(20, 41, 75, 0.04);
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .principle-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(20, 41, 75, 0.08);
    border-color: rgba(196, 154, 60, 0.4);
  }

  .card-gold-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background-color: var(--color-gold, #C49A3C);
  }

  .card-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3, 0.75rem);
  }

  .principle-num {
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--color-navy, #14294B);
    background-color: var(--color-mist, #F4F7FB);
    border: 1px solid rgba(20, 41, 75, 0.12);
    padding: 2px 7px;
    border-radius: 4px;
  }

  .principle-badge {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-gold-text, #967119);
    background-color: rgba(196, 154, 60, 0.1);
    padding: 2px 7px;
    border-radius: 4px;
  }

  .principle-heading {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-navy, #14294B);
    margin: 0 0 var(--space-2, 0.5rem) 0;
    line-height: 1.35;
  }

  .principle-summary {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-ink, #0D1B33);
    margin: 0 0 var(--space-3, 0.75rem) 0;
  }

  .principle-detail {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-slate, #5B6A80);
    margin: 0;
    margin-top: auto;
  }

  /* RTL Support */
  :global([dir="rtl"]) .card-meta-row {
    flex-direction: row-reverse;
  }
</style>

