---
/**
 * src/components/about/WhyIndiaCoordination.astro
 * Destination Context & Why Use Nuhavi in India component.
 *
 * Requirements:
 * - Explain why patients can use Nuhavi for medical travel coordination to India.
 * - Honest, objective context: advanced medical care, direct billing, language comfort, continuity.
 * - Localized for EN, RU, and AR (RTL).
 */

import type { WhyIndiaReason } from '../../data/aboutData';

interface Props {
  eyebrow: string;
  heading: string;
  lead: string;
  reasons: WhyIndiaReason[];
  lang?: 'en' | 'ru' | 'ar';
}

const { eyebrow, heading, lead, reasons, lang = 'en' } = Astro.props;
---

<section class={`why-india-section lang-${lang}`} aria-labelledby="why-india-heading">
  <div class="why-india-header">
    <span class="why-india-eyebrow">{eyebrow}</span>
    <h2 id="why-india-heading" class="why-india-title">{heading}</h2>
    <p class="why-india-lead">{lead}</p>
  </div>

  <div class="reasons-grid" role="list">
    {reasons.map((r, idx) => (
      <div class="reason-card" role="listitem">
        <div class="reason-top-row">
          <span class="reason-index-pill" aria-hidden="true">{`0${idx + 1}`}</span>
          <h3 class="reason-title">{r.title}</h3>
        </div>
        <p class="reason-desc">{r.desc}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .why-india-section {
    width: 100%;
    margin-bottom: var(--space-12, 3rem);
  }

  .why-india-header {
    margin-bottom: var(--space-8, 2rem);
    max-width: 820px;
  }

  .why-india-eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-gold-text, #967119);
    background-color: rgba(196, 154, 60, 0.1);
    padding: 4px 10px;
    border-radius: 4px;
    margin-bottom: var(--space-3, 0.75rem);
  }

  .why-india-title {
    font-family: var(--font-serif, "Playfair Display", Georgia, serif);
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-navy, #14294B);
    margin: 0 0 var(--space-3, 0.75rem) 0;
  }

  .why-india-lead {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-slate, #5B6A80);
    margin: 0;
  }

  /* 4-Card Reasons Grid */
  .reasons-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5, 1.25rem);
  }

  @media (min-width: 640px) {
    .reasons-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6, 1.5rem);
    }
  }

  .reason-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: 12px;
    padding: var(--space-6, 1.5rem);
    box-shadow: 0 2px 10px rgba(20, 41, 75, 0.03);
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .reason-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(20, 41, 75, 0.07);
  }

  .reason-top-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: var(--space-2, 0.5rem);
  }

  .reason-index-pill {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-gold, #C49A3C);
    background-color: var(--color-mist, #F4F7FB);
    border: 1px solid rgba(196, 154, 60, 0.3);
    padding: 2px 6px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .reason-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-navy, #14294B);
    margin: 0;
    line-height: 1.35;
  }

  .reason-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-slate, #5B6A80);
    margin: 0;
  }

  /* RTL Support */
  :global([dir="rtl"]) .reason-top-row {
    flex-direction: row-reverse;
  }
</style>

