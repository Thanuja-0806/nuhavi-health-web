---
/**
 * src/components/request-opinion/RequestOpinionView.astro
 * Unified, premium multi-step medical opinion request experience for Nuhavi Health.
 * Used by /en/request-opinion/, /ru/request-opinion/, and /ar/request-opinion/ (RTL).
 *
 * Strict Requirements:
 * - Exact preservation of all DOM element IDs and field names.
 * - Live AWS API Gateway POST integration (https://h7ihc39gd2.execute-api.ap-south-2.amazonaws.com/enquiry).
 * - Exact payload structure expected by AWS Lambda.
 * - Client-side validation with accessible error summary and field focus.
 * - Multi-language support (English, Russian, Arabic RTL).
 * - High-contrast clinical emergency notice.
 */

import { requestOpinionData } from '../../data/contactData';
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const data = requestOpinionData[lang];
const s1 = data.steps.step1;
const s2 = data.steps.step2;
const s3 = data.steps.step3;
const sSuccess = data.steps.success;
const sb = data.sidebar;
const isRtl = lang === 'ar';
---

<div class={`enquiry-page-container ${isRtl ? 'is-rtl' : ''}`} dir={isRtl ? 'rtl' : 'ltr'}>
  <div class="container main-content">
    <!-- Breadcrumb Navigation -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href={`/${lang}/`}>{data.breadcrumbs.home}</a></li>
        <li aria-hidden="true"><span class="sep">{isRtl ? '\\' : '/'}</span></li>
        <li aria-current="page">{data.breadcrumbs.requestOpinion}</li>
      </ol>
    </nav>

    <!-- Signature 72x3 px Gold Rule -->
    <div class="gold-rule" aria-hidden="true"></div>

    <!-- Page Header -->
    <header class="page-header">
      <span class="eyebrow-pill">{data.eyebrow}</span>
      <h1 class="page-title">{data.title}</h1>
      <p class="page-deck">{data.deck}</p>
    </header>

    <div class="enquiry-layout">
      <!-- Left: Form Container with 3 Steps + Success State -->
      <div class="form-container">
        <!-- Form Timing & Privacy Advisory -->
        <div class="form-intro-banner">
          <span class="intro-icon" aria-hidden="true">⏱</span>
          <p class="form-timing-note">{data.timingNote}</p>
        </div>

        <!-- Step Progress Indicator -->
        <div class="steps-progress-bar" id="progress-bar-wrap" role="tablist" aria-label="Enquiry progress">
          <div class="step-indicator active" id="ind-1">
            <span class="step-badge">1</span>
            <span class="step-label">{s1.label}</span>
          </div>
          <div class="step-connector" aria-hidden="true"></div>
          <div class="step-indicator" id="ind-2">
            <span class="step-badge">2</span>
            <span class="step-label">{s2.label}</span>
          </div>
          <div class="step-connector" aria-hidden="true"></div>
          <div class="step-indicator" id="ind-3">
            <span class="step-badge">3</span>
            <span class="step-label">{s3.label}</span>
          </div>
        </div>

        <!-- ============================================================
             STEP 1: About you
             ============================================================ -->
        <div class="form-step-panel" id="step-1-panel">
          <!-- Step 1 Validation Errors Box -->
          <div class="validation-errors-box" id="step-1-errors" style="display: none;" role="alert">
            <div class="errors-header">
              <span class="err-icon" aria-hidden="true">⚠</span>
              <p class="errors-heading">{s1.errorsHeading}</p>
            </div>
            <ul class="errors-list">
              <li id="err-name" style="display: none;">
                <a href="#patientName">{s1.errorName}</a>
              </li>
              <li id="err-country" style="display: none;">
                <a href="#residenceCountry">{s1.errorCountry}</a>
              </li>
            </ul>
          </div>

          <h2 class="step-heading">{s1.heading}</h2>

          <div class="form-field" id="field-wrap-name">
            <label for="patientName">
              {s1.nameLabel} <span class="required-star" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="patientName"
              name="patientName"
              placeholder={s1.namePlaceholder}
              autocomplete="name"
              required
            />
          </div>

          <div class="form-field">
            <label for="filledBy">{s1.whoLabel}</label>
            <div class="select-wrapper">
              <select id="filledBy" name="filledBy">
                {s1.whoOptions.map((opt) => (
                  <option value={opt.value}>{opt.label}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="form-row">
            <div class="form-field" id="field-wrap-country">
              <label for="residenceCountry">
                {s1.countryLabel} <span class="required-star" aria-hidden="true">*</span>
              </label>
              <div class="select-wrapper">
                <select id="residenceCountry" name="residenceCountry" required>
                  <option value="" disabled selected>{s1.countryPlaceholder}</option>
                  {s1.countryOptions.map((opt) => (
                    <option value={opt.value}>{opt.label}</option>
                  ))}
                </select>
              </div>
            </div>

            <div class="form-field">
              <label for="prefLanguage">{s1.languageLabel}</label>
              <div class="select-wrapper">
                <select id="prefLanguage" name="prefLanguage">
                  {s1.languageOptions.map((opt) => (
                    <option value={opt.value} selected={opt.value === lang}>{opt.label}</option>
                  ))}
                </select>
              </div>
              <span class="field-subnote">{s1.languageSubnote}</span>
            </div>
          </div>

          <div class="form-actions">
            <button type="button" class="btn-pill btn-continue" id="btn-to-step-2">
              <span>{s1.continueButton}</span>
              <span class="btn-arrow" aria-hidden="true">{isRtl ? '←' : '→'}</span>
            </button>
          </div>
        </div>

        <!-- ============================================================
             STEP 2: Your enquiry
             ============================================================ -->
        <div class="form-step-panel" id="step-2-panel" style="display: none;">
          <h2 class="step-heading">{s2.heading}</h2>

          <div class="form-field">
            <label for="specialty">{s2.specialtyLabel}</label>
            <div class="select-wrapper">
              <select id="specialty" name="specialty">
                {s2.specialtyOptions.map((opt) => (
                  <option value={opt.value}>{opt.label}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="form-field">
            <label for="enquiryNotes">{s2.notesLabel}</label>
            <textarea
              id="enquiryNotes"
              name="enquiryNotes"
              rows="4"
              placeholder={s2.notesPlaceholder}
            ></textarea>
          </div>

          <div class="form-actions dual-actions">
            <button type="button" class="btn-pill btn-back" id="btn-back-to-1">
              <span class="btn-arrow-back" aria-hidden="true">{isRtl ? '→' : '←'}</span>
              <span>{s2.backButton}</span>
            </button>
            <button type="button" class="btn-pill btn-continue" id="btn-to-step-3">
              <span>{s2.continueButton}</span>
              <span class="btn-arrow" aria-hidden="true">{isRtl ? '←' : '→'}</span>
            </button>
          </div>
        </div>

        <!-- ============================================================
             STEP 3: Contact and consent
             ============================================================ -->
        <div class="form-step-panel" id="step-3-panel" style="display: none;">
          <!-- Step 3 Validation Errors Box -->
          <div class="validation-errors-box" id="step-3-errors" style="display: none;" role="alert">
            <div class="errors-header">
              <span class="err-icon" aria-hidden="true">⚠</span>
              <p class="errors-heading">{s3.errorsHeading}</p>
            </div>
            <ul class="errors-list">
              <li id="err-consent" style="display: none;">
                <a href="#consentEnquiry">{s3.errorConsent}</a>
              </li>
            </ul>
          </div>

          <h2 class="step-heading">{s3.heading}</h2>

          <div class="form-field">
            <label for="email">
              {s3.emailLabel} <span class="required-star" aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder={s3.emailPlaceholder}
              autocomplete="email"
              required
            />
          </div>

          <div class="form-field">
            <label for="phone">
              {s3.phoneLabel} <span class="required-star" aria-hidden="true">*</span>
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder={s3.phonePlaceholder}
              autocomplete="tel"
              required
            />
          </div>

          <div class="form-field">
            <label class="group-label">{s3.contactMethodLabel}</label>
            <div class="contact-method-grid">
              {s3.contactMethodOptions.map((m, idx) => (
                <label class="contact-tile">
                  <input
                    type="radio"
                    name="contactMethod"
                    value={m.value}
                    checked={idx === 0}
                  />
                  <span class="tile-label">{m.label}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="form-field">
            <label for="contactTime">{s3.timeLabel}</label>
            <div class="select-wrapper">
              <select id="contactTime" name="contactTime">
                {s3.timeOptions.map((opt) => (
                  <option value={opt.value}>{opt.label}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="consent-block">
            <label class="checkbox-line" id="label-consent-enquiry">
              <input type="checkbox" id="consentEnquiry" required />
              <span class="checkbox-text">
                {s3.privacyConsentText.split(s3.privacyLinkText)[0]}
                <a href={`/${lang}/about/`} target="_blank">{s3.privacyLinkText}</a>
                {s3.privacyConsentText.split(s3.privacyLinkText)[1] || ''}
              </span>
            </label>

            <label class="checkbox-line">
              <input type="checkbox" id="consentMarketing" />
              <span class="checkbox-text">{s3.marketingConsentText}</span>
            </label>
          </div>

          <div class="form-actions dual-actions">
            <button type="button" class="btn-pill btn-back" id="btn-back-to-2">
              <span class="btn-arrow-back" aria-hidden="true">{isRtl ? '→' : '←'}</span>
              <span>{s3.backButton}</span>
            </button>
            <button type="button" class="btn-pill btn-continue" id="btn-send-enquiry">
              <span class="btn-text-content">{s3.submitButton}</span>
            </button>
          </div>
        </div>

        <!-- ============================================================
             STEP 4: Success State (After Sending)
             ============================================================ -->
        <div class="form-step-panel" id="success-panel" style="display: none;">
          <div class="success-banner-card">
            <div class="success-icon-badge" aria-hidden="true">✓</div>
            <h2 class="step-heading success-heading">{sSuccess.heading}</h2>
            <div class="ref-code-card">
              <span class="ref-prefix">{sSuccess.referencePrefix}</span>
              <p class="ref-code"><strong class="ref-id">DEMO-EL2X45</strong></p>
              <span class="ref-suffix">{sSuccess.referenceSuffix}</span>
            </div>
            <p class="follow-note">{sSuccess.followNote}</p>
          </div>

          <!-- Preview notice (hidden on real API submission) -->
          <div class="demo-banner">
            {sSuccess.demoBanner}
          </div>

          <!-- Standard Upload Offer Box (All countries except Uzbekistan) -->
          <div class="reports-offer-box" id="standard-upload-box">
            <div class="offer-header">
              <h3>
                {sSuccess.uploadOfferTitle}
                <span class="tag-opt">{sSuccess.uploadOfferTag}</span>
              </h3>
            </div>
            <p class="offer-desc">
              {sSuccess.uploadOfferBodyPrefix} <strong class="user-sent-email">patient@example.com</strong>{sSuccess.uploadOfferBodySuffix}
            </p>

            <label class="checkbox-line opt-consent">
              <input type="checkbox" id="consentHealthData" />
              <span class="checkbox-text">
                {sSuccess.healthConsentText} <a href={`/${lang}/about/`} target="_blank">{sSuccess.healthConsentLinkText}</a>
              </span>
            </label>

            <!-- Green Confirmation Banner (Shown when link is requested) -->
            <div class="green-confirmation-banner" id="link-requested-banner" style="display: none;" role="status">
              <span class="confirm-check" aria-hidden="true">✓</span>
              <span>
                {sSuccess.linkRequestedBanner} <strong class="user-sent-email">patient@example.com</strong>.
                <a href={`/${lang}/about/`} class="preview-link">{sSuccess.viewUploadPageLink}</a>
              </span>
            </div>

            <div class="upload-btn-wrap" id="upload-btn-container">
              <button type="button" class="btn-pill btn-continue is-disabled" id="btn-request-link" disabled>
                {sSuccess.requestLinkButton}
              </button>
            </div>
            <p class="upload-later-text">{sSuccess.uploadLaterText}</p>
          </div>

          <!-- Uzbekistan Patient Upload Notice -->
          <div class="reports-offer-box uzbek-reports-box" id="uzbek-upload-box" style="display: none;">
            <div class="offer-header">
              <h3>
                {sSuccess.uploadOfferTitle}
                <span class="tag-opt">{sSuccess.uploadOfferTag}</span>
              </h3>
            </div>
            <p class="offer-desc">
              {sSuccess.uploadOfferBodyPrefix} <strong class="user-sent-email">patient@example.com</strong>{sSuccess.uploadOfferBodySuffix}
            </p>

            <div class="amber-closed-warning">
              <span class="warning-icon" aria-hidden="true">ℹ</span>
              <p>{sSuccess.uzbekWarning}</p>
            </div>

            <div class="amber-closed-warning amber-sub-warning">
              <span class="warning-icon" aria-hidden="true">⚠</span>
              <p>{sSuccess.uzbekGeneticWarning}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Informational Sidebar -->
      <aside class="info-sidebar" aria-label="Coordination Information">
        <!-- What Happens Next -->
        <div class="info-card next-card">
          <div class="card-title-row">
            <span class="info-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 11 12 14 22 4"></polyline>
                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
              </svg>
            </span>
            <h3>{sb.nextHeading}</h3>
          </div>
          <ol class="next-list">
            {sb.nextSteps.map((step, idx) => (
              <li>
                <span class="step-num">{idx + 1}</span>
                <span class="step-content">{step}</span>
              </li>
            ))}
          </ol>
        </div>

        <!-- Confidentiality Guarantee -->
        <div class="info-card privacy-card">
          <div class="card-title-row">
            <span class="info-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </span>
            <h3>{sb.privacyHeading}</h3>
          </div>
          <p class="privacy-note">{sb.privacyBody}</p>
        </div>

        <!-- Emergency Alert Notice (Red box) -->
        <div class="emergency-box" role="alert">
          <div class="emergency-header">
            <span class="alert-icon" aria-hidden="true">⚠</span>
            <strong>{sb.emergencyHeading}</strong>
          </div>
          <p class="emergency-text">{sb.emergencyBody}</p>
        </div>
      </aside>
    </div>
  </div>
</div>

<script>
  function setupRequestOpinion() {
    const ind1 = document.getElementById('ind-1');
    const ind2 = document.getElementById('ind-2');
    const ind3 = document.getElementById('ind-3');

    const p1 = document.getElementById('step-1-panel');
    const p2 = document.getElementById('step-2-panel');
    const p3 = document.getElementById('step-3-panel');
    const pSuccess = document.getElementById('success-panel');

    const btnTo2 = document.getElementById('btn-to-step-2');
    const btnBackTo1 = document.getElementById('btn-back-to-1');
    const btnTo3 = document.getElementById('btn-to-step-3');
    const btnBackTo2 = document.getElementById('btn-back-to-2');
    const btnSend = document.getElementById('btn-send-enquiry');

    // Inputs for validation
    const nameInput = document.getElementById('patientName') as HTMLInputElement | null;
    const countrySelect = document.getElementById('residenceCountry') as HTMLSelectElement | null;
    const s1Errors = document.getElementById('step-1-errors');
    const errName = document.getElementById('err-name');
    const errCountry = document.getElementById('err-country');

    // Step 1 Validation & Proceed
    if (btnTo2) {
      btnTo2.addEventListener('click', () => {
        let hasErrors = false;
        const nameVal = nameInput ? nameInput.value.trim() : '';
        const countryVal = countrySelect ? countrySelect.value : '';

        if (!nameVal) {
          hasErrors = true;
          if (errName) errName.style.display = 'list-item';
          if (nameInput) nameInput.classList.add('field-invalid');
        } else {
          if (errName) errName.style.display = 'none';
          if (nameInput) nameInput.classList.remove('field-invalid');
        }

        if (!countryVal) {
          hasErrors = true;
          if (errCountry) errCountry.style.display = 'list-item';
          if (countrySelect) countrySelect.classList.add('field-invalid');
        } else {
          if (errCountry) errCountry.style.display = 'none';
          if (countrySelect) countrySelect.classList.remove('field-invalid');
        }

        if (hasErrors) {
          if (s1Errors) {
            s1Errors.style.display = 'block';
            s1Errors.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
          return;
        }

        if (s1Errors) s1Errors.style.display = 'none';
        if (p1) p1.style.display = 'none';
        if (p2) p2.style.display = 'block';
        if (ind1) {
          ind1.classList.remove('active');
          ind1.classList.add('completed');
        }
        if (ind2) ind2.classList.add('active');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Clear errors on input
    nameInput?.addEventListener('input', () => {
      if (nameInput.value.trim() && errName) {
        errName.style.display = 'none';
        nameInput.classList.remove('field-invalid');
      }
    });

    countrySelect?.addEventListener('change', () => {
      if (countrySelect.value && errCountry) {
        errCountry.style.display = 'none';
        countrySelect.classList.remove('field-invalid');
      }
    });

    if (btnBackTo1) {
      btnBackTo1.addEventListener('click', () => {
        if (p2) p2.style.display = 'none';
        if (p1) p1.style.display = 'block';
        if (ind2) ind2.classList.remove('active');
        if (ind1) {
          ind1.classList.remove('completed');
          ind1.classList.add('active');
        }
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    if (btnTo3) {
      btnTo3.addEventListener('click', () => {
        if (p2) p2.style.display = 'none';
        if (p3) p3.style.display = 'block';
        if (ind2) {
          ind2.classList.remove('active');
          ind2.classList.add('completed');
        }
        if (ind3) ind3.classList.add('active');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    if (btnBackTo2) {
      btnBackTo2.addEventListener('click', () => {
        if (p3) p3.style.display = 'none';
        if (p2) p2.style.display = 'block';
        if (ind3) ind3.classList.remove('active');
        if (ind2) {
          ind2.classList.remove('completed');
          ind2.classList.add('active');
        }
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Step 3 Submission
    if (btnSend) {
      btnSend.addEventListener('click', async () => {
        const consentEnquiry = document.getElementById('consentEnquiry') as HTMLInputElement | null;
        const s3Errors = document.getElementById('step-3-errors');
        const errConsent = document.getElementById('err-consent');

        const showError = (message: string) => {
          if (s3Errors) {
            let errSubmit = document.getElementById('err-submit');

            if (!errSubmit) {
              errSubmit = document.createElement('li');
              errSubmit.id = 'err-submit';
              s3Errors.querySelector('.errors-list')?.appendChild(errSubmit);
            }

            errSubmit.textContent = message;
            errSubmit.style.display = 'list-item';
            s3Errors.style.display = 'block';
            s3Errors.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        };

        if (!consentEnquiry?.checked) {
          if (s3Errors) s3Errors.style.display = 'block';
          if (errConsent) errConsent.style.display = 'list-item';
          return;
        }

        if (errConsent) errConsent.style.display = 'none';

        const name = (document.getElementById('patientName') as HTMLInputElement)?.value.trim();
        const email = (document.getElementById('email') as HTMLInputElement)?.value.trim();
        const phone = (document.getElementById('phone') as HTMLInputElement)?.value.trim();
        const message = (document.getElementById('enquiryNotes') as HTMLTextAreaElement)?.value.trim() || 'No additional notes provided.';
        const contactPreference = (document.querySelector('input[name="contactMethod"]:checked') as HTMLInputElement)?.value || 'whatsapp';

        if (!name || !email || !phone) {
          showError('Please complete all required fields before submitting.');
          return;
        }

        const payload = {
          name,
          email,
          phone,
          message,
          contactPreference,
          privacyConsent: consentEnquiry.checked,
          marketingConsent: (document.getElementById('consentMarketing') as HTMLInputElement | null)?.checked ?? false,
          country: (document.getElementById('residenceCountry') as HTMLSelectElement | null)?.value || '',
          enquiryFor: (document.getElementById('specialty') as HTMLSelectElement | null)?.value || 'cancer-care',
          relationship: (document.getElementById('filledBy') as HTMLSelectElement | null)?.value || 'patient',
          preferredLanguage: (document.getElementById('prefLanguage') as HTMLSelectElement | null)?.value || 'en',
          contactTime: (document.getElementById('contactTime') as HTMLSelectElement | null)?.value || 'any',
        };

        const originalBtnHtml = btnSend.innerHTML;
        btnSend.disabled = true;
        btnSend.classList.add('is-submitting');
        btnSend.innerHTML = `<span>Submitting...</span>`;

        try {
          const response = await fetch(
            'https://h7ihc39gd2.execute-api.ap-south-2.amazonaws.com/enquiry',
            {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify(payload),
            }
          );

          const result = await response.json();

          if (!response.ok || !result.success) {
            throw new Error(result.message || 'Unable to submit your enquiry. Please try again.');
          }

          document.querySelectorAll('.user-sent-email').forEach((el) => {
            el.textContent = email;
          });

          const referenceEl = pSuccess?.querySelector('.ref-code strong');
          if (referenceEl && result.enquiryId) {
            referenceEl.textContent = result.enquiryId;
          }

          const demoBanner = pSuccess?.querySelector('.demo-banner') as HTMLElement | null;
          if (demoBanner) {
            demoBanner.style.display = 'none';
          }

          const country = (document.getElementById('residenceCountry') as HTMLSelectElement | null)?.value;
          const standardBox = document.getElementById('standard-upload-box');
          const uzbekBox = document.getElementById('uzbek-upload-box');

          if (country === 'uzbekistan') {
            if (standardBox) standardBox.style.display = 'none';
            if (uzbekBox) uzbekBox.style.display = 'block';
          } else {
            if (standardBox) standardBox.style.display = 'block';
            if (uzbekBox) uzbekBox.style.display = 'none';
          }

          if (s3Errors) s3Errors.style.display = 'none';
          if (p3) p3.style.display = 'none';
          if (pSuccess) pSuccess.style.display = 'block';
          if (ind3) {
            ind3.classList.remove('active');
            ind3.classList.add('completed');
          }
          pSuccess?.scrollIntoView({ behavior: 'smooth' });

        } catch (error) {
          showError(error instanceof Error ? error.message : 'Something went wrong. Please try again.');
        } finally {
          btnSend.disabled = false;
          btnSend.classList.remove('is-submitting');
          btnSend.innerHTML = originalBtnHtml;
        }
      });
    }

    // Step 4: Health Data Consent & Request Link
    const consentHealth = document.getElementById('consentHealthData') as HTMLInputElement | null;
    const btnRequestLink = document.getElementById('btn-request-link') as HTMLButtonElement | null;
    const linkRequestedBanner = document.getElementById('link-requested-banner');
    const uploadBtnWrap = document.getElementById('upload-btn-container');

    if (consentHealth && btnRequestLink) {
      consentHealth.addEventListener('change', () => {
        if (consentHealth.checked) {
          btnRequestLink.removeAttribute('disabled');
          btnRequestLink.classList.remove('is-disabled');
        } else {
          btnRequestLink.setAttribute('disabled', 'true');
          btnRequestLink.classList.add('is-disabled');
        }
      });

      btnRequestLink.addEventListener('click', () => {
        if (linkRequestedBanner) {
          linkRequestedBanner.style.display = 'flex';
        }
        if (uploadBtnWrap) {
          uploadBtnWrap.style.display = 'none';
        }
      });
    }
  }

  let isInitialized = false;

  function init() {
    if (isInitialized) return;
    isInitialized = true;
    setupRequestOpinion();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

