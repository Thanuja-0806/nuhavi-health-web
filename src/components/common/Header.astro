  }

  /* --------------------------------------------------------------------------
     RTL (RIGHT-TO-LEFT) ARABIC MIRRORING SUPPORT (Page 40)
     -------------------------------------------------------------------------- */
  :global([dir="rtl"]) .header-container {
    flex-direction: row;
  }

  :global([dir="rtl"]) .header-logo {
    order: 1;
  }

  :global([dir="rtl"]) .desktop-nav {
    order: 2;
  }

  :global([dir="rtl"]) .header-actions {
    order: 3;
  }

  :global([dir="rtl"]) .lang-dropdown {
    right: auto;
    left: 0;
  }

  :global([dir="rtl"]) .specialties-dropdown {
    right: 0;
    left: auto;
  }

  :global([dir="rtl"]) .mobile-nav-panel {
    right: auto;
    left: 0;
  }
</style>

<script>
  function setupHeader() {
    // Treatments dropdown desktop
    const treatmentsNavItem = document.getElementById('treatments-nav-item');
    const treatmentsBtn = document.getElementById('treatments-menu-btn');
    const treatmentsPanel = document.getElementById('treatments-dropdown-panel');

    if (treatmentsNavItem && treatmentsBtn && treatmentsPanel && !(treatmentsBtn as any).__treatmentsInitialized) {
      (treatmentsBtn as any).__treatmentsInitialized = true;
      let hoverTimeout: any = null;

      function openTreatmentsDropdown() {
        if (hoverTimeout) clearTimeout(hoverTimeout);
        const specialtiesPanel = document.getElementById('specialties-dropdown-panel');
        const specialtiesNavItem = document.getElementById('specialties-nav-item');
        const specialtiesBtn = document.getElementById('specialties-menu-btn');
        specialtiesPanel?.classList.remove('open');
        specialtiesNavItem?.classList.remove('is-open');
        specialtiesBtn?.setAttribute('aria-expanded', 'false');

        treatmentsPanel?.classList.add('open');
        treatmentsNavItem?.classList.add('is-open');
        treatmentsBtn?.setAttribute('aria-expanded', 'true');
      }

      function closeTreatmentsDropdown() {
        if (hoverTimeout) clearTimeout(hoverTimeout);
        treatmentsPanel?.classList.remove('open');
        treatmentsNavItem?.classList.remove('is-open');
        treatmentsBtn?.setAttribute('aria-expanded', 'false');
      }

      treatmentsBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (treatmentsPanel?.classList.contains('open')) {
          closeTreatmentsDropdown();
        } else {
          openTreatmentsDropdown();
        }
      });

      treatmentsNavItem.addEventListener('mouseenter', () => {
        if (window.innerWidth >= 1200) openTreatmentsDropdown();
      });

      treatmentsNavItem.addEventListener('mouseleave', () => {
        if (window.innerWidth >= 1200) hoverTimeout = setTimeout(closeTreatmentsDropdown, 180);
      });

      document.addEventListener('click', (e) => {
        if (treatmentsNavItem && !treatmentsNavItem.contains(e.target as Node)) {
          closeTreatmentsDropdown();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeTreatmentsDropdown();
      });
    }

    // Specialties dropdown desktop
    const specialtiesNavItem = document.getElementById('specialties-nav-item');
    const specialtiesBtn = document.getElementById('specialties-menu-btn');
    const specialtiesPanel = document.getElementById('specialties-dropdown-panel');

    if (specialtiesNavItem && specialtiesBtn && specialtiesPanel && !(specialtiesBtn as any).__specialtiesInitialized) {
      (specialtiesBtn as any).__specialtiesInitialized = true;
      let hoverTimeout: any = null;

      function openSpecialtiesDropdown() {
        if (hoverTimeout) clearTimeout(hoverTimeout);
        // Close treatments dropdown if open
        const treatmentsNavItem = document.getElementById('treatments-nav-item');
        const treatmentsBtn = document.getElementById('treatments-menu-btn');
        const treatmentsPanel = document.getElementById('treatments-dropdown-panel');
        treatmentsPanel?.classList.remove('open');
        treatmentsNavItem?.classList.remove('is-open');
        treatmentsBtn?.setAttribute('aria-expanded', 'false');

        specialtiesPanel?.classList.add('open');
        specialtiesNavItem?.classList.add('is-open');
        specialtiesBtn?.setAttribute('aria-expanded', 'true');
      }

      function closeSpecialtiesDropdown() {
        if (hoverTimeout) clearTimeout(hoverTimeout);
        specialtiesPanel?.classList.remove('open');
        specialtiesNavItem?.classList.remove('is-open');
        specialtiesBtn?.setAttribute('aria-expanded', 'false');
      }

      specialtiesBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (specialtiesPanel?.classList.contains('open')) {
          closeSpecialtiesDropdown();
        } else {
          openSpecialtiesDropdown();
        }
      });

      specialtiesNavItem.addEventListener('mouseenter', () => {
        if (window.innerWidth >= 1200) openSpecialtiesDropdown();
      });

      specialtiesNavItem.addEventListener('mouseleave', () => {
        if (window.innerWidth >= 1200) hoverTimeout = setTimeout(closeSpecialtiesDropdown, 180);
      });

      document.addEventListener('click', (e) => {
        if (specialtiesNavItem && !specialtiesNavItem.contains(e.target as Node)) {
          closeSpecialtiesDropdown();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeSpecialtiesDropdown();
      });
    }

    // Mobile treatments accordion
    const mobileTreatmentsToggle = document.getElementById('mobile-treatments-toggle');
    const mobileTreatmentsSubmenu = document.getElementById('mobile-treatments-submenu');

    if (mobileTreatmentsToggle && mobileTreatmentsSubmenu && !(mobileTreatmentsToggle as any).__accInit) {
      (mobileTreatmentsToggle as any).__accInit = true;
      mobileTreatmentsToggle.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = mobileTreatmentsSubmenu.classList.contains('open');
        if (isOpen) {
          mobileTreatmentsSubmenu.classList.remove('open');
          mobileTreatmentsToggle.setAttribute('aria-expanded', 'false');
        } else {
          mobileTreatmentsSubmenu.classList.add('open');
          mobileTreatmentsToggle.setAttribute('aria-expanded', 'true');
        }
      });
    }

    // Mobile specialties accordion
    const mobileSpecialtiesToggle = document.getElementById('mobile-specialties-toggle');
    const mobileSpecialtiesSubmenu = document.getElementById('mobile-specialties-submenu');

    if (mobileSpecialtiesToggle && mobileSpecialtiesSubmenu && !(mobileSpecialtiesToggle as any).__accInit) {
      (mobileSpecialtiesToggle as any).__accInit = true;
      mobileSpecialtiesToggle.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = mobileSpecialtiesSubmenu.classList.contains('open');
        if (isOpen) {
          mobileSpecialtiesSubmenu.classList.remove('open');
          mobileSpecialtiesToggle.setAttribute('aria-expanded', 'false');
        } else {
          mobileSpecialtiesSubmenu.classList.add('open');
          mobileSpecialtiesToggle.setAttribute('aria-expanded', 'true');
        }
      });
    }

    // Mobile nav toggle
    const mobileToggle = document.getElementById('mobile-nav-toggle');
    const mobileDrawer = document.getElementById('mobile-nav-drawer');
    const mobileClose = document.getElementById('mobile-nav-close');
    const mobileBackdrop = document.getElementById('mobile-nav-backdrop');

    if (mobileToggle && !(mobileToggle as any).__drawerInit) {
      (mobileToggle as any).__drawerInit = true;

      function openDrawer() {
        mobileDrawer?.classList.add('open');
        mobileDrawer?.setAttribute('aria-hidden', 'false');
        mobileToggle?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      function closeDrawer() {
        mobileDrawer?.classList.remove('open');
        mobileDrawer?.setAttribute('aria-hidden', 'true');
        mobileToggle?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      mobileToggle.addEventListener('click', openDrawer);
      mobileClose?.addEventListener('click', closeDrawer);
      mobileBackdrop?.addEventListener('click', closeDrawer);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mobileDrawer?.classList.contains('open')) {
          closeDrawer();
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeader);
  } else {
    setupHeader();
  }
  document.addEventListener('astro:page-load', setupHeader);
</script>
