---
/**
 * Header.astro
 * Global navigation header for Nuhavi Health.
 * Includes text wordmark logo, desktop navigation, language preview switcher,
 * prominent "Request a medical opinion" pill CTA, and an accessible mobile navigation drawer.
 */

const navLinks = [
  { label: 'Treatments', href: '/en/treatments' },
  { label: 'Hospitals', href: '/en/hospitals' },
  { label: 'How it works', href: '/en/how-it-works' },
  { label: 'Countries', href: '/en/countries' },
  { label: 'Stories', href: '/en/stories' },
  { label: 'Resources', href: '/en/resources' },
  { label: 'About', href: '/en/about' },
  { label: 'Contact', href: '/en/contact' },
];

const languages = [
  { code: 'en', name: 'English', status: 'Live', isLive: true },
  { code: 'ru', name: 'Русский', status: 'Preview', isLive: false },
  { code: 'ar', name: 'العربية', status: 'Preview', isLive: false },
];
---

<header class="site-header">
  <div class="container header-container">
    <!-- Brand Text Logo -->
    <a href="/en/" class="header-logo" aria-label="Nuhavi Health - Home">
      <span class="logo-text">Nuhavi Health</span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="desktop-nav" aria-label="Primary navigation">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li class="nav-item">
            <a href={link.href} class="nav-link">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions (Language Selector & CTA) -->
    <div class="header-actions">
      <!-- Language Selector -->
      <div class="lang-selector" id="lang-selector-container">
        <button
          type="button"
          class="lang-btn"
          id="lang-btn"
          aria-expanded="false"
          aria-haspopup="true"
          aria-label="Select language (Current: English)"
        >
          <!-- Globe SVG Icon -->
          <svg class="icon-globe" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span class="lang-current">EN</span>
          <!-- Chevron Down SVG -->
          <svg class="icon-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div class="lang-dropdown" id="lang-dropdown" role="menu" aria-label="Languages">
          <ul class="lang-list">
            {languages.map((lang) => (
              <li role="none">
                {lang.isLive ? (
                  <a
                    href="/en/"
                    class="lang-option active"
                    role="menuitem"
                    aria-current="true"
                  >
                    <span class="lang-name">{lang.name}</span>
                    <span class="lang-badge live">{lang.status}</span>
                  </a>
                ) : (
                  <div
                    class="lang-option disabled"
                    role="menuitem"
                    aria-disabled="true"
                    title={`${lang.name} is a preview language and not yet active.`}
                  >
                    <span class="lang-name">{lang.name}</span>
                    <span class="lang-badge preview">{lang.status}</span>
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Prominent Pill CTA -->
      <a href="/en/request-opinion/" class="btn-primary header-cta">
        Request a medical opinion
      </a>

      <!-- Mobile Hamburger / Close Toggle Button -->
      <button
        type="button"
        id="mobile-nav-toggle"
        class="mobile-nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label="Open mobile navigation menu"
      >
        <span class="hamburger-box">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-nav-drawer"
    class="mobile-nav-drawer"
    aria-hidden="true"
  >
    <div class="mobile-nav-backdrop" id="mobile-nav-backdrop"></div>
    <div class="mobile-nav-panel">
      <div class="mobile-nav-header">
        <span class="mobile-logo">Nuhavi Health</span>
        <button
          type="button"
          id="mobile-nav-close"
          class="mobile-close-btn"
          aria-label="Close navigation menu"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav class="mobile-nav-links" aria-label="Mobile navigation">
        <ul class="mobile-links-list">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="mobile-link">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Mobile Language Preview Section -->
      <div class="mobile-lang-section">
        <span class="mobile-section-label">Language</span>
        <div class="mobile-lang-options">
          {languages.map((lang) => (
            <div class={`mobile-lang-item ${lang.isLive ? 'active' : 'preview'}`}>
              <span class="lang-text">{lang.name}</span>
              <span class={`lang-badge ${lang.isLive ? 'live' : 'preview'}`}>
                {lang.status}
              </span>
            </div>
          ))}
        </div>
      </div>

      <!-- Mobile CTA -->
      <div class="mobile-cta-container">
        <a href="/en/request-opinion/" class="btn-primary mobile-cta">
          Request a medical opinion
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* --------------------------------------------------------------------------
     HEADER CONTAINER & BASE
     -------------------------------------------------------------------------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: var(--color-paper);
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
    transition: background-color 0.2s ease;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
    gap: var(--space-3);
    max-width: 1360px;
  }

  @media (max-width: 480px) {
    .header-container {
      height: 72px;
    }

    .logo-text {
      font-size: 1.2rem;
    }
  }

  /* Logo (Aligned Left) */
  .header-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: var(--color-deep-navy);
    flex-shrink: 0;
  }

  .logo-text {
    font-size: 1.375rem;
    font-weight: var(--font-weight-heading);
    letter-spacing: -0.02em;
    color: var(--color-deep-navy);
    white-space: nowrap;
  }

  .header-logo:hover .logo-text {
    color: var(--color-navy);
  }

  /* --------------------------------------------------------------------------
     DESKTOP NAVIGATION
     -------------------------------------------------------------------------- */
  .desktop-nav {
    display: none;
    flex: 1 1 auto;
    margin: 0 var(--space-3);
  }

  @media (min-width: 1240px) {
    .desktop-nav {
      display: flex;
      justify-content: center;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(10px, 1.3vw, 20px);
    list-style: none;
    flex-wrap: nowrap;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    flex-shrink: 0;
  }

  .nav-link {
    font-size: 0.9375rem;
    font-weight: var(--font-weight-subheading);
    color: var(--color-ink);
    text-decoration: none;
    padding: var(--space-1) 0;
    position: relative;
    white-space: nowrap; /* Guarantees every link stays on a single line */
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--color-gold-text);
  }

  /* --------------------------------------------------------------------------
     HEADER ACTIONS (Language & CTA)
     -------------------------------------------------------------------------- */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  /* Language Selector */
  .lang-selector {
    position: relative;
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 var(--space-2);
    background-color: transparent;
    border: 1px solid rgba(20, 41, 75, 0.15);
    border-radius: var(--radius-pill);
    color: var(--color-deep-navy);
    font-family: var(--font-family-base);
    font-size: 0.875rem;
    font-weight: var(--font-weight-subheading);
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .lang-btn:hover {
    border-color: var(--color-navy);
    background-color: var(--color-mist);
  }

  .icon-globe {
    color: var(--color-gold);
    flex-shrink: 0;
  }

  .icon-chevron {
    color: var(--color-slate);
    transition: transform 0.2s ease;
  }

  .lang-btn[aria-expanded="true"] .icon-chevron {
    transform: rotate(180deg);
  }

  /* Language Dropdown */
  .lang-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 200px;
    background-color: var(--color-paper);
    border-radius: var(--radius-card);
    border: 1px solid rgba(20, 41, 75, 0.12);
    box-shadow: 0 10px 25px -5px rgba(20, 41, 75, 0.1);
    z-index: 1010;
    padding: var(--space-1);
  }

  .lang-dropdown.open {
    display: block;
  }

  .lang-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .lang-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px var(--space-2);
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: var(--font-weight-body);
    color: var(--color-ink);
  }

  .lang-option.active {
    background-color: var(--color-mist);
    font-weight: var(--font-weight-subheading);
    color: var(--color-deep-navy);
  }

  .lang-option.disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .lang-option:not(.disabled):hover {
    background-color: var(--color-mist);
    color: var(--color-gold-text);
  }

  .lang-badge {
    font-size: 0.75rem;
    font-weight: var(--font-weight-subheading);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.02em;
  }

  .lang-badge.live {
    background-color: var(--color-mist);
    color: var(--color-success);
    border: 1px solid rgba(38, 115, 77, 0.3);
  }

  .lang-badge.preview {
    background-color: var(--color-confirmation);
    color: var(--color-gold-text);
    border: 1px solid rgba(196, 154, 60, 0.3);
  }

  /* Desktop Header CTA */
  .header-cta {
    display: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (min-width: 1240px) {
    .header-cta {
      display: inline-flex;
      font-size: 0.9375rem;
      padding: 0 var(--space-3);
    }
  }

  /* --------------------------------------------------------------------------
     MOBILE NAVIGATION TOGGLE
     -------------------------------------------------------------------------- */
  .mobile-nav-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: transparent;
    border: 1px solid rgba(20, 41, 75, 0.12);
    border-radius: var(--radius-pill);
    cursor: pointer;
    padding: 0;
    color: var(--color-deep-navy);
    flex-shrink: 0;
  }

  .mobile-nav-toggle:hover {
    background-color: var(--color-mist);
  }

  @media (min-width: 1240px) {
    .mobile-nav-toggle {
      display: none;
    }
  }

  .hamburger-box {
    width: 22px;
    height: 16px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hamburger-line {
    width: 100%;
    height: 2px;
    background-color: var(--color-deep-navy);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* --------------------------------------------------------------------------
     MOBILE NAVIGATION DRAWER
     -------------------------------------------------------------------------- */
  .mobile-nav-drawer {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 2000;
  }

  .mobile-nav-drawer.open {
    display: block;
  }

  .mobile-nav-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(13, 27, 51, 0.5);
    backdrop-filter: blur(2px);
  }

  .mobile-nav-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    max-width: min(340px, 88vw);
    height: 100%;
    background-color: var(--color-paper);
    display: flex;
    flex-direction: column;
    padding: var(--space-4) var(--space-3);
    overflow-y: auto;
    box-shadow: -5px 0 25px rgba(20, 41, 75, 0.15);
    animation: slideInRight 0.25s ease-out;
  }

  @keyframes slideInRight {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav-panel {
      animation: none;
    }
  }

  .mobile-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
  }

  .mobile-logo {
    font-size: 1.25rem;
    font-weight: var(--font-weight-heading);
    color: var(--color-deep-navy);
  }

  .mobile-close-btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    border-radius: var(--radius-pill);
    color: var(--color-deep-navy);
    cursor: pointer;
  }

  .mobile-close-btn:hover {
    background-color: var(--color-mist);
  }

  .mobile-nav-links {
    margin-top: var(--space-3);
  }

  .mobile-links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .mobile-link {
    display: block;
    padding: var(--space-2) var(--space-1);
    font-size: 1.0625rem;
    font-weight: var(--font-weight-subheading);
    color: var(--color-deep-navy);
    text-decoration: none;
    border-bottom: 1px solid rgba(20, 41, 75, 0.04);
  }

  .mobile-link:hover {
    color: var(--color-gold-text);
  }

  /* Mobile Language Section */
  .mobile-lang-section {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid rgba(20, 41, 75, 0.08);
  }

  .mobile-section-label {
    display: block;
    font-size: 0.8125rem;
    font-weight: var(--font-weight-subheading);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-slate);
    margin-bottom: var(--space-2);
  }

  .mobile-lang-options {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .mobile-lang-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-1) 0;
    font-size: 0.9375rem;
    color: var(--color-ink);
  }

  .mobile-lang-item.active {
    font-weight: var(--font-weight-subheading);
    color: var(--color-deep-navy);
  }

  /* Mobile CTA */
  .mobile-cta-container {
    margin-top: auto;
    padding-top: var(--space-4);
  }

  .mobile-cta {
    width: 100%;
    text-align: center;
  }
</style>

<script>
  /**
   * Accessible Header Scripts
   * Handles:
   * 1. Desktop language dropdown toggle, click-outside, and Escape key.
   * 2. Mobile drawer open/close, focus trapping, body scroll locking, and Escape key.
   */
  function setupHeader() {
    // --- Language Dropdown ---
    const langBtn = document.getElementById('lang-btn');
    const langDropdown = document.getElementById('lang-dropdown');
    const langContainer = document.getElementById('lang-selector-container');

    function closeLangDropdown() {
      if (langDropdown && langDropdown.classList.contains('open')) {
        langDropdown.classList.remove('open');
        langBtn?.setAttribute('aria-expanded', 'false');
      }
    }

    if (langBtn && langDropdown) {
      langBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = langDropdown.classList.contains('open');
        if (isOpen) {
          closeLangDropdown();
        } else {
          langDropdown.classList.add('open');
          langBtn.setAttribute('aria-expanded', 'true');
        }
      });

      // Close when clicking outside
      document.addEventListener('click', (e) => {
        if (langContainer && !langContainer.contains(e.target as Node)) {
          closeLangDropdown();
        }
      });

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeLangDropdown();
        }
      });
    }

    // --- Mobile Drawer ---
    const mobileToggle = document.getElementById('mobile-nav-toggle');
    const mobileDrawer = document.getElementById('mobile-nav-drawer');
    const mobileClose = document.getElementById('mobile-nav-close');
    const mobileBackdrop = document.getElementById('mobile-nav-backdrop');
    const mobileLinks = document.querySelectorAll('.mobile-link, .mobile-cta');

    function openMobileDrawer() {
      if (!mobileDrawer) return;
      mobileDrawer.classList.add('open');
      mobileDrawer.setAttribute('aria-hidden', 'false');
      mobileToggle?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden'; // Prevent page background scrolling
      mobileClose?.focus();
    }

    function closeMobileDrawer() {
      if (!mobileDrawer) return;
      mobileDrawer.classList.remove('open');
      mobileDrawer.setAttribute('aria-hidden', 'true');
      mobileToggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = ''; // Restore page scrolling
      mobileToggle?.focus();
    }

    mobileToggle?.addEventListener('click', openMobileDrawer);
    mobileClose?.addEventListener('click', closeMobileDrawer);
    mobileBackdrop?.addEventListener('click', closeMobileDrawer);

    // Close when navigating via a link in the mobile drawer
    mobileLinks.forEach((link) => {
      link.addEventListener('click', closeMobileDrawer);
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileDrawer?.classList.contains('open')) {
        closeMobileDrawer();
      }
    });
  }

  // Run on initial load and handle client navigation if enabled
  document.addEventListener('DOMContentLoaded', setupHeader);
  setupHeader();
</script>
