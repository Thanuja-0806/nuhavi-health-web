---
/**
 * Header.astro
 * Global navigation header for Nuhavi Health.
 * Includes text wordmark logo, desktop navigation, language switcher,
 * prominent "Request a medical opinion" pill CTA, and an accessible mobile navigation drawer.
 *
 * Implements full localization for English (/en/), Russian (/ru/), and Arabic (/ar/ RTL).
 */
import { translations, type SupportedLang } from '../../i18n/translations';

interface Props {
  currentLang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : 'en';

const currentLang: SupportedLang = Astro.props.currentLang || detectedLang;
const t = translations[currentLang].nav;

const prefix = `/${currentLang}`;
const homeHref = `${prefix}/`;
const requestOpinionHref = `${prefix}/request-opinion/`;
const contactHref = `${prefix}/contact/`;

const navLinks = [
  { label: t.treatments, href: '/en/treatments' },
  { label: t.hospitals, href: '/en/hospitals' },
  { label: t.howItWorks, href: '/en/how-it-works' },
  { label: t.countries, href: '/en/countries' },
  { label: t.stories, href: '/en/stories' },
  { label: t.resources, href: '/en/resources' },
  { label: t.about, href: '/en/about' },
  { label: t.contact, href: contactHref },
];

const languages = [
  { code: 'en', name: 'English', status: 'Live', isLive: true, href: '/en/' },
  { code: 'ru', name: 'Русский', status: 'Live', isLive: true, href: '/ru/' },
  { code: 'ar', name: 'العربية', status: 'Live', isLive: true, href: '/ar/' },
];

const langLabels: Record<SupportedLang, string> = {
  en: 'English',
  ru: 'Русский',
  ar: 'العربية',
};
---

<header class="site-header">
  <div class="container header-container">
    <!-- Brand Logo (Moves to right on RTL) -->
    <a href={homeHref} class="header-logo" aria-label={`Nuhavi Health - Home (${langLabels[currentLang]})`}>
      <img
        src="/images/nuhavi-logo.svg"
        alt="Nuhavi Health"
        class="header-logo-img"
        width="162"
        height="34"
        loading="eager"
        decoding="sync"
      />
    </a>

    <!-- Desktop Navigation Links (Mirrors to right-to-left on RTL) -->
    <nav class="desktop-nav" aria-label={t.menu}>
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li class="nav-item">
            <a href={link.href} class="nav-link">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions (Language Selector & CTA - On left on RTL) -->
    <div class="header-actions">
      <!-- Language Selector -->
      <div class="lang-selector" id="lang-selector-container">
        <button
          type="button"
          class="lang-btn"
          id="lang-btn"
          aria-expanded="false"
          aria-haspopup="true"
          aria-label={`${t.language} (Current: ${langLabels[currentLang]})`}
        >
          <!-- Globe SVG Icon -->
          <svg class="icon-globe" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span class="lang-current">{currentLang.toUpperCase()}</span>
          <!-- Chevron Down SVG -->
          <svg class="icon-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>

        <!-- Dropdown Menu -->
        <div class="lang-dropdown" id="lang-dropdown" role="menu" aria-label={t.language}>
          <ul class="lang-list">
            {languages.map((lang) => {
              const isCurrent = lang.code === currentLang;
              return (
                <li role="none">
                  <a
                    href={lang.href}
                    class={`lang-option ${isCurrent ? 'active' : ''}`}
                    role="menuitem"
                    aria-current={isCurrent ? "true" : undefined}
                  >
                    <span class="lang-name">{lang.name}</span>
                    <span class={`lang-badge ${lang.isLive ? 'live' : 'preview'}`}>
                      {lang.status}
                    </span>
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      </div>

      <!-- Prominent Pill CTA -->
      <a href={requestOpinionHref} class="btn-primary header-cta">
        {t.requestOpinion}
      </a>

      <!-- Mobile Hamburger / Close Toggle Button -->
      <button
        type="button"
        id="mobile-nav-toggle"
        class="mobile-nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
        aria-label={t.menu}
      >
        <span class="hamburger-box">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </span>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-nav-drawer"
    class="mobile-nav-drawer"
    aria-hidden="true"
  >
    <div class="mobile-nav-backdrop" id="mobile-nav-backdrop"></div>
    <div class="mobile-nav-panel">
      <div class="mobile-nav-header">
        <a href={homeHref} class="mobile-logo-link" aria-label={`Nuhavi Health - Home (${langLabels[currentLang]})`}>
          <img
            src="/images/nuhavi-logo.svg"
            alt="Nuhavi Health"
            class="mobile-logo-img"
            width="144"
            height="30"
          />
        </a>
        <button
          type="button"
          id="mobile-nav-close"
          class="mobile-close-btn"
          aria-label={t.close}
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav class="mobile-nav-links" aria-label="Mobile navigation">
        <ul class="mobile-links-list">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="mobile-link">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Mobile Language Section -->
      <div class="mobile-lang-section">
        <span class="mobile-section-label">{t.language}</span>
        <div class="mobile-lang-options">
          {languages.map((lang) => {
            const isCurrent = lang.code === currentLang;
            return (
              <a
                href={lang.href}
                class={`mobile-lang-item ${isCurrent ? 'active' : ''}`}
                aria-current={isCurrent ? "true" : undefined}
              >
                <span class="lang-text">{lang.name}</span>
                <span class={`lang-badge ${lang.isLive ? 'live' : 'preview'}`}>
                  {lang.status}
                </span>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Mobile CTA -->
      <div class="mobile-cta-container">
        <a href={requestOpinionHref} class="btn-primary mobile-cta">
          {t.requestOpinion}
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* --------------------------------------------------------------------------
     HEADER CONTAINER & BASE
     -------------------------------------------------------------------------- */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: var(--color-paper);
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
    transition: background-color 0.2s ease;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
    gap: clamp(8px, 1.2vw, 20px);
    max-width: 1360px;
  }

  @media (max-width: 480px) {
    .header-container {
      height: 72px;
    }
  }

  /* Logo (Default Left in LTR) */
  .header-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 0.15s ease;
  }

  .header-logo:hover {
    opacity: 0.85;
  }

  .header-logo-img {
    display: block;
    height: 34px;
    width: auto;
    max-width: 170px;
    object-fit: contain;
  }

  @media (max-width: 480px) {
    .header-logo-img {
      height: 28px;
      max-width: 140px;
    }
  }

  .mobile-logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .mobile-logo-img {
    display: block;
    height: 30px;
    width: auto;
    object-fit: contain;
  }

  /* --------------------------------------------------------------------------
     DESKTOP NAVIGATION
     -------------------------------------------------------------------------- */
  .desktop-nav {
    display: none;
    flex: 1 1 auto;
    margin: 0 clamp(4px, 0.8vw, 16px);
  }

  @media (min-width: 1200px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 1.1vw, 20px);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    display: inline-flex;
  }

  .nav-link {
    font-family: var(--font-family-base);
    font-size: clamp(0.84rem, 0.88vw, 0.9375rem);
    font-weight: var(--font-weight-subheading);
    color: var(--color-navy);
    text-decoration: none;
    padding: 6px clamp(3px, 0.4vw, 8px);
    position: relative;
    transition: color 0.15s ease;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: var(--color-gold-text);
  }

  /* --------------------------------------------------------------------------
     HEADER ACTIONS (Language & CTA)
     -------------------------------------------------------------------------- */
  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  /* Language Selector */
  .lang-selector {
    position: relative;
  }

  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 var(--space-2);
    background-color: transparent;
    border: 1px solid rgba(20, 41, 75, 0.15);
    border-radius: var(--radius-pill);
    color: var(--color-deep-navy);
    font-family: var(--font-family-base);
    font-size: 0.875rem;
    font-weight: var(--font-weight-subheading);
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .lang-btn:hover {
    border-color: var(--color-navy);
    background-color: var(--color-mist);
  }

  .icon-globe {
    color: var(--color-gold);
    flex-shrink: 0;
    pointer-events: none;
  }

  .icon-chevron {
    color: var(--color-slate);
    transition: transform 0.2s ease;
    pointer-events: none;
  }

  .lang-current {
    pointer-events: none;
  }

  .lang-btn[aria-expanded="true"] .icon-chevron,
  .lang-selector.is-open .icon-chevron {
    transform: rotate(180deg);
  }

  /* Language Dropdown */
  .lang-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 200px;
    background-color: var(--color-paper);
    border-radius: var(--radius-card);
    border: 1px solid rgba(20, 41, 75, 0.12);
    box-shadow: 0 10px 25px -5px rgba(20, 41, 75, 0.15);
    z-index: 1010;
    padding: var(--space-1);
    pointer-events: auto;
  }

  .lang-dropdown.open,
  .lang-selector.is-open .lang-dropdown,
  .lang-btn[aria-expanded="true"] + .lang-dropdown {
    display: block !important;
  }

  .lang-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
  }

  .lang-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-1) var(--space-2);
    border-radius: calc(var(--radius-card) - 4px);
    font-size: 0.875rem;
    color: var(--color-ink);
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .lang-name,
  .lang-badge {
    pointer-events: none;
  }

  .lang-option:hover {
    background-color: var(--color-mist);
    color: var(--color-deep-navy);
  }

  .lang-option.active {
    font-weight: var(--font-weight-subheading);
    color: var(--color-deep-navy);
    background-color: rgba(20, 41, 75, 0.05);
  }

  .lang-badge {
    font-size: 0.6875rem;
    font-weight: var(--font-weight-subheading);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 2px 6px;
    border-radius: var(--radius-pill);
    line-height: 1.2;
  }

  .lang-badge.live {
    background-color: rgba(38, 115, 77, 0.1);
    color: var(--color-success);
    border: 1px solid rgba(38, 115, 77, 0.3);
  }

  .lang-badge.preview {
    background-color: var(--color-confirmation);
    color: var(--color-gold-text);
    border: 1px solid rgba(196, 154, 60, 0.3);
  }

  /* Desktop Header CTA */
  .header-cta {
    display: none;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (min-width: 1200px) {
    .header-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 40px;
      font-size: 0.875rem;
      font-weight: var(--font-weight-subheading);
      padding: 0 clamp(14px, 1.2vw, 22px);
      border-radius: var(--radius-pill);
      line-height: 1;
    }
  }

  /* --------------------------------------------------------------------------
     MOBILE NAVIGATION TOGGLE
     -------------------------------------------------------------------------- */
  .mobile-nav-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: transparent;
    border: 1px solid rgba(20, 41, 75, 0.12);
    border-radius: var(--radius-pill);
    cursor: pointer;
    padding: 0;
    color: var(--color-deep-navy);
    flex-shrink: 0;
  }

  .mobile-nav-toggle:hover {
    background-color: var(--color-mist);
  }

  @media (min-width: 1200px) {
    .mobile-nav-toggle {
      display: none;
    }
  }

  .hamburger-box {
    width: 22px;
    height: 16px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hamburger-line {
    width: 100%;
    height: 2px;
    background-color: var(--color-deep-navy);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  /* --------------------------------------------------------------------------
     MOBILE NAVIGATION DRAWER
     -------------------------------------------------------------------------- */
  .mobile-nav-drawer {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 2000;
  }

  .mobile-nav-drawer.open {
    display: block;
  }

  .mobile-nav-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(13, 27, 51, 0.5);
    backdrop-filter: blur(2px);
  }

  .mobile-nav-panel {
    position: absolute;
    top: 0;
    right: 0;
    width: 100%;
    max-width: min(340px, 88vw);
    height: 100%;
    background-color: var(--color-paper);
    display: flex;
    flex-direction: column;
    padding: var(--space-4) var(--space-3);
    overflow-y: auto;
    box-shadow: -5px 0 25px rgba(20, 41, 75, 0.15);
    animation: slideInRight 0.25s ease-out;
  }

  @keyframes slideInRight {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(0);
    }
  }

  .mobile-nav-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
  }

  .mobile-logo {
    font-size: 1.25rem;
    font-weight: var(--font-weight-heading);
    color: var(--color-deep-navy);
  }

  .mobile-close-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: none;
    border-radius: var(--radius-pill);
    color: var(--color-slate);
    cursor: pointer;
  }

  .mobile-close-btn:hover {
    color: var(--color-navy);
    background-color: var(--color-mist);
  }

  .mobile-nav-links {
    margin-bottom: var(--space-4);
  }

  .mobile-links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
  }

  .mobile-link {
    display: block;
    padding: var(--space-1) 0;
    font-size: 1.0625rem;
    font-weight: var(--font-weight-subheading);
    color: var(--color-navy);
    text-decoration: none;
  }

  .mobile-link:hover {
    color: var(--color-gold-text);
  }

  /* Mobile Language Section */
  .mobile-lang-section {
    padding-top: var(--space-3);
    border-top: 1px solid rgba(20, 41, 75, 0.08);
    margin-bottom: var(--space-4);
  }

  .mobile-section-label {
    display: block;
    font-size: 0.75rem;
    font-weight: var(--font-weight-subheading);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-slate);
    margin-bottom: var(--space-2);
  }

  .mobile-lang-options {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .mobile-lang-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-1) 0;
    font-size: 0.9375rem;
    color: var(--color-ink);
    text-decoration: none;
  }

  .mobile-lang-item.active {
    font-weight: var(--font-weight-subheading);
    color: var(--color-deep-navy);
  }

  /* Mobile CTA */
  .mobile-cta-container {
    margin-top: auto;
    padding-top: var(--space-4);
  }

  .mobile-cta {
    width: 100%;
    text-align: center;
  }

  /* --------------------------------------------------------------------------
     RTL (RIGHT-TO-LEFT) ARABIC MIRRORING SUPPORT (PDF Page 40)
     -------------------------------------------------------------------------- */
  :global([dir="rtl"]) .header-container {
    flex-direction: row;
  }

  :global([dir="rtl"]) .header-logo {
    order: 1; /* First in RTL -> positioned on Right */
  }

  :global([dir="rtl"]) .desktop-nav {
    order: 2; /* Center in RTL */
  }

  :global([dir="rtl"]) .header-actions {
    order: 3; /* Last in RTL -> positioned on Left */
  }

  :global([dir="rtl"]) .lang-dropdown {
    right: auto;
    left: 0;
  }

  :global([dir="rtl"]) .mobile-nav-panel {
    right: auto;
    left: 0;
    box-shadow: 5px 0 25px rgba(20, 41, 75, 0.15);
    animation-name: slideInLeft;
  }

  @keyframes slideInLeft {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(0);
    }
  }
</style>

<script>
  function setupHeader() {
    // --- Language Dropdown ---
    const langBtn = document.getElementById('lang-btn');
    const langDropdown = document.getElementById('lang-dropdown');
    const langContainer = document.getElementById('lang-selector-container');

    if (langBtn && langDropdown && !(langBtn as any).__langInitialized) {
      (langBtn as any).__langInitialized = true;

      function openLangDropdown() {
        langDropdown?.classList.add('open');
        langContainer?.classList.add('is-open');
        langBtn?.setAttribute('aria-expanded', 'true');
      }

      function closeLangDropdown() {
        langDropdown?.classList.remove('open');
        langContainer?.classList.remove('is-open');
        langBtn?.setAttribute('aria-expanded', 'false');
      }

      function toggleLangDropdown(e: Event) {
        e.preventDefault();
        e.stopPropagation();
        const isOpen = langDropdown?.classList.contains('open') || langBtn?.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          closeLangDropdown();
        } else {
          openLangDropdown();
        }
      }

      langBtn.addEventListener('click', toggleLangDropdown);

      // Close when clicking outside
      document.addEventListener('click', (e) => {
        if (langContainer && !langContainer.contains(e.target as Node)) {
          closeLangDropdown();
        }
      });

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeLangDropdown();
        }
      });
    }

    // --- Mobile Drawer ---
    const mobileToggle = document.getElementById('mobile-nav-toggle');
    const mobileDrawer = document.getElementById('mobile-nav-drawer');
    const mobileClose = document.getElementById('mobile-nav-close');
    const mobileBackdrop = document.getElementById('mobile-nav-backdrop');
    const mobileLinks = document.querySelectorAll('.mobile-link, .mobile-cta');

    if (mobileToggle && !(mobileToggle as any).__drawerInitialized) {
      (mobileToggle as any).__drawerInitialized = true;

      function openMobileDrawer() {
        if (!mobileDrawer) return;
        mobileDrawer.classList.add('open');
        mobileDrawer.setAttribute('aria-hidden', 'false');
        mobileToggle?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        mobileClose?.focus();
      }

      function closeMobileDrawer() {
        if (!mobileDrawer) return;
        mobileDrawer.classList.remove('open');
        mobileDrawer.setAttribute('aria-hidden', 'true');
        mobileToggle?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        mobileToggle?.focus();
      }

      mobileToggle.addEventListener('click', openMobileDrawer);
      mobileClose?.addEventListener('click', closeMobileDrawer);
      mobileBackdrop?.addEventListener('click', closeMobileDrawer);

      // Close when navigating via a link in the mobile drawer
      mobileLinks.forEach((link) => {
        link.addEventListener('click', closeMobileDrawer);
      });

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mobileDrawer?.classList.contains('open')) {
          closeMobileDrawer();
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupHeader);
  } else {
    setupHeader();
  }
  document.addEventListener('astro:page-load', setupHeader);
</script>
