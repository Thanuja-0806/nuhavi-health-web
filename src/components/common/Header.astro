      box-shadow: 0 4px 12px rgba(15, 35, 64, 0.2);
    }
  }

  /* --------------------------------------------------------------------------
     MOBILE MENU BUTTON (Visible < 1200px)
     -------------------------------------------------------------------------- */
  .mobile-nav-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    min-height: 44px;
    background: transparent;
    border: 1px solid #CBD5E1;
    border-radius: 999px;
    font-family: var(--font-family-base);
    font-size: 0.8125rem;
    font-weight: 700;
    color: #14294B;
    cursor: pointer;
  }

  @media (min-width: 1200px) {
    .mobile-nav-toggle {
      display: none;
    }
  }

  /* --------------------------------------------------------------------------
     MOBILE DRAWER
     -------------------------------------------------------------------------- */
  .mobile-nav-drawer {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2000;
  }

  .mobile-nav-drawer.open {
    display: block;
  }

  .mobile-nav-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(13, 27, 51, 0.5);
    backdrop-filter: blur(2px);
  }

  .mobile-nav-panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    max-width: 380px;
    background-color: #FFFFFF;
    box-shadow: -8px 0 32px rgba(13, 27, 51, 0.2);
    display: flex;
    flex-direction: column;
    padding: 20px;
    overflow-y: auto;
    box-sizing: border-box;
  }

  .mobile-nav-header {
    display: flex;
