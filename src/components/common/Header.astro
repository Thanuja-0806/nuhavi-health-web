---
/**
 * Header.astro
 * Global navigation header for Nuhavi Health.
 * PRIMARY SOURCE OF TRUTH: Nuhavi Health — Website Look & Feel — 30 October 2026.pdf (Pages 4, 5, 11, etc.)
 *
 * Features:
 * - Professional clean white header with Nuhavi crest logo and wordmark.
 * - Navigation links (Manrope 600, #14294B): Treatments, Hospitals, How it works, Countries, Stories, Resources, About, Contact.
 * - Active state: subtle 2px gold underline (#C49A3C).
 * - Language switcher dropdown (English, Russian, Arabic, French) with globe icon.
 * - Navy primary CTA pill button (#14294B): "Request a medical opinion" (radius 999px, no arrows).
 * - Responsive menu toggle below 1200px with full mobile drawer.
 * - Preserves working language routes, dropdown behavior, and WAI-ARIA accessibility.
 */
import { translations, type SupportedLang } from '../../i18n/translations';
import { specialtiesList } from '../../data/specialtyData';
import SpecialtyIcon from './SpecialtyIcon.astro';

interface Props {
  currentLang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : currentPath.startsWith('/fr')
  ? 'fr'
  : 'en';

const currentLang: SupportedLang = Astro.props.currentLang || detectedLang;
const t = translations[currentLang].nav;

const prefix = `/${currentLang}`;
const homeHref = `${prefix}/`;
const requestOpinionHref = `${prefix}/request-opinion/`;
const contactHref = `${prefix}/contact/`;
const treatmentsIndexHref = `${prefix}/treatments/`;
const storiesHref = `${prefix}/stories/`;
const aboutHref = `${prefix}/about/`;

const isArabic = currentLang === 'ar';
const isRussian = currentLang === 'ru';
const isFrench = currentLang === 'fr';

const isHomePage =
  currentPath === '/' ||
  currentPath === '/en/' ||
  currentPath === '/ru/' ||
  currentPath === '/ar/' ||
  currentPath === '/fr/' ||
  currentPath === '/en' ||
  currentPath === '/ru' ||
  currentPath === '/ar' ||
  currentPath === '/fr';

const targetSpecialtySlugs = [
  'oncology',
  'orthopaedics',
  'nephrology-urology',
  'cardiac-sciences',
  'neurosciences',
  'gastroenterology',
  'organ-transplants',
  'fertility',
];

const acceptingSpecialties = specialtiesList.filter(
  (s) => s.status === 'accepting' && targetSpecialtySlugs.includes(s.slug)
);
const onRequestSpecialties = specialtiesList.filter(
  (s) => s.status === 'on-request' && targetSpecialtySlugs.includes(s.slug)
);
const isTreatmentsActive = currentPath.includes('/treatments');
const isSpecialtiesActive = currentPath.includes('/knowledge-centre/') && currentPath !== '/en/knowledge-centre/';

const headerSpecialties = [
  // Left Column (1-8) matching approved mockup
  { slug: 'cardiology', name: 'Cardiology', image: '/images/specialties/cardiology.jpg', hubHref: '/en/knowledge-centre/cardiology/' },
  { slug: 'oncology', name: 'Oncology', image: '/images/specialties/oncology.jpg', hubHref: '/en/knowledge-centre/oncology/' },
  { slug: 'neurology', name: 'Neurology', image: '/images/specialties/neurology.jpg', hubHref: '/en/knowledge-centre/neurology/' },
  { slug: 'orthopedics', name: 'Orthopedics', image: '/images/specialties/orthopedics.jpg', hubHref: '/en/knowledge-centre/orthopedics/' },
  { slug: 'spine-surgery', name: 'Spine Surgery', image: '/images/specialties/spine-surgery.jpg', hubHref: '/en/knowledge-centre/spine-surgery/' },
  { slug: 'hair-transplantation', name: 'Hair Transplantation', image: '/images/specialties/hair-transplantation.jpg', hubHref: '/en/knowledge-centre/hair-transplantation/' },
  { slug: 'weight-loss-surgery', name: 'Weight Loss Surgery', image: '/images/specialties/weight-loss-surgery.jpg', hubHref: '/en/knowledge-centre/weight-loss-surgery/' },
  { slug: 'ivf', name: 'IVF & Reproductive Medicine', image: '/images/specialties/ivf.jpg', hubHref: '/en/knowledge-centre/ivf/' },
  // Right Column (9-15) matching approved mockup
  { slug: 'bone-marrow-transplant', name: 'Bone Marrow Transplant', image: '/images/specialties/bone-marrow-transplant.jpg', hubHref: '/en/knowledge-centre/bone-marrow-transplant/' },
  { slug: 'kidney-transplant', name: 'Kidney Transplant', image: '/images/specialties/kidney-transplant.jpg', hubHref: '/en/knowledge-centre/kidney-transplant/' },
  { slug: 'liver-transplant', name: 'Liver Transplant', image: '/images/specialties/liver-transplant.jpg', hubHref: '/en/knowledge-centre/liver-transplant/' },
  { slug: 'dental-care', name: 'Dental Care', image: '/images/specialties/dental-care.jpg', hubHref: '/en/knowledge-centre/dental-care/' },
  { slug: 'ayush-wellness', name: 'AYUSH Wellness', image: '/images/specialties/ayush-wellness.jpg', hubHref: '/en/knowledge-centre/ayush-wellness/' },
  { slug: 'general-surgery', name: 'General Surgery', image: '/images/specialties/general-surgery.jpg', hubHref: '/en/knowledge-centre/general-surgery/' },
  { slug: 'cosmetic-surgery', name: 'Cosmetic & Plastic Surgery', image: '/images/specialties/cosmetic-surgery.jpg', hubHref: '/en/knowledge-centre/cosmetic-surgery/' },
];

const videosHref = currentLang === 'en' ? '/en/videos/' : `${prefix}/videos/`;

const navLinks = [
  { label: t.specialties, href: '/en/knowledge-centre/', isSpecialtiesDropdown: true },
  { label: t.hospitals, href: '/en/hospitals/' },
  { label: t.doctors, href: '/en/doctors/' },
  { label: t.cost, href: currentLang === 'en' ? '/en/cost/' : `${prefix}/how-it-works/costs-and-fees/` },
  { label: isArabic ? 'القوافل الطبية' : isRussian ? 'Медицинские миссии' : 'Medical camps', href: '/en/medical-camps/' },
  { label: t.stories, href: storiesHref },
  { label: t.resources, href: '/en/knowledge-centre/' },
  { label: t.videos, href: videosHref },
  { label: t.about, href: aboutHref },
];

/**
 * Resolves the equivalent page URL in targetLang for the current route.
 */
function getEquivalentRoute(targetLang: SupportedLang, path: string): string {
  const normalized = path.replace(/^\/(en|ru|ar|fr)(\/|$)/, '').replace(/^\/+|\/+$/g, '');

  if (targetLang === 'en') {
    return normalized ? `/en/${normalized}/` : '/en/';
  }

  const sharedRoutes = [
    '',
    'about',
    'contact',
    'how-it-works/costs-and-fees',
    'medical-camps',
    'request-opinion',
    'resources',
    'stories',
    'treatments',
    'videos',
  ];

  if (sharedRoutes.includes(normalized)) {
    return normalized ? `/${targetLang}/${normalized}/` : `/${targetLang}/`;
  }

  const specialtySlugs = [
    'oncology',
    'orthopaedics',
    'cardiac-sciences',
    'neurosciences',
    'organ-transplants',
    'spine-surgery',
    'gastroenterology',
    'nephrology-urology',
    'fertility',
    'ophthalmology',
  ];

  for (const slug of specialtySlugs) {
    if (normalized === `treatments/${slug}`) {
      return `/${targetLang}/treatments/${slug}/`;
    }
  }

  if (normalized.startsWith('treatments/oncology/')) {
    return `/${targetLang}/treatments/oncology/`;
  }

  if (normalized === 'request-opinion') {
    if (targetLang === 'ru') {
      return '/ru/request-opinion/';
    }
    return `/${targetLang}/`;
  }

  return `/${targetLang}/`;
}

const languages = [
  {
    code: 'en' as SupportedLang,
    name: 'English',
    nativeName: 'English',
    shortLabel: 'EN',
    href: getEquivalentRoute('en', currentPath),
  },
  {
    code: 'ru' as SupportedLang,
    name: 'Russian',
    nativeName: 'Русский',
    shortLabel: 'RU',
    href: getEquivalentRoute('ru', currentPath),
  },
  {
    code: 'ar' as SupportedLang,
    name: 'Arabic',
    nativeName: 'العربية',
    shortLabel: 'AR',
    href: getEquivalentRoute('ar', currentPath),
  },
  {
    code: 'fr' as SupportedLang,
    name: 'French',
    nativeName: 'Français',
    shortLabel: 'FR',
    href: getEquivalentRoute('fr', currentPath),
  },
];

const currentLangItem = languages.find((l) => l.code === currentLang) || languages[0];

const langLabels: Record<SupportedLang, string> = {
  en: 'English',
  ru: 'Русский',
  ar: 'العربية',
  fr: 'Français',
};
---

<header class="site-header">
  <!-- Top Utility Bar (12-Page Approved PDF Page 2) -->
  <div class="header-top-bar">
    <div class="container top-bar-container">
      <div class="top-bar-left">
        <nav class="top-languages" aria-label={t.language}>
          {languages.map((l, index) => (
            <span class="top-lang-entry">
              <a
                href={l.href}
                class={`top-lang-link ${l.code === currentLang ? 'is-active' : ''}`}
                lang={l.code}
                dir={l.code === 'ar' ? 'rtl' : 'ltr'}
              >
                {l.nativeName}
              </a>
              {index < languages.length - 1 && <span class="lang-divider" aria-hidden="true">|</span>}
            </span>
          ))}
        </nav>
      </div>
      <div class="top-bar-right">
        <a href="/en/doctors/" class="top-bar-link">
          {isArabic ? 'للأطباء المحولين' : isRussian ? 'Для направляющих врачей' : isFrench ? 'Pour les médecins référents' : 'For referring doctors'}
        </a>
        <span class="top-bar-divider" aria-hidden="true">·</span>
        <a href="/en/hospitals/" class="top-bar-link">
          {isArabic ? 'للمستشفيات' : isRussian ? 'Для больниц' : isFrench ? 'Pour les hôpitaux' : 'For hospitals'}
        </a>
        <span class="top-bar-divider" aria-hidden="true">·</span>
        <a href="https://wa.me/919999999999" class="top-bar-whatsapp" target="_blank" rel="noopener noreferrer">
          <svg class="whatsapp-icon" width="13" height="13" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.06-2.146-.541-1.859-.77-3.053-2.659-3.146-2.783-.092-.124-.755-1.004-.755-1.916 0-.912.478-1.36.648-1.533.17-.173.371-.217.495-.217.124 0 .248 0 .356.006.114.006.265-.043.414.316.155.372.531 1.298.577 1.392.046.093.078.202.016.326-.062.124-.093.202-.186.31-.093.109-.196.243-.28.326-.093.093-.19.195-.082.381.109.186.483.796 1.037 1.289.713.636 1.314.833 1.5.925.186.093.295.078.404-.047.109-.124.465-.541.59-.727.124-.186.248-.155.418-.093.17.062 1.083.511 1.269.604.186.093.31.14.356.217.046.077.046.45-.098.855z"/>
          </svg>
          <span>WhatsApp [WhatsApp number]</span>
        </a>
        <span class="top-bar-divider" aria-hidden="true">·</span>
        <span class="top-bar-note">
          {isArabic ? 'الرد خلال يوم عمل واحد' : isRussian ? 'Ответ в течение 1 рабочего дня' : isFrench ? 'Réponse sous 1 jour ouvré' : 'Coordinators reply within 1 working day'}
        </span>
      </div>
    </div>
  </div>

  <div class="header-main-row">
    <div class="container header-container">
      <!-- Brand Logo (12-Page Approved PDF Page 1) -->
      <a href={homeHref} class="header-logo" aria-label={`Nuhavi Health - Home (${langLabels[currentLang]})`}>
        <div class="brand-crest" aria-hidden="true">
          <svg class="crest-svg" width="36" height="36" viewBox="0 0 36 36" fill="none">
            <rect width="36" height="36" rx="6" fill="#0F2340" />
            <path d="M10 26V10L26 26V10" stroke="#A88B5A" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <div class="brand-wordmark">
          <div class="brand-name-row">
            <span class="logo-name">NUHAVI</span>
            <span class="logo-suffix">HEALTH</span>
          </div>
          <span class="brand-tagline">Clarity before you travel. Care until you're home.</span>
        </div>
      </a>

      <!-- Desktop Navigation Links (Visible >= 1200px) -->
      <nav class="desktop-nav" aria-label={t.menu}>
        <ul class="nav-list">
          {navLinks.map((link) => {
            if (link.isDropdown) {
              return (
                <li class="nav-item has-dropdown" id="treatments-nav-item">
                  <button
                    type="button"
                    class={`nav-link treatments-trigger ${isTreatmentsActive ? 'is-active' : ''}`}
                    id="treatments-menu-btn"
                    aria-expanded="false"
                    aria-haspopup="true"
                    aria-controls="treatments-dropdown-panel"
                    aria-label={t.treatmentsMenuAria}
                  >
                    <span>{link.label}</span>
                    <svg class="icon-chevron treatments-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </button>

                  <!-- Desktop Treatments Dropdown Menu -->
                  <div
                    class="treatments-dropdown"
                    id="treatments-dropdown-panel"
                    role="region"
                    aria-label={t.treatmentsMenuAria}
                  >
                    <div class="treatments-dropdown-inner">
                      <div class="dropdown-columns-wrap">
                        <!-- Column 1: Accepting Enquiries (2) -->
                        <div class="dropdown-col col-accepting">
                          <div class="group-header">
                            <span class="group-badge badge-accepting">
                              <span class="badge-dot" aria-hidden="true">●</span>
                              {t.acceptingGroupLabel}
                            </span>
                          </div>
                          <div class="group-cards">
                            {acceptingSpecialties.map((spec) => {
                              const item = spec.content[currentLang];
                              const href = `${prefix}/treatments/${spec.slug}/`;
                              const isActive = currentPath === href || currentPath.startsWith(href);
                              return (
                                <a href={href} class={`specialty-dropdown-card ${isActive ? 'is-active' : ''}`}>
                                  <span class="card-spec-title">{item.title}</span>
                                  <span class="card-spec-desc">{item.description}</span>
                                </a>
                              );
                            })}
                          </div>
                        </div>

                        <!-- Column 2: On Request (8) -->
                        <div class="dropdown-col col-on-request">
                          <div class="group-header">
                            <span class="group-badge badge-on-request">
                              <span class="badge-dot" aria-hidden="true">○</span>
                              {t.onRequestGroupLabel}
                            </span>
                          </div>
                          <div class="group-grid">
                            {onRequestSpecialties.map((spec) => {
                              const item = spec.content[currentLang];
                              const href = `${prefix}/treatments/${spec.slug}/`;
                              const isActive = currentPath === href || currentPath.startsWith(href);
                              return (
                                <a href={href} class={`specialty-dropdown-link ${isActive ? 'is-active' : ''}`}>
                                  <span class="link-spec-bullet" aria-hidden="true">•</span>
                                  <span class="link-spec-text">{item.title}</span>
                                </a>
                              );
                            })}
                          </div>
                        </div>
                      </div>

                      <!-- Bottom Bar: View all treatments overview -->
                      <div class="dropdown-footer-bar">
                        <a href={treatmentsIndexHref} class="view-all-treatments-link">
                          <span>{t.viewAllTreatments}</span>
                          <span aria-hidden="true">&rarr;</span>
                        </a>
                      </div>
                    </div>
                  </div>
                </li>
              );
            }

            if (link.isSpecialtiesDropdown) {
              return (
                <li class="nav-item has-dropdown" id="specialties-nav-item">
                  <button
                    type="button"
                    class={`nav-link specialties-trigger ${isSpecialtiesActive ? 'is-active' : ''}`}
                    id="specialties-menu-btn"
                    aria-expanded="false"
                    aria-haspopup="true"
                    aria-controls="specialties-dropdown-panel"
                    aria-label={t.specialtiesMenuAria}
                  >
                    <span>{link.label}</span>
                    <svg class="icon-chevron specialties-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </button>

                  <!-- Desktop Specialties Mega Dropdown Panel (2-Column Layout matching visual reference) -->
                  <div
                    class="specialties-dropdown"
                    id="specialties-dropdown-panel"
                    role="region"
                    aria-label={t.specialtiesMenuAria}
                  >
                    <div class="specialties-dropdown-inner">
                      <ul class="specialties-grid-list">
                        {headerSpecialties.map((spec) => {
                          const isActive = currentPath === spec.hubHref || currentPath.startsWith(spec.hubHref);
                          return (
                            <li>
                              <a href={spec.hubHref} class={`specialty-dropdown-link ${isActive ? 'is-active' : ''}`}>
                                <span class="spec-thumb-box">
                                  <img
                                    src={spec.image}
                                    alt={spec.name}
                                    class="spec-thumb-img"
                                    width="36"
                                    height="36"
                                    loading="lazy"
                                  />
                                </span>
                                <span class="spec-label">{spec.name}</span>
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  </div>
                </li>
              );
            }

            const isActive = currentPath === link.href || (link.href !== '/en/' && currentPath.startsWith(link.href));
            return (
              <li class="nav-item">
                <a href={link.href} class={`nav-link ${isActive ? 'is-active' : ''}`}>
                  {link.label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <!-- Header Actions: Search & CTA Button -->
      <div class="header-actions">
        <!-- Search Trigger Icon (PDF Page 2) -->
        <a href={treatmentsIndexHref} class="header-search-btn" aria-label="Search treatments or conditions">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </a>

        <!-- Prominent Navy CTA (Desktop >= 1200px, hidden on homepage per request) -->
        {!isHomePage && (
          <a href={requestOpinionHref} class="header-opinion-btn">
            {t.requestOpinion}
          </a>
        )}

        <!-- Mobile / Tablet Menu Button (Visible < 1200px) -->
        <button
          type="button"
          id="mobile-nav-toggle"
          class="mobile-nav-toggle"
          aria-expanded="false"
          aria-controls="mobile-nav-drawer"
          aria-label={t.menu}
        >
          <svg class="menu-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <span class="menu-label">{t.menu}</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div
    id="mobile-nav-drawer"
    class="mobile-nav-drawer"
    aria-hidden="true"
  >
    <div class="mobile-nav-backdrop" id="mobile-nav-backdrop"></div>
    <div class="mobile-nav-panel">
      <div class="mobile-nav-header">
        <a href={homeHref} class="header-logo" aria-label="Nuhavi Health - Home">
          <div class="brand-crest" aria-hidden="true">
            <svg class="crest-svg" width="30" height="30" viewBox="0 0 36 36" fill="none">
              <rect width="36" height="36" rx="6" fill="#0F2340" />
              <path d="M10 26V10L26 26V10" stroke="#A88B5A" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <div class="brand-wordmark">
            <div class="brand-name-row">
              <span class="logo-name">NUHAVI</span>
              <span class="logo-suffix">HEALTH</span>
            </div>
          </div>
        </a>
        <button
          type="button"
          id="mobile-nav-close"
          class="mobile-close-btn"
          aria-label={t.close}
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
          <span>{t.close}</span>
        </button>
      </div>

      <nav class="mobile-nav-links" aria-label="Mobile navigation">
        <ul class="mobile-links-list">
          <li>
            <a href={homeHref} class={`mobile-link ${currentPath === homeHref ? 'active' : ''}`}>
              <span>{currentLang === 'ru' ? 'Главная' : currentLang === 'ar' ? 'الرئيسية' : 'Home'}</span>
            </a>
          </li>

          {navLinks.map((link) => {
            if (link.isDropdown) {
              return (
                <li class="mobile-accordion-item">
                  <button
                    type="button"
                    class={`mobile-link mobile-accordion-toggle ${isTreatmentsActive ? 'active' : ''}`}
                    id="mobile-treatments-toggle"
                    aria-expanded="false"
                    aria-controls="mobile-treatments-submenu"
                  >
                    <span>{link.label}</span>
                    <svg class="accordion-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                  </button>

                  <div
                    id="mobile-treatments-submenu"
                    class="mobile-accordion-submenu"
                    aria-hidden="true"
                  >
                    <div class="mobile-subgroup">
                      <div class="mobile-subgroup-label">
                        <span class="group-badge badge-accepting">
                          <span class="badge-dot" aria-hidden="true">●</span>
                          {t.acceptingGroupLabel}
                        </span>
                      </div>
                      <ul class="mobile-subgroup-list">
                        {acceptingSpecialties.map((spec) => {
                          const item = spec.content[currentLang];
                          const href = `${prefix}/treatments/${spec.slug}/`;
                          const isActive = currentPath === href || currentPath.startsWith(href);
                          return (
                            <li>
                              <a href={href} class={`mobile-sublink ${isActive ? 'active' : ''}`}>
                                <span class="mobile-sublink-title">{item.title}</span>
                              </a>
                            </li>
                          );
                        })}
                      </ul>
                    </div>

                    <div class="mobile-subgroup">
                      <div class="mobile-subgroup-label">
                        <span class="group-badge badge-on-request">
                          <span class="badge-dot" aria-hidden="true">○</span>
                          {t.onRequestGroupLabel}
                        </span>
                      </div>
                      <ul class="mobile-subgroup-list">
                        {onRequestSpecialties.map((spec) => {
                          const item = spec.content[currentLang];
                          const href = `${prefix}/treatments/${spec.slug}/`;
                          const isActive = currentPath === href || currentPath.startsWith(href);
                          return (
