---
/**
 * Footer.astro
 * Global footer for Nuhavi Health.
 * Features the brand wordmark, clear description of the coordination role,
 * logically grouped navigation links, mandatory legal links, and a dynamic copyright year.
 * Complies strictly with zero invented claims, addresses, phone numbers, or social media handles.
 *
 * Fully localized for English (/en/), Russian (/ru/), and Arabic (/ar/ RTL).
 */
import { translations, type SupportedLang } from '../../i18n/translations';

interface Props {
  currentLang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : 'en';

const currentLang: SupportedLang = Astro.props.currentLang || detectedLang;
const t = translations[currentLang].footer;
const tNav = translations[currentLang].nav;

const prefix = `/${currentLang}`;
const homeHref = `${prefix}/`;
const contactHref = `${prefix}/contact/`;

const currentYear = new Date().getFullYear();

const coordinationLinks = [
  { label: tNav.treatments, href: '/en/treatments' },
  { label: tNav.hospitals, href: '/en/hospitals' },
  { label: tNav.howItWorks, href: '/en/how-it-works' },
  { label: tNav.countries, href: '/en/countries' },
];

const companyLinks = [
  { label: t.aboutHeading, href: '/en/about' },
  { label: tNav.stories, href: '/en/stories' },
  { label: tNav.resources, href: '/en/resources' },
  { label: tNav.contact, href: contactHref },
];

const legalLinks = [
  { label: t.privacyPolicy, href: '/en/privacy' },
  { label: t.termsConditions, href: '/en/terms' },
  { label: t.disclaimer, href: '/en/disclaimer' },
];
---

<footer class="site-footer">
  <div class="container footer-container">
    <!-- Top Footer: Brand, Coordination Role & Grouped Navigation -->
    <div class="footer-top">
      <!-- Column 1: Brand Wordmark & Neutral Role Description -->
      <div class="footer-brand-col">
        <a href={homeHref} class="footer-logo" aria-label="Nuhavi Health - Home">
          <img
            src="/images/nuhavi-logo-white.svg"
            alt="Nuhavi Health"
            class="footer-logo-img"
            width="162"
            height="34"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="role-description">
          {t.roleDescription}
        </p>
        <p class="disclaimer-callout">
          <strong>{currentLang === 'ru' ? 'Внимание:' : currentLang === 'ar' ? 'تنويه:' : 'Notice:'}</strong> {t.disclaimerCallout.replace(/^(Notice:|Внимание:|تنويه:)\s*/, '')}
        </p>
      </div>

      <!-- Column 2: Travel & Coordination Links -->
      <div class="footer-nav-col">
        <h4 class="col-heading">{t.coordinationHeading}</h4>
        <ul class="footer-link-list">
          {coordinationLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Company & Information Links -->
      <div class="footer-nav-col">
        <h4 class="col-heading">{t.aboutHeading}</h4>
        <ul class="footer-link-list">
          {companyLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Legal & Policy Links -->
      <div class="footer-nav-col">
        <h4 class="col-heading">{t.legalHeading}</h4>
        <ul class="footer-link-list">
          {legalLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-link">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Footer: Copyright & Legal Compliance Bar -->
    <div class="footer-bottom">
      <p class="copyright-text">
        {t.copyright(currentYear)}
      </p>
      <div class="footer-bottom-links">
        {legalLinks.map((link) => (
          <a href={link.href} class="bottom-legal-link">
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-deep-navy);
    color: rgba(244, 247, 251, 0.8);
    padding: var(--space-10) 0 var(--space-6);
    border-top: 1px solid rgba(244, 247, 251, 0.1);
    font-family: var(--font-family-base);
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* --------------------------------------------------------------------------
     TOP FOOTER: 4-COLUMN RESPONSIVE GRID
     -------------------------------------------------------------------------- */
  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .footer-top {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .footer-top {
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: var(--space-8);
    }
  }

  /* Column 1: Brand & Role */
  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-logo {
    text-decoration: none;
    display: inline-block;
    transition: opacity 0.15s ease;
  }

  .footer-logo:hover {
    opacity: 0.85;
  }

  .footer-logo-img {
    display: block;
    height: 34px;
    width: auto;
    max-width: 170px;
    object-fit: contain;
  }

  @media (max-width: 480px) {
    .footer-logo-img {
      height: 28px;
      max-width: 140px;
    }
  }

  .role-description {
    font-size: 0.875rem;
    line-height: var(--line-height-body);
    color: rgba(244, 247, 251, 0.7);
    max-width: 360px;
  }

  .disclaimer-callout {
    font-size: 0.75rem;
    line-height: 1.5;
    color: rgba(244, 247, 251, 0.55);
    background-color: rgba(20, 41, 75, 0.5);
    border-radius: var(--radius-card);
    padding: var(--space-2);
    border-left: 2px solid var(--color-gold);
    max-width: 360px;
  }

  :global([dir="rtl"]) .disclaimer-callout {
    border-left: none;
    border-right: 2px solid var(--color-gold);
  }

  .disclaimer-callout strong {
    color: var(--color-gold);
  }

  /* Navigation Columns */
  .footer-nav-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .col-heading {
    font-size: 0.875rem;
    font-weight: var(--font-weight-subheading);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gold);
    margin-bottom: var(--space-1);
  }

  .footer-link-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
  }

  .footer-link {
    font-size: 0.875rem;
    color: rgba(244, 247, 251, 0.8);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: var(--color-paper);
    text-decoration: underline;
  }

  /* --------------------------------------------------------------------------
     BOTTOM FOOTER: COPYRIGHT & LEGAL ROW
     -------------------------------------------------------------------------- */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(244, 247, 251, 0.08);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .copyright-text {
    font-size: 0.8125rem;
    color: rgba(244, 247, 251, 0.5);
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .bottom-legal-link {
    font-size: 0.8125rem;
    color: rgba(244, 247, 251, 0.6);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .bottom-legal-link:hover {
    color: var(--color-paper);
  }
</style>
