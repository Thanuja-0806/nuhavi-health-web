---
/**
 * src/components/common/SpecialtyIcon.astro
 * Small, clean medical outline icons for the 15 Nuhavi Health specialties.
 * Consistent stroke width, proportions and clinical visual symbols.
 * Supports any requested size (compact 14-16px in cards/chips, 20px default, 48-56px in hero banners).
 */
interface Props {
  icon: string;
  color?: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const {
  icon: rawIcon,
  color = 'currentColor',
  size: requestedSize = 20,
  strokeWidth = 1.8,
  class: className = '',
} = Astro.props;

const size = requestedSize || 20;
const icon = (rawIcon || '').toLowerCase().trim();
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke={color}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`specialty-svg-icon ${className}`}
  aria-hidden="true"
>
  {/* 1. Cardiology – Heart with pulse */}
  {(icon === 'cardiology' || icon === 'heart' || icon === 'cardiac' || icon === 'cardiac-sciences') && (
    <Fragment>
      <path d="M19.5 13.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572" />
      <path d="M7 12h2.5l1.5-3 2 6 1.5-3H17" />
    </Fragment>
  )}

  {/* 2. Oncology – Cancer awareness ribbon */}
  {(icon === 'oncology' || icon === 'ribbon' || icon === 'cancer' || icon === 'cancer-care') && (
    <Fragment>
      <path d="M6 9a6 6 0 0 1 12 0c0 4.5-3.5 8-6 11-2.5-3-6-6.5-6-11Z" />
      <path d="m8 16-2.5 5" />
      <path d="m16 16 2.5 5" />
    </Fragment>
  )}

  {/* 3. Neurology – Brain */}
  {(icon === 'neurology' || icon === 'brain' || icon === 'neuro' || icon === 'neurosciences') && (
    <Fragment>
      <path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z" />
      <path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z" />
      <path d="M12 5v14" />
    </Fragment>
  )}

  {/* 4. Orthopedics – Bone / joint */}
  {(icon === 'orthopedics' || icon === 'orthopaedics' || icon === 'bone' || icon === 'joint') && (
    <path d="M17 10c.7-.7 1.6-1 2.5-1a3.5 3.5 0 1 0 0 7c-.9 0-1.8-.3-2.5-1l-6-6c-.7-.7-1.6-1-2.5-1a3.5 3.5 0 1 0 0 7c.9 0 1.8-.3 2.5-1z" />
  )}

  {/* 5. Spine Surgery – Vertebral spine */}
  {(icon === 'spine-surgery' || icon === 'spine') && (
    <Fragment>
      <line x1="12" y1="2" x2="12" y2="22" />
      <rect x="7" y="4" width="10" height="2.5" rx="1.25" />
      <rect x="6" y="8.5" width="12" height="3" rx="1.5" />
      <rect x="6" y="13.5" width="12" height="3" rx="1.5" />
      <rect x="7" y="18.5" width="10" height="2.5" rx="1.25" />
    </Fragment>
  )}

  {/* 6. Hair Transplantation – Hair follicles */}
  {(icon === 'hair-transplantation' || icon === 'hair') && (
    <Fragment>
      <path d="M3 18h18" stroke-dasharray="2 2" />
      <path d="M7 18c0-5 2-10 5-14" />
      <path d="M12 18c0-4 1.5-8 4-12" />
      <path d="M17 18c0-3 1-6 3-9" />
      <circle cx="7" cy="18.5" r="1.5" />
      <circle cx="12" cy="18.5" r="1.5" />
      <circle cx="17" cy="18.5" r="1.5" />
    </Fragment>
  )}

  {/* 7. Weight Loss Surgery – Stomach */}
  {(icon === 'weight-loss-surgery' || icon === 'bariatric' || icon === 'scale' || icon === 'stomach' || icon === 'bariatric-surgery' || icon === 'weight-loss') && (
    <Fragment>
      <path d="M10 2v3c-2.5 1-4.5 3.5-4.5 7 0 5 4.5 8 8 8 2.5 0 4-1.5 4.5-3 .5-1.5 0-3-1-5l2-2c1.5-1.5 1-4-1-5-2-1-5-1-7-1" />
      <path d="M10 7c-.5 3-.5 6 1 9" stroke-dasharray="1.5 1.5" />
    </Fragment>
  )}

  {/* 8. IVF & Reproductive Medicine – Embryo / fertility symbol */}
  {(icon === 'ivf' || icon === 'fertility' || icon === 'reproductive' || icon.includes('ivf')) && (
    <Fragment>
      <circle cx="12" cy="12" r="9" />
      <circle cx="9.5" cy="11" r="3.5" />
      <circle cx="14.5" cy="13" r="3.5" />
    </Fragment>
  )}

  {/* 9. Bone Marrow Transplant – Bone marrow / blood cell */}
  {(icon === 'bone-marrow-transplant' || icon === 'bmt' || icon === 'stem-cell' || icon === 'blood' || icon === 'organ-transplants') && (
    <Fragment>
      <path d="M12 2.5c0 0-6 6.5-6 11.5a6 6 0 0 0 12 0c0-5-6-11.5-6-11.5z" />
      <circle cx="12" cy="14" r="2.5" />
    </Fragment>
  )}

  {/* 10. Kidney Transplant – Kidneys */}
  {(icon === 'kidney-transplant' || icon === 'kidney' || icon === 'kidneys' || icon === 'nephrology' || icon === 'urology' || icon === 'nephrology-urology') && (
    <Fragment>
      <path d="M6 7c-1.5 0-3 1.5-3 4 0 3 2 4.5 3.5 4.5 1.5 0 1.5-1 1.5-2s-.5-1.5-.5-2.5c0-1.5.5-2.5 1-3C8 7 7 6 6 6z" />
      <path d="M18 7c1.5 0 3 1.5 3 4 0 3-2 4.5-3.5 4.5-1.5 0-1.5-1-1.5-2s.5-1.5.5-2.5c0-1.5-.5-2.5-1-3C16 7 17 6 18 6z" />
      <path d="M8 14.5c0 3 2 5 4 6.5" />
      <path d="M16 14.5c0 3-2 5-4 6.5" />
    </Fragment>
  )}

  {/* 11. Liver Transplant – Liver */}
  {(icon === 'liver-transplant' || icon === 'liver' || icon === 'gastro' || icon === 'gastroenterology') && (
    <Fragment>
      <path d="M4 8.5C5.5 5.5 10.5 4 17 6c2.5.8 3.5 2.5 3.5 4.5 0 4.5-4.5 8.5-10.5 8.5-4.5 0-6.5-2-6.5-5.5 0-1.8.2-3.5.5-5z" />
      <path d="M13 6c-.2 3.5-.8 7.5-1.5 12" stroke-dasharray="1.5 1.5" />
    </Fragment>
  )}

  {/* 12. Dental Care – Tooth */}
  {(icon === 'dental-care' || icon === 'dental' || icon === 'tooth') && (
    <path d="M12 4c-3-1.5-6.5-.5-7 2-.5 3 .5 6 1.5 9 1 3 1.5 5 2.5 5s1.5-2.5 2-5c.5-2 1-2 2-2s1.5 0 2 2c.5 2.5 1 5 2 5s1.5-2 2.5-5c1-3 2-6 1.5-9-.5-2.5-4-3.5-7-2z" />
  )}

  {/* 13. AYUSH Wellness – Medicinal leaf */}
  {(icon === 'ayush-wellness' || icon === 'ayush' || icon === 'leaf' || icon === 'wellness') && (
    <Fragment>
      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10Z" />
      <path d="M2 21c0-3 1.8-5.4 5.1-6C9.5 14.5 12 13 13 12" />
    </Fragment>
  )}

  {/* 14. General Surgery – Surgical scalpel */}
  {(icon === 'general-surgery' || icon === 'surgery' || icon === 'scalpel' || icon === 'laparoscopic') && (
    <Fragment>
      <path d="M19 4L11 12l-1 4 4-1 8-8c.5-.5.5-1.5 0-2l-1-1c-.5-.5-1.5-.5-2 0z" />
      <line x1="4" y1="20" x2="11" y2="13" />
    </Fragment>
  )}

  {/* 15. Cosmetic & Plastic Surgery – Face profile */}
  {(icon === 'cosmetic-surgery' || icon === 'cosmetic' || icon === 'sparkle' || icon === 'plastic' || icon.includes('cosmetic')) && (
    <Fragment>
      <path d="M9 3c2.5 0 3.5 1.2 3.5 3 0 .8-.3 1.5-.8 2.2l2.3 1.6c.6.4.8 1 .8 1.6 0 .8-.5 1.4-1.2 1.6.6.3 1 .9 1 1.6 0 1.6-1.5 3-4.6 3.4H7" />
      <circle cx="9.5" cy="8.5" r="0.8" fill={color} />
    </Fragment>
  )}

  {/* Clean fallback medical cross if unknown */}
  {!['cardiology', 'heart', 'cardiac', 'cardiac-sciences',
     'oncology', 'ribbon', 'cancer', 'cancer-care',
     'neurology', 'brain', 'neuro', 'neurosciences',
     'orthopedics', 'orthopaedics', 'bone', 'joint',
     'spine-surgery', 'spine',
     'hair-transplantation', 'hair',
     'weight-loss-surgery', 'bariatric', 'scale', 'stomach', 'bariatric-surgery', 'weight-loss',
     'ivf', 'fertility', 'reproductive',
     'bone-marrow-transplant', 'bmt', 'stem-cell', 'blood', 'organ-transplants',
     'kidney-transplant', 'kidney', 'kidneys', 'nephrology', 'urology', 'nephrology-urology',
     'liver-transplant', 'liver', 'gastro', 'gastroenterology',
     'dental-care', 'dental', 'tooth',
     'ayush-wellness', 'ayush', 'leaf', 'wellness',
     'general-surgery', 'surgery', 'scalpel', 'laparoscopic',
     'cosmetic-surgery', 'cosmetic', 'sparkle', 'plastic'
    ].includes(icon) && !icon.includes('ivf') && !icon.includes('cosmetic') && (
    <path d="M12 4v16m-8-8h16" />
  )}
</svg>
