---
/**
 * src/components/common/ChatWidget.astro
 * Floating "Chat with us" widget and Care Coordinator modal panel.
 * Reference: Nuhavi Health Look and Feel PDF Pages 2, 38, 39, 41.
 * 
 * Rules:
 * - Floating "Chat with us" button on every page.
 * - Shows Telegram first on Russian/Uzbek pages and /en/countries/uzbekistan/.
 * - Shows WhatsApp first elsewhere (English & African pages).
 * - Clearly warns: "Please do not send medical reports in chat. After your enquiry we email you a private, secure upload link."
 * - No automated chatbot; real person replies during office hours.
 */

// Detect current path to order Telegram vs WhatsApp
const currentPath = Astro.url.pathname;
const isUzbekOrRussian = currentPath.includes('/uzbekistan') || currentPath.startsWith('/ru') || currentPath.startsWith('/uz');
---

<div class="chat-widget-root" id="chat-widget-root" data-uzbek={isUzbekOrRussian ? "true" : "false"}>
  <!-- Chat Panel Flyout (hidden by default) -->
  <div
    class="chat-panel"
    id="chat-panel"
    role="dialog"
    aria-labelledby="chat-panel-title"
    aria-hidden="true"
  >
    <div class="chat-panel-header">
      <div class="chat-header-text">
        <h3 id="chat-panel-title" class="chat-title">Talk to a care coordinator</h3>
        <p class="chat-hours">A coordinator replies during office hours — Monday to Saturday.</p>
      </div>
      <button type="button" class="chat-close-btn" id="chat-panel-close" aria-label="Close chat panel">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="chat-channels-list">
      {isUzbekOrRussian ? (
        <>
          <!-- Telegram First -->
          <a href="/en/contact/" class="channel-card telegram-channel">
            <div class="channel-icon-wrap telegram-bg">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.52 2.77-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
              </svg>
            </div>
            <div class="channel-info">
              <span class="channel-name">Telegram</span>
              <span class="channel-status">Number coming soon — use the contact page</span>
            </div>
          </a>

          <!-- WhatsApp Second -->
          <a href="/en/contact/" class="channel-card whatsapp-channel">
            <div class="channel-icon-wrap whatsapp-bg">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.63C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.3C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.05 7.42C8.88 7.42 8.6 7.49 8.36 7.75C8.12 8.01 7.44 8.64 7.44 9.93C7.44 11.22 8.38 12.46 8.51 12.63C8.65 12.81 10.36 15.45 12.97 16.58C13.6 16.85 14.08 17 14.47 17.13C15.1 17.33 15.67 17.3 16.12 17.23C16.63 17.16 17.67 16.6 17.89 15.98C18.11 15.37 18.11 14.84 18.04 14.73C17.97 14.62 17.79 14.56 17.53 14.43C17.27 14.3 15.99 13.67 15.75 13.58C15.52 13.5 15.35 13.45 15.18 13.71C15 13.97 14.5 14.56 14.35 14.73C14.2 14.9 14.05 14.92 13.79 14.79C13.53 14.67 12.7 14.39 11.71 13.51C10.94 12.83 10.42 11.98 10.27 11.72C10.12 11.47 10.25 11.33 10.38 11.2C10.5 11.08 10.65 10.89 10.78 10.74C10.91 10.59 10.95 10.48 11.04 10.31C11.12 10.14 11.08 9.99 11.02 9.86C10.95 9.74 10.44 8.49 10.23 7.98C10.02 7.48 9.81 7.55 9.66 7.54C9.51 7.54 9.34 7.42 9.05 7.42Z"/>
              </svg>
            </div>
            <div class="channel-info">
              <span class="channel-name">WhatsApp</span>
              <span class="channel-status">Number coming soon — use the contact page</span>
            </div>
          </a>
        </>
      ) : (
        <>
          <!-- WhatsApp First (Default / African pages) -->
          <a href="/en/contact/" class="channel-card whatsapp-channel">
            <div class="channel-icon-wrap whatsapp-bg">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.63C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.3C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.05 7.42C8.88 7.42 8.6 7.49 8.36 7.75C8.12 8.01 7.44 8.64 7.44 9.93C7.44 11.22 8.38 12.46 8.51 12.63C8.65 12.81 10.36 15.45 12.97 16.58C13.6 16.85 14.08 17 14.47 17.13C15.1 17.33 15.67 17.3 16.12 17.23C16.63 17.16 17.67 16.6 17.89 15.98C18.11 15.37 18.11 14.84 18.04 14.73C17.97 14.62 17.79 14.56 17.53 14.43C17.27 14.3 15.99 13.67 15.75 13.58C15.52 13.5 15.35 13.45 15.18 13.71C15 13.97 14.5 14.56 14.35 14.73C14.2 14.9 14.05 14.92 13.79 14.79C13.53 14.67 12.7 14.39 11.71 13.51C10.94 12.83 10.42 11.98 10.27 11.72C10.12 11.47 10.25 11.33 10.38 11.2C10.5 11.08 10.65 10.89 10.78 10.74C10.91 10.59 10.95 10.48 11.04 10.31C11.12 10.14 11.08 9.99 11.02 9.86C10.95 9.74 10.44 8.49 10.23 7.98C10.02 7.48 9.81 7.55 9.66 7.54C9.51 7.54 9.34 7.42 9.05 7.42Z"/>
              </svg>
            </div>
            <div class="channel-info">
              <span class="channel-name">WhatsApp</span>
              <span class="channel-status">Number coming soon — use the contact page</span>
            </div>
          </a>

          <!-- Telegram Second -->
          <a href="/en/contact/" class="channel-card telegram-channel">
            <div class="channel-icon-wrap telegram-bg">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.52 2.77-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/>
              </svg>
            </div>
            <div class="channel-info">
              <span class="channel-name">Telegram</span>
              <span class="channel-status">Number coming soon — use the contact page</span>
            </div>
          </a>
        </>
      )}
    </div>

    <!-- Warning / Privacy Note (PDF Page 38) -->
    <div class="chat-warning-box">
      <p>
        Please do not send medical reports in chat. After your enquiry we email you a private, secure upload link.
      </p>
    </div>
  </div>

  <!-- Floating Pill Trigger Button (PDF Pages 2, 38) -->
  <button
    type="button"
    class="floating-chat-btn"
    id="floating-chat-btn"
    aria-expanded="false"
    aria-controls="chat-panel"
    aria-label="Toggle care coordinator chat"
  >
    <span class="chat-btn-icon" aria-hidden="true">
      <svg class="icon-chat" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
      <svg class="icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </span>
    <span class="chat-btn-label">Chat with us</span>
  </button>
</div>

<style>
  .chat-widget-root {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 999;
    font-family: var(--font-family-base);
  }

  /* Floating Pill Button */
  .floating-chat-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--color-deep-navy);
    color: var(--color-paper);
    padding: 12px 20px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 4px 16px rgba(13, 27, 51, 0.25);
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }

  .floating-chat-btn:hover {
    background-color: var(--color-navy);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(13, 27, 51, 0.35);
  }

  .floating-chat-btn:focus-visible {
    outline: 3px solid var(--color-gold);
    outline-offset: 2px;
  }

  .chat-btn-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .icon-close {
    display: none;
  }

  /* When Chat is Open */
  .chat-widget-root.is-open .icon-chat {
    display: none;
  }

  .chat-widget-root.is-open .icon-close {
    display: inline-block;
  }

  /* Modal / Flyout Panel */
  .chat-panel {
    display: none;
    position: absolute;
    bottom: 60px;
    right: 0;
    width: 320px;
    background-color: var(--color-paper);
    border-radius: var(--radius-card);
    border: 1px solid rgba(20, 41, 75, 0.12);
    box-shadow: 0 12px 32px rgba(13, 27, 51, 0.2);
    padding: var(--space-4);
    box-sizing: border-box;
    animation: slideUpFade 0.2s ease forwards;
  }

  @keyframes slideUpFade {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .chat-widget-root.is-open .chat-panel {
    display: block;
  }

  .chat-panel-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
  }

  .chat-title {
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1.25;
    margin: 0 0 4px;
  }

  .chat-hours {
    font-size: 0.75rem;
    color: var(--color-slate);
    line-height: 1.35;
    margin: 0;
  }

  .chat-close-btn {
    background: none;
    border: none;
    color: var(--color-slate);
    cursor: pointer;
    padding: 2px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chat-close-btn:hover {
    color: var(--color-navy);
    background-color: var(--color-mist);
  }

  /* Channels */
  .chat-channels-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .channel-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid rgba(20, 41, 75, 0.08);
    background-color: var(--color-mist);
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .channel-card:hover {
    background-color: #EBF1F7;
    border-color: rgba(20, 41, 75, 0.18);
  }

  .channel-icon-wrap {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    flex-shrink: 0;
  }

  .telegram-bg {
    background-color: #24A1DE;
  }

  .whatsapp-bg {
    background-color: #25D366;
  }

  .channel-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .channel-name {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-navy);
    line-height: 1.2;
  }

  .channel-status {
    font-size: 0.6875rem;
    color: var(--color-slate);
    line-height: 1.3;
    margin-top: 2px;
  }

  /* Warning Box (PDF Page 38) */
  .chat-warning-box {
    background-color: var(--color-confirmation);
    border: 1px solid var(--color-gold);
    border-radius: 8px;
    padding: 8px 10px;
  }

  .chat-warning-box p {
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--color-ink);
    margin: 0;
  }

  /* Mobile collapsed view (PDF Page 39) */
  @media (max-width: 480px) {
    .chat-widget-root {
      bottom: 16px;
      right: 16px;
    }

    .floating-chat-btn {
      padding: 10px 16px;
    }

    .chat-panel {
      width: calc(100vw - 32px);
      right: 0;
      bottom: 56px;
    }
  }
</style>

<script>
  function setupChatWidget() {
    const root = document.getElementById('chat-widget-root');
    const toggleBtn = document.getElementById('floating-chat-btn');
    const closeBtn = document.getElementById('chat-panel-close');
    const panel = document.getElementById('chat-panel');

    if (!root || !toggleBtn || !panel) return;

    function openChat() {
      root.classList.add('is-open');
      toggleBtn.setAttribute('aria-expanded', 'true');
      panel.setAttribute('aria-hidden', 'false');
    }

    function closeChat() {
      root.classList.remove('is-open');
      toggleBtn.setAttribute('aria-expanded', 'false');
      panel.setAttribute('aria-hidden', 'true');
    }

    toggleBtn.addEventListener('click', () => {
      const isOpen = root.classList.contains('is-open');
      if (isOpen) {
        closeChat();
      } else {
        openChat();
      }
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', closeChat);
    }

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('is-open')) {
        closeChat();
        toggleBtn.focus();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', setupChatWidget);
  setupChatWidget();
</script>

