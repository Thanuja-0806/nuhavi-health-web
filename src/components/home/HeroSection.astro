<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('hero-kc-search-form') as HTMLFormElement | null;
    const treatmentInput = document.getElementById('hero-treatment-input') as HTMLInputElement | null;
    const hospitalInput = document.getElementById('hero-hospital-input') as HTMLInputElement | null;

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const term = (treatmentInput?.value || '').trim() || (hospitalInput?.value || '').trim();
      if (!term) {
        treatmentInput?.focus();
        return;
      }
      window.location.href = `/en/knowledge-centre/search/?q=${encodeURIComponent(term)}`;
    });
  });
</script>
