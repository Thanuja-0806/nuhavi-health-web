---
/**
 * src/components/home/HeroSection.astro
 * Approved Homepage Hero Section for Nuhavi Health.
 * PRIMARY SOURCE OF TRUTH: Nuhavi Health — Website Look & Feel.pdf (12 pages — Pages 2 & 11)
 *
 * Requirements:
 * - Ivory / cream background (#F6F2EA).
 * - Eyebrow: DOCTOR-LED MEDICAL TRAVEL · HYDERABAD, INDIA
 * - Headline: "Expert medical care in India. Support at every step." (Cormorant Garamond, Navy #0F2340)
 * - Supporting copy: "Our doctors review your case. You compare written estimates from accredited hospitals. One coordinator stays with your family until you're home."
 * - Two search fields: "Treatment or condition" and "Hospital or doctor" + Search button.
 * - Popular links: Cancer treatment, Knee replacement, Kidney transplant, Second opinion.
 * - Right-side hero visual:
 *     - Dotted international route map connecting Tashkent, Muscat, Addis Ababa, Nairobi, Dar es Salaam -> Hyderabad.
 *     - Sample case card labelled "YOUR CASE · SAMPLE" and "Reviewed".
 *     - Written estimates card showing Partner hospital A, B and C with USD [range] placeholders.
 *     - Coordinator card showing "Farida, your coordinator; Russian · English · on WhatsApp".
 * - Below hero action: "Request a medical opinion" CTA pill, "Get my opinion & estimate", and trust statement:
 *     "Reviewed by our doctors · reply within 1 working day · reports shared later via secure link."
 * - Mobile responsive at 390px and RTL support for Arabic.
 */
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : currentPath.startsWith('/fr')
  ? 'fr'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const prefix = `/${lang}`;
const kcPrefix = '/en';
const isArabic = lang === 'ar';
const isRussian = lang === 'ru';
const isFrench = lang === 'fr';

const requestOpinionHref = `${prefix}/request-opinion/`;
const oncologyHref = `${kcPrefix}/knowledge-centre/oncology/`;
const orthopaedicsHref = `${kcPrefix}/knowledge-centre/orthopedics/`;
const nephrologyHref = `${kcPrefix}/knowledge-centre/kidney-transplant/`;

// Localized strings
const t = {
  eyebrow: isArabic
    ? 'سفر علاجي بإشراف أطباء · حيدر آباد، الهند'
    : isRussian
    ? 'МЕДИЦИНСКИЙ ТУРИЗМ ПОД РУКОВОДСТВОМ ВРАЧЕЙ · ХАЙДАРАБАД, ИНДИЯ'
    : isFrench
    ? 'VOYAGE MÉDICAL DIRIGÉ PAR DES MÉDECINS · HYDERABAD, INDE'
    : 'DOCTOR-LED MEDICAL TRAVEL · HYDERABAD, INDIA',
  headline: isArabic
    ? 'رعاية طبية متخصصة في الهند. دعم في كل خطوة.'
    : isRussian
    ? 'Квалифицированная медицинская помощь в Индии. Поддержка на каждом этапе.'
    : isFrench
    ? 'Soins médicaux experts en Inde. Accompagnement à chaque étape.'
    : 'Expert medical care in India. Support at every step.',
  copy: isArabic
    ? 'أطباؤنا يراجعون حالتك. تقارن بين تقديرات التكلفة المكتوبة من مستشفيات معتمدة. منسق شخصي واحد يرافق عائلتك حتى عودتكم إلى الوطن.'
    : isRussian
    ? 'Наши врачи изучат ваши документы. Вы сравните письменные расчеты от аккредитованных клиник. Персональный координатор будет сопровождать вашу семью до возвращения домой.'
    : isFrench
    ? 'Nos médecins examinent votre dossier. Vous comparez les devis écrits d\'hôpitaux accrédités. Un coordinateur reste avec votre famille jusqu\'à votre retour.'
    : 'Our doctors review your case. You compare written estimates from accredited hospitals. One coordinator stays with your family until you\'re home.',
  searchTreatmentLabel: isArabic ? 'العلاج أو الحالة الطبية' : isRussian ? 'Направление или диагноз' : 'Treatment or condition',
  searchTreatmentPlaceholder: isArabic ? 'مثال: علاج السرطان، استبدال المفصل' : isRussian ? 'напр. Рак молочной железы, замена сустава' : 'e.g. Breast cancer, knee replacement',
  searchHospitalLabel: isArabic ? 'المستشفى أو الطبيب' : isRussian ? 'Больница или врач' : 'Hospital or doctor',
  searchHospitalPlaceholder: isArabic ? 'الكل' : isRussian ? 'Любая' : 'Any',
  searchBtn: isArabic ? 'بحث' : isRussian ? 'Найти' : isFrench ? 'Rechercher' : 'Search',
  popularLabel: isArabic ? 'روابط شائعة:' : isRussian ? 'Популярные направления:' : isFrench ? 'Liens populaires :' : 'Popular:',
  cancerTreatment: isArabic ? 'علاج السرطان' : isRussian ? 'Лечение рака' : isFrench ? 'Traitement du cancer' : 'Cancer treatment',
  kneeReplacement: isArabic ? 'استبدال مفصل الركبة' : isRussian ? 'Замена коленного сустава' : isFrench ? 'Prothèse de genou' : 'Knee replacement',
  kidneyTransplant: isArabic ? 'زراعة الكلى' : isRussian ? 'Трансплантация почки' : isFrench ? 'Greffe de rein' : 'Kidney transplant',
  secondOpinion: isArabic ? 'رأي طبي ثانٍ' : isRussian ? 'Второе мнение' : isFrench ? 'Second avis' : 'Second opinion',
  requestOpinionCta: isArabic ? 'طلب رأي طبي' : isRussian ? 'Запросить медицинское заключение' : isFrench ? 'Demander un avis médical' : 'Request a medical opinion',
  formCta: isArabic ? 'احصل على الرأي والتقدير' : isRussian ? 'Получить заключение и расчет' : isFrench ? 'Obtenir mon avis & devis' : 'Get my opinion & estimate',
  trustStatement: isArabic
    ? 'مراجعة بإشراف أطبائنا · الرد خلال يوم عمل واحد · مشاركة التقارير لاحقاً عبر رابط آمن'
    : isRussian
    ? 'Рассмотрение нашими врачами · ответ в течение 1 рабочего дня · загрузка документов позже по защищенной ссылке'
    : isFrench
    ? 'Examiné par nos médecins · réponse sous 1 jour ouvré · dossiers partagés ultérieurement via lien sécurisé'
    : 'Reviewed by our doctors · reply within 1 working day · reports shared later via secure link.',
  sampleCardPill: isArabic ? 'حالتك · نموذج توضيحي' : isRussian ? 'ВАШ СЛУЧАЙ · ОБРАЗЕЦ' : 'YOUR CASE · SAMPLE',
  reviewedBadge: isArabic ? 'تمت المراجعة' : isRussian ? 'Рассмотрено' : 'Reviewed',
  writtenEstimates: isArabic ? 'تقديرات تكلفة مكتوبة' : isRussian ? 'ПИСЬМЕННЫЕ РАСЧЕТЫ' : 'WRITTEN ESTIMATES',
  coordinatorName: isArabic ? 'فريدة، منسقة الرعاية' : isRussian ? 'Фарида, ваш координатор' : 'Farida, your coordinator',
  coordinatorDetails: isArabic ? 'الروسية · الإنجليزية · عبر واتساب' : isRussian ? 'Русский · English · на WhatsApp' : 'Russian · English · on WhatsApp',
};
---

<section class="hero-section" aria-labelledby="hero-heading">
  <div class="container hero-container">
    <!-- Left Column: Copy, Search & Primary CTA -->
    <div class="hero-left-col">
      <!-- Eyebrow Badge -->
      <div class="hero-eyebrow">
        <span class="eyebrow-icon" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
          </svg>
        </span>
        <span class="eyebrow-text">{t.eyebrow}</span>
      </div>

      <!-- Main Headline in Cormorant Garamond -->
      <h1 id="hero-heading" class="hero-headline">
        {t.headline}
      </h1>

      <!-- Supporting Body Copy -->
      <p class="hero-copy">
        {t.copy}
      </p>

      <!-- Two-Field Search Card Connected to Dedicated Knowledge Centre Search Page -->
      <form class="hero-search-card" id="hero-kc-search-form" action="/en/knowledge-centre/search/" method="get" role="search" aria-label="Search Knowledge Centre">
        <div class="search-fields-row">
          <div class="search-field-cell">
            <label for="hero-treatment-input" class="search-cell-label">{t.searchTreatmentLabel}</label>
            <input
              type="text"
              id="hero-treatment-input"
              name="q"
              class="search-cell-input"
              placeholder={t.searchTreatmentPlaceholder}
              aria-label={t.searchTreatmentLabel}
            />
          </div>

          <div class="search-cell-divider" aria-hidden="true"></div>

          <div class="search-field-cell">
            <label for="hero-hospital-input" class="search-cell-label">{t.searchHospitalLabel}</label>
            <input
              type="text"
              id="hero-hospital-input"
              name="hospital"
              class="search-cell-input"
              placeholder={t.searchHospitalPlaceholder}
              aria-label={t.searchHospitalLabel}
            />
          </div>
        </div>

        <div class="search-btn-row">
          <button type="submit" class="hero-search-btn" id="hero-search-submit-btn">
            <span>{t.searchBtn}</span>
          </button>
        </div>
      </form>

      <!-- Popular Links Row (User Screenshot Pills) -->
      <div class="popular-links-row">
        <span class="popular-label">{t.popularLabel}</span>
        <div class="popular-tags">
          <a href={oncologyHref} class="popular-link">{t.cancerTreatment}</a>
          <a href={orthopaedicsHref} class="popular-link">{t.kneeReplacement}</a>
          <a href={nephrologyHref} class="popular-link">{t.kidneyTransplant}</a>
          <a href={requestOpinionHref} class="popular-link">{t.secondOpinion}</a>
        </div>
      </div>
    </div>

    <!-- Right Column: Dotted International Map & Floating Visual Cards -->
    <div class="hero-right-col" aria-hidden="true">
      <div class="map-visual-card">
        <!-- Card Header Badge -->
        <div class="map-card-header">
          <span class="map-header-tag">INTERNATIONAL CARE COORDINATION</span>
          <span class="map-hyderabad-badge">
            <span class="hub-pulse"></span>
            Destination: Hyderabad, India
          </span>
        </div>

        <!-- SVG Dotted Map with Gold Flight Routes -->
        <div class="map-svg-wrap">
          <svg viewBox="0 0 540 340" class="hero-map-svg" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="goldFlightLine" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#A88B5A" stop-opacity="0.85" />
                <stop offset="100%" stop-color="#C49A3C" stop-opacity="1" />
              </linearGradient>
            </defs>

            <!-- Background subtle world coordinate grid dots -->
            <g class="map-grid-dots" opacity="0.18" fill="#FFFFFF">
              <circle cx="60" cy="50" r="1.5" /><circle cx="100" cy="50" r="1.5" /><circle cx="140" cy="50" r="1.5" /><circle cx="180" cy="50" r="1.5" /><circle cx="220" cy="50" r="1.5" /><circle cx="260" cy="50" r="1.5" /><circle cx="300" cy="50" r="1.5" /><circle cx="340" cy="50" r="1.5" /><circle cx="380" cy="50" r="1.5" /><circle cx="420" cy="50" r="1.5" /><circle cx="460" cy="50" r="1.5" /><circle cx="500" cy="50" r="1.5" />
              <circle cx="60" cy="90" r="1.5" /><circle cx="100" cy="90" r="1.5" /><circle cx="140" cy="90" r="1.5" /><circle cx="180" cy="90" r="1.5" /><circle cx="220" cy="90" r="1.5" /><circle cx="260" cy="90" r="1.5" /><circle cx="300" cy="90" r="1.5" /><circle cx="340" cy="90" r="1.5" /><circle cx="380" cy="90" r="1.5" /><circle cx="420" cy="90" r="1.5" /><circle cx="460" cy="90" r="1.5" /><circle cx="500" cy="90" r="1.5" />
              <circle cx="60" cy="130" r="1.5" /><circle cx="100" cy="130" r="1.5" /><circle cx="140" cy="130" r="1.5" /><circle cx="180" cy="130" r="1.5" /><circle cx="220" cy="130" r="1.5" /><circle cx="260" cy="130" r="1.5" /><circle cx="300" cy="130" r="1.5" /><circle cx="340" cy="130" r="1.5" /><circle cx="380" cy="130" r="1.5" /><circle cx="420" cy="130" r="1.5" /><circle cx="460" cy="130" r="1.5" /><circle cx="500" cy="130" r="1.5" />
              <circle cx="60" cy="170" r="1.5" /><circle cx="100" cy="170" r="1.5" /><circle cx="140" cy="170" r="1.5" /><circle cx="180" cy="170" r="1.5" /><circle cx="220" cy="170" r="1.5" /><circle cx="260" cy="170" r="1.5" /><circle cx="300" cy="170" r="1.5" /><circle cx="340" cy="170" r="1.5" /><circle cx="380" cy="170" r="1.5" /><circle cx="420" cy="170" r="1.5" /><circle cx="460" cy="170" r="1.5" /><circle cx="500" cy="170" r="1.5" />
              <circle cx="60" cy="210" r="1.5" /><circle cx="100" cy="210" r="1.5" /><circle cx="140" cy="210" r="1.5" /><circle cx="180" cy="210" r="1.5" /><circle cx="220" cy="210" r="1.5" /><circle cx="260" cy="210" r="1.5" /><circle cx="300" cy="210" r="1.5" /><circle cx="340" cy="210" r="1.5" /><circle cx="380" cy="210" r="1.5" /><circle cx="420" cy="210" r="1.5" /><circle cx="460" cy="210" r="1.5" /><circle cx="500" cy="210" r="1.5" />
              <circle cx="60" cy="250" r="1.5" /><circle cx="100" cy="250" r="1.5" /><circle cx="140" cy="250" r="1.5" /><circle cx="180" cy="250" r="1.5" /><circle cx="220" cy="250" r="1.5" /><circle cx="260" cy="250" r="1.5" /><circle cx="300" cy="250" r="1.5" /><circle cx="340" cy="250" r="1.5" /><circle cx="380" cy="250" r="1.5" /><circle cx="420" cy="250" r="1.5" /><circle cx="460" cy="250" r="1.5" /><circle cx="500" cy="250" r="1.5" />
              <circle cx="60" cy="290" r="1.5" /><circle cx="100" cy="290" r="1.5" /><circle cx="140" cy="290" r="1.5" /><circle cx="180" cy="290" r="1.5" /><circle cx="220" cy="290" r="1.5" /><circle cx="260" cy="290" r="1.5" /><circle cx="300" cy="290" r="1.5" /><circle cx="340" cy="290" r="1.5" /><circle cx="380" cy="290" r="1.5" /><circle cx="420" cy="290" r="1.5" /><circle cx="460" cy="290" r="1.5" /><circle cx="500" cy="290" r="1.5" />
            </g>

            <!-- Flight Paths (Curved dotted lines to Hyderabad at x=410, y=175) -->
            <!-- 1. Tashkent (x=270, y=75) -> Hyderabad -->
            <path d="M 270 75 Q 330 110 410 175" stroke="url(#goldFlightLine)" stroke-width="2" stroke-dasharray="4 5" />
            <!-- 2. Muscat (x=285, y=145) -> Hyderabad -->
            <path d="M 285 145 Q 345 155 410 175" stroke="url(#goldFlightLine)" stroke-width="2" stroke-dasharray="4 5" />
            <!-- 3. Addis Ababa (x=190, y=210) -> Hyderabad -->
            <path d="M 190 210 Q 290 190 410 175" stroke="url(#goldFlightLine)" stroke-width="2" stroke-dasharray="4 5" />
            <!-- 4. Nairobi (x=205, y=260) -> Hyderabad -->
            <path d="M 205 260 Q 300 230 410 175" stroke="url(#goldFlightLine)" stroke-width="2" stroke-dasharray="4 5" />
            <!-- 5. Dar es Salaam (x=215, y=295) -> Hyderabad -->
            <path d="M 215 295 Q 315 255 410 175" stroke="url(#goldFlightLine)" stroke-width="2" stroke-dasharray="4 5" />

            <!-- Origin Nodes -->
            <!-- Tashkent -->
            <circle cx="270" cy="75" r="4.5" fill="#A88B5A" />
            <circle cx="270" cy="75" r="2" fill="#0F2340" />
            <text x="260" y="62" fill="#DCE3EC" font-size="10.5" font-family="'Inter', sans-serif" font-weight="600" text-anchor="middle">Tashkent</text>

            <!-- Muscat -->
            <circle cx="285" cy="145" r="4.5" fill="#A88B5A" />
            <circle cx="285" cy="145" r="2" fill="#0F2340" />
            <text x="270" y="140" fill="#DCE3EC" font-size="10.5" font-family="'Inter', sans-serif" font-weight="600" text-anchor="end">Muscat</text>

            <!-- Addis Ababa -->
            <circle cx="190" cy="210" r="4.5" fill="#A88B5A" />
            <circle cx="190" cy="210" r="2" fill="#0F2340" />
            <text x="175" y="214" fill="#DCE3EC" font-size="10.5" font-family="'Inter', sans-serif" font-weight="600" text-anchor="end">Addis Ababa</text>

            <!-- Nairobi -->
            <circle cx="205" cy="260" r="4.5" fill="#A88B5A" />
            <circle cx="205" cy="260" r="2" fill="#0F2340" />
            <text x="190" y="264" fill="#DCE3EC" font-size="10.5" font-family="'Inter', sans-serif" font-weight="600" text-anchor="end">Nairobi</text>

            <!-- Dar es Salaam -->
            <circle cx="215" cy="295" r="4.5" fill="#A88B5A" />
            <circle cx="215" cy="295" r="2" fill="#0F2340" />
            <text x="200" y="300" fill="#DCE3EC" font-size="10.5" font-family="'Inter', sans-serif" font-weight="600" text-anchor="end">Dar es Salaam</text>

            <!-- Destination: Hyderabad Beacon -->
            <circle cx="410" cy="175" r="14" fill="#A88B5A" opacity="0.25" />
            <circle cx="410" cy="175" r="8" fill="#A88B5A" />
            <circle cx="410" cy="175" r="3.5" fill="#FFFFFF" />
            <text x="410" y="206" fill="#F6F2EA" font-size="12" font-family="'Inter', sans-serif" font-weight="700" text-anchor="middle">Hyderabad</text>
            <text x="410" y="220" fill="#A88B5A" font-size="9" font-family="'Inter', sans-serif" font-weight="600" text-anchor="middle">MEDICAL HUB</text>
          </svg>
        </div>

        <!-- Floating Info Cards (PDF Page 2) -->
        <div class="map-floating-cards">
          <!-- Card 1: Sample Case Card -->
          <div class="card-sample-case">
            <div class="case-header-row">
              <span class="sample-label">{t.sampleCardPill}</span>
              <span class="reviewed-badge">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                {t.reviewedBadge}
              </span>
            </div>
            <p class="case-subtext">Clinical review & multi-specialist assessment completed</p>
          </div>

          <!-- Card 2: Written Estimates Card -->
          <div class="card-written-estimates">
            <div class="estimates-title-row">
              <span class="estimates-title">{t.writtenEstimates}</span>
              <span class="estimates-tag">Hyderabad Partners</span>
            </div>
            <div class="estimates-list">
              <div class="est-item">
                <span class="est-name">Partner hospital A</span>
                <span class="est-val">USD [range]</span>
              </div>
              <div class="est-item">
                <span class="est-name">Partner hospital B</span>
                <span class="est-val">USD [range]</span>
              </div>
              <div class="est-item">
                <span class="est-name">Partner hospital C</span>
                <span class="est-val">USD [range]</span>
              </div>
            </div>
          </div>

          <!-- Card 3: Coordinator Card -->
          <div class="card-coordinator">
            <div class="coord-avatar-col">
              <div class="coord-avatar">
                <span>F</span>
                <span class="coord-online-dot"></span>
              </div>
            </div>
            <div class="coord-info-col">
              <span class="coord-name">{t.coordinatorName}</span>
              <div class="coord-sub-row">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="#25D366">
                  <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.06-2.146-.541-1.859-.77-3.053-2.659-3.146-2.783-.092-.124-.755-1.004-.755-1.916 0-.912.478-1.36.648-1.533.17-.173.371-.217.495-.217.124 0 .248 0 .356.006.114.006.265-.043.414.316.155.372.531 1.298.577 1.392.046.093.078.202.016.326-.062.124-.093.202-.186.31-.093.109-.196.243-.28.326-.093.093-.19.195-.082.381.109.186.483.796 1.037 1.289.713.636 1.314.833 1.5.925.186.093.295.078.404-.047.109-.124.465-.541.59-.727.124-.186.248-.155.418-.093.17.062 1.083.511 1.269.604.186.093.31.14.356.217.046.077.046.45-.098.855z"/>
                </svg>
                <span class="coord-details">{t.coordinatorDetails}</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* --------------------------------------------------------------------------
     HERO BASE & IVORY CANVAS (#F6F2EA — Approved 12-Page PDF Page 2)
     -------------------------------------------------------------------------- */
  .hero-section {
    width: 100%;
    background-color: #F6F2EA;
    color: #0F2340;
    padding-top: clamp(48px, 6vw, 80px);
    padding-bottom: clamp(56px, 7vw, 96px);
    border-bottom: 1px solid rgba(15, 35, 64, 0.08);
  }

  .hero-container {
    max-width: 1366px;
    margin: 0 auto;
    padding-left: clamp(16px, 3vw, 40px);
    padding-right: clamp(16px, 3vw, 40px);
    display: grid;
    grid-template-columns: 1.15fr 0.95fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
    box-sizing: border-box;
  }

  /* --------------------------------------------------------------------------
     LEFT COLUMN: TYPOGRAPHY, SEARCH & CTAS
     -------------------------------------------------------------------------- */
  .hero-left-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    padding: 6px 14px;
    background-color: rgba(168, 139, 90, 0.12);
    border: 1px solid rgba(168, 139, 90, 0.35);
    border-radius: 9999px;
    color: #0F2340;
  }

  .eyebrow-icon {
    display: flex;
    align-items: center;
    color: #A88B5A;
  }

  .eyebrow-text {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-headline {
    font-family: var(--font-family-heading);
    font-size: clamp(2.35rem, 4.4vw, 3.6rem);
    line-height: 1.12;
    font-weight: 700;
    color: #0F2340;
    letter-spacing: -0.02em;
    margin: 0;
  }

  .hero-copy {
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.6;
    color: #374151;
