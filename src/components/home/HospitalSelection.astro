---
/**
 * src/components/home/HospitalSelection.astro
 * Homepage: "Hospitals are chosen on capability, not popularity"
 * Reference: Page 9 of Nuhavi Health Look and Feel PDF.
 * Localized for English (/en/), Russian (/ru/), and Arabic (/ar/ RTL).
 */
import { homeTranslations } from '../../i18n/homeTranslations';
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const content = homeTranslations[lang].hospitalSelection;
---

<section class="hospital-selection-section" aria-labelledby="hospital-selection-heading">
  <div class="container selection-container">
    <div class="selection-grid">
      <!-- Left Column: Title, Deck, Checklist, Pill Link -->
      <div class="selection-left-col">
        <h2 id="hospital-selection-heading" class="selection-title">
          {content.title}
        </h2>
        <p class="selection-deck">
          {content.deck}
        </p>

        <!-- 5-Point Checklist -->
        <ul class="selection-checklist">
          {content.checklist.map((item) => (
            <li>
              <span class="check-icon" aria-hidden="true">&#10003;</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <div class="selection-cta-wrap">
          <a href="/en/hospitals/" class="btn-pill-primary">
            {content.standardCta}
          </a>
        </div>
      </div>

      <!-- Right Column: Standard Audit Card -->
      <div class="selection-right-col">
        <div class="standard-policy-card">
          <div class="card-gold-accent" aria-hidden="true"></div>
          <h3 class="policy-card-title">{content.cardTitle}</h3>
          <p class="policy-card-text">
            {content.cardText}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hospital-selection-section {
    width: 100%;
    background-color: var(--color-paper);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
  }

  .selection-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-4);
    box-sizing: border-box;
  }

  .selection-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 900px) {
    .selection-grid {
      grid-template-columns: 7fr 5fr;
      gap: var(--space-10);
      align-items: center;
    }
  }

  .selection-left-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .selection-title {
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1.2;
    margin: 0;
  }

  .selection-deck {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-slate);
    margin: 0;
  }

  .selection-checklist {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .selection-checklist li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-ink);
  }

  .check-icon {
    color: var(--color-success);
    font-weight: 800;
    font-size: 1rem;
    line-height: 1.3;
    flex-shrink: 0;
  }

  .selection-cta-wrap {
    margin-top: var(--space-2);
  }

  .btn-pill-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    background-color: var(--color-navy);
    color: var(--color-paper);
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 0.875rem;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .btn-pill-primary:hover {
    background-color: var(--color-deep-navy);
    transform: translateY(-1px);
  }

  /* Right Card */
  .standard-policy-card {
    background-color: var(--color-mist);
    border: 1px solid rgba(20, 41, 75, 0.08);
    border-radius: var(--radius-card);
    padding: var(--space-8);
    position: relative;
    overflow: hidden;
  }

  .card-gold-accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background-color: var(--color-gold);
  }

  .policy-card-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0 0 var(--space-3);
  }

  .policy-card-text {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-slate);
    margin: 0;
  }

  /* RTL Support */
  :global([dir="rtl"]) .selection-title,
  :global([dir="rtl"]) .selection-deck,
  :global([dir="rtl"]) .policy-card-title,
  :global([dir="rtl"]) .policy-card-text {
    text-align: right;
  }
</style>
