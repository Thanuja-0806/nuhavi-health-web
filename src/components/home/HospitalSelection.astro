---
/**
 * src/components/home/HospitalSelection.astro
 * Approved Partner Hospitals Section — 12-Page PDF (Page 3)
 *
 * Heading: Visited and verified by our doctors
 * Link: All partner hospitals →
 * 4 Hospital Cards in a row:
 * - Hospital photo — with permission placeholder
 * - Badges: NABH, JCI, Verified by Nuhavi
 * - Location from RGIA, Beds, Focus
 * - Profile and WhatsApp buttons
 */
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : currentPath.startsWith('/fr')
  ? 'fr'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const isArabic = lang === 'ar';
const isRussian = lang === 'ru';
const isFrench = lang === 'fr';

const prefix = `/${lang}`;
const hospitalsIndexHref = `${prefix}/hospitals/`;
const requestOpinionHref = `${prefix}/request-opinion/`;

const t = {
  eyebrow: isArabic ? 'المستشفيات الشريكة' : isRussian ? 'КЛИНИКИ-ПАРТНЕРЫ' : 'PARTNER HOSPITALS',
  heading: isArabic ? 'مستشفيات زارها وتحقق منها أطباؤنا' : isRussian ? 'Посещены и проверены нашими врачами' : 'Visited and verified by our doctors',
  allHospitalsLink: isArabic ? 'جميع المستشفيات الشريكة ←' : isRussian ? 'Все клиники-партнеры →' : 'All partner hospitals →',
  photoPlaceholder: isArabic ? 'صورة المستشفى — بإذن مسبق' : isRussian ? 'Фото клиники — с разрешения' : 'Hospital photo — with permission',
  profileBtn: isArabic ? 'الملف التعريفي' : isRussian ? 'Профиль' : 'Profile',
  whatsappBtn: isArabic ? 'واتساب' : isRussian ? 'WhatsApp' : 'WhatsApp',
};

const hospitals = [
  {
    name: 'Partner hospital A',
    location: 'Gachibowli · [km] from RGIA airport',
    details: '[beds] beds · Multi-specialty',
    verified: '✓ Verified by Nuhavi · [month year]',
  },
  {
    name: 'Partner hospital B',
    location: 'Banjara Hills · [km] from RGIA airport',
    details: '[beds] beds · Cancer centre',
    verified: '✓ Verified by Nuhavi · [month year]',
  },
  {
    name: 'Partner hospital C',
    location: 'Secunderabad · [km] from RGIA airport',
    details: '[beds] beds · Multi-specialty',
    verified: '✓ Verified by Nuhavi · [month year]',
  },
  {
    name: 'Partner hospital D',
    location: 'Madhapur · [km] from RGIA airport',
    details: '[beds] beds · Orthopaedics & spine',
    verified: '✓ Verified by Nuhavi · [month year]',
  },
];
---

<section class="partner-hospitals-section" id="hospitals" aria-labelledby="hospitals-heading" dir={isArabic ? 'rtl' : 'ltr'}>
  <div class="container hospitals-container">
    <!-- Header with Left Heading and Right "All partner hospitals →" Link -->
    <div class="hospitals-header-row">
      <div class="header-left">
        <span class="hospitals-eyebrow">{t.eyebrow}</span>
        <h2 id="hospitals-heading" class="hospitals-title">
          {t.heading}
        </h2>
      </div>
      <div class="header-right">
        <a href={hospitalsIndexHref} class="all-hospitals-link">
          <span>{t.allHospitalsLink}</span>
        </a>
      </div>
    </div>

    <!-- 4 Hospital Cards Grid (PDF Page 3) -->
    <div class="hospitals-cards-grid">
      {hospitals.map((hosp) => (
        <article class="hosp-card">
          <!-- Photo Placeholder Box -->
          <div class="hosp-card-photo-box">
            <span class="photo-box-text">{t.photoPlaceholder}</span>
          </div>

          <div class="hosp-card-body">
            <div class="hosp-badges-row">
              <span class="badge-item">NABH</span>
              <span class="badge-item">JCI</span>
            </div>

            <h3 class="hosp-title">{hosp.name}</h3>
            <p class="hosp-line">{hosp.location}</p>
            <p class="hosp-line">{hosp.details}</p>
            <p class="hosp-verified-line">{hosp.verified}</p>

            <div class="hosp-card-actions">
              <a href={requestOpinionHref} class="btn-hosp-profile">
                {t.profileBtn}
              </a>
              <a href="https://wa.me/919999999999" class="btn-hosp-wa" target="_blank" rel="noopener noreferrer">
                {t.whatsappBtn}
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .partner-hospitals-section {
    width: 100%;
    background-color: #FFFFFF;
    padding: clamp(64px, 8vw, 88px) 0;
  }

  .hospitals-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 40px);
    box-sizing: border-box;
  }

  .hospitals-header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .hospitals-eyebrow {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #A88B5A;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .hospitals-title {
    font-family: var(--font-family-heading);
    font-size: clamp(2rem, 3.2vw, 2.85rem);
    color: #0F2340;
    font-weight: 600;
    margin: 0;
    line-height: 1.15;
  }

  .all-hospitals-link {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #0F2340;
    text-decoration: underline;
    transition: color 0.15s ease;
  }

  .all-hospitals-link:hover {
    color: #A88B5A;
  }

  /* 4 Cards Grid */
  .hospitals-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .hosp-card {
    background-color: #FFFFFF;
    border: 1px solid rgba(15, 35, 64, 0.12);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 1px 3px rgba(15, 35, 64, 0.03);
    transition: box-shadow 0.18s ease, border-color 0.18s ease;
  }

  .hosp-card:hover {
    border-color: #A88B5A;
    box-shadow: 0 6px 18px rgba(15, 35, 64, 0.08);
  }

  .hosp-card-photo-box {
    background-color: #DCE3EC;
    height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    text-align: center;
  }

  .photo-box-text {
    font-size: 0.78rem;
    color: #4B5563;
    font-weight: 500;
  }

  .hosp-card-body {
    padding: 20px 18px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 4px;
  }

  .hosp-badges-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
  }

  .badge-item {
    font-size: 0.65rem;
    font-weight: 700;
    color: #0F2340;
    background-color: #F1F5F9;
    border: 1px solid #CBD5E1;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .hosp-title {
    font-family: var(--font-family-heading);
    font-size: 1.35rem;
    font-weight: 600;
    color: #0F2340;
    margin: 0 0 2px 0;
    line-height: 1.2;
  }

  .hosp-line {
    font-size: 0.785rem;
    color: #4B5563;
    margin: 0;
    line-height: 1.45;
  }

  .hosp-verified-line {
    font-size: 0.785rem;
    color: #26734D;
    margin: 4px 0 16px 0;
  }

  .hosp-card-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: auto;
  }

  .btn-hosp-profile {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    border: 1px solid rgba(15, 35, 64, 0.25);
    background-color: #FFFFFF;
    color: #0F2340;
    border-radius: 4px;
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .btn-hosp-profile:hover {
    border-color: #0F2340;
    background-color: #F8FAFD;
  }

  .btn-hosp-wa {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 12px;
    background-color: #25D366;
    color: #FFFFFF;
    border-radius: 4px;
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    transition: background-color 0.15s ease;
  }

  .btn-hosp-wa:hover {
    background-color: #20BA5A;
  }

  @media (max-width: 1024px) {
    .hospitals-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .hospitals-cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
