---
/**
 * HospitalSelection.astro
 * Homepage section: "Hospitals are chosen on capability, not popularity" (Module 8)
 * Reference: Page 9 (visual reference), Page 19 (selection standard), and Page 20 (hospital comparison) of the Nuhavi Health Look and Feel PDF.
 *
 * Implements:
 * 1. Clean light background (Paper #FFFFFF) with standard section spacing.
 * 2. Exact heading: "Hospitals are chosen on capability, not popularity".
 * 3. Exact supporting text: "We present hospitals by their services, infrastructure and accreditation — never by individual doctors."
 * 4. Exactly seven numbered selection criteria in strict chronological order (01 to 07) with exact reference copy.
 * 5. Separate light-colored information panel explaining why hospital profiles are not listed prior to signed agreements & independent audits.
 * 6. Zero hospital profiles, logos, hospital names, doctor names, rankings, ratings, or placeholder entries.
 * 7. Pending CTA: "Read our selection standard" (visibly pending since /en/hospitals/ does not exist yet).
 * 8. Two-column desktop layout (criteria on left, verification panel on right) and single-column mobile layout.
 */

interface SelectionCriterion {
  number: string;
  title: string;
  description: string;
}

const criteria: SelectionCriterion[] = [
  {
    number: '01',
    title: '01 — Accreditation',
    description: 'Government national accreditation (NABH) or international accreditation (JCI) for the hospital, with the certificate and expiry date on file.'
  },
  {
    number: '02',
    title: '02 — Specialty infrastructure',
    description: 'The specialty infrastructure your treatment needs — for example, radiotherapy, intensive care or a joint-replacement theatre.'
  },
  {
    number: '03',
    title: '03 — Multidisciplinary review',
    description: 'A multidisciplinary team review for cancer cases.'
  },
  {
    number: '04',
    title: '04 — International patient support',
    description: 'An international-patient desk and named interpreter.'
  },
  {
    number: '05',
    title: '05 — Written estimates',
    description: 'Written estimates with inclusions, exclusions and validity.'
  },
  {
    number: '06',
    title: '06 — Discharge documentation',
    description: 'Discharge summaries in English, shared with the patient.'
  },
  {
    number: '07',
    title: '07 — Signed agreement',
    description: 'A signed agreement with Nuhavi that rules out referral payments.'
  }
];
---

<section class="hospital-section" aria-labelledby="hospital-heading">
  <div class="container hospital-container">
    <div class="hospital-layout">
      <!-- Left Column: Heading, Supporting Copy & 7 Numbered Criteria -->
      <div class="hospital-main-col">
        <header class="hospital-header">
          <span class="hospital-eyebrow">HOSPITAL SELECTION</span>
          <h2 id="hospital-heading" class="hospital-title">
            Hospitals are chosen on capability, not popularity
          </h2>
          <p class="hospital-supporting-text">
            We present hospitals by their services, infrastructure and accreditation — never by individual doctors.
          </p>
        </header>

        <!-- 7 Numbered Criteria List -->
        <ol class="criteria-list" aria-label="Seven hospital selection criteria">
          {criteria.map((item) => (
            <li class="criteria-item" data-criterion={item.number}>
              <div class="criteria-marker" aria-hidden="true">
                <span class="criteria-num">{item.number}</span>
              </div>
              <div class="criteria-content">
                <h3 class="criteria-title">{item.title}</h3>
                <p class="criteria-description">{item.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- Right Column: Verification Information Panel & Pending CTA -->
      <aside class="hospital-sidebar-col">
        <div class="verification-panel">
          <span class="panel-eyebrow">HOSPITAL VERIFICATION</span>
          <h3 class="panel-title">Independent verification before publication</h3>

          <div class="panel-body">
            <p class="panel-text">
              Hospital profiles appear here after a signed agreement and an independent check of their accreditation and services.
            </p>
            <p class="panel-text">
              No hospitals are listed until then, so you see hospitals that are verified rather than names you cannot trust.
            </p>
          </div>

          <div class="verification-status-box">
            <span class="status-dot" aria-hidden="true"></span>
            <span class="status-text">
              Publication requires a signed partner agreement and independent verification of accreditation and services.
            </span>
          </div>

          <!-- Pending CTA (Marked pending since /en/hospitals/ does not exist yet) -->
          <div class="panel-cta-wrapper">
            <span class="btn-pending" role="link" aria-disabled="true" title="Dedicated Hospitals guide coming soon">
              <span class="cta-label">Read our selection standard</span>
              <span class="badge-pending" aria-hidden="true">Guide pending</span>
            </span>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  /* --------------------------------------------------------------------------
     SECTION BASE & SHELL (Clean Light Paper #FFFFFF Background)
     -------------------------------------------------------------------------- */
  .hospital-section {
    width: 100%;
    background-color: var(--color-paper);
    padding-top: var(--section-spacing);
    padding-bottom: var(--section-spacing);
    border-top: 1px solid rgba(20, 41, 75, 0.08);
  }

  .hospital-container {
    width: 100%;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--space-3);
    padding-right: var(--space-3);
  }

  @media (max-width: 480px) {
    .hospital-container {
      padding-left: var(--space-2);
      padding-right: var(--space-2);
    }
  }

  /* --------------------------------------------------------------------------
     TWO-COLUMN DESKTOP LAYOUT (1024px+)
     -------------------------------------------------------------------------- */
  .hospital-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  @media (min-width: 1024px) {
    .hospital-layout {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: var(--space-8);
      align-items: start;
    }
  }

  /* --------------------------------------------------------------------------
     LEFT COLUMN: HEADER & NUMBERED CRITERIA
     -------------------------------------------------------------------------- */
  .hospital-main-col {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .hospital-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-bottom: var(--space-6);
  }

  .hospital-eyebrow {
    font-size: 0.8125rem;
    font-weight: var(--font-weight-subheading);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gold-text);
  }

  .hospital-title {
    font-size: clamp(1.75rem, 3.5vw, 2.375rem);
    font-weight: var(--font-weight-heading);
    color: var(--color-deep-navy);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .hospital-supporting-text {
    font-size: 1.0625rem;
    font-weight: var(--font-weight-body);
    line-height: var(--line-height-body);
    color: var(--color-slate);
    margin-top: 4px;
  }

  /* --------------------------------------------------------------------------
     NUMBERED CRITERIA LIST (01 to 07)
     -------------------------------------------------------------------------- */
  .criteria-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(20, 41, 75, 0.08);
  }

  .criteria-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4) 0;
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
  }

  .criteria-marker {
    flex-shrink: 0;
    width: 32px;
    padding-top: 2px;
  }

  .criteria-num {
    font-size: 0.875rem;
    font-weight: var(--font-weight-subheading);
    color: var(--color-gold-text);
    letter-spacing: 0.04em;
  }

  .criteria-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
    min-width: 0;
  }

  .criteria-title {
    font-size: 1.0625rem;
    font-weight: var(--font-weight-subheading);
    color: var(--color-deep-navy);
    line-height: 1.3;
  }

  .criteria-description {
    font-size: 0.9375rem;
    font-weight: var(--font-weight-body);
    line-height: 1.55;
    color: var(--color-ink);
  }

  /* --------------------------------------------------------------------------
     RIGHT COLUMN: VERIFICATION INFORMATION PANEL
     -------------------------------------------------------------------------- */
  .hospital-sidebar-col {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .hospital-sidebar-col {
      position: sticky;
      top: calc(var(--space-6) + 40px);
    }
  }

  .verification-panel {
    background-color: var(--color-mist);
    border: 1px solid rgba(20, 41, 75, 0.1);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    box-shadow: 0 2px 10px rgba(20, 41, 75, 0.03);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .panel-eyebrow {
    font-size: 0.75rem;
    font-weight: var(--font-weight-subheading);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gold-text);
  }

  .panel-title {
    font-size: 1.25rem;
    font-weight: var(--font-weight-heading);
    color: var(--color-deep-navy);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .panel-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .panel-text {
    font-size: 0.9375rem;
    font-weight: var(--font-weight-body);
    line-height: 1.6;
    color: var(--color-ink);
  }

  .verification-status-box {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background-color: var(--color-paper);
    border: 1px solid rgba(20, 41, 75, 0.08);
    border-left: 3px solid var(--color-gold);
    border-radius: 0 8px 8px 0;
    padding: var(--space-3);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-gold);
    margin-top: 6px;
    flex-shrink: 0;
  }

  .status-text {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-slate);
  }

  /* Pending CTA Button */
  .panel-cta-wrapper {
    margin-top: var(--space-1);
  }

  .btn-pending {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--button-min-height);
    padding: 0 var(--space-4);
    background-color: var(--color-paper);
    color: var(--color-navy);
    border: 1.5px solid rgba(20, 41, 75, 0.2);
    border-radius: var(--radius-pill);
    font-size: 0.9375rem;
    font-weight: var(--font-weight-subheading);
    cursor: default;
    user-select: none;
    box-shadow: 0 1px 3px rgba(20, 41, 75, 0.04);
  }

  .badge-pending {
    font-size: 0.6875rem;
    font-weight: var(--font-weight-subheading);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: rgba(20, 41, 75, 0.08);
    color: var(--color-slate);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
  }

  /* --------------------------------------------------------------------------
     MOBILE REFINEMENTS (<= 640px, 390px, 360px)
     -------------------------------------------------------------------------- */
  @media (max-width: 640px) {
    .hospital-layout {
      gap: var(--space-6);
    }

    .criteria-item {
      padding: var(--space-3) 0;
      gap: var(--space-2);
    }

    .criteria-title {
      font-size: 1rem;
    }

    .criteria-description {
      font-size: 0.875rem;
    }

    .verification-panel {
      padding: var(--space-4);
      gap: var(--space-3);
    }

    .panel-title {
      font-size: 1.125rem;
    }

    .panel-text {
      font-size: 0.875rem;
    }

    .btn-pending {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      min-height: 42px;
      padding: 8px 12px;
      gap: 6px;
    }

    .cta-label {
      font-size: 0.8125rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .badge-pending {
      font-size: 0.625rem;
      padding: 2px 6px;
      flex-shrink: 0;
    }
  }
</style>

