---
/**
 * src/components/home/SpecialtyExplorer.astro
 * Approved 8-Specialty Explorer — 12-Page PDF (Pages 2–3 & 11)
 *
 * Heading: What we can help with.
 * Copy: Cancer care and joint replacement are our focus. Other specialties are arranged case by case with our partner hospitals.
 *
 * Filters:
 * - All treatments (8)
 * - Accepting enquiries (2)
 * - Arranged on request (6)
 *
 * Exactly Eight Treatment Cards:
 * 1. Oncology — Accepting enquiries (Cancer care: Diagnosis review, surgery, chemotherapy and radiotherapy.)
 * 2. Orthopaedics — Accepting enquiries (Joint replacement: Knee and hip replacement, selected spine procedures.)
 * 3. Nephrology — Arranged on request (Kidney & transplant: Renal care, dialysis planning and transplant evaluation.)
 * 4. Cardiology — Arranged on request (Cardiac sciences: Cardiac evaluation, bypass and valve surgery.)
 * 5. Neurosciences — Arranged on request (Brain & spine: Neurosurgical and spine opinions and treatment.)
 * 6. Gastro — Arranged on request (Liver & digestive: Gastroenterology, liver care and GI surgery.)
 * 7. Surgery — Arranged on request (General surgery: Planned general and laparoscopic surgery.)
 * 8. Fertility — Arranged on request (Fertility & IVF: Evaluation and treatment at partner fertility centres.)
 */
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  eyebrow?: string;
  heading?: string;
  headingLevel?: 'h1' | 'h2';
  supportingText?: string;
  variant?: 'home' | 'page';
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : currentPath.startsWith('/fr')
  ? 'fr'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const isArabic = lang === 'ar';
const isRussian = lang === 'ru';
const isFrench = lang === 'fr';

const {
  variant = 'home',
  headingLevel = 'h2',
} = Astro.props;

const HeadingTag = headingLevel;
const prefix = `/${lang}`;

// Localized strings
const t = {
  eyebrow: isArabic ? 'التخصصات الطبية' : isRussian ? 'МЕДИЦИНСКИЕ НАПРАВЛЕНИЯ' : isFrench ? 'SPÉCIALITÉS MÉDICALES' : 'MEDICAL SPECIALTIES',
  heading: isArabic ? 'ما يمكننا المساعدة فيه' : isRussian ? 'Чем мы можем помочь' : isFrench ? 'Ce que nous pouvons prendre en charge' : 'What we can help with.',
  supporting: isArabic
    ? 'علاج الأورام واستبدال المفاصل هما تركيزنا الأساسي. التخصصات الأخرى يتم ترتيبها حسب كل حالة مع مستشفياتنا الشريكة.'
    : isRussian
    ? 'Лечение онкологии и замена суставов — наш основной фокус. Другие направления организуются индивидуально с нашими клиниками-партнерами.'
    : isFrench
    ? 'L\'oncologie et le remplacement articulaire sont notre priorité. Les autres spécialités sont organisées au cas par cas avec nos hôpitaux partenaires.'
    : 'Cancer care and joint replacement are our focus. Other specialties are arranged case by case with our partner hospitals.',
  filterAll: isArabic ? 'جميع العلاجات (8)' : isRussian ? 'Все направления (8)' : isFrench ? 'Tous les traitements (8)' : 'All treatments (8)',
  filterAccepting: isArabic ? 'استقبال الطلبات متاح (2)' : isRussian ? 'Прием открыт (2)' : isFrench ? 'Demandes acceptées (2)' : 'Accepting enquiries (2)',
  filterOnRequest: isArabic ? 'متاح حسب الطلب (6)' : isRussian ? 'По запросу (6)' : isFrench ? 'Sur demande (6)' : 'Arranged on request (6)',
  acceptingBadge: isArabic ? 'استقبال الطلبات متاح' : isRussian ? 'Прием открыт' : isFrench ? 'Demandes acceptées' : 'Accepting enquiries',
  onRequestBadge: isArabic ? 'متاح حسب الطلب' : isRussian ? 'По запросу' : isFrench ? 'Sur demande' : 'Arranged on request',
  exploreLink: isArabic ? 'تفاصيل التخصص' : isRussian ? 'Подробнее' : isFrench ? 'En savoir plus' : 'Explore specialty',
  requestOpinionBtn: isArabic ? 'طلب رأي طبي' : isRussian ? 'Запросить заключение' : isFrench ? 'Demander un avis' : 'Request opinion',
  footnote: isArabic
    ? 'متاح حسب الطلب يعني أننا سنبحث عن مستشفى معتمد ومناسب لحالتك في حيدر آباد ونستشير أطباءنا قبل سفرك.'
    : isRussian
    ? '«По запросу» означает, что мы подберем проверенную аккредитованную клинику в Хайдарабаде под ваш диагноз и проведем врачебный анализ до поездки.'
    : isFrench
    ? '« Sur demande » signifie que nous trouverons un hôpital accrédité adapté à votre cas à Hyderabad et consulterons nos médecins avant votre voyage.'
    : 'Arranged on request means our doctor team will identify a suitable accredited partner hospital in Hyderabad and coordinate an independent review for your case.',
};

const finalHeading = Astro.props.heading || t.heading;
const finalSupportingText = Astro.props.supportingText || t.supporting;

// Exactly 8 specialties from PDF
const specialties = [
  // 1. Oncology — Accepting enquiries
  {
    id: 'oncology',
    slug: 'oncology',
    status: 'accepting' as const,
    title: isArabic ? 'طب الأورام' : isRussian ? 'Онкология' : 'Oncology',
    subTitle: isArabic ? 'علاج السرطان' : isRussian ? 'Лечение рака' : 'Cancer care',
    description: isArabic
      ? 'مراجعة التشخيص، الجراحة، العلاج الكيميائي والعلاج الإشعاعي.'
      : isRussian
      ? 'Пересмотр диагноза, хирургия, химиотерапия и лучевая терапия.'
      : 'Diagnosis review, surgery, chemotherapy and radiotherapy.',
  },
  // 2. Orthopaedics — Accepting enquiries
  {
    id: 'orthopaedics',
    slug: 'orthopaedics',
    status: 'accepting' as const,
    title: isArabic ? 'جراحة العظام' : isRussian ? 'Ортопедия' : 'Orthopaedics',
    subTitle: isArabic ? 'استبدال المفاصل' : isRussian ? 'Эндопротезирование суставов' : 'Joint replacement',
    description: isArabic
      ? 'استبدال مفصل الركبة والورك، وجراحات مختارة للعمود الفقري.'
      : isRussian
      ? 'Замена коленного и тазобедренного суставов, отдельные операции на позвоночнике.'
      : 'Knee and hip replacement, selected spine procedures.',
  },
  // 3. Nephrology — Arranged on request
  {
    id: 'nephrology',
    slug: 'nephrology-urology',
    status: 'on-request' as const,
    title: isArabic ? 'أمراض الكلى' : isRussian ? 'Нефрология' : 'Nephrology',
    subTitle: isArabic ? 'الكلى والزراعة' : isRussian ? 'Почки и трансплантация' : 'Kidney & transplant',
    description: isArabic
      ? 'رعاية الكلى وتخطيط الغسيل الكلوي وتقييم زراعة الكلى.'
      : isRussian
      ? 'Лечение почек, планирование диализа и оценка перед трансплантацией.'
      : 'Renal care, dialysis planning and transplant evaluation.',
  },
  // 4. Cardiology — Arranged on request
  {
    id: 'cardiology',
    slug: 'cardiac-sciences',
    status: 'on-request' as const,
    title: isArabic ? 'أمراض القلب' : isRussian ? 'Кардиология' : 'Cardiology',
    subTitle: isArabic ? 'علوم القلب' : isRussian ? 'Кардиологические науки' : 'Cardiac sciences',
    description: isArabic
      ? 'التقييم القلبي وجراحة المجازة وجراحة الصمامات.'
      : isRussian
      ? 'Кардиологическое обследование, шунтирование и операции на клапанах.'
      : 'Cardiac evaluation, bypass and valve surgery.',
  },
  // 5. Neurosciences — Arranged on request
  {
    id: 'neurosciences',
    slug: 'neurosciences',
    status: 'on-request' as const,
    title: isArabic ? 'علوم الأعصاب' : isRussian ? 'Неврология' : 'Neurosciences',
    subTitle: isArabic ? 'المخ والعمود الفقري' : isRussian ? 'Головной и спинной мозг' : 'Brain & spine',
    description: isArabic
      ? 'استشارات وعلاج جراحة المخ والأعصاب والعمود الفقري.'
      : isRussian
      ? 'Нейрохирургические консультации, операции на мозге и позвоночнике.'
      : 'Neurosurgical and spine opinions and treatment.',
  },
  // 6. Gastro — Arranged on request
  {
    id: 'gastro',
    slug: 'gastroenterology',
    status: 'on-request' as const,
    title: isArabic ? 'الجهاز الهضمي' : isRussian ? 'Гастроэнтерология' : 'Gastro',
    subTitle: isArabic ? 'الكبد والجهاز الهضمي' : isRussian ? 'Печень и пищеварение' : 'Liver & digestive',
    description: isArabic
      ? 'أمراض الجهاز الهضمي، رعاية الكبد وجراحة الجهاز الهضمي.'
      : isRussian
      ? 'Гастроэнтерология, заболевания печени и абдоминальная хирургия.'
      : 'Gastroenterology, liver care and GI surgery.',
  },
  // 7. Surgery — Arranged on request
  {
    id: 'surgery',
    slug: 'organ-transplants',
    status: 'on-request' as const,
    title: isArabic ? 'الجراحة العامة' : isRussian ? 'Хирургия' : 'Surgery',
    subTitle: isArabic ? 'جراحة عامة وتنظيرية' : isRussian ? 'Общая хирургия' : 'General surgery',
    description: isArabic
      ? 'الجراحة العامة المخطط لها والجراحة بالمنظار.'
      : isRussian
      ? 'Плановая общая и лапароскопическая хирургия.'
      : 'Planned general and laparoscopic surgery.',
  },
  // 8. Fertility — Arranged on request
  {
    id: 'fertility',
    slug: 'fertility',
    status: 'on-request' as const,
    title: isArabic ? 'الخصوبة' : isRussian ? 'Репродуктология' : 'Fertility',
    subTitle: isArabic ? 'الخصوبة وأطفال الأنابيب' : isRussian ? 'ЭКО и фертильность' : 'Fertility & IVF',
    description: isArabic
      ? 'التقييم والعلاج في مراكز الخصوبة الشريكة.'
      : isRussian
      ? 'Обследование и лечение в партнерских центрах репродукции.'
      : 'Evaluation and treatment at partner fertility centres.',
  },
];
---

<section class="specialty-explorer-section" id="treatments" aria-labelledby="specialty-heading">
  <div class="container specialty-container">
    <!-- Header Block -->
    <div class="specialty-header">
      <div class="specialty-eyebrow-pill">
        <span class="eyebrow-dot"></span>
        <span>{t.eyebrow}</span>
      </div>
      <HeadingTag id="specialty-heading" class="specialty-title">
        {finalHeading}
      </HeadingTag>
      <p class="specialty-deck">
        {finalSupportingText}
      </p>

      <!-- 3 Filter Buttons (All 8, Accepting 2, On Request 6) -->
      <div class="filter-tabs-bar" role="tablist" aria-label="Treatment specialty filters">
        <button
          type="button"
          role="tab"
          class="filter-tab is-active"
          id="tab-all"
          aria-selected="true"
          aria-controls="specialties-grid"
          data-filter="all"
        >
          {t.filterAll}
        </button>
        <button
          type="button"
          role="tab"
          class="filter-tab"
          id="tab-accepting"
          aria-selected="false"
          aria-controls="specialties-grid"
          data-filter="accepting"
        >
          <span class="tab-indicator accepting-dot">●</span>
          {t.filterAccepting}
        </button>
        <button
          type="button"
          role="tab"
          class="filter-tab"
          id="tab-on-request"
          aria-selected="false"
          aria-controls="specialties-grid"
          data-filter="on-request"
        >
          <span class="tab-indicator on-request-dot">○</span>
          {t.filterOnRequest}
        </button>
      </div>
    </div>

    <!-- 8 Treatment Cards Grid -->
    <div class="specialties-cards-grid" id="specialties-grid">
      {specialties.map((spec, index) => {
        const isAccepting = spec.status === 'accepting';
        const cardHref = `${prefix}/treatments/${spec.slug}/`;
        return (
          <article
            class="treatment-card"
            data-status={spec.status}
          >
            <!-- Navy Top Visual Panel with Subtle Waves -->
            <div class="card-navy-panel">
              <svg class="subtle-wave-bg" viewBox="0 0 320 140" fill="none" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0 60 C 80 40, 160 80, 240 50 C 280 35, 300 45, 320 40 L 320 0 L 0 0 Z" fill="rgba(168, 139, 90, 0.08)" />
                <path d="M0 90 C 70 70, 150 110, 230 80 C 270 65, 300 75, 320 70 L 320 0 L 0 0 Z" fill="rgba(255, 255, 255, 0.03)" />
                <path d="M0 120 C 90 100, 180 135, 260 115 C 290 105, 310 112, 320 110" stroke="rgba(168, 139, 90, 0.22)" stroke-width="1.2" stroke-dasharray="3 4" fill="none" />
              </svg>

              <div class="panel-header-row">
                <span class="card-number">0{index + 1}</span>
                <span class={`status-tag ${isAccepting ? 'tag-accepting' : 'tag-on-request'}`}>
                  <span class="status-dot" aria-hidden="true">{isAccepting ? '●' : '○'}</span>
                  {isAccepting ? t.acceptingBadge : t.onRequestBadge}
                </span>
              </div>

              <div class="panel-titles">
                <h3 class="card-title">
                  <a href={cardHref} class="card-title-link">
                    {spec.title}
                  </a>
                </h3>
                <span class="card-subtitle">{spec.subTitle}</span>
              </div>
            </div>

            <!-- Lower Ivory/White Content Panel -->
            <div class="card-content-panel">
              <p class="card-description">{spec.description}</p>

              <div class="card-footer-row">
                <a href={cardHref} class="card-link-action">
                  <span>{t.exploreLink}</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
                {isAccepting && (
                  <a href={`${prefix}/request-opinion/`} class="card-opinion-btn">
                    <span>{t.requestOpinionBtn}</span>
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Footnote note on Arranged on request -->
    <div class="specialty-footnote" role="note">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
      <span>{t.footnote}</span>
    </div>
  </div>
</section>

<script>
  // Simple, accessible client-side filter for the 3 tabs
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
  const cards = document.querySelectorAll<HTMLElement>('.treatment-card');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;

      // Update tab active states
      tabButtons.forEach((b) => {
        b.classList.remove('is-active');
        b.setAttribute('aria-selected', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-selected', 'true');

      // Filter cards
      cards.forEach((card) => {
        const cardStatus = card.dataset.status;
        if (filter === 'all' || cardStatus === filter) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>

<style>
  .specialty-explorer-section {
    width: 100%;
    background-color: #FFFFFF;
    padding: clamp(48px, 6vw, 72px) 0;
    border-bottom: 1px solid rgba(15, 35, 64, 0.08);
  }

  .specialty-container {
    max-width: 1366px;
    margin: 0 auto;
    padding-left: clamp(16px, 3vw, 40px);
    padding-right: clamp(16px, 3vw, 40px);
    box-sizing: border-box;
  }

  .specialty-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .specialty-eyebrow-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #A88B5A;
    background-color: rgba(168, 139, 90, 0.1);
    border: 1px solid rgba(168, 139, 90, 0.3);
    padding: 4px 14px;
    border-radius: 9999px;
    margin-bottom: 14px;
  }

  .eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #A88B5A;
  }

  .specialty-title {
    font-family: var(--font-family-heading);
    font-size: clamp(2rem, 3.6vw, 2.75rem);
    color: #0F2340;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0 0 12px 0;
    line-height: 1.18;
  }

  .specialty-deck {
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    color: #4B5563;
    line-height: 1.6;
    margin: 0 0 24px 0;
  }

  /* Filter Tabs */
  .filter-tabs-bar {
    display: inline-flex;
    align-items: center;
    background-color: #F6F2EA;
    border: 1px solid rgba(15, 35, 64, 0.12);
    border-radius: 9999px;
    padding: 4px;
    gap: 4px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .filter-tab {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: none;
    padding: 8px 18px;
    border-radius: 9999px;
    font-family: var(--font-family-base);
    font-size: 0.875rem;
    font-weight: 600;
    color: #4B5563;
    cursor: pointer;
    transition: all 0.18s ease;
  }

  .filter-tab:hover {
    color: #0F2340;
  }

  .filter-tab.is-active {
    background-color: #0F2340;
    color: #FFFFFF;
    box-shadow: 0 2px 8px rgba(15, 35, 64, 0.15);
  }

  .accepting-dot {
    color: #A88B5A;
  }

  .on-request-dot {
    color: #6B7280;
  }

  /* Cards Grid: Exactly 8 Cards in 4 columns x 2 rows */
  .specialties-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 28px;
  }

  .treatment-card {
    background-color: #FFFFFF;
    border: 1px solid rgba(15, 35, 64, 0.12);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(15, 35, 64, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .treatment-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px -4px rgba(15, 35, 64, 0.12);
    border-color: #A88B5A;
  }

  /* Navy Top Visual Panel with Subtle Waves on ALL 8 cards */
  .card-navy-panel {
    background-color: #0F2340;
    position: relative;
    padding: 20px 20px 18px;
    overflow: hidden;
    border-bottom: 2px solid #A88B5A;
    color: #FFFFFF;
  }

  .subtle-wave-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.9;
  }

  .panel-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    position: relative;
    z-index: 1;
    margin-bottom: 14px;
  }

  .card-number {
    font-family: var(--font-family-base);
    font-size: 0.8125rem;
    font-weight: 700;
    color: #A88B5A;
    letter-spacing: 0.06em;
  }

  .status-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 2.5px 8.5px;
    border-radius: 9999px;
    position: relative;
    z-index: 1;
  }

  .tag-accepting {
    background-color: rgba(38, 115, 77, 0.3);
    color: #E3EBE3;
    border: 1px solid rgba(74, 222, 128, 0.45);
  }

  .tag-on-request {
    background-color: rgba(255, 255, 255, 0.1);
    color: #DCE3EC;
    border: 1px solid rgba(255, 255, 255, 0.22);
  }

  .status-dot {
    font-size: 0.7rem;
  }

  .panel-titles {
    position: relative;
    z-index: 1;
  }

  .card-title {
    font-family: var(--font-family-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 3px 0;
    line-height: 1.22;
  }

  .card-title-link {
    color: #FFFFFF;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .card-title-link:hover {
    color: #A88B5A;
  }

  .card-subtitle {
    display: block;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #A88B5A;
    letter-spacing: 0.02em;
  }

  /* Lower Ivory/White Content Panel */
  .card-content-panel {
    background-color: #FAF8F5;
    padding: 18px 20px 18px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    min-height: 135px;
  }

  .card-description {
    font-size: 0.85rem;
    color: #4B5563;
    line-height: 1.5;
    margin: 0 0 16px 0;
  }

  .card-footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    border-top: 1px solid rgba(15, 35, 64, 0.08);
    padding-top: 12px;
    margin-top: auto;
  }

  .card-link-action {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #0F2340;
    text-decoration: none;
    transition: color 0.15s ease, gap 0.15s ease;
  }

  .card-link-action:hover {
    color: #A88B5A;
    gap: 8px;
  }

  .card-opinion-btn {
