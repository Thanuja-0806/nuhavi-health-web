---
/**
 * SpecialtyExplorer.astro
 * Shared specialty explorer component for Homepage and Treatments page.
 * Localized for English (/en/), Russian (/ru/), and Arabic (/ar/ RTL).
 */
import { homeTranslations } from '../../i18n/homeTranslations';
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  eyebrow?: string;
  heading?: string;
  headingLevel?: 'h1' | 'h2';
  supportingText?: string;
  variant?: 'home' | 'page';
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const content = homeTranslations[lang].specialties;

const {
  eyebrow = content.eyebrow,
  heading = content.title,
  headingLevel = 'h2',
  supportingText = content.deck,
  variant = 'home',
} = Astro.props;

const HeadingTag = headingLevel;
const CardTitleTag = headingLevel === 'h1' ? 'h2' : 'h3';

const specialties = content.items;

const acceptingSpecialties = specialties.filter((s) => s.status === 'accepting');
const onRequestSpecialties = specialties.filter((s) => s.status === 'on-request');
---

<section
  class={`specialty-explorer-section variant-${variant}`}
  aria-labelledby="specialty-section-heading"
>
  <div class="container specialty-container">
    <header class="specialty-header">
      <div class="header-content">
        <span class="section-eyebrow">{eyebrow}</span>
        <HeadingTag id="specialty-section-heading" class="section-title">
          {heading}
        </HeadingTag>
        <p class="section-supporting-text">
          {supportingText}
        </p>
      </div>

      <!-- Filter Controls -->
      <div
        class="filter-controls"
        role="group"
        aria-label="Filter medical specialties"
      >
        <button
          type="button"
          class="filter-btn active"
          data-filter="all"
          aria-pressed="true"
        >
          {lang === 'ru' ? 'Все 10' : lang === 'ar' ? 'الكل (10)' : 'All 10'}
        </button>
        <button
          type="button"
          class="filter-btn"
          data-filter="accepting"
          aria-pressed="false"
        >
          {content.acceptingLabel} ({acceptingSpecialties.length})
        </button>
        <button
          type="button"
          class="filter-btn"
          data-filter="on-request"
          aria-pressed="false"
        >
          {content.onRequestLabel} ({onRequestSpecialties.length})
        </button>
      </div>
    </header>

    <!-- Specialties Grid -->
    <div class="specialties-grid" id="specialties-grid">
      {specialties.map((specialty) => {
        const isFeatured = specialty.status === 'accepting';
        const cardClass = `specialty-card ${specialty.status} ${isFeatured ? 'featured' : ''}`;
        const isCancerCare = specialty.id === 'cancer-care';

        return isCancerCare ? (
          <a
            href="/en/treatments/oncology/"
            class={`${cardClass} is-link`}
            data-status={specialty.status}
            aria-label={`${specialty.title} - ${specialty.statusLabel}`}
          >
            <div class="card-inner">
              <div class="card-status-header">
                <span class={`status-badge ${specialty.status}`}>
                  {specialty.statusLabel}
                </span>
                <span class="card-arrow" aria-hidden="true">&rarr;</span>
              </div>
              <CardTitleTag class="card-title">
                {specialty.title}
              </CardTitleTag>
              <p class="card-description">
                {specialty.description}
              </p>
            </div>
          </a>
        ) : (
          <div
            class={cardClass}
            data-status={specialty.status}
          >
            <div class="card-inner">
              <div class="card-status-header">
                <span class={`status-badge ${specialty.status}`}>
                  {specialty.statusLabel}
                </span>
              </div>
              <CardTitleTag class="card-title">
                {specialty.title}
              </CardTitleTag>
              <p class="card-description">
                {specialty.description}
              </p>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Footnote below grid -->
    <div class="specialty-footnote">
      <p>
        <strong>{lang === 'ru' ? 'Обратите внимание:' : lang === 'ar' ? 'ملاحظة:' : 'Note:'}</strong> {lang === 'ru' ? 'По направлениям «По запросу» мы рассматриваем каждый случай индивидуально с профильными клиниками.' : lang === 'ar' ? 'بالنسبة للتخصصات المصنفة «حسب الطلب»، نراجع كل حالة بشكل منفرد مع المستشفيات التخصصية.' : 'For specialties listed as "On request", we coordinate directly with accredited partner hospitals on a case-by-case basis.'}
      </p>
    </div>
  </div>
</section>

<style>
  .specialty-explorer-section {
    width: 100%;
    padding: var(--space-10) 0 var(--space-12);
  }

  .variant-home {
    background-color: var(--color-mist);
  }

  .variant-page {
    background-color: var(--color-paper);
  }

  .specialty-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-3);
    box-sizing: border-box;
  }

  .specialty-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 900px) {
    .specialty-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      gap: var(--space-6);
    }
  }

  .header-content {
    max-width: 640px;
  }

  .section-eyebrow {
    font-size: 0.8125rem;
    font-weight: var(--font-weight-subheading);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gold);
    line-height: 1.2;
    display: block;
    margin-bottom: var(--space-1);
  }

  .section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: var(--font-weight-heading);
    color: var(--color-deep-navy);
    line-height: var(--line-height-heading);
    letter-spacing: -0.02em;
    margin: 0 0 var(--space-2);
  }

  .section-supporting-text {
    font-size: 1rem;
    font-weight: var(--font-weight-body);
    line-height: var(--line-height-body);
    color: var(--color-slate);
    margin: 0;
  }

  /* Filter Controls */
  .filter-controls {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    background-color: var(--color-paper);
    padding: 4px;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(20, 41, 75, 0.1);
  }

  .filter-btn {
    background: transparent;
    border: none;
    border-radius: var(--radius-pill);
    padding: 6px 14px;
    font-family: var(--font-family-base);
    font-size: 0.8125rem;
    font-weight: var(--font-weight-subheading);
    color: var(--color-slate);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filter-btn:hover {
    color: var(--color-navy);
  }

  .filter-btn.active {
    background-color: var(--color-deep-navy);
    color: var(--color-paper);
  }

  /* Specialties Grid */
  .specialties-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .specialties-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .specialties-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .specialty-card.featured {
      grid-column: span 2;
    }
  }

  .specialty-card {
    background-color: var(--color-paper);
    border: 1px solid rgba(20, 41, 75, 0.08);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .specialty-card.is-link:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(20, 41, 75, 0.08);
    border-color: rgba(196, 154, 60, 0.5);
  }

  .card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .card-status-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .status-badge {
    font-size: 0.6875rem;
    font-weight: var(--font-weight-subheading);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 3px 8px;
    border-radius: var(--radius-pill);
  }

  .status-badge.accepting {
    background-color: rgba(38, 115, 77, 0.1);
    color: var(--color-success);
    border: 1px solid rgba(38, 115, 77, 0.25);
  }

  .status-badge.on-request {
    background-color: rgba(91, 106, 128, 0.1);
    color: var(--color-slate);
    border: 1px solid rgba(91, 106, 128, 0.2);
  }

  .card-arrow {
    color: var(--color-gold);
    font-size: 1.125rem;
    transition: transform 0.2s ease;
  }

  .specialty-card.is-link:hover .card-arrow {
    transform: translateX(4px);
  }

  :global([dir="rtl"]) .specialty-card.is-link:hover .card-arrow {
    transform: translateX(-4px);
  }

  .card-title {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--color-deep-navy);
    line-height: 1.3;
    margin: 0 0 var(--space-2);
  }

  .card-description {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-slate);
    margin: 0;
  }

  .specialty-footnote {
    margin-top: var(--space-6);
    padding: var(--space-3) var(--space-4);
    background-color: rgba(20, 41, 75, 0.03);
    border-radius: var(--radius-card);
    font-size: 0.8125rem;
    color: var(--color-slate);
  }

  /* RTL Support */
  :global([dir="rtl"]) .header-content,
  :global([dir="rtl"]) .card-title,
  :global([dir="rtl"]) .card-description,
  :global([dir="rtl"]) .specialty-footnote {
    text-align: right;
  }
</style>
