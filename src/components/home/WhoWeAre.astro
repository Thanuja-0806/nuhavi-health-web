---
/**
 * src/components/home/WhoWeAre.astro
 * Homepage section: "Who we are, and who we are not" & 4 Trust Cards
 * Localized for English (/en/), Russian (/ru/), and Arabic (/ar/ RTL).
 */
import { homeTranslations } from '../../i18n/homeTranslations';
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const who = homeTranslations[lang].whoWeAre;
---

<section class="who-we-are-section" aria-labelledby="who-we-are-heading">
  <div class="container who-container">
    <!-- Top 3-Column Layout: Who we are | We do | We do not -->
    <div class="who-grid">
      <!-- Col 1: Main statement -->
      <div class="who-col-intro">
        <h2 id="who-we-are-heading" class="who-title">
          {who.title}
        </h2>
        <p class="who-deck">
          {who.deck}
        </p>
      </div>

      <!-- Col 2: We do -->
      <div class="who-col-list">
        <h3 class="list-heading">{who.weDoTitle}</h3>
        <ul class="we-do-list">
          {who.weDoItems.map((item) => (
            <li>
              <span class="check-mark" aria-hidden="true">&#10003;</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: We do not -->
      <div class="who-col-list">
        <h3 class="list-heading">{who.weDoNotTitle}</h3>
        <ul class="we-do-not-list">
          {who.weDoNotItems.map((item) => (
            <li>
              <span class="cross-mark" aria-hidden="true">&#10005;</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom 4 Trust Cards (Page 5) -->
    <div class="trust-cards-grid">
      {who.trustCards.map((card) => (
        <div class="trust-card">
          <h3 class="trust-card-title">{card.title}</h3>
          <p class="trust-card-text">
            {card.text}
            {card.marker && <span class="amber-marker">{card.marker}</span>}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .who-we-are-section {
    width: 100%;
    background-color: var(--color-paper);
    padding: var(--space-12) 0 var(--space-10);
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
  }

  .who-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-4);
    box-sizing: border-box;
  }

  .who-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 900px) {
    .who-grid {
      grid-template-columns: 4fr 4fr 4fr;
      gap: var(--space-8);
      align-items: start;
    }
  }

  .who-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1.2;
    margin: 0 0 var(--space-3);
  }

  .who-deck {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-slate);
    margin: 0;
  }

  .list-heading {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0 0 var(--space-4);
  }

  .we-do-list,
  .we-do-not-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .we-do-list li,
  .we-do-not-list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-ink);
  }

  .check-mark {
    color: var(--color-success);
    font-weight: 800;
    font-size: 1rem;
    line-height: 1.3;
    flex-shrink: 0;
  }

  .cross-mark {
    color: var(--color-slate);
    font-weight: 700;
    font-size: 0.9375rem;
    line-height: 1.3;
    flex-shrink: 0;
  }

  /* 4 Trust Cards Grid */
  .trust-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    padding-top: var(--space-8);
    border-top: 1px solid rgba(20, 41, 75, 0.08);
  }

  @media (min-width: 600px) {
    .trust-cards-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .trust-cards-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-5);
    }
  }

  .trust-card {
    background-color: var(--color-mist);
    border: 1px solid rgba(20, 41, 75, 0.08);
    border-radius: var(--radius-card);
    padding: var(--space-5);
  }

  .trust-card-title {
    font-size: 1rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0 0 var(--space-2);
    line-height: 1.3;
  }

  .trust-card-text {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-slate);
    margin: 0;
  }

  .amber-marker {
    display: inline;
    background-color: var(--color-confirmation);
    border: 1px solid var(--color-gold);
    color: var(--color-gold-text);
    padding: 1px 4px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    margin-left: 2px;
  }

  /* RTL Support */
  :global([dir="rtl"]) .who-title,
  :global([dir="rtl"]) .who-deck,
  :global([dir="rtl"]) .list-heading,
  :global([dir="rtl"]) .trust-card-title,
  :global([dir="rtl"]) .trust-card-text {
    text-align: right;
  }
</style>
