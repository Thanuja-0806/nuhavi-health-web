---
/**
 * src/components/home/PrepareWithConfidence.astro
 * Homepage: "Prepare with confidence"
 * Reference: Page 10 of Nuhavi Health Look and Feel PDF.
 * Localized for English (/en/), Russian (/ru/), and Arabic (/ar/ RTL).
 */
import { homeTranslations } from '../../i18n/homeTranslations';
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const content = homeTranslations[lang].prepareWithConfidence;
const guides = content.guides;
---

<section class="prepare-section" aria-labelledby="prepare-heading">
  <div class="container prepare-container">
    <div class="prepare-header">
      <div class="header-left">
        <h2 id="prepare-heading" class="prepare-title">
          {content.title}
        </h2>
      </div>
      <div class="header-right">
        <p class="prepare-deck">
          {content.deck}
        </p>
      </div>
    </div>

    <!-- 6 Guide Cards Grid (3 cols x 2 rows on desktop) -->
    <div class="guides-grid">
      {guides.map((guide) => (
        <a href={guide.href} class="guide-card">
          <div class="guide-card-top">
            <span class="guide-tag">{lang === 'ru' ? 'Руководство' : lang === 'ar' ? 'دليل إرشادي' : 'Guide'}</span>
            <span class="guide-arrow" aria-hidden="true">&rarr;</span>
          </div>
          <h3 class="guide-title">{guide.title}</h3>
          <p class="guide-desc">{guide.desc}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .prepare-section {
    width: 100%;
    background-color: var(--color-mist);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
  }

  .prepare-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-4);
    box-sizing: border-box;
  }

  .prepare-header {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  @media (min-width: 900px) {
    .prepare-header {
      grid-template-columns: 5fr 7fr;
      align-items: end;
      gap: var(--space-8);
    }
  }

  .prepare-title {
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1.2;
    margin: 0;
  }

  .prepare-deck {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-slate);
    margin: 0;
  }

  /* 6 Guides Grid */
  .guides-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 640px) {
    .guides-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .guides-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .guide-card {
    background-color: #FFFFFF;
    border: 1px solid rgba(20, 41, 75, 0.08);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .guide-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(20, 41, 75, 0.06);
    border-color: rgba(196, 154, 60, 0.4);
  }

  .guide-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .guide-tag {
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-gold-text);
    background-color: var(--color-confirmation);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid rgba(196, 154, 60, 0.25);
  }

  .guide-arrow {
    color: var(--color-gold);
    font-size: 1.125rem;
    transition: transform 0.2s ease;
  }

  .guide-card:hover .guide-arrow {
    transform: translateX(4px);
  }

  :global([dir="rtl"]) .guide-card:hover .guide-arrow {
    transform: translateX(-4px);
  }

  .guide-title {
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1.35;
    margin: 0 0 var(--space-2);
  }

  .guide-desc {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: var(--color-slate);
    margin: 0;
  }

  /* RTL Support */
  :global([dir="rtl"]) .prepare-title,
  :global([dir="rtl"]) .prepare-deck,
  :global([dir="rtl"]) .guide-title,
  :global([dir="rtl"]) .guide-desc {
    text-align: right;
  }
</style>
