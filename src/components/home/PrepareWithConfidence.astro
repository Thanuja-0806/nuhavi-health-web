---
/**
 * src/components/home/PrepareWithConfidence.astro
 * Homepage: "Prepare with confidence" — 12-Page PDF (Page 6)
 *
 * Heading: Prepare with confidence
 * Link: All guides →
 * Exactly 3 guides:
 * 1. Medical visa for India: a step-by-step guide (Reviewed by a Nuhavi doctor · 7 min read)
 * 2. How to read a hospital estimate (Reviewed by a Nuhavi doctor · 6 min read)
 * 3. Preparing your medical records (Reviewed by a Nuhavi doctor · 5 min read)
 */
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : currentPath.startsWith('/fr')
  ? 'fr'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const isArabic = lang === 'ar';
const isRussian = lang === 'ru';
const isFrench = lang === 'fr';

const prefix = `/${lang}`;
const allGuidesHref = `${prefix}/resources/`;

const t = {
  heading: isArabic ? 'استعد للرحلة بثقة واطمئنان' : isRussian ? 'Готовьтесь к поездке с уверенностью' : 'Prepare with confidence',
  allGuidesLink: isArabic ? 'جميع الأدلة ←' : isRussian ? 'Все руководства →' : 'All guides →',
  guides: [
    {
      title: isArabic
        ? 'التأشيرة الطبية للهند: دليل خطوة بخطوة'
        : isRussian
        ? 'Медицинская виза в Индию: пошаговое руководство'
        : 'Medical visa for India: a step-by-step guide',
      meta: isArabic
        ? 'مراجعة طبية بواسطة أطباء نوهـافي · قراءة في 7 دقائق'
        : isRussian
        ? 'Проверено врачом Nuhavi · время чтения: 7 мин'
        : 'Reviewed by a Nuhavi doctor · 7 min read',
      href: `${prefix}/resources/understanding-treatment-estimate/`,
    },
    {
      title: isArabic
        ? 'كيف تقرأ تقدير تكلفة المستشفى'
        : isRussian
        ? 'Как читать смету расходов из клиники'
        : 'How to read a hospital estimate',
      meta: isArabic
        ? 'مراجعة طبية بواسطة أطباء نوهـافي · قراءة في 6 دقائق'
        : isRussian
        ? 'Проверено врачом Nuhavi · время чтения: 6 мин'
        : 'Reviewed by a Nuhavi doctor · 6 min read',
      href: `${prefix}/how-it-works/costs-and-fees/`,
    },
    {
      title: isArabic
        ? 'تجهيز ملفك وتقاريرك الطبية'
        : isRussian
        ? 'Как правильно подготовить медицинские выписки'
        : 'Preparing your medical records',
      meta: isArabic
        ? 'مراجعة طبية بواسطة أطباء نوهـافي · قراءة في 5 دقائق'
        : isRussian
        ? 'Проверено врачом Nuhavi · время чтения: 5 мин'
        : 'Reviewed by a Nuhavi doctor · 5 min read',
      href: `${prefix}/resources/preparing-medical-records/`,
    },
  ],
};
---

<section class="prepare-section" aria-labelledby="prepare-heading" dir={isArabic ? 'rtl' : 'ltr'}>
  <div class="container prepare-container">
    <div class="prepare-header-row">
      <h2 id="prepare-heading" class="prepare-title">
        {t.heading}
      </h2>
      <a href={allGuidesHref} class="all-guides-link">
        <span>{t.allGuidesLink}</span>
      </a>
    </div>

    <!-- 3 Guide Cards (PDF Page 6) -->
    <div class="guides-grid">
      {t.guides.map((guide) => (
        <a href={guide.href} class="guide-card">
          <h3 class="guide-title">{guide.title}</h3>
          <span class="guide-meta">{guide.meta}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .prepare-section {
    width: 100%;
    background-color: #FFFFFF;
    padding: clamp(56px, 7vw, 80px) 0;
    border-bottom: 1px solid rgba(15, 35, 64, 0.08);
  }

  .prepare-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 40px);
    box-sizing: border-box;
  }

  .prepare-header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 36px;
    flex-wrap: wrap;
  }

  .prepare-title {
    font-family: var(--font-family-heading);
    font-size: clamp(2rem, 3vw, 2.7rem);
    color: #0F2340;
    font-weight: 600;
    margin: 0;
    line-height: 1.2;
  }

  .all-guides-link {
    font-size: 0.9375rem;
    font-weight: 600;
    color: #0F2340;
    text-decoration: underline;
    transition: color 0.15s ease;
  }

  .all-guides-link:hover {
    color: #A88B5A;
  }

  /* 3 Guides in a row */
  .guides-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .guide-card {
    background-color: #FAF8F5;
    border: 1px solid rgba(15, 35, 64, 0.1);
    border-radius: 8px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    text-decoration: none;
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }

  .guide-card:hover {
    border-color: #A88B5A;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(15, 35, 64, 0.06);
  }

  .guide-title {
    font-family: var(--font-family-heading);
    font-size: 1.25rem;
    font-weight: 600;
    color: #0F2340;
    margin: 0;
    line-height: 1.35;
  }

  .guide-meta {
    font-size: 0.785rem;
    color: #64748B;
  }

  @media (max-width: 860px) {
    .guides-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
