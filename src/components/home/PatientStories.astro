---
/**
 * src/components/home/PatientStories.astro
 * Homepage: "Patient stories"
 * Reference: Page 9 of Nuhavi Health Look and Feel PDF.
 * Localized for English (/en/), Russian (/ru/), and Arabic (/ar/ RTL).
 */
import { homeTranslations } from '../../i18n/homeTranslations';
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const content = homeTranslations[lang].patientStories;
---

<section class="patient-stories-section" aria-labelledby="patient-stories-heading">
  <div class="container stories-container">
    <div class="stories-grid">
      <!-- Left Column: Title, Deck, Link -->
      <div class="stories-left-col">
        <h2 id="patient-stories-heading" class="stories-title">
          {content.title}
        </h2>
        <p class="stories-deck">
          {content.deck}
        </p>

        <div class="stories-link-wrap">
          <a href="/en/stories/" class="stories-text-link">
            {content.linkText} <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Ethical Policy Card -->
      <div class="stories-right-col">
        <div class="stories-policy-card">
          <div class="policy-gold-bar" aria-hidden="true"></div>
          <h3 class="policy-title">{content.policyTitle}</h3>
          <p class="policy-text">
            {content.policyText}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .patient-stories-section {
    width: 100%;
    background-color: var(--color-paper);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
  }

  .stories-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-4);
    box-sizing: border-box;
  }

  .stories-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 900px) {
    .stories-grid {
      grid-template-columns: 6fr 6fr;
      gap: var(--space-10);
      align-items: center;
    }
  }

  .stories-left-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .stories-title {
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1.2;
    margin: 0;
  }

  .stories-deck {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-slate);
    margin: 0;
  }

  .stories-link-wrap {
    margin-top: var(--space-2);
  }

  .stories-text-link {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-gold-text);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.15s ease;
  }

  .stories-text-link:hover {
    color: var(--color-navy);
    text-decoration: underline;
  }

  :global([dir="rtl"]) .stories-text-link span {
    display: inline-block;
    transform: scaleX(-1);
  }

  /* Right Column: Policy Card */
  .stories-policy-card {
    background-color: var(--color-mist);
    border: 1px solid rgba(20, 41, 75, 0.08);
    border-radius: var(--radius-card);
    padding: var(--space-8);
    position: relative;
    overflow: hidden;
  }

  .policy-gold-bar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background-color: var(--color-gold);
  }

  .policy-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0 0 var(--space-3);
  }

  .policy-text {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-slate);
    margin: 0;
  }

  /* RTL Support */
  :global([dir="rtl"]) .stories-title,
  :global([dir="rtl"]) .stories-deck,
  :global([dir="rtl"]) .policy-title,
  :global([dir="rtl"]) .policy-text {
    text-align: right;
  }
</style>
