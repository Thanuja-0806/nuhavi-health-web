---
/**
 * src/components/home/CoordinatorBenefits.astro
 * Homepage: "Why patients and families choose a coordinator"
 * Reference: Page 8 of Nuhavi Health Look and Feel PDF.
 * Localized for English (/en/), Russian (/ru/), and Arabic (/ar/ RTL).
 */
import { homeTranslations } from '../../i18n/homeTranslations';
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const content = homeTranslations[lang].coordinatorBenefits;
const benefitCards = content.cards;
---

<section class="coordinator-benefits-section" aria-labelledby="coordinator-benefits-heading">
  <div class="container benefits-container">
    <div class="benefits-header">
      <h2 id="coordinator-benefits-heading" class="benefits-title">
        {content.title}
      </h2>
      <p class="benefits-deck">
        {content.deck}
      </p>
    </div>

    <!-- 10 Benefit Cards Grid (5 cols x 2 rows on desktop) -->
    <div class="benefits-grid">
      {benefitCards.map((card, idx) => (
        <div class="benefit-card">
          <div class="benefit-card-header">
            <span class="card-num">{String(idx + 1).padStart(2, '0')}</span>
            <div class="benefit-icon-badge" aria-hidden="true">
              {idx === 0 && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
              )}
              {idx === 1 && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="1" x2="12" y2="23"></line>
                  <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
              )}
              {idx === 2 && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                </svg>
              )}
              {idx === 3 && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              )}
              {idx === 4 && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="22" y1="12" x2="18" y2="12"></line>
                  <line x1="6" y1="12" x2="2" y2="12"></line>
                  <line x1="12" y1="6" x2="12" y2="2"></line>
                  <line x1="12" y1="22" x2="12" y2="18"></line>
                </svg>
              )}
              {idx === 5 && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                </svg>
              )}
              {idx === 6 && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              )}
              {idx === 7 && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="2" y1="12" x2="22" y2="12"></line>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
              )}
              {idx === 8 && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
              )}
              {idx === 9 && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path>
                </svg>
              )}
            </div>
          </div>
          <h3 class="card-title">{card.title}</h3>
          <p class="card-desc">{card.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .coordinator-benefits-section {
    width: 100%;
    background: radial-gradient(circle at 85% 15%, rgba(196, 154, 60, 0.08) 0%, transparent 45%),
                linear-gradient(180deg, #091322 0%, #0D1B33 50%, #0A1527 100%);
    color: var(--color-paper);
    padding: var(--space-12) 0;
    border-top: 1px solid rgba(196, 154, 60, 0.2);
    border-bottom: 1px solid rgba(196, 154, 60, 0.2);
  }

  .benefits-container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--space-4);
    box-sizing: border-box;
  }

  .benefits-header {
    max-width: 760px;
    margin-bottom: var(--space-10);
  }

  .benefits-title {
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: var(--color-paper);
    line-height: 1.2;
    margin: 0 0 var(--space-3);
  }

  .benefits-deck {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(244, 247, 251, 0.7);
    margin: 0;
  }

  /* 10 Benefit Cards Grid */
  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 600px) {
    .benefits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .benefits-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1140px) {
    .benefits-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .benefit-card {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    backdrop-filter: blur(4px);
    transition: background-color 0.2s ease, transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .benefit-card:hover {
    background-color: rgba(255, 255, 255, 0.09);
    border-color: rgba(196, 154, 60, 0.45);
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .benefit-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .benefit-icon-badge {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(196, 154, 60, 0.12);
    color: var(--color-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .benefit-card:hover .benefit-icon-badge {
    background: var(--color-gold);
    color: var(--color-deep-navy);
    transform: scale(1.08);
  }

  .card-num {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-gold);
    letter-spacing: 0.05em;
  }

  .card-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-paper);
    line-height: 1.3;
    margin: 0 0 var(--space-2);
  }

  .card-desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgba(244, 247, 251, 0.7);
    margin: 0;
  }

  /* RTL Support */
  :global([dir="rtl"]) .benefits-header,
  :global([dir="rtl"]) .benefits-title,
  :global([dir="rtl"]) .benefits-deck,
  :global([dir="rtl"]) .card-title,
  :global([dir="rtl"]) .card-desc {
    text-align: right;
  }
</style>
