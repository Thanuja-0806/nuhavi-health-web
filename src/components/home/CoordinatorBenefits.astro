---
/**
 * src/components/home/CoordinatorBenefits.astro
 * Homepage: "Why patients and families choose a coordinator"
 * Reference: Page 8 of Nuhavi Health Look and Feel PDF.
 * Localized for English (/en/), Russian (/ru/), and Arabic (/ar/ RTL).
 */
import { homeTranslations } from '../../i18n/homeTranslations';
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const content = homeTranslations[lang].coordinatorBenefits;
const benefitCards = content.cards;
---

<section class="coordinator-benefits-section" aria-labelledby="coordinator-benefits-heading">
  <div class="container benefits-container">
    <div class="benefits-header">
      <h2 id="coordinator-benefits-heading" class="benefits-title">
        {content.title}
      </h2>
      <p class="benefits-deck">
        {content.deck}
      </p>
    </div>

    <!-- 10 Benefit Cards Grid (5 cols x 2 rows on desktop) -->
    <div class="benefits-grid">
      {benefitCards.map((card, idx) => (
        <div class="benefit-card">
          <span class="card-num">{String(idx + 1).padStart(2, '0')}</span>
          <h3 class="card-title">{card.title}</h3>
          <p class="card-desc">{card.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .coordinator-benefits-section {
    width: 100%;
    background-color: var(--color-deep-navy);
    color: var(--color-paper);
    padding: var(--space-12) 0;
  }

  .benefits-container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 var(--space-4);
    box-sizing: border-box;
  }

  .benefits-header {
    max-width: 760px;
    margin-bottom: var(--space-10);
  }

  .benefits-title {
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: var(--color-paper);
    line-height: 1.2;
    margin: 0 0 var(--space-3);
  }

  .benefits-deck {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(244, 247, 251, 0.7);
    margin: 0;
  }

  /* 10 Benefit Cards Grid */
  .benefits-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media (min-width: 600px) {
    .benefits-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .benefits-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1140px) {
    .benefits-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .benefit-card {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-card);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .benefit-card:hover {
    background-color: rgba(255, 255, 255, 0.07);
    transform: translateY(-2px);
  }

  .card-num {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--color-gold);
    margin-bottom: var(--space-2);
    letter-spacing: 0.05em;
  }

  .card-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-paper);
    line-height: 1.3;
    margin: 0 0 var(--space-2);
  }

  .card-desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgba(244, 247, 251, 0.7);
    margin: 0;
  }

  /* RTL Support */
  :global([dir="rtl"]) .benefits-header,
  :global([dir="rtl"]) .benefits-title,
  :global([dir="rtl"]) .benefits-deck,
  :global([dir="rtl"]) .card-title,
  :global([dir="rtl"]) .card-desc {
    text-align: right;
  }
</style>
