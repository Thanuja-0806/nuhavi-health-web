---
/**
 * src/components/home/PatientJourney.astro
 * Homepage 7-Step Patient Journey Section
 * Reference: Page 8 of Nuhavi Health Look and Feel PDF.
 * Localized for English (/en/), Russian (/ru/), and Arabic (/ar/ RTL).
 */
import { homeTranslations } from '../../i18n/homeTranslations';
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const content = homeTranslations[lang].patientJourney;
const steps = content.steps;
const legend = content.legend;
---

<section class="patient-journey-section" aria-labelledby="journey-heading">
  <div class="container journey-container">
    <div class="journey-grid">
      <!-- Left Column: Heading, Deck & Responsibility Legend -->
      <div class="journey-left-col">
        <h2 id="journey-heading" class="journey-title">
          {content.title}
        </h2>
        <p class="journey-deck">
          {content.deck}
        </p>

        <!-- Responsibility Legend Swatches (PDF Page 8) -->
        <div class="responsibility-legend" aria-label="Responsibility Legend">
          <div class="legend-item">
            <span class="legend-swatch swatch-you"></span>
            <span class="legend-label">{legend.you}</span>
          </div>
          <div class="legend-item">
            <span class="legend-swatch swatch-nuhavi"></span>
            <span class="legend-label">{legend.nuhavi}</span>
          </div>
          <div class="legend-item">
            <span class="legend-swatch swatch-hospital"></span>
            <span class="legend-label">{legend.hospital}</span>
          </div>
          <div class="legend-item">
            <span class="legend-swatch swatch-receive"></span>
            <span class="legend-label">{legend.receive}</span>
          </div>
        </div>

        <div class="journey-cta-wrap">
          <a href="/en/how-it-works/" class="btn-pill-primary">
            {content.fullProcessCta}
          </a>
        </div>
      </div>

      <!-- Right Column: 7-Step Accordion / Disclosure List -->
      <div class="journey-right-col">
        <div class="steps-accordion">
          {steps.map((step, idx) => (
            <details class="step-disclosure" open={idx === 0}>
              <summary class="step-summary">
                <span class="step-num">Step {step.num}</span>
                <span class="step-name">{step.title}</span>
                <span class="step-toggle-icon" aria-hidden="true">+</span>
              </summary>
              <div class="step-content">
                <div class="step-grid-four">
                  <div class="step-box box-you">
                    <span class="box-tag">{legend.you}</span>
                    <p class="box-text">{step.you}</p>
                  </div>
                  <div class="step-box box-nuhavi">
                    <span class="box-tag">{legend.nuhavi}</span>
                    <p class="box-text">{step.nuhavi}</p>
                  </div>
                  <div class="step-box box-hospital">
                    <span class="box-tag">{legend.hospital}</span>
                    <p class="box-text">{step.hospital}</p>
                  </div>
                  <div class="step-box box-receive">
                    <span class="box-tag">{legend.receive}</span>
                    <p class="box-text">{step.receive}</p>
                  </div>
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .patient-journey-section {
    width: 100%;
    background-color: var(--color-paper);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
  }

  .journey-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-4);
    box-sizing: border-box;
  }

  .journey-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 960px) {
    .journey-grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-10);
      align-items: start;
    }
  }

  /* Left Column */
  .journey-left-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .journey-title {
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1.2;
    margin: 0;
  }

  .journey-deck {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-slate);
    margin: 0;
  }

  /* Responsibility Legend */
  .responsibility-legend {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: var(--space-2);
    padding: var(--space-4);
    background-color: var(--color-mist);
    border-radius: var(--radius-card);
    border: 1px solid rgba(20, 41, 75, 0.06);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--color-navy);
    font-weight: 600;
  }

  .legend-swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    flex-shrink: 0;
  }

  .swatch-you {
    background-color: #5B6A80;
  }
  .swatch-nuhavi {
    background-color: var(--color-gold);
  }
  .swatch-hospital {
    background-color: var(--color-navy);
  }
  .swatch-receive {
    background-color: var(--color-success);
  }

  .journey-cta-wrap {
    margin-top: var(--space-2);
  }

  .btn-pill-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    background-color: var(--color-navy);
    color: var(--color-paper);
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 0.875rem;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .btn-pill-primary:hover {
    background-color: var(--color-deep-navy);
    transform: translateY(-1px);
  }

  /* Right Column: Accordion */
  .steps-accordion {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .step-disclosure {
    background-color: var(--color-mist);
    border: 1px solid rgba(20, 41, 75, 0.08);
    border-radius: var(--radius-card);
    overflow: hidden;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .step-disclosure[open] {
    background-color: #FFFFFF;
    border-color: rgba(20, 41, 75, 0.18);
    box-shadow: 0 4px 16px rgba(20, 41, 75, 0.04);
  }

  .step-summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    cursor: pointer;
    user-select: none;
    list-style: none;
  }

  .step-summary::-webkit-details-marker {
    display: none;
  }

  .step-num {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--color-gold-text);
    background-color: var(--color-confirmation);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid rgba(196, 154, 60, 0.3);
    white-space: nowrap;
  }

  .step-name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-navy);
    flex-grow: 1;
    line-height: 1.35;
  }

  .step-toggle-icon {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-slate);
    transition: transform 0.2s ease;
  }

  .step-disclosure[open] .step-toggle-icon {
    transform: rotate(45deg);
  }

  .step-content {
    padding: 0 18px 18px;
  }

  .step-grid-four {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid rgba(20, 41, 75, 0.08);
  }

  @media (min-width: 600px) {
    .step-grid-four {
      grid-template-columns: 1fr 1fr;
    }
  }

  .step-box {
    padding: 12px;
    border-radius: 8px;
    border: 1px solid rgba(20, 41, 75, 0.08);
  }

  .box-you {
    background-color: #F8FAFC;
    border-left: 3px solid #5B6A80;
  }
  .box-nuhavi {
    background-color: #FFFDF9;
    border-left: 3px solid var(--color-gold);
  }
  .box-hospital {
    background-color: #F4F7FB;
    border-left: 3px solid var(--color-navy);
  }
  .box-receive {
    background-color: #F0FDF4;
    border-left: 3px solid var(--color-success);
  }

  :global([dir="rtl"]) .box-you {
    border-left: 1px solid rgba(20, 41, 75, 0.08);
    border-right: 3px solid #5B6A80;
  }
  :global([dir="rtl"]) .box-nuhavi {
    border-left: 1px solid rgba(20, 41, 75, 0.08);
    border-right: 3px solid var(--color-gold);
  }
  :global([dir="rtl"]) .box-hospital {
    border-left: 1px solid rgba(20, 41, 75, 0.08);
    border-right: 3px solid var(--color-navy);
  }
  :global([dir="rtl"]) .box-receive {
    border-left: 1px solid rgba(20, 41, 75, 0.08);
    border-right: 3px solid var(--color-success);
  }

  .box-tag {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-slate);
    margin-bottom: 4px;
  }

  .box-text {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-ink);
    margin: 0;
  }

  /* RTL Support */
  :global([dir="rtl"]) .journey-title,
  :global([dir="rtl"]) .journey-deck,
  :global([dir="rtl"]) .step-name,
  :global([dir="rtl"]) .box-text {
    text-align: right;
  }
</style>
