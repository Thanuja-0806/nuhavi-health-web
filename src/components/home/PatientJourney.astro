---
/**
 * src/components/home/PatientJourney.astro
 * Approved Four Steps & Coordinator Section — 12-Page PDF (Pages 4–5)
 *
 * Heading: Four steps. One coordinator throughout.
 * Four Steps:
 * 1. Share your case.
 * 2. Compare options.
 * 3. Travel with support.
 * 4. Treatment & home.
 *
 * Includes:
 * - Detailed first-step explanation & secure report-sharing process
 * - Sample coordinator WhatsApp conversation
 * - 9 Coordinator Services:
 *   1. Doctor review of records
 *   2. Hospital opinions
 *   3. Written estimates
 *   4. Visa invitation letter
 *   5. Airport reception
 *   6. Stay & local transport
 *   7. Interpreter at consultations
 *   8. Daily updates for family
 *   9. Follow-up after you return
 */
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : currentPath.startsWith('/fr')
  ? 'fr'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const isArabic = lang === 'ar';
const isRussian = lang === 'ru';
const isFrench = lang === 'fr';

const prefix = `/${lang}`;
const requestOpinionHref = `${prefix}/request-opinion/`;

const t = {
  eyebrow: isArabic ? 'كيف نعمل' : isRussian ? 'КАК ЭТО РАБОТАЕТ' : 'HOW IT WORKS',
  heading: isArabic
    ? 'أربع خطوات. منسق شخصي واحد طوال رحلتك.'
    : isRussian
    ? 'Четыре шага. Один координатор на всем пути.'
    : isFrench
    ? 'Quatre étapes. Un coordinateur dédié tout au long du parcours.'
    : 'Four steps. One coordinator throughout.',
  deck: isArabic
    ? 'من أول اتصال حتى عودتكم بسلام إلى الوطن، يرافقك نفس المنسق الطبي الذي يتحدث لغتك ويفهم احتياجات عائلتك.'
    : isRussian
    ? 'С первого обращения до благополучного возвращения домой с вами работает один и тот же координатор, говорящий на вашем языке.'
    : isFrench
    ? 'Du premier contact jusqu\'à votre retour en toute sécurité, le même coordinateur vous accompagne, parle votre langue et veille sur votre famille.'
    : 'From your first message until you are safely home, the same named coordinator manages your logistics, answers questions, and coordinates with the hospital.',
  steps: [
    {
      num: '01',
      title: isArabic ? '1. شارك تفاصيل حالتك' : isRussian ? '1. Отправьте данные' : '1. Share your case.',
      copy: isArabic
        ? 'أرسل نموذج الاستفسار الأولي. بعد استلامه، نرسل لك رابطاً مشفراً وخاصاً لرفع التقارير والأشعة ليتولى أطباؤنا دراستها.'
        : isRussian
        ? 'Заполните короткую форму запроса. После этого мы пришлем защищенную ссылку для загрузки медицинских выписок и снимков.'
        : 'Send a short enquiry. We email you a private 256-bit encrypted link to upload medical reports and scans for physician review.',
      badge: isArabic ? 'رابط تحميل آمن' : isRussian ? 'Безопасная ссылка' : 'Encrypted report upload',
    },
    {
      num: '02',
      title: isArabic ? '2. قارن الخيارات والتقديرات' : isRussian ? '2. Сравните варианты' : '2. Compare options.',
      copy: isArabic
        ? 'يقوم أطباؤنا بالتنسيق مع مستشفيات حيدر آباد المعتمدة للحصول على آراء طبية وتقديرات تكلفة مفصلة ومكتوبة للمقارنة بينها.'
        : isRussian
        ? 'Наши врачи связываются с клиниками Хайдарабада и получают официальные заключения и письменные расчеты стоимости.'
        : 'Our doctors request written clinical opinions and itemised cost estimates from accredited Hyderabad hospitals for side-by-side comparison.',
      badge: isArabic ? 'مقارنة شفافة' : isRussian ? 'Письменные сметы' : 'Written estimates',
    },
    {
      num: '03',
      title: isArabic ? '3. سافر مع الدعم الكامل' : isRussian ? '3. Поездка с поддержкой' : '3. Travel with support.',
      copy: isArabic
        ? 'نجهز خطاب دعوة التأشيرة الطبية، ونرتب استقبال المطار، والإقامة المريحة، والمواصلات المحلية ومترجماً عند الحاجة.'
        : isRussian
        ? 'Оформляем визовое приглашение, организуем встречу в аэропорту Хайдарабада, проживание, трансферы и переводчика.'
        : 'We arrange the medical visa invitation letter, airport reception at Hyderabad International Airport, stay, and local transit.',
      badge: isArabic ? 'استقبال وتأشيرة' : isRussian ? 'Виза и встреча' : 'Visa & airport pickup',
    },
    {
      num: '04',
      title: isArabic ? '4. العلاج والعودة للوطن' : isRussian ? '4. Лечение и возвращение' : '4. Treatment & home.',
      copy: isArabic
        ? 'مرافقة يومية أثناء الفحوصات والعمليات، وإحاطة العائلة بالمستجدات، ومتابعة التواصل الطبي مع الجراح بعد العودة.'
        : isRussian
        ? 'Координатор сопровождает вас на консультациях, информирует семью и организует телемедицинскую связь с врачом после выписки.'
        : 'Your coordinator stays at your side during consultations, provides daily updates to your family, and organizes post-treatment tele-follow-ups.',
      badge: isArabic ? 'رعاية مستمرة' : isRussian ? 'Связь с врачом' : 'Tele-follow-up',
    },
  ],
  servicesTitle: isArabic ? 'خدمات المنسق الشخصي' : isRussian ? 'Услуги персонального координатора' : 'Coordinator Services',
  servicesList: [
    isArabic ? 'مراجعة الأطباء للتقارير والملفات' : isRussian ? 'Врачебный анализ медицинских документов' : 'Doctor review of records',
    isArabic ? 'الحصول على آراء المستشفيات' : isRussian ? 'Официальные заключения ведущих клиник' : 'Hospital opinions',
    isArabic ? 'تقديرات تكلفة مكتوبة ومفصلة' : isRussian ? 'Постатейные письменные расчеты' : 'Written estimates',
    isArabic ? 'خطاب دعوة التأشيرة الطبية' : isRussian ? 'Визовое приглашение от клиники' : 'Visa invitation letter',
    isArabic ? 'الاستقبال من مطار حيدر آباد' : isRussian ? 'Встреча в аэропорту Хайдарабада' : 'Airport reception',
    isArabic ? 'ترتيبات الإقامة والمواصلات المحلية' : isRussian ? 'Организация проживания и трансферов' : 'Stay & local transport',
    isArabic ? 'مترجم مرافق أثناء الاستشارات الطبية' : isRussian ? 'Переводчик на очных консультациях' : 'Interpreter at consultations',
    isArabic ? 'تحديثات يومية لطمأنة العائلة' : isRussian ? 'Ежедневные отчеты для родственников' : 'Daily updates for family',
    isArabic ? 'المتابعة الطبية بعد العودة إلى الوطن' : isRussian ? 'Организация связи с хирургом после отъезда' : 'Follow-up after you return',
  ],
  chatTitle: isArabic ? 'محادثة منسقة الرعاية (نموذج توضيحي)' : isRussian ? 'Переписка с координатором (WhatsApp)' : 'Coordinator WhatsApp Conversation · Sample',
};
---

<section class="patient-journey-section" id="how-it-works" aria-labelledby="journey-heading">
  <div class="container journey-container">
    <div class="journey-header">
      <div class="journey-eyebrow">
        <span>{t.eyebrow}</span>
      </div>
      <h2 id="journey-heading" class="journey-title">
        {t.heading}
      </h2>
      <p class="journey-deck">
        {t.deck}
      </p>
    </div>

    <!-- 4 Steps Visual Pathway (PDF Page 4) -->
    <div class="steps-grid">
      {t.steps.map((step) => (
        <div class="step-card">
          <div class="step-top-row">
            <span class="step-num">{step.num}</span>
            <span class="step-badge">{step.badge}</span>
          </div>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-copy">{step.copy}</p>
        </div>
      ))}
    </div>

    <!-- Split Section: WhatsApp Conversation Sample & Coordinator Services List -->
    <div class="coordinator-details-card">
      <div class="details-grid">
        <!-- Left: WhatsApp Simulation Box -->
        <div class="whatsapp-sim-col">
          <div class="sim-phone-frame">
            <div class="sim-header">
              <div class="sim-avatar">
                <span>F</span>
                <span class="sim-status-dot"></span>
              </div>
              <div class="sim-contact">
                <span class="sim-name">Farida · Nuhavi Coordinator</span>
                <span class="sim-status">online · WhatsApp Business</span>
              </div>
            </div>

            <div class="sim-chat-body">
              <div class="msg msg-incoming">
                <p>Hello! I am Farida, your Nuhavi coordinator. Our doctors finished reviewing your knee MRI and pathology report.</p>
                <span class="msg-time">10:14 AM</span>
              </div>

              <div class="msg msg-incoming">
                <p>We received written surgical estimates from Hospital A and Hospital B in Gachibowli. I have prepared a side-by-side comparison for your family.</p>
                <span class="msg-time">10:15 AM</span>
              </div>

              <div class="msg msg-outgoing">
                <p>Thank you Farida! Does Hospital A's estimate include the robotic knee implant?</p>
                <span class="msg-time">10:18 AM</span>
              </div>

              <div class="msg msg-incoming">
                <p>Yes, exactly. It covers the FDA-approved implant, 5 inpatient room days, and surgeon fees. Shall we review the travel dates?</p>
                <span class="msg-time">10:20 AM</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Right: 9 Coordinator Services List -->
        <div class="services-list-col">
          <div class="services-header-row">
            <span class="services-badge">Full Coordination Scope</span>
            <h3 class="services-title">{t.servicesTitle}</h3>
          </div>

          <div class="services-numbered-grid">
            {t.servicesList.map((srv, sIdx) => (
              <div class="service-item">
                <span class="srv-num">0{sIdx + 1}</span>
                <span class="srv-text">{srv}</span>
              </div>
            ))}
          </div>

          <div class="services-action-row">
            <a href={requestOpinionHref} class="btn-journey-opinion">
              <span>Request a medical opinion</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .patient-journey-section {
    width: 100%;
    background-color: #FFFFFF;
    padding: clamp(64px, 8vw, 96px) 0;
    border-bottom: 1px solid rgba(15, 35, 64, 0.08);
  }

  .journey-container {
    max-width: 1366px;
    margin: 0 auto;
    padding-left: clamp(16px, 3vw, 40px);
    padding-right: clamp(16px, 3vw, 40px);
    box-sizing: border-box;
  }

  .journey-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 48px;
  }

  .journey-eyebrow {
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #A88B5A;
    background-color: rgba(168, 139, 90, 0.12);
    border: 1px solid rgba(168, 139, 90, 0.3);
    padding: 4px 14px;
    border-radius: 9999px;
    margin-bottom: 16px;
  }

  .journey-title {
    font-family: var(--font-family-heading);
    font-size: clamp(2.1rem, 3.8vw, 3.1rem);
    color: #0F2340;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin: 0 0 16px 0;
    line-height: 1.15;
  }

  .journey-deck {
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    color: #4B5563;
    line-height: 1.6;
    margin: 0;
  }

  /* 4 Steps Grid (PDF Page 4) */
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 48px;
  }

  .step-card {
    background-color: #F8FAFD;
    border: 1px solid rgba(15, 35, 64, 0.1);
    border-radius: 14px;
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }

  .step-card:hover {
    transform: translateY(-2px);
    border-color: #A88B5A;
  }

  .step-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .step-num {
    font-family: var(--font-family-base);
    font-size: 0.8125rem;
    font-weight: 700;
    color: #A88B5A;
  }

  .step-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    color: #0F2340;
    background-color: #F6F2EA;
    padding: 2px 8px;
    border-radius: 4px;
  }

  .step-title {
    font-family: var(--font-family-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: #0F2340;
    margin: 0;
    line-height: 1.25;
  }

  .step-copy {
    font-size: 0.875rem;
    color: #4B5563;
    line-height: 1.55;
    margin: 0;
  }

  /* Split Coordinator & WhatsApp Card */
  .coordinator-details-card {
    background-color: #FAF8F5;
    border: 1px solid rgba(168, 139, 90, 0.3);
    border-radius: 18px;
    padding: 32px;
    box-shadow: 0 6px 24px rgba(15, 35, 64, 0.04);
  }

  .details-grid {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 36px;
    align-items: center;
  }

  /* WhatsApp Simulation Frame */
  .sim-phone-frame {
    background-color: #FFFFFF;
    border: 1px solid #DCE3EC;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(15, 35, 64, 0.08);
  }

  .sim-header {
    background-color: #0F2340;
    color: #FFFFFF;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .sim-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: #A88B5A;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 0.8125rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    flex-shrink: 0;
  }

  .sim-status-dot {
    position: absolute;
    bottom: -1px;
    right: -1px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #25D366;
    border: 1.5px solid #0F2340;
  }

  .sim-contact {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .sim-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #FFFFFF;
  }

  .sim-status {
    font-size: 0.6875rem;
    color: #A88B5A;
  }

  .sim-chat-body {
    background-color: #ECE5DD;
    background-image: radial-gradient(#D1C7B7 1px, transparent 1px);
    background-size: 16px 16px;
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 300px;
  }

  .msg {
    max-width: 85%;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 0.785rem;
    line-height: 1.4;
    position: relative;
  }

  .msg p {
    margin: 0 0 2px 0;
  }

  .msg-time {
    font-size: 0.625rem;
    color: #8C8C8C;
    float: right;
    margin-left: 8px;
  }

  .msg-incoming {
    background-color: #FFFFFF;
    color: #111827;
    align-self: flex-start;
    border-top-left-radius: 2px;
  }

  .msg-outgoing {
    background-color: #E2F7CB;
    color: #111827;
    align-self: flex-end;
    border-top-right-radius: 2px;
  }

  /* Services List Col */
  .services-list-col {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .services-badge {
    font-size: 0.6875rem;
    font-weight: 700;
    color: #A88B5A;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .services-title {
    font-family: var(--font-family-heading);
    font-size: 1.6rem;
    font-weight: 700;
    color: #0F2340;
    margin: 4px 0 0 0;
  }

  .services-numbered-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 16px;
  }

  .service-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8125rem;
    color: #374151;
  }

  .srv-num {
    font-size: 0.6875rem;
    font-weight: 700;
    color: #A88B5A;
    background-color: rgba(168, 139, 90, 0.15);
    padding: 2px 6px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .srv-text {
    line-height: 1.35;
  }

  .services-action-row {
    margin-top: 8px;
  }

  .btn-journey-opinion {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #A88B5A;
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.875rem;
    padding: 12px 24px;
    border-radius: 9999px;
    text-decoration: none;
    transition: background-color 0.18s ease;
  }

  .btn-journey-opinion:hover {
    background-color: #967949;
  }

  @media (max-width: 1024px) {
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .details-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .steps-grid {
      grid-template-columns: 1fr;
    }
    .services-numbered-grid {
      grid-template-columns: 1fr;
    }
    .coordinator-details-card {
      padding: 20px 16px;
    }
  }
</style>
