---
/**
 * src/components/home/CostBreakdown.astro
 * Homepage: "What goes into the cost of treatment"
 * Reference: Page 9 & 35 of Nuhavi Health Look and Feel PDF.
 * Localized for English (/en/), Russian (/ru/), and Arabic (/ar/ RTL).
 */
import { homeTranslations } from '../../i18n/homeTranslations';
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const content = homeTranslations[lang].costBreakdown;
const costCategories = content.categories;
---

<section class="cost-breakdown-section" aria-labelledby="cost-breakdown-heading">
  <div class="container cost-container">
    <div class="cost-grid">
      <!-- Left Column: Title, Deck, CTA Link -->
      <div class="cost-left-col">
        <h2 id="cost-breakdown-heading" class="cost-title">
          {content.title}
        </h2>
        <p class="cost-deck">
          {content.deck}
        </p>

        <div class="cost-cta-wrap">
          <a href="/en/how-it-works/costs-and-fees/" class="btn-pill-primary">
            {content.feesCta}
          </a>
        </div>
      </div>

      <!-- Right Column: Interactive Segmented Bar + Legend -->
      <div class="cost-right-col">
        <div class="cost-interactive-card">
          <span class="illustrative-label">
            {content.illustrativeNote}
          </span>

          <!-- 7-Color Segmented Horizontal Bar -->
          <div class="segmented-bar" role="img" aria-label="Cost breakdown percentage bar">
            <div class="segment seg-1" style="width: 45%;" title="Surgery & Surgeon Fees: 45%"></div>
            <div class="segment seg-2" style="width: 20%;" title="Hospital Stay & Nursing: 20%"></div>
            <div class="segment seg-3" style="width: 10%;" title="Diagnostic Tests: 10%"></div>
            <div class="segment seg-4" style="width: 10%;" title="Implants & Consumables: 10%"></div>
            <div class="segment seg-5" style="width: 7%;" title="Local Accommodation: 7%"></div>
            <div class="segment seg-6" style="width: 5%;" title="Flight & Medical Visa: 5%"></div>
            <div class="segment seg-7" style="width: 3%;" title="Nuhavi Coordination Fee: 3%"></div>
          </div>

          <!-- Category Legend Grid -->
          <div class="categories-legend-grid">
            {costCategories.map((cat, idx) => (
              <button
                type="button"
                class={`category-item cat-item-${idx + 1} ${idx === 0 ? 'active' : ''}`}
                data-cat-idx={idx}
                aria-pressed={idx === 0 ? 'true' : 'false'}
              >
                <span class={`cat-dot dot-${idx + 1}`}></span>
                <span class="cat-name">{cat.name}</span>
                <span class="cat-pct">{cat.percent}</span>
              </button>
            ))}
          </div>

          <!-- Selected Category Detail Box -->
          <div class="selected-cat-box" id="selected-cat-box">
            <h4 class="cat-box-title" id="cat-box-title">{costCategories[0].name} ({costCategories[0].percent})</h4>
            <p class="cat-box-desc" id="cat-box-desc">{costCategories[0].desc}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cost-breakdown-section {
    width: 100%;
    background-color: var(--color-mist);
    padding: var(--space-12) 0;
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
  }

  .cost-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-4);
    box-sizing: border-box;
  }

  .cost-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 960px) {
    .cost-grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-10);
      align-items: center;
    }
  }

  /* Left Column */
  .cost-left-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .cost-title {
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1.2;
    margin: 0;
  }

  .cost-deck {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-slate);
    margin: 0;
  }

  .cost-cta-wrap {
    margin-top: var(--space-2);
  }

  .btn-pill-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    background-color: var(--color-navy);
    color: var(--color-paper);
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 0.875rem;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .btn-pill-primary:hover {
    background-color: var(--color-deep-navy);
    transform: translateY(-1px);
  }

  /* Right Column: Card */
  .cost-interactive-card {
    background-color: #FFFFFF;
    border: 1px solid rgba(20, 41, 75, 0.08);
    border-radius: var(--radius-card);
    padding: var(--space-6);
    box-shadow: 0 4px 20px rgba(20, 41, 75, 0.04);
  }

  .illustrative-label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-slate);
    margin-bottom: 12px;
  }

  /* Segmented Bar */
  .segmented-bar {
    display: flex;
    height: 16px;
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: var(--space-5);
    background-color: var(--color-mist);
  }

  .segment {
    height: 100%;
    transition: opacity 0.2s ease;
  }

  .seg-1 { background-color: var(--color-navy); }
  .seg-2 { background-color: var(--color-deep-navy); }
  .seg-3 { background-color: var(--color-gold); }
  .seg-4 { background-color: var(--color-success); }
  .seg-5 { background-color: #24A1DE; }
  .seg-6 { background-color: #5B6A80; }
  .seg-7 { background-color: #E65100; }

  /* Legend */
  .categories-legend-grid {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: var(--space-5);
  }

  .category-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    cursor: pointer;
    font-family: var(--font-family-base);
    text-align: left;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  :global([dir="rtl"]) .category-item {
    text-align: right;
  }

  .category-item:hover {
    background-color: var(--color-mist);
  }

  .category-item.active {
    background-color: var(--color-mist);
    border-color: rgba(20, 41, 75, 0.15);
  }

  .cat-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot-1 { background-color: var(--color-navy); }
  .dot-2 { background-color: var(--color-deep-navy); }
  .dot-3 { background-color: var(--color-gold); }
  .dot-4 { background-color: var(--color-success); }
  .dot-5 { background-color: #24A1DE; }
  .dot-6 { background-color: #5B6A80; }
  .dot-7 { background-color: #E65100; }

  .cat-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-navy);
    flex-grow: 1;
  }

  .cat-pct {
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--color-slate);
  }

  /* Selected Box */
  .selected-cat-box {
    padding: var(--space-4);
    background-color: var(--color-mist);
    border-radius: 8px;
    border-left: 3px solid var(--color-gold);
  }

  :global([dir="rtl"]) .selected-cat-box {
    border-left: none;
    border-right: 3px solid var(--color-gold);
    text-align: right;
  }

  .cat-box-title {
    font-size: 0.9375rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0 0 4px;
  }

  .cat-box-desc {
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-slate);
    margin: 0;
  }

  /* RTL Support */
  :global([dir="rtl"]) .cost-title,
  :global([dir="rtl"]) .cost-deck {
    text-align: right;
  }
</style>

<script define:vars={{ costCategories }}>
  function setupCostInteractivity() {
    const buttons = document.querySelectorAll('.category-item');
    const titleEl = document.getElementById('cat-box-title');
    const descEl = document.getElementById('cat-box-desc');

    if (!buttons.length || !titleEl || !descEl) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');

        const idx = parseInt(btn.getAttribute('data-cat-idx') || '0', 10);
        const data = costCategories[idx];
        if (data) {
          titleEl.textContent = `${data.name} (${data.percent})`;
          descEl.textContent = data.desc;
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupCostInteractivity);
  setupCostInteractivity();
</script>
