---
/**
 * src/components/home/CostBreakdown.astro
 * Approved Cost Clarity Section — 12-Page PDF (Page 4)
 *
 * Background: Ivory (#F6F2EA)
 * Left column: Heading, copy, 3 check bullets, "See treatment costs" & "How Nuhavi is paid" buttons.
 * Right column: Estimate comparison table for Total knee replacement.
 */
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : currentPath.startsWith('/fr')
  ? 'fr'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const isArabic = lang === 'ar';
const isRussian = lang === 'ru';
const isFrench = lang === 'fr';

const prefix = `/${lang}`;
const costsPageHref = `${prefix}/how-it-works/costs-and-fees/`;
const commercialHref = `${prefix}/about/commercial-relationships/`;

const t = {
  eyebrow: isArabic ? 'شفافية التكلفة' : isRussian ? 'ПРОЗРАЧНОСТЬ СТОИМОСТИ' : 'COST CLARITY',
  heading: isArabic
    ? 'اعرف التكلفة قبل أن تسافر'
    : isRussian
    ? 'Знайте стоимость до поездки'
    : isFrench
    ? 'Connaissez le coût avant de voyager'
    : 'Know the cost before you travel',
  deck: isArabic
    ? 'لا نعد بأقل الأسعار. نحن نحصل لك على تقديرات مكتوبة من مستشفيين أو ثلاثة مستشفيات معتمدة، ونوضح ما هو مشمول وما هو غير مشمول، ونشرح لك بدقة كيف تدفع أتعاب نوهـافي.'
    : isRussian
    ? 'Мы не обещаем самую низкую цену. Мы получаем для вас письменные сметы из двух-трех аккредитованных клиник, объясняем, что включено, а что нет, и открыто говорим, как оплачивается работа Nuhavi.'
    : isFrench
    ? 'Nous ne promettons pas le prix le plus bas. Nous vous obtenons des devis écrits de deux ou trois hôpitaux accrédités, expliquons ce qui est inclus et ce qui ne l\'est pas, et vous expliquons exactement comment Nuhavi est rémunéré.'
    : 'We don\'t promise the lowest price. We get you written estimates from two or three accredited hospitals, explain what is and isn\'t included, and tell you exactly how Nuhavi is paid.',
  bullets: [
    isArabic ? 'مفصل: الجراحة، الإقامة، الأدوية، الفحوصات' : isRussian ? 'Постатейно: операция, пребывание, лекарства, анализы' : 'Itemised: surgery, stay, medicines, tests',
    isArabic ? 'تاريخ الصلاحية والعملة محددين بدقة' : isRussian ? 'Срок действия и валюта указаны явно' : 'Validity date and currency stated',
    isArabic ? 'مقارنة جنباً إلى جنب بواسطة منسقك' : isRussian ? 'Сравнение бок о бок вашим координатором' : 'Compared side by side by your coordinator',
  ],
  seeCostsBtn: isArabic ? 'عرض تكاليف العلاج' : isRussian ? 'Посмотреть стоимость лечения' : 'See treatment costs',
  howNuhaviPaidBtn: isArabic ? 'كيف تدفع أتعاب نوهـافي' : isRussian ? 'Как оплачиваются услуги Nuhavi' : 'How Nuhavi is paid',
  sampleHeader: isArabic ? 'مقارنة تقديرية · نموذج توضيحي' : isRussian ? 'СРАВНЕНИЕ СМЕТ · ПРИМЕР' : 'ESTIMATE COMPARISON · SAMPLE LAYOUT',
  validity: isArabic ? 'صالح لمدة 30 يوماً' : isRussian ? 'Действительно 30 дней' : 'Valid 30 days',
  procedureTitle: isArabic ? 'استبدال كامل لمفصل الركبة' : isRussian ? 'Полная замена коленного сустава' : 'Total knee replacement',
  itemLabel: isArabic ? 'البند' : isRussian ? 'Статья' : 'Item',
  hospA: isArabic ? 'المستشفى أ' : isRussian ? 'Клиника A' : 'Hospital A',
  hospB: isArabic ? 'المستشفى ب' : isRussian ? 'Клиника B' : 'Hospital B',
  hospC: isArabic ? 'المستشفى ج' : isRussian ? 'Клиника C' : 'Hospital C',
  rowSurgery: isArabic ? 'الجراحة وأتعاب الجراح' : isRussian ? 'Операция и хирург' : 'Surgery & surgeon',
  rowImplant: isArabic ? 'المفصل الصناعي' : isRussian ? 'Имплантат' : 'Implant',
  rowRoom: isArabic ? 'الغرفة والتمريض (5 أيام)' : isRussian ? 'Палата и уход (5 дней)' : 'Room & nursing (5 days)',
  rowPhysio: isArabic ? 'العلاج الطبيعي' : isRussian ? 'Физиотерапия' : 'Physiotherapy',
  rowTotal: isArabic ? 'الإجمالي (دولار)' : isRussian ? 'Итого (USD)' : 'Total (USD)',
  footnote: isArabic
    ? 'الأرقام مستمدة من التقدير المكتوب لكل مستشفى لحالتك.'
    : isRussian
    ? 'Цифры взяты из письменных смет каждой клиники для вашего случая.'
    : 'Figures come from each hospital\'s written estimate for your case.',
};
---

<section class="cost-clarity-section" id="costs" aria-labelledby="cost-heading" dir={isArabic ? 'rtl' : 'ltr'}>
  <div class="container cost-container">
    <div class="cost-two-col-grid">
      <!-- Left Column: Copy, Bullets & Action Buttons -->
      <div class="cost-left-col">
        <span class="cost-eyebrow">{t.eyebrow}</span>
        <h2 id="cost-heading" class="cost-title">
          {t.heading}
        </h2>
        <p class="cost-deck">
          {t.deck}
        </p>

        <ul class="cost-bullets-list">
          {t.bullets.map((b) => (
            <li>
              <span class="check-icon" aria-hidden="true">✓</span>
              <span>{b}</span>
            </li>
          ))}
        </ul>

        <div class="cost-buttons-row">
          <a href={costsPageHref} class="btn-navy-cost">
            {t.seeCostsBtn}
          </a>
          <a href={commercialHref} class="btn-outline-cost">
            {t.howNuhaviPaidBtn}
          </a>
        </div>
      </div>

      <!-- Right Column: Estimate Comparison Table Card (PDF Page 4) -->
      <div class="cost-right-col">
        <div class="estimate-table-card">
          <div class="table-card-header">
            <span class="meta-tag">{t.sampleHeader}</span>
            <span class="validity-tag">{t.validity}</span>
          </div>

          <h3 class="procedure-heading">{t.procedureTitle}</h3>

          <div class="table-wrap">
            <table class="comparison-table">
              <thead>
                <tr>
                  <th scope="col" class="th-item">{t.itemLabel}</th>
                  <th scope="col" class="th-hosp">{t.hospA}</th>
                  <th scope="col" class="th-hosp">{t.hospB}</th>
                  <th scope="col" class="th-hosp">{t.hospC}</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row" class="td-item">{t.rowSurgery}</th>
                  <td class="td-val">[ ]</td>
                  <td class="td-val">[ ]</td>
                  <td class="td-val">[ ]</td>
                </tr>
                <tr>
                  <th scope="row" class="td-item">{t.rowImplant}</th>
                  <td class="td-val">[ ]</td>
                  <td class="td-val">[ ]</td>
                  <td class="td-val">[ ]</td>
                </tr>
                <tr>
                  <th scope="row" class="td-item">{t.rowRoom}</th>
                  <td class="td-val">[ ]</td>
                  <td class="td-val">[ ]</td>
                  <td class="td-val">[ ]</td>
                </tr>
                <tr>
                  <th scope="row" class="td-item">{t.rowPhysio}</th>
                  <td class="td-val">[ ]</td>
                  <td class="td-val">[ ]</td>
                  <td class="td-val">[ ]</td>
                </tr>
                <tr class="row-total">
                  <th scope="row" class="td-item td-total-label">{t.rowTotal}</th>
                  <td class="td-val td-total-val">[ ]</td>
                  <td class="td-val td-total-val">[ ]</td>
                  <td class="td-val td-total-val">[ ]</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="table-footnote">{t.footnote}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cost-clarity-section {
    width: 100%;
    background-color: #F6F2EA;
    padding: clamp(64px, 8vw, 92px) 0;
  }

  .cost-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 40px);
    box-sizing: border-box;
  }

  .cost-two-col-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 48px;
    align-items: center;
  }

  .cost-left-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .cost-eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #A88B5A;
    text-transform: uppercase;
  }

  .cost-title {
    font-family: var(--font-family-heading);
    font-size: clamp(2.1rem, 3.2vw, 2.85rem);
    color: #0F2340;
    font-weight: 600;
    margin: 0;
    line-height: 1.15;
  }

  .cost-deck {
    font-size: 1rem;
    color: #4B5563;
    line-height: 1.6;
    margin: 0;
  }

  .cost-bullets-list {
    list-style: none;
    padding: 0;
    margin: 8px 0 16px 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cost-bullets-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9375rem;
    color: #0F2340;
    font-weight: 500;
  }

  .check-icon {
    color: #A88B5A;
    font-weight: 700;
  }

  .cost-buttons-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .btn-navy-cost {
    background-color: #0F2340;
    color: #FFFFFF;
    padding: 12px 24px;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .btn-navy-cost:hover {
    background-color: #1A365D;
  }

  .btn-outline-cost {
    background-color: #FFFFFF;
    color: #0F2340;
    border: 1px solid rgba(15, 35, 64, 0.25);
    padding: 11px 22px;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .btn-outline-cost:hover {
    border-color: #0F2340;
    background-color: #FAF8F5;
  }

  /* Right Card */
  .estimate-table-card {
    background-color: #FFFFFF;
    border: 1px solid rgba(15, 35, 64, 0.12);
    border-radius: 10px;
    padding: 28px 24px;
    box-shadow: 0 4px 16px rgba(15, 35, 64, 0.04);
  }

  .table-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #64748B;
    text-transform: uppercase;
  }

  .procedure-heading {
    font-family: var(--font-family-heading);
    font-size: 1.5rem;
    font-weight: 600;
    color: #0F2340;
    margin: 0 0 20px 0;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .comparison-table th,
  .comparison-table td {
    padding: 10px 12px;
    text-align: left;
    border-bottom: 1px solid #E2E8F0;
  }

  [dir="rtl"] .comparison-table th,
  [dir="rtl"] .comparison-table td {
    text-align: right;
  }

  .th-item {
    font-weight: 600;
    color: #64748B;
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .th-hosp {
    font-weight: 600;
    color: #0F2340;
    text-align: right;
    font-size: 0.8125rem;
  }

  [dir="rtl"] .th-hosp {
    text-align: left;
  }

  .td-item {
    font-weight: 500;
    color: #374151;
  }

  .td-val {
    text-align: right;
    color: #64748B;
    font-family: monospace;
  }

  [dir="rtl"] .td-val {
    text-align: left;
  }

  .row-total {
    border-top: 2px solid #0F2340;
    font-weight: 700;
  }

  .row-total th,
  .row-total td {
    color: #0F2340;
    border-bottom: none;
    padding-top: 14px;
  }

  .table-footnote {
    font-size: 0.75rem;
    color: #64748B;
    margin: 18px 0 0 0;
    font-style: italic;
  }

  @media (max-width: 900px) {
    .cost-two-col-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
