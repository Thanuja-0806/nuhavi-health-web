---
/**
 * src/components/home/ClosingCTA.astro
 * Homepage: "Your treatment journey starts with clarity" — 12-Page PDF (Page 6)
 *
 * Left:
 * Headline: Your treatment journey starts with clarity.
 * 1 Send a short enquiry — no reports needed yet
 * 2 Your coordinator replies within 1 working day
 * 3 Doctor review, opinions and written estimates follow
 *
 * Right:
 * [Request a medical opinion] (Brass button)
 * [Chat on WhatsApp] (Navy button with white border)
 */
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : currentPath.startsWith('/fr')
  ? 'fr'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const isArabic = lang === 'ar';
const isRussian = lang === 'ru';
const isFrench = lang === 'fr';

const prefix = `/${lang}`;
const requestOpinionHref = `${prefix}/request-opinion/`;

const t = {
  title: isArabic
    ? 'رحلتك العلاجية تبدأ بالوضوح التام.'
    : isRussian
    ? 'Ваш путь к лечению начинается с ясности.'
    : 'Your treatment journey starts with clarity.',
  step1: isArabic
    ? 'أرسل استفساراً قصيراً — لا حاجة لتقارير في هذه المرحلة'
    : isRussian
    ? 'Отправьте короткий запрос — выписки пока не требуются'
    : 'Send a short enquiry — no reports needed yet',
  step2: isArabic
    ? 'يرد منسقك الشخصي خلال يوم عمل واحد'
    : isRussian
    ? 'Ваш координатор ответит в течение 1 рабочего дня'
    : 'Your coordinator replies within 1 working day',
  step3: isArabic
    ? 'مراجعة أطبائنا، والآراء الطبية والتقديرات المكتوبة تتبع ذلك'
    : isRussian
    ? 'Врачебный анализ, заключения и письменные расчеты следуют далее'
    : 'Doctor review, opinions and written estimates follow',
  primaryCta: isArabic ? 'اطلب رأياً طبياً' : isRussian ? 'Запросить медицинское заключение' : 'Request a medical opinion',
  whatsappCta: isArabic ? 'محادثة عبر واتساب' : isRussian ? 'Чат в WhatsApp' : 'Chat on WhatsApp',
};
---

<section class="closing-cta-section" aria-labelledby="closing-cta-heading" dir={isArabic ? 'rtl' : 'ltr'}>
  <div class="container closing-container">
    <div class="closing-two-col-grid">
      <!-- Left: Heading & 3 Steps -->
      <div class="closing-left-col">
        <h2 id="closing-cta-heading" class="closing-title">
          {t.title}
        </h2>

        <div class="steps-row">
          <div class="step-item">
            <span class="step-num">1</span>
            <p class="step-text">{t.step1}</p>
          </div>
          <div class="step-item">
            <span class="step-num">2</span>
            <p class="step-text">{t.step2}</p>
          </div>
          <div class="step-item">
            <span class="step-num">3</span>
            <p class="step-text">{t.step3}</p>
          </div>
        </div>
      </div>

      <!-- Right: Action Buttons -->
      <div class="closing-right-col">
        <a href={requestOpinionHref} class="btn-brass-cta">
          {t.primaryCta}
        </a>
        <a href="https://wa.me/919999999999" class="btn-wa-cta" target="_blank" rel="noopener noreferrer">
          {t.whatsappCta}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .closing-cta-section {
    width: 100%;
    background-color: #0F2340;
    color: #FFFFFF;
    padding: clamp(60px, 7vw, 84px) 0;
  }

  .closing-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 40px);
    box-sizing: border-box;
  }

  .closing-two-col-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .closing-left-col {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .closing-title {
    font-family: var(--font-family-heading);
    font-size: clamp(2.1rem, 3.2vw, 2.85rem);
    color: #FFFFFF;
    font-weight: 600;
    margin: 0;
    line-height: 1.15;
  }

  .steps-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .step-item {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }

  .step-num {
    font-size: 0.875rem;
    font-weight: 700;
    color: #A88B5A;
    line-height: 1.4;
  }

  .step-text {
    font-size: 0.8125rem;
    color: #CBD5E1;
    line-height: 1.45;
    margin: 0;
  }

  /* Right Action Buttons */
  .closing-right-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
    justify-content: center;
  }

  .btn-brass-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #A88B5A;
    color: #FFFFFF;
    padding: 14px 28px;
    border-radius: 6px;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.15s ease;
    width: 260px;
    box-sizing: border-box;
    text-align: center;
  }

  .btn-brass-cta:hover {
    background-color: #967949;
  }

  .btn-wa-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.4);
    padding: 13px 28px;
    border-radius: 6px;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
    width: 260px;
    box-sizing: border-box;
    text-align: center;
  }

  .btn-wa-cta:hover {
    border-color: #FFFFFF;
    background-color: rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 960px) {
    .closing-two-col-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .closing-right-col {
      align-items: stretch;
    }
    .btn-brass-cta,
    .btn-wa-cta {
      width: 100%;
    }
  }

  @media (max-width: 640px) {
    .steps-row {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
