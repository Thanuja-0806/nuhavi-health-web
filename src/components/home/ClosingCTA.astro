---
/**
 * src/components/home/ClosingCTA.astro
 * Homepage: "Your treatment journey starts with clarity"
 * Reference: Page 10 of Nuhavi Health Look and Feel PDF.
 * Localized for English (/en/), Russian (/ru/), and Arabic (/ar/ RTL).
 */
import { homeTranslations } from '../../i18n/homeTranslations';
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const content = homeTranslations[lang].closingCta;
const prefix = `/${lang}`;
---

<section class="closing-cta-section" aria-labelledby="closing-cta-heading">
  <div class="container closing-cta-container">
    <div class="closing-cta-content">
      <h2 id="closing-cta-heading" class="closing-title">
        {content.title}
      </h2>
      <p class="closing-deck">
        {content.deck}
      </p>

      <div class="closing-btn-group">
        <a href={`${prefix}/request-opinion/`} class="btn-pill-gold">
          {content.primaryCta}
        </a>
        <a href={`${prefix}/contact/`} class="btn-pill-outline-white">
          {content.secondaryCta}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .closing-cta-section {
    width: 100%;
    background-color: var(--color-deep-navy);
    color: var(--color-paper);
    padding: var(--space-12) 0;
    text-align: center;
  }

  .closing-cta-container {
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    padding: 0 var(--space-4);
    box-sizing: border-box;
  }

  .closing-cta-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .closing-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--color-paper);
    line-height: 1.2;
    margin: 0;
  }

  .closing-deck {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgba(244, 247, 251, 0.75);
    max-width: 680px;
    margin: 0;
  }

  .closing-btn-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-2);
  }

  .btn-pill-gold {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    background-color: var(--color-gold);
    color: var(--color-deep-navy);
    border-radius: var(--radius-pill);
    font-weight: 800;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: transform 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
    box-shadow: 0 4px 16px rgba(196, 154, 60, 0.25);
  }

  .btn-pill-gold:hover {
    background-color: #D4AF37;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(196, 154, 60, 0.35);
  }

  .btn-pill-outline-white {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 28px;
    background-color: transparent;
    color: var(--color-paper);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }

  .btn-pill-outline-white:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.6);
    transform: translateY(-2px);
  }
</style>
