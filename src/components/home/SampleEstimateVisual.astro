---
/**
 * src/components/home/SampleEstimateVisual.astro
 * Section 4: Sample Patient Journey / Estimate Comparison Visual
 * Prominently labelled SAMPLE; zero invented real patient data.
 * Demonstrates how Nuhavi prepares transparent, side-by-side hospital quotations.
 */
---

<section class="sample-estimate-section" aria-labelledby="sample-heading">
  <div class="container sample-container">
    <div class="sample-header">
      <div class="sample-watermark-pill" role="note" aria-label="Sample demonstration notice">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span>SAMPLE COMPARATIVE ESTIMATE · FOR ILLUSTRATION ONLY · ZERO REAL PATIENT DATA</span>
      </div>
      <h2 id="sample-heading" class="sample-title">How We Compare Hospital Options Side-by-Side</h2>
      <p class="sample-deck">
        Before you commit to traveling, we present itemised, written options from accredited Indian hospitals so you can compare clinical approach, implant specification, and total expenditure with total clarity.
      </p>
    </div>

    <!-- Comparative Visual Table Card -->
    <div class="estimate-comparison-card">
      <div class="comparison-card-top">
        <div class="comparison-case-meta">
          <span class="meta-label">Illustrative Case Model:</span>
          <span class="meta-value">Bilateral Robotic Total Knee Replacement (Severe Osteoarthritis)</span>
        </div>
        <div class="comparison-case-badge">
          <span>Dual Hospital Assessment</span>
        </div>
      </div>

      <div class="table-scroll-wrapper">
        <table class="comparison-table">
          <thead>
            <tr>
              <th scope="col" class="th-feature">Assessment & Quotation Elements</th>
              <th scope="col" class="th-hospital hospital-a">
                <span class="hosp-tag">Hospital Option A</span>
                <span class="hosp-name">NABH/JCI Tertiary Medical Institute</span>
                <span class="hosp-sub">Hyderabad Medical Precinct</span>
              </th>
              <th scope="col" class="th-hospital hospital-b">
                <span class="hosp-tag">Hospital Option B</span>
                <span class="hosp-name">Academic Super-Specialty Centre</span>
                <span class="hosp-sub">Hyderabad Central Campus</span>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" class="td-feature">
                <strong>Surgical Technology & Method</strong>
                <span>Approach, navigation, and robotic platform</span>
              </th>
              <td class="td-hosp">
                <span class="data-highlight">CT-Guided Robotic Arm (MAKO)</span>
                <span class="data-sub">Sub-millimeter alignment; bone-sparing</span>
              </td>
              <td class="td-hosp">
                <span class="data-highlight">Imageless Robotic System (ROSA)</span>
                <span class="data-sub">Kinematic ligament balancing</span>
              </td>
            </tr>

            <tr>
              <th scope="row" class="td-feature">
                <strong>Prosthesis & Bearing Spec</strong>
                <span>FDA / CE certified implant manufacturer</span>
              </th>
              <td class="td-hosp">
                <span class="data-text">Stryker Triathlon (High Cross-Linked Poly)</span>
                <span class="data-sub">Direct manufacturer certificate provided</span>
              </td>
              <td class="td-hosp">
                <span class="data-text">Zimmer Biomet Persona (Vitamin E Infused)</span>
                <span class="data-sub">Certified implant passport included</span>
              </td>
            </tr>

            <tr>
              <th scope="row" class="td-feature">
                <strong>Hospital Stay Included</strong>
                <span>Inpatient ward and step-down monitoring</span>
              </th>
              <td class="td-hosp">
                <span class="data-text">5 Nights Private Single Room</span>
                <span class="data-sub">Includes 1 night High Dependency Unit</span>
              </td>
              <td class="td-hosp">
                <span class="data-text">6 Nights Deluxe Single Room</span>
                <span class="data-sub">Includes 1 night ICU monitoring</span>
              </td>
            </tr>

            <tr>
              <th scope="row" class="td-feature">
                <strong>Surgeon, Anaesthesia & OT Charges</strong>
                <span>Surgical faculty and operating suite sterile fees</span>
              </th>
              <td class="td-hosp">
                <span class="data-text">Included in fixed package</span>
              </td>
              <td class="td-hosp">
                <span class="data-text">Included in fixed package</span>
              </td>
            </tr>

            <tr>
              <th scope="row" class="td-feature">
                <strong>Inpatient Physical Therapy</strong>
                <span>Mobilisation, gait retraining & stairs coaching</span>
              </th>
              <td class="td-hosp">
                <span class="data-text">Twice daily sessions during stay</span>
              </td>
              <td class="td-hosp">
                <span class="data-text">Twice daily sessions during stay</span>
              </td>
            </tr>

            <tr class="total-row">
              <th scope="row" class="td-feature total-title">
                <strong>Total Indicative Hospital Cost</strong>
                <span>Direct payment to hospital upon admission</span>
              </th>
              <td class="td-hosp total-cell">
                <span class="price-val">$7,800 USD</span>
                <span class="price-sub">Fixed Bilateral Package</span>
              </td>
              <td class="td-hosp total-cell">
                <span class="price-val">$8,400 USD</span>
                <span class="price-sub">Fixed Bilateral Package</span>
              </td>
            </tr>

            <tr class="coordination-row">
              <th scope="row" class="td-feature">
                <strong>Nuhavi Coordination Fee</strong>
                <span>Bilingual coordinator, airport pickup, hospital accompaniment</span>
              </th>
              <td colspan="2" class="td-shared-coord">
                <span class="coord-val">Fixed, agreed in writing before travel · Zero hospital commissions</span>
                <span class="coord-sub">Patients pay medical fees directly to hospitals. Nuhavi never marks up hospital invoices.</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="comparison-footnote-card">
        <h4>Clear Rules on Preliminary Estimates:</h4>
        <p>
          1. <strong>Direct Hospital Payment:</strong> You pay the hospital directly at cashier desks with an itemised hospital receipt. Nuhavi never collects treatment money.<br />
          2. <strong>Excluded Items:</strong> Estimates clearly state exclusions: personal telephone, attendant guest meals, extra days if complications arise, and post-discharge home pharmacy.<br />
          3. <strong>Validity Period:</strong> Every written quote carries a stated validity date (typically 90 days) ensuring price certainty before booking flights.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .sample-estimate-section {
    background-color: #FFFFFF;
    padding: 72px 0 80px;
    border-bottom: 1px solid var(--color-border);
  }

  .sample-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(16px, 2vw, 32px);
  }

  .sample-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .sample-watermark-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: var(--color-ivory);
    border: 1px solid #D5C29D;
    color: #7A5C22;
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    margin-bottom: 16px;
  }

  .sample-title {
    font-family: var(--font-family-heading);
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    color: var(--color-navy);
    line-height: 1.2;
    margin-bottom: 12px;
  }

  .sample-deck {
    font-size: 1.0625rem;
    color: var(--color-slate);
    max-width: 760px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Comparison Card */
  .estimate-comparison-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(15, 35, 64, 0.06);
  }

  .comparison-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 28px;
    background-color: #F8FAFD;
    border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap;
    gap: 12px;
  }

  .comparison-case-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9375rem;
  }

  .meta-label {
    color: var(--color-slate);
    font-weight: 500;
  }

  .meta-value {
    color: var(--color-navy);
    font-weight: 700;
  }

  .comparison-case-badge {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-navy);
    background-color: var(--color-mist);
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .table-scroll-wrapper {
    overflow-x: auto;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.9375rem;
  }

  .comparison-table th,
  .comparison-table td {
    padding: 18px 24px;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }

  .th-feature {
    width: 38%;
    background-color: #FAFBFD;
    color: var(--color-navy);
    font-weight: 600;
  }

  .th-hospital {
    width: 31%;
    background-color: #FFFFFF;
  }

  .hosp-tag {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--color-brass);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 4px;
  }

  .hosp-name {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-navy);
  }

  .hosp-sub {
    display: block;
    font-size: 0.75rem;
    color: var(--color-slate);
  }

  .td-feature {
    background-color: #FAFBFD;
    color: var(--color-navy);
    font-weight: 500;
  }

  .td-feature strong {
    display: block;
    font-size: 0.9375rem;
    color: var(--color-navy);
  }

  .td-feature span {
    display: block;
    font-size: 0.75rem;
    color: var(--color-slate);
    font-weight: 400;
    margin-top: 2px;
  }

  .td-hosp {
    background-color: #FFFFFF;
  }

  .data-highlight {
    display: block;
    font-weight: 700;
    color: var(--color-navy);
  }

  .data-text {
    display: block;
    font-weight: 600;
    color: var(--color-navy);
  }

  .data-sub {
    display: block;
    font-size: 0.75rem;
    color: var(--color-slate);
    margin-top: 2px;
  }

  .total-row {
    background-color: #F6F2EA;
  }

  .total-row .td-feature {
    background-color: #F6F2EA;
  }

  .total-title strong {
    font-size: 1.0625rem;
    color: var(--color-navy);
  }

  .total-cell {
    background-color: #F6F2EA;
  }

  .price-val {
    display: block;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-navy);
    font-family: var(--font-family-heading);
  }

  .price-sub {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-brass);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .coordination-row {
    background-color: #FFFFFF;
  }

  .td-shared-coord {
    background-color: #FFFFFF;
  }

  .coord-val {
    display: block;
    font-weight: 700;
    color: var(--color-navy);
    font-size: 0.9375rem;
  }

  .coord-sub {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-slate);
    margin-top: 2px;
  }

  /* Footnote */
  .comparison-footnote-card {
    padding: 24px 28px;
    background-color: #FAFBFD;
    border-top: 1px solid var(--color-border);
  }

  .comparison-footnote-card h4 {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 8px 0;
  }

  .comparison-footnote-card p {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: #4A5B73;
    margin: 0;
  }

  @media (max-width: 768px) {
    .comparison-card-top {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

