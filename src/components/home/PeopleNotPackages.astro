---
/**
 * PeopleNotPackages.astro
 * Homepage section: "People, not packages"
 * Reference: Page 6 of the Nuhavi Health Look and Feel PDF.
 * Localized for English (/en/), Russian (/ru/), and Arabic (/ar/ RTL).
 */
import { homeTranslations } from '../../i18n/homeTranslations';
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const content = homeTranslations[lang].peopleNotPackages;
const photos = content.photos;

const leftPhoto = photos[0];
const rightTopPhoto = photos[1];
const rightBottomPhoto = photos[2];
---

<section class="people-section" aria-labelledby="people-section-heading">
  <div class="container people-container">
    <div class="people-card">
      <header class="people-header">
        <div class="header-title-col">
          <span class="section-eyebrow">{content.eyebrow}</span>
          <h2 id="people-section-heading" class="section-title">
            {content.title}
          </h2>
        </div>
        <p class="section-supporting-text">
          {content.deck}
        </p>
      </header>

      <!-- Three-Photo Collage Grid -->
      <div class="collage-grid">
        <!-- LEFT: Large Portrait Photo Placeholder -->
        <figure class="collage-figure portrait-figure">
          <div
            class="placeholder-frame portrait-frame"
            role="img"
            aria-label={`Photo placeholder: ${leftPhoto.description}`}
          >
            <div class="placeholder-content">
              <svg class="placeholder-camera-icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                <circle cx="12" cy="13" r="4"></circle>
              </svg>
              <span class="placeholder-badge">{leftPhoto.label}</span>
            </div>
          </div>
          <figcaption class="collage-caption">
            {leftPhoto.caption}
          </figcaption>
        </figure>

        <!-- RIGHT: Two Stacked Landscape Photo Placeholders -->
        <div class="right-column-stack">
          <!-- Top Landscape Photo -->
          <figure class="collage-figure landscape-figure">
            <div
              class="placeholder-frame landscape-frame"
              role="img"
              aria-label={`Photo placeholder: ${rightTopPhoto.description}`}
            >
              <div class="placeholder-content">
                <svg class="placeholder-camera-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                  <circle cx="12" cy="13" r="4"></circle>
                </svg>
                <span class="placeholder-badge">{rightTopPhoto.label}</span>
              </div>
            </div>
            <figcaption class="collage-caption">
              {rightTopPhoto.caption}
            </figcaption>
          </figure>

          <!-- Bottom Landscape Photo -->
          <figure class="collage-figure landscape-figure">
            <div
              class="placeholder-frame landscape-frame"
              role="img"
              aria-label={`Photo placeholder: ${rightBottomPhoto.description}`}
            >
              <div class="placeholder-content">
                <svg class="placeholder-camera-icon" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                  <circle cx="12" cy="13" r="4"></circle>
                </svg>
                <span class="placeholder-badge">{rightBottomPhoto.label}</span>
              </div>
            </div>
            <figcaption class="collage-caption">
              {rightBottomPhoto.caption}
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .people-section {
    width: 100%;
    background-color: var(--color-mist);
    padding: var(--space-8) 0 var(--space-10);
    overflow: hidden;
  }

  .people-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-3);
    box-sizing: border-box;
  }

  .people-card {
    background-color: var(--color-paper);
    border: 1px solid rgba(20, 41, 75, 0.08);
    border-radius: var(--radius-card);
    padding: var(--space-6) var(--space-5);
    box-shadow: 0 4px 20px -2px rgba(20, 41, 75, 0.04);
  }

  @media (min-width: 768px) {
    .people-card {
      padding: var(--space-8) var(--space-7);
    }
  }

  @media (min-width: 1024px) {
    .people-card {
      padding: var(--space-10) var(--space-8);
    }
  }

  .people-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 768px) {
    .people-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      gap: var(--space-6);
    }
  }

  .header-title-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: 540px;
  }

  .section-eyebrow {
    font-size: 0.8125rem;
    font-weight: var(--font-weight-subheading);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-gold);
    line-height: 1.2;
  }

  .section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: var(--font-weight-heading);
    color: var(--color-deep-navy);
    line-height: var(--line-height-heading);
    letter-spacing: -0.02em;
    margin: 0;
  }

  .section-supporting-text {
    font-size: 1.0625rem;
    font-weight: var(--font-weight-deck);
    line-height: var(--line-height-body);
    color: var(--color-slate);
    max-width: 460px;
    margin: 0;
  }

  /* Collage Grid */
  .collage-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .collage-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
      align-items: stretch;
    }
  }

  .collage-figure {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
  }

  .right-column-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .right-column-stack {
      gap: var(--space-6);
    }
  }

  .placeholder-frame {
    position: relative;
    width: 100%;
    background-color: var(--color-navy);
    border-radius: var(--radius-card);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .placeholder-frame::after {
    content: '';
    position: absolute;
    inset: 12px;
    border: 1px dashed rgba(196, 154, 60, 0.4);
    border-radius: calc(var(--radius-card) - 4px);
    pointer-events: none;
  }

  .portrait-frame {
    aspect-ratio: 3 / 4;
    min-height: 280px;
  }

  @media (min-width: 768px) {
    .portrait-frame {
      height: 100%;
      min-height: 480px;
    }
  }

  .landscape-frame {
    aspect-ratio: 16 / 9;
    min-height: 160px;
  }

  .placeholder-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    z-index: 2;
  }

  .placeholder-camera-icon {
    color: var(--color-gold);
    opacity: 0.9;
  }

  .placeholder-badge {
    font-size: 0.75rem;
    font-weight: var(--font-weight-subheading);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-paper);
    background-color: rgba(13, 27, 51, 0.6);
    border: 1px solid rgba(244, 247, 251, 0.15);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }

  .collage-caption {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-slate);
    font-weight: var(--font-weight-body);
  }

  /* RTL Support */
  :global([dir="rtl"]) .section-title,
  :global([dir="rtl"]) .section-supporting-text,
  :global([dir="rtl"]) .collage-caption {
    text-align: right;
  }
</style>
