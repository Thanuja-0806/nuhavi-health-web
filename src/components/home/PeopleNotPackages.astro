---
/**
 * src/components/home/PeopleNotPackages.astro
 * 3 Segment Cards: NRI Families, Referring Doctors, Meet Our Doctors (PDF Page 6)
 *
 * 1. For NRI Families: Nuhavi Care for Parents
 * 2. For Referring Doctors: Refer a patient. Stay in the clinical loop. (Navy card)
 * 3. Meet Our Doctors: Medical camp · January 2027
 */
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : currentPath.startsWith('/fr')
  ? 'fr'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const isArabic = lang === 'ar';
const isRussian = lang === 'ru';
const isFrench = lang === 'fr';

const prefix = `/${lang}`;
const requestOpinionHref = `${prefix}/request-opinion/`;
const contactHref = `${prefix}/contact/`;

const t = {
  nriTag: isArabic ? 'للعائلات المقيمة بالخارج' : isRussian ? 'ДЛЯ СЕМЕЙ ЗА РУБЕЖОМ' : 'FOR NRI FAMILIES',
  nriTitle: isArabic ? 'رعاية نوهـافي للوالدين' : isRussian ? 'Забота о родителях от Nuhavi' : 'Nuhavi Care for Parents',
  nriDeck: isArabic
    ? 'نعتني بعلاج والديك في الهند أثناء وجودك في الخارج — مع إحاطتك بتحديثات يومية يمكنك الاعتماد عليها.'
    : isRussian
    ? 'Мы позаботимся о лечении ваших родителей в Индии, пока вы находитесь за рубежом, с надежными регулярными отчетами.'
    : 'We look after your parents\' treatment in India while you\'re abroad — with updates you can rely on.',
  nriLink: isArabic ? 'معرفة المزيد ←' : isRussian ? 'Узнать больше →' : 'Learn more →',

  docTag: isArabic ? 'للأطباء المحولين' : isRussian ? 'ДЛЯ НАПРАВЛЯЮЩИХ ВРАЧЕЙ' : 'FOR REFERRING DOCTORS',
  docTitle: isArabic ? 'أحِل مريضك. وابقَ مطلعاً على المسار الطبي.' : isRussian ? 'Направьте пациента. Оставайтесь в курсе лечения.' : 'Refer a patient. Stay in the clinical loop.',
  docDeck: isArabic
    ? 'مراجعة طبية مشتركة بين الأطباء، وتحديثات متواصلة وتقرير خروج شامل لمريضك.'
    : isRussian
    ? 'Врачебный консилиум «доктор-доктор», регулярные отчеты о динамике и выписной эпикриз для вашего пациента.'
    : 'Doctor-to-doctor case review, shared updates and the discharge summary for your patient.',
  docBtn: isArabic ? 'انضم كشريك إحالة' : isRussian ? 'Стать партнером по направлению' : 'Become a referral partner',

  campTag: isArabic ? 'لقاء أطبائنا' : isRussian ? 'ВСТРЕЧА С ВРАЧАМИ' : 'MEET OUR DOCTORS',
  campTitle: isArabic ? 'مخيم استشاري طبي · يناير 2027' : isRussian ? 'Медицинский консилиум · Январь 2027' : 'Medical camp · January 2027',
  campDeck: isArabic
    ? 'استشارات في الأورام والجراحة العامة في [المدينة]. أحضر تقاريرك الطبية؛ واخرج بخطة واضحة.'
    : isRussian
    ? 'Консультации по онкологии и общей хирургии в [городе]. Принесите ваши выписки и получите четкий план действий.'
    : 'Oncology and general surgery consultations in [city]. Bring your reports; leave with a plan.',
  campLink: isArabic ? 'التسجيل في المخيم ←' : isRussian ? 'Зарегистрироваться →' : 'Register for the camp →',
};
---

<section class="segment-cards-section" aria-label="Audiences and services" dir={isArabic ? 'rtl' : 'ltr'}>
  <div class="container segment-container">
    <div class="segment-cards-grid">
      <!-- Card 1: For NRI Families -->
      <article class="segment-card card-nri">
        <span class="segment-tag">{t.nriTag}</span>
        <h3 class="segment-title">{t.nriTitle}</h3>
        <p class="segment-deck">{t.nriDeck}</p>
        <a href={requestOpinionHref} class="segment-link">
          <span>{t.nriLink}</span>
        </a>
      </article>

      <!-- Card 2: For Referring Doctors (Navy Background) -->
      <article class="segment-card card-doctors">
        <span class="segment-tag tag-gold">{t.docTag}</span>
        <h3 class="segment-title text-white">{t.docTitle}</h3>
        <p class="segment-deck text-mist">{t.docDeck}</p>
        <div class="card-btn-wrap">
          <a href={contactHref} class="btn-brass-partner">
            {t.docBtn}
          </a>
        </div>
      </article>

      <!-- Card 3: Meet Our Doctors -->
      <article class="segment-card card-camp">
        <span class="segment-tag">{t.campTag}</span>
        <h3 class="segment-title">{t.campTitle}</h3>
        <p class="segment-deck">{t.campDeck}</p>
        <a href={contactHref} class="segment-link">
          <span>{t.campLink}</span>
        </a>
      </article>
    </div>
  </div>
</section>

<style>
  .segment-cards-section {
    width: 100%;
    background-color: #FFFFFF;
    padding: clamp(48px, 6vw, 72px) 0;
  }

  .segment-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 40px);
    box-sizing: border-box;
  }

  .segment-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }

  .segment-card {
    border-radius: 8px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    border: 1px solid rgba(15, 35, 64, 0.12);
  }

  .card-nri,
  .card-camp {
    background-color: #FAF8F5;
  }

  .card-doctors {
    background-color: #0F2340;
    border-color: #0F2340;
    color: #FFFFFF;
  }

  .segment-tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #A88B5A;
    text-transform: uppercase;
  }

  .tag-gold {
    color: #A88B5A;
  }

  .segment-title {
    font-family: var(--font-family-heading);
    font-size: 1.45rem;
    font-weight: 600;
    color: #0F2340;
    margin: 0;
    line-height: 1.25;
  }

  .text-white {
    color: #FFFFFF;
  }

  .segment-deck {
    font-size: 0.875rem;
    color: #4B5563;
    line-height: 1.55;
    margin: 0;
    flex-grow: 1;
  }

  .text-mist {
    color: #CBD5E1;
  }

  .segment-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: #0F2340;
    text-decoration: underline;
    transition: color 0.15s ease;
  }

  .segment-link:hover {
    color: #A88B5A;
  }

  .card-btn-wrap {
    margin-top: 8px;
  }

  .btn-brass-partner {
    display: inline-block;
    background-color: #A88B5A;
    color: #FFFFFF;
    padding: 10px 18px;
    border-radius: 4px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    text-align: center;
    transition: background-color 0.15s ease;
  }

  .btn-brass-partner:hover {
    background-color: #967949;
  }

  @media (max-width: 960px) {
    .segment-cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
