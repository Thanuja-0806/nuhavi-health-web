---
/**
 * PeopleNotPackages.astro
 * Homepage section: "People, not packages"
 * Reference: Page 6 of the Nuhavi Health Look and Feel PDF (30 October 2026).
 *
 * Implements:
 * 1. Semantic section with Mist (#F4F7FB) background.
 * 2. Subtle bordered container card with rounded corners.
 * 3. Side-by-side header on desktop (heading & supporting text).
 * 4. Three-photo collage: large portrait placeholder on left, two stacked landscape placeholders on right.
 * 5. Navy placeholders with subtle inset dashed gold outline, centered camera icon, and "Photo to come" badges.
 * 6. Responsive stacking for mobile viewports (390px and 360px) with zero horizontal overflow.
 */

const photos = [
  {
    id: 'lounge',
    position: 'left',
    type: 'portrait',
    label: 'Photo to come',
    description: 'A Nuhavi coordinator talking with a patient and her daughter in a bright hospital lounge',
    caption: 'Your coordinator explains each step, in writing and in person.'
  },
  {
    id: 'airport',
    position: 'right-top',
    type: 'landscape',
    label: 'Photo to come',
    description: 'A coordinator greeting a family at Hyderabad airport arrivals',
    caption: 'Met at Hyderabad airport and taken to your stay.'
  },
  {
    id: 'consultation',
    position: 'right-bottom',
    type: 'landscape',
    label: 'Photo to come',
    description: 'An interpreter sitting beside a patient during a consultation',
    caption: 'An interpreter at consultations when you need one.'
  }
];

const leftPhoto = photos[0];
const rightTopPhoto = photos[1];
const rightBottomPhoto = photos[2];
---

<section class="people-section" aria-labelledby="people-section-heading">
  <div class="container people-container">
    <!-- Outer Card Shell with subtle border & rounded corners -->
    <div class="people-card">
      <!-- Section Header: Side-by-side on desktop, stacked on mobile -->
      <header class="people-header">
        <div class="header-title-col">
          <span class="section-eyebrow">Personal Coordination</span>
          <h2 id="people-section-heading" class="section-title">
            People, not packages
          </h2>
        </div>
        <p class="section-supporting-text">
          The same coordinator meets you, sits with you at consultations and checks on you after you fly home.
        </p>
      </header>

      <!-- Three-Photo Collage Grid -->
      <div class="collage-grid">
        <!-- LEFT: Large Portrait Photo Placeholder -->
        <figure class="collage-figure portrait-figure">
          <div
            class="placeholder-frame portrait-frame"
            role="img"
            aria-label={`Photo placeholder: ${leftPhoto.description}`}
          >
            <div class="placeholder-content">
              <!-- Decorative Camera SVG Icon -->
              <svg class="placeholder-camera-icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                <circle cx="12" cy="13" r="4"></circle>
              </svg>
              <span class="placeholder-badge">{leftPhoto.label}</span>
              <p class="placeholder-description">{leftPhoto.description}</p>
            </div>
          </div>
          <figcaption class="photo-caption">
            {leftPhoto.caption}
          </figcaption>
        </figure>

        <!-- RIGHT: Two Stacked Landscape Photo Placeholders -->
        <div class="collage-right-col">
          <!-- Right Top -->
          <figure class="collage-figure landscape-figure">
            <div
              class="placeholder-frame landscape-frame"
              role="img"
              aria-label={`Photo placeholder: ${rightTopPhoto.description}`}
            >
              <div class="placeholder-content">
                <svg class="placeholder-camera-icon" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                  <circle cx="12" cy="13" r="4"></circle>
                </svg>
                <span class="placeholder-badge">{rightTopPhoto.label}</span>
                <p class="placeholder-description">{rightTopPhoto.description}</p>
              </div>
            </div>
            <figcaption class="photo-caption">
              {rightTopPhoto.caption}
            </figcaption>
          </figure>

          <!-- Right Bottom -->
          <figure class="collage-figure landscape-figure">
            <div
              class="placeholder-frame landscape-frame"
              role="img"
              aria-label={`Photo placeholder: ${rightBottomPhoto.description}`}
            >
              <div class="placeholder-content">
                <svg class="placeholder-camera-icon" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                  <circle cx="12" cy="13" r="4"></circle>
                </svg>
                <span class="placeholder-badge">{rightBottomPhoto.label}</span>
                <p class="placeholder-description">{rightBottomPhoto.description}</p>
              </div>
            </div>
            <figcaption class="photo-caption">
              {rightBottomPhoto.caption}
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* --------------------------------------------------------------------------
     SECTION BASE & SHELL
     -------------------------------------------------------------------------- */
  .people-section {
    width: 100%;
    background-color: var(--color-mist);
    padding-top: var(--section-spacing);
    padding-bottom: var(--section-spacing);
  }

  /* Outer Container: Expanded to 1200px to match the wide reference layout */
  .people-container {
    max-width: 1200px;
  }

  @media (max-width: 480px) {
    .people-container {
      padding-left: var(--space-2);
      padding-right: var(--space-2);
    }
  }

  /* Inner Card: Subtle border with rounded corners */
  .people-card {
    background-color: var(--color-paper);
    border: 1px solid rgba(20, 41, 75, 0.1);
    border-radius: var(--radius-card);
    padding: var(--space-4);
    box-shadow: 0 4px 20px rgba(20, 41, 75, 0.04);
  }

  @media (max-width: 480px) {
    .people-card {
      padding: var(--space-3);
    }
  }

  @media (min-width: 768px) {
    .people-card {
      padding: var(--space-5);
    }
  }

  @media (min-width: 1100px) {
    .people-card {
      padding: var(--space-6);
    }
  }

  /* --------------------------------------------------------------------------
     SECTION HEADER (Side-by-side on desktop, stacked on mobile)
     -------------------------------------------------------------------------- */
  .people-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid rgba(20, 41, 75, 0.08);
    padding-bottom: var(--space-4);
  }

  @media (min-width: 900px) {
    .people-header {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      gap: var(--space-6);
    }
  }

  .header-title-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .section-eyebrow {
    font-size: 0.8125rem;
    font-weight: var(--font-weight-subheading);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gold-text);
  }

  .section-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: var(--font-weight-heading);
    color: var(--color-deep-navy);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .section-supporting-text {
    font-size: 1.0625rem;
    font-weight: var(--font-weight-body);
    line-height: var(--line-height-body);
    color: var(--color-slate);
    max-width: 480px;
  }

  /* --------------------------------------------------------------------------
     COLLAGE GRID LAYOUT
     Desktop: Left (large portrait) + Right (2 stacked landscapes)
     Mobile: Stacks vertically (Portrait -> Landscape 1 -> Landscape 2)
     -------------------------------------------------------------------------- */
  .collage-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 900px) {
    .collage-grid {
      grid-template-columns: 1.15fr 1fr;
      gap: var(--space-5);
      align-items: start;
    }
  }

  /* Right column holding 2 stacked landscape figures */
  .collage-right-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  /* Individual Figure */
  .collage-figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* --------------------------------------------------------------------------
     NAVY PHOTO PLACEHOLDER DESIGN
     Navy background, subtle inset dashed gold outline, centered icon & copy
     -------------------------------------------------------------------------- */
  .placeholder-frame {
    background-color: var(--color-deep-navy);
    border-radius: var(--radius-card);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    border: 1px solid rgba(196, 154, 60, 0.25);
  }

  /* Subtle Inset Dashed Gold Outline */
  .placeholder-frame::before {
    content: '';
    position: absolute;
    inset: 10px;
    border: 1.5px dashed rgba(196, 154, 60, 0.45);
    border-radius: calc(var(--radius-card) - 4px);
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .placeholder-frame::before {
      inset: 14px;
    }
  }

  /* Aspect Ratios */
  .portrait-frame {
    aspect-ratio: 4 / 4.8;
    min-height: 320px;
  }

  @media (min-width: 900px) {
    .portrait-frame {
      aspect-ratio: 4 / 5.1;
      min-height: 480px;
    }
  }

  .landscape-frame {
    aspect-ratio: 16 / 9.5;
    min-height: 200px;
  }

  /* Content inside placeholder */
  .placeholder-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
    padding: var(--space-2);
    max-width: 320px;
  }

  .placeholder-camera-icon {
    color: var(--color-gold);
    opacity: 0.9;
    flex-shrink: 0;
  }

  .placeholder-badge {
    font-size: 0.75rem;
    font-weight: var(--font-weight-subheading);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gold);
    background-color: rgba(196, 154, 60, 0.15);
    border: 1px solid rgba(196, 154, 60, 0.35);
    padding: 3px 10px;
    border-radius: var(--radius-pill);
  }

  .placeholder-description {
    font-size: 0.875rem;
    line-height: 1.45;
    color: rgba(244, 247, 251, 0.82);
    font-weight: var(--font-weight-body);
  }

  /* --------------------------------------------------------------------------
     CAPTIONS BELOW IMAGES
     -------------------------------------------------------------------------- */
  .photo-caption {
    font-size: 0.9375rem;
    font-weight: var(--font-weight-subheading);
    color: var(--color-deep-navy);
    line-height: 1.4;
    padding-left: var(--space-1);
  }
</style>
