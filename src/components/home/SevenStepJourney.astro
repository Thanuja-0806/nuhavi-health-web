---
/**
 * src/components/home/SevenStepJourney.astro
 * Section: How Nuhavi Works — Your Healthcare Journey with Nuhavi
 * SOURCE OF TRUTH: Nuhavi Knowledge Centre website - Claude.pdf (Pages 2 & 3)
 *
 * Requirements:
 * - Eyebrow: HOW NUHAVI WORKS
 * - Headline: Your Healthcare Journey with Nuhavi
 * - Deck: From your first enquiry to treatment and continued care, we're with you at every step.
 * - Video mockup card:
 *     - Deep Navy card (#0F2340) with gold N crest
 *     - Play video, Subtitles on, 58 seconds · subtitles in English
 * - 7 Steps with gold circular icon badges:
 *     1. Enquire
 *     2. Share medical records
 *     3. Specialist review
 *     4. Understand your options
 *     5. Plan your journey
 *     6. Receive treatment
 *     7. Continued follow-up
 * - Bottom CTA: Start Your Healthcare Journey
 */
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang?: SupportedLang;
}

const currentPath = Astro.url.pathname;
const detectedLang: SupportedLang = currentPath.startsWith('/ar')
  ? 'ar'
  : currentPath.startsWith('/ru')
  ? 'ru'
  : currentPath.startsWith('/fr')
  ? 'fr'
  : 'en';

const lang: SupportedLang = Astro.props.lang || detectedLang;
const isArabic = lang === 'ar';
const isRussian = lang === 'ru';
const isFrench = lang === 'fr';

const prefix = `/${lang}`;
const requestOpinionHref = `${prefix}/request-opinion/`;

const t = {
  eyebrow: isArabic ? 'كيف نعمل في نوهـافي' : isRussian ? 'КАК РАБОТАЕТ NUHAVI' : 'HOW NUHAVI WORKS',
  heading: isArabic
    ? 'رحلتك العلاجية مع نوهـافي'
    : isRussian
    ? 'Ваш медицинский маршрут с Nuhavi'
    : 'Your Healthcare Journey with Nuhavi',
  deck: isArabic
    ? 'من استفسارك الأول وحتى العلاج والرعاية المستمرة، نحن معك في كل خطوة.'
    : isRussian
    ? 'От первого обращения до лечения и последующего наблюдения — мы с вами на каждом этапе.'
    : "From your first enquiry to treatment and continued care, we're with you at every step.",
  videoTitle: isArabic ? 'رحلتك العلاجية مع نوهـافي' : isRussian ? 'Ваш медицинский маршрут с Nuhavi' : 'Your Healthcare Journey with Nuhavi',
  videoSub: isArabic ? 'من الاستفسار الأول وحتى الرعاية المستمرة' : isRussian ? 'От первого обращения до лечения и наблюдения' : 'From your first enquiry to treatment and continued care',
  playVideo: isArabic ? 'تشغيل الفيديو' : isRussian ? 'Воспроизвести' : 'Play video',
  subtitlesOn: isArabic ? 'الترجمة مفعلة' : isRussian ? 'Субтитры включены' : 'Subtitles on',
  videoDuration: isArabic ? '٥٨ ثانية · ترجمة باللغة الإنجليزية' : isRussian ? '58 секунд · субтитры на английском' : '58 seconds · subtitles in English',
  startJourney: isArabic ? 'ابدأ رحلتك العلاجية' : isRussian ? 'Начать медицинский маршрут' : 'Start Your Healthcare Journey',
};

const steps = [
  {
    stepNum: 1,
    title: isArabic ? 'الاستفسار الأولي' : isRussian ? 'Запрос' : 'Enquire',
    desc: isArabic ? 'أخبرنا باحتياجك عبر واتساب، الهاتف أو الموقع.' : isRussian ? 'Сообщите нам о вашей ситуации через WhatsApp, по телефону или онлайн.' : 'Tell us what you need, by WhatsApp, phone or online.',
    icon: 'chat',
  },
  {
    stepNum: 2,
    title: isArabic ? 'مشاركة التقارير الطبية' : isRussian ? 'Передача документов' : 'Share medical records',
    desc: isArabic ? 'رفع التقارير والأشعة التشخيصية عبر رابط مشفر وآمن.' : isRussian ? 'Безопасная загрузка выписок, анализов и снимков.' : 'Upload reports and scans securely.',
    icon: 'upload',
  },
  {
    stepNum: 3,
    title: isArabic ? 'مراجعة الطبيب المختص' : isRussian ? 'Оценка специалиста' : 'Specialist review',
    desc: isArabic ? 'يقوم استشاري معتمد بدراسة وتقييم حالتك السريرية.' : isRussian ? 'Профильный специалист детально изучает ваш клинический случай.' : 'A suitable specialist reviews your case.',
    icon: 'search',
  },
  {
    stepNum: 4,
    title: isArabic ? 'فهم الخيارات المتاحة' : isRussian ? 'План и варианты' : 'Understand your options',
    desc: isArabic ? 'الحصول على خطة واضحة ومكتوبة: العلاج، المستشفى والطبيب.' : isRussian ? 'Четкий план: тактика лечения, клиника и лечащий врач.' : 'Get a clear plan: treatment, hospital and doctor.',
    icon: 'clipboard',
  },
  {
    stepNum: 5,
    title: isArabic ? 'التخطيط لرحلتك' : isRussian ? 'Организация поездки' : 'Plan your journey',
    desc: isArabic ? 'ننسق خطابات التأشيرة الطبية، السفر والإقامة المريحة.' : isRussian ? 'Оформление визового приглашения, перелет и проживание.' : 'We arrange visa letters, travel and stay.',
    icon: 'plane',
  },
  {
    stepNum: 6,
    title: isArabic ? 'تلقي العلاج الطبي' : isRussian ? 'Лечение в клинике' : 'Receive treatment',
    desc: isArabic ? 'يرافقك المنسق الشخصي داخل المستشفى خطوة بخطوة.' : isRussian ? 'Персональный координатор сопровождает вас в больнице.' : 'A coordinator supports you in hospital.',
    icon: 'hospital',
  },
  {
    stepNum: 7,
    title: isArabic ? 'المتابعة بعد العودة' : isRussian ? 'Последующее наблюдение' : 'Continued follow-up',
    desc: isArabic ? 'جلسات متابعة عبر الفيديو بينك وبين طبيبك المعالج ومستشارك المحلي.' : isRussian ? 'Видеоконсультации с вами и вашим местным лечащим врачом.' : 'Video follow-ups with you and your local doctor.',
    icon: 'video',
  },
];
---

<section class="seven-step-journey-section" id="how-it-works" aria-labelledby="journey-heading" dir={isArabic ? 'rtl' : 'ltr'}>
  <div class="container journey-container">
    <div class="journey-header">
      <span class="journey-eyebrow">{t.eyebrow}</span>
      <h2 id="journey-heading" class="journey-title">{t.heading}</h2>
      <p class="journey-deck">{t.deck}</p>
    </div>

    <!-- Video Mockup Display -->
    <div class="video-mockup-wrapper">
      <div class="video-display-card">
        <div class="video-crest-badge" aria-hidden="true">
          <svg width="44" height="44" viewBox="0 0 36 36" fill="none">
            <rect width="36" height="36" rx="8" fill="#14294B" stroke="#A88B5A" stroke-width="1.5" />
            <path d="M10 26V10L26 26V10" stroke="#A88B5A" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <h3 class="video-main-heading">{t.videoTitle}</h3>
        <p class="video-sub-heading">{t.videoSub}</p>

        <div class="video-play-center-btn" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="#FFFFFF">
            <path d="M8 5v14l11-7z"></path>
          </svg>
        </div>
      </div>

      <div class="video-controls-bar">
        <button type="button" class="video-control-btn play-action" aria-label="Play journey overview video">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z"></path>
          </svg>
          <span>{t.playVideo}</span>
        </button>

        <div class="video-meta-pills">
          <span class="subtitles-pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="5" width="20" height="14" rx="2"></rect>
              <line x1="6" y1="12" x2="10" y2="12"></line>
              <line x1="14" y1="12" x2="18" y2="12"></line>
              <line x1="6" y1="15" x2="14" y2="15"></line>
            </svg>
            <span>{t.subtitlesOn}</span>
          </span>
          <span class="duration-text">{t.videoDuration}</span>
        </div>
      </div>
    </div>

    <!-- 7 Steps Vertical Stack / Interactive List -->
    <div class="steps-stack">
      {steps.map((item) => (
        <div class="step-row-item">
          <div class="step-badge-col">
            <div class="step-icon-circle" aria-hidden="true">
              {item.icon === 'chat' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A88B5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
              )}
              {item.icon === 'upload' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A88B5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17 8 12 3 7 8"></polyline>
                  <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
              )}
              {item.icon === 'search' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A88B5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
              )}
              {item.icon === 'clipboard' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A88B5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                  <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                  <line x1="9" y1="12" x2="15" y2="12"></line>
                  <line x1="9" y1="16" x2="13" y2="16"></line>
                </svg>
              )}
              {item.icon === 'plane' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A88B5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
              )}
              {item.icon === 'hospital' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A88B5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 21h18"></path>
                  <path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"></path>
                  <line x1="12" y1="7" x2="12" y2="13"></line>
                  <line x1="9" y1="10" x2="15" y2="10"></line>
                </svg>
              )}
              {item.icon === 'video' && (
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A88B5A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="23 7 16 12 23 17 23 7"></polygon>
                  <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                </svg>
              )}
            </div>
            {item.stepNum < 7 && <div class="step-connector-line" aria-hidden="true"></div>}
          </div>

          <div class="step-content-col">
            <span class="step-tag-label">STEP {item.stepNum}</span>
            <h3 class="step-name">{item.title}</h3>
            <p class="step-desc">{item.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Central CTA Button -->
    <div class="journey-cta-wrap">
      <a href={requestOpinionHref} class="btn-journey-start">
        <span>{t.startJourney}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .seven-step-journey-section {
    background-color: #FAF8F5;
    padding: clamp(60px, 8vw, 96px) 0;
    border-bottom: 1px solid #DCE3EC;
  }

  .journey-container {
    max-width: 980px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3vw, 32px);
    box-sizing: border-box;
  }

  .journey-header {
    text-align: center;
    max-width: 760px;
    margin: 0 auto clamp(36px, 5vw, 48px);
  }

  .journey-eyebrow {
    display: inline-block;
    font-family: var(--font-family-base, 'Inter', sans-serif);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #A88B5A;
    margin-bottom: 8px;
  }

  .journey-title {
    font-family: var(--font-family-heading, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(2rem, 3.4vw, 2.85rem);
    font-weight: 700;
    color: #0F2340;
    line-height: 1.15;
    margin: 0 0 12px 0;
  }

  .journey-deck {
    font-family: var(--font-family-base, 'Inter', sans-serif);
    font-size: 1.0625rem;
    color: #5A6E85;
    line-height: 1.6;
    margin: 0;
  }

  /* Video Mockup Display */
  .video-mockup-wrapper {
    margin-bottom: clamp(40px, 6vw, 56px);
  }

  .video-display-card {
    position: relative;
    background: linear-gradient(145deg, #0F2340 0%, #162E52 100%);
    border-radius: 16px;
    padding: clamp(48px, 7vw, 72px) clamp(24px, 4vw, 48px);
    text-align: center;
    color: #FFFFFF;
    box-shadow: 0 12px 36px rgba(15, 35, 64, 0.16);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 280px;
  }

  .video-crest-badge {
    margin-bottom: 16px;
  }

  .video-main-heading {
    font-family: var(--font-family-heading, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    font-weight: 600;
    margin: 0 0 8px 0;
    color: #FFFFFF;
    line-height: 1.2;
  }

  .video-sub-heading {
    font-family: var(--font-family-base, 'Inter', sans-serif);
    font-size: 0.9375rem;
    color: #DCE3EC;
    margin: 0 0 24px 0;
  }

  .video-play-center-btn {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: #A88B5A;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    cursor: pointer;
    transition: transform 0.18s ease, background-color 0.18s ease;
  }

  .video-play-center-btn:hover {
    transform: scale(1.06);
    background-color: #C49A3C;
  }

  .video-controls-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background-color: #FFFFFF;
    border: 1px solid #DCE3EC;
    border-top: none;
    border-radius: 0 0 12px 12px;
    margin-top: -8px;
    box-shadow: 0 4px 12px rgba(15, 35, 64, 0.04);
    flex-wrap: wrap;
    gap: 12px;
  }

  .video-control-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    font-family: var(--font-family-base, 'Inter', sans-serif);
    font-size: 0.875rem;
    font-weight: 600;
    color: #0F2340;
    cursor: pointer;
  }

  .video-meta-pills {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .subtitles-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background-color: #F1F5F9;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #0F2340;
  }

  .duration-text {
    font-size: 0.8125rem;
    color: #5A6E85;
  }

  /* Steps Stack */
  .steps-stack {
    display: flex;
    flex-direction: column;
    max-width: 640px;
    margin: 0 auto;
  }

  .step-row-item {
    display: flex;
    gap: 20px;
    position: relative;
  }

  .step-badge-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .step-icon-circle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid #A88B5A;
    background-color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(168, 139, 90, 0.12);
  }

  .step-connector-line {
    width: 2px;
    flex: 1;
    min-height: 40px;
    background-color: #DCE3EC;
    margin: 6px 0;
  }

  .step-content-col {
    padding-bottom: 32px;
  }

  .step-tag-label {
    display: block;
    font-family: var(--font-family-base, 'Inter', sans-serif);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #A88B5A;
    margin-bottom: 2px;
    text-transform: uppercase;
  }

  .step-name {
    font-family: var(--font-family-heading, 'Cormorant Garamond', Georgia, serif);
    font-size: 1.375rem;
    font-weight: 600;
    color: #0F2340;
    line-height: 1.25;
    margin: 0 0 4px 0;
  }

  .step-desc {
    font-family: var(--font-family-base, 'Inter', sans-serif);
    font-size: 0.875rem;
    color: #5A6E85;
    line-height: 1.5;
    margin: 0;
  }

  /* Central CTA Button */
  .journey-cta-wrap {
    text-align: center;
    margin-top: 24px;
  }

  .btn-journey-start {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 13px 32px;
    min-height: 48px;
    background-color: #0F2340;
    color: #FFFFFF;
    border: none;
    border-radius: 999px;
    font-family: var(--font-family-base, 'Inter', sans-serif);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(15, 35, 64, 0.15);
    transition: background-color 0.18s ease, transform 0.18s ease;
  }

  .btn-journey-start:hover {
    background-color: #1a365d;
    transform: translateY(-2px);
  }
</style>

