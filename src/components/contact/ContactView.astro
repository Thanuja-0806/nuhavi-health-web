---
/**
 * src/components/contact/ContactView.astro
 * Unified, premium Contact page view component for Nuhavi Health.
 * Used by /en/contact/, /ru/contact/, and /ar/contact/ (RTL).
 *
 * Design System:
 * - Nuhavi Navy (#14294B), Deep Navy (#0D1B33), Gold (#C49A3C), Mist (#F4F7FB), White (#FFFFFF)
 * - Signature 72x3px Gold Rule
 * - Clean elevation, subtle border contrast, accessible typography
 * - Preserves approved verification placeholders without inventing contact details
 * - High-contrast clinical emergency notice
 */

import { contactData } from '../../data/contactData';
import type { SupportedLang } from '../../i18n/translations';

interface Props {
  lang: SupportedLang;
}

const { lang } = Astro.props;
const data = contactData[lang];
const isRtl = lang === 'ar';
---

<div class={`contact-container ${isRtl ? 'is-rtl' : ''}`} dir={isRtl ? 'rtl' : 'ltr'}>
  <div class="container main-content">
    <!-- Breadcrumb Navigation -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href={`/${lang}/`}>{data.breadcrumbs.home}</a></li>
        <li aria-hidden="true"><span class="sep">{isRtl ? '\\' : '/'}</span></li>
        <li aria-current="page">{data.breadcrumbs.contact}</li>
      </ol>
    </nav>

    <!-- Signature 72x3 px Gold Rule -->
    <div class="gold-rule" aria-hidden="true"></div>

    <!-- Page Header -->
    <header class="page-header">
      <span class="eyebrow-pill">{data.eyebrow}</span>
      <h1 class="page-title">{data.title}</h1>
      <p class="page-deck">{data.deck}</p>
    </header>

    <!-- Channels Layout -->
    <div class="channels-section">
      <!-- Section Heading -->
      <div class="section-label-row">
        <h2 class="section-label">{data.channelsHeading}</h2>
      </div>

      <!-- Row 1: 3 Direct Channels (Telegram, WhatsApp, Email) -->
      <div class="channels-grid-three">
        {data.channels.map((ch) => (
          <div class="channel-card" id={`channel-${ch.id}`}>
            <div class="card-top">
              <div class="channel-icon-wrap" aria-hidden="true">
                {ch.id === 'telegram' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="22" y1="2" x2="11" y2="13"></line>
                    <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                  </svg>
                )}
                {ch.id === 'whatsapp' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                  </svg>
                )}
                {ch.id === 'email' && (
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                  </svg>
                )}
              </div>
              <span class="region-badge">{ch.badgeLabel}</span>
            </div>

            <h3 class="card-title">{ch.title}</h3>
            
            <div class="amber-marker" role="note">
              <span class="marker-icon" aria-hidden="true">🔒</span>
              <span class="marker-text">{ch.placeholderNotice}</span>
            </div>

            <p class="card-note">{ch.note}</p>
          </div>
        ))}
      </div>

      <!-- Row 2: Action Cards (Enquiry Form & Coordination Hours) -->
      <div class="channels-grid-two">
        <!-- Enquiry Form Card -->
        <div class="action-card form-feature-card">
          <div class="action-card-header">
            <span class="recommend-badge">{data.enquiryCard.badge}</span>
            <div class="action-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
          </div>

          <h3 class="action-card-title">{data.enquiryCard.title}</h3>
          <p class="action-card-desc">{data.enquiryCard.description}</p>

          <div class="action-btn-wrap">
            <a href={data.enquiryCard.buttonHref} class="btn-primary-pill">
              <span>{data.enquiryCard.buttonLabel}</span>
              <span class="btn-arrow" aria-hidden="true">{isRtl ? '←' : '→'}</span>
            </a>
          </div>
        </div>

        <!-- Coordination Hours Card -->
        <div class="action-card hours-card">
          <div class="action-card-header">
            <div class="action-icon hours-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
          </div>

          <h3 class="action-card-title">{data.hoursCard.title}</h3>
          <p class="hours-schedule">{data.hoursCard.schedule}</p>

          <div class="reply-status-box">
            <span class="reply-label">{data.hoursCard.replyLabel}:</span>
            <div class="amber-inline-marker">
              {data.hoursCard.replyPlaceholder}
            </div>
          </div>

          <p class="hours-subnote">
            {lang === 'ar'
              ? 'تتم الإجابة على الاستفسارات وفق توقيت الهند القياسي (UTC+5:30).'
              : lang === 'ru'
              ? 'Обработка обращений ведется по стандартному индийскому времени (IST).'
              : 'Enquiries handled according to Indian Standard Time (IST).'}
          </p>
        </div>
      </div>
    </div>

    <!-- Medical Record Privacy Notice -->
    <div class="privacy-callout-card">
      <div class="privacy-icon" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <div class="privacy-content">
        <h4 class="privacy-title">{data.privacyNotice.title}</h4>
        <p class="privacy-text">{data.privacyNotice.text}</p>
      </div>
    </div>

    <!-- Emergency Warning Notice (Red Box) -->
    <div class="emergency-box" role="alert">
      <div class="emergency-header">
        <span class="alert-icon" aria-hidden="true">⚠</span>
        <strong>{data.emergencyNotice.title}</strong>
      </div>
      <p class="emergency-text">{data.emergencyNotice.text}</p>
    </div>
  </div>
</div>

<style>
  .contact-container {
    background-color: var(--color-paper);
    color: var(--color-ink);
    padding: var(--space-8) 0 var(--space-12);
  }

  /* Breadcrumbs */
  .breadcrumb {
    margin-bottom: var(--space-4);
  }

  .breadcrumb ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--color-slate);
  }

  .breadcrumb a {
    color: var(--color-navy);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .breadcrumb a:hover {
    color: var(--color-gold);
    text-decoration: underline;
  }

  .breadcrumb .sep {
    color: rgba(20, 41, 75, 0.3);
  }

  .breadcrumb [aria-current="page"] {
    color: var(--color-slate);
    font-weight: 600;
  }

  /* Gold 72x3 px Rule */
  .gold-rule {
    width: 72px;
    height: 3px;
    background-color: var(--color-gold);
    margin-bottom: var(--space-4);
  }

  /* Header */
  .page-header {
    margin-bottom: var(--space-8);
    max-width: 820px;
  }

  .eyebrow-pill {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-navy);
    background-color: var(--color-mist);
    border: 1px solid rgba(20, 41, 75, 0.12);
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: var(--space-3);
  }

  .page-title {
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    font-weight: 800;
    color: var(--color-navy);
    line-height: 1.15;
    margin: 0 0 var(--space-3);
  }

  .page-deck {
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1.6;
    color: var(--color-slate);
    margin: 0;
  }

  /* Channels Section */
  .channels-section {
    margin-bottom: var(--space-8);
  }

  .section-label-row {
    margin-bottom: var(--space-4);
  }

  .section-label {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-slate);
    margin: 0;
  }

  /* Row 1 Grid: 3 Cards */
  .channels-grid-three {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin-bottom: var(--space-5);
  }

  @media (min-width: 768px) {
    .channels-grid-three {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .channel-card {
    background-color: #FFFFFF;
    border: 1px solid rgba(20, 41, 75, 0.12);
    border-radius: 14px;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(20, 41, 75, 0.03);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .channel-card:hover {
    border-color: rgba(196, 154, 60, 0.5);
    box-shadow: 0 6px 18px rgba(20, 41, 75, 0.06);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .channel-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background-color: var(--color-mist);
    color: var(--color-navy);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .region-badge {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-slate);
    background-color: var(--color-mist);
    border: 1px solid rgba(20, 41, 75, 0.08);
    padding: 3px 8px;
    border-radius: 6px;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0 0 var(--space-3);
  }

  .amber-marker {
    background-color: #FFF6E5;
    border: 1px solid #C49A3C;
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 0.75rem;
    line-height: 1.45;
    color: #8A6726;
    word-break: break-word;
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: var(--space-3);
  }

  .marker-icon {
    font-size: 0.8125rem;
    line-height: 1;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .card-note {
    font-size: 0.8125rem;
    color: var(--color-slate);
    line-height: 1.5;
    margin: auto 0 0;
  }

  /* Row 2 Grid: 2 Action Cards */
  .channels-grid-two {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .channels-grid-two {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .action-card {
    background-color: #FFFFFF;
    border: 1px solid rgba(20, 41, 75, 0.12);
    border-radius: 14px;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(20, 41, 75, 0.03);
  }

  .form-feature-card {
    background: linear-gradient(135deg, #FFFFFF 0%, #F9FBFE 100%);
    border-color: rgba(20, 41, 75, 0.18);
  }

  .action-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .recommend-badge {
    font-size: 0.6875rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #8A6726;
    background-color: #FFF6E5;
    border: 1px solid #C49A3C;
    padding: 3px 10px;
    border-radius: 999px;
  }

  .action-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background-color: var(--color-mist);
    color: var(--color-navy);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .action-card-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-navy);
    margin: 0 0 var(--space-2);
  }

  .action-card-desc {
    font-size: 0.875rem;
    color: var(--color-slate);
    line-height: 1.55;
    margin: 0 0 var(--space-5);
  }

  .action-btn-wrap {
    margin-top: auto;
  }

  .btn-primary-pill {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 48px;
    padding: 0 24px;
    border-radius: 999px;
    background-color: var(--color-navy);
    color: #FFFFFF;
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(20, 41, 75, 0.12);
    transition: background-color 0.2s ease, transform 0.15s ease, box-shadow 0.2s ease;
  }

  .btn-primary-pill:hover {
    background-color: var(--color-deep-navy);
    box-shadow: 0 6px 16px rgba(20, 41, 75, 0.2);
    transform: translateY(-1px);
  }

  .btn-arrow {
    font-size: 1.125rem;
    transition: transform 0.2s ease;
  }

  .btn-primary-pill:hover .btn-arrow {
    transform: translateX(3px);
  }

  .is-rtl .btn-primary-pill:hover .btn-arrow {
    transform: translateX(-3px);
  }

  /* Hours Card */
  .hours-schedule {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 var(--space-4);
  }

  .reply-status-box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: var(--space-3);
  }

  .reply-label {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-slate);
  }

  .amber-inline-marker {
    background-color: #FFF6E5;
    border: 1px solid #C49A3C;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 0.75rem;
    line-height: 1.35;
    color: #8A6726;
  }

  .hours-subnote {
    font-size: 0.75rem;
    color: var(--color-slate);
    margin: 0;
  }

  /* Privacy Notice Card */
  .privacy-callout-card {
    background-color: var(--color-mist);
    border: 1px solid rgba(20, 41, 75, 0.1);
    border-radius: 12px;
    padding: var(--space-5);
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .privacy-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background-color: #FFFFFF;
    color: var(--color-navy);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 2px 4px rgba(20, 41, 75, 0.05);
  }

  .privacy-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-navy);
    margin: 0 0 4px;
  }

  .privacy-text {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-slate);
    margin: 0;
  }

  /* Emergency Warning Box */
  .emergency-box {
    background-color: #FEF3F2;
    border: 1px solid #FECDCA;
    border-radius: 12px;
    padding: var(--space-5);
  }

  .emergency-header {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--color-error);
    margin-bottom: 6px;
  }

  .alert-icon {
    font-size: 1.125rem;
  }

  .emergency-header strong {
    font-size: 0.9375rem;
    font-weight: 800;
  }

  .emergency-text {
    font-size: 0.8125rem;
    line-height: 1.55;
    color: #55160C;
    margin: 0;
  }

  /* RTL Support */
  .is-rtl {
    text-align: right;
  }

  .is-rtl .card-top,
  .is-rtl .action-card-header,
  .is-rtl .emergency-header {
    flex-direction: row-reverse;
  }

  .is-rtl .breadcrumb ol {
    flex-direction: row-reverse;
  }

  .is-rtl .amber-marker {
    flex-direction: row-reverse;
  }

  .is-rtl .btn-primary-pill {
    flex-direction: row-reverse;
  }

  .is-rtl .privacy-callout-card {
    flex-direction: row-reverse;
  }
</style>

