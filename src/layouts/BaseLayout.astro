---
/**
 * BaseLayout.astro
 * Master layout wrapper for all Nuhavi Health web pages.
 * Provides consistent HTML structure, responsive meta tags,
 * SEO metadata, imports the global design tokens, and incorporates
 * the shared global Header, Footer, and Floating Chat Widget.
 *
 * Fully supports localization for English (/en/), Russian (/ru/), and Arabic (/ar/ RTL).
 */
import type { SupportedLang } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  lang?: SupportedLang;
  dir?: 'ltr' | 'rtl';
  previewNotice?: string;
}

const currentPath = Astro.url.pathname;
const isArabic = currentPath.startsWith('/ar') || Astro.props.lang === 'ar';
const isRussian = currentPath.startsWith('/ru') || Astro.props.lang === 'ru';
const isFrench = currentPath.startsWith('/fr') || Astro.props.lang === 'fr';

const lang: SupportedLang = Astro.props.lang || (isArabic ? 'ar' : isRussian ? 'ru' : isFrench ? 'fr' : 'en');
const dir: 'ltr' | 'rtl' = Astro.props.dir || (isArabic ? 'rtl' : 'ltr');

const previewNotice = Astro.props.previewNotice || null;

const defaultTitle = isArabic
  ? "نوهـافي هيلث | رعاية طبية متخصصة في الهند"
  : isRussian
  ? "Nuhavi Health | Квалифицированная медицинская помощь в Индии"
  : "Nuhavi Health | Expert Medical Care in India";

const defaultDescription = isArabic
  ? "تنسيق طبي متكامل بإشراف أطباء للمرضى الدوليين القادمين للعلاج في الهند."
  : isRussian
  ? "Координация медицинских поездок и лечения иностранных пациентов в ведущих клиниках Индии."
  : "Nuhavi Health coordinates trusted, seamless medical travel and healthcare journeys for international patients.";

const {
  title = defaultTitle,
  description = defaultDescription
} = Astro.props;

// Import our design system tokens and baseline styles
import '../styles/global.css';

// Import shared Header, Footer, and Floating Chat components
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import ChatWidget from '../components/common/ChatWidget.astro';
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Fonts: Cormorant Garamond (Headings), Inter (UI & Body), IBM Plex Sans Arabic -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Inter:wght@300;400;500;600;700&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- Accessible Skip to Content Link -->
    <a href="#main-content" class="skip-to-content">
      {isArabic ? 'الانتقال إلى المحتوى الرئيسي' : isRussian ? 'Перейти к основному содержимому' : 'Skip to main content'}
    </a>

    <!-- Global Header -->
    <Header currentLang={lang} />

    <!-- Optional Notice Banner -->
    {previewNotice && (
      <aside class="lang-preview-banner" role="status" aria-label="Language notice">
        <div class="container preview-banner-inner">
          <span class="preview-badge">Notice</span>
          <span class="preview-message">{previewNotice}</span>
        </div>
      </aside>
    )}

    <!-- Main page content container -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer currentLang={lang} />

    <!-- Floating "Chat with us" Component on every page (PDF Pages 2, 38, 41) -->
    <ChatWidget currentLang={lang} />

    <!-- Mobile Sticky Action Bar (Approved 12-Page PDF Pages 11 & 12) -->
    <div class="mobile-sticky-action-bar" aria-label="Mobile quick actions">
      <a href={`/${lang}/request-opinion/`} class="btn-mobile-estimate">
        <span>{isArabic ? 'احصل على تقدير' : isRussian ? 'Получить расчет' : isFrench ? 'Obtenir un devis' : 'Get my estimate'}</span>
      </a>
      <a href="https://wa.me/919999999999" class="btn-mobile-wa" target="_blank" rel="noopener noreferrer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.63C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.3C4.24 14.99 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M9.05 7.42C8.88 7.42 8.6 7.49 8.36 7.75C8.12 8.01 7.44 8.64 7.44 9.93C7.44 11.22 8.38 12.46 8.51 12.63C8.65 12.81 10.36 15.45 12.97 16.58C13.6 16.85 14.08 17 14.47 17.13C15.1 17.33 15.67 17.3 16.12 17.23C16.63 17.16 17.67 16.6 17.89 15.98C18.11 15.37 18.11 14.84 18.04 14.73C17.97 14.62 17.79 14.56 17.53 14.43C17.27 14.3 15.99 13.67 15.75 13.58C15.52 13.5 15.35 13.45 15.18 13.71C15 13.97 14.5 14.56 14.35 14.73C14.2 14.9 14.05 14.92 13.79 14.79C13.53 14.67 12.7 14.39 11.71 13.51C10.94 12.83 10.42 11.98 10.27 11.72C10.12 11.47 10.25 11.33 10.38 11.2C10.5 11.08 10.65 10.89 10.78 10.74C10.91 10.59 10.95 10.48 11.04 10.31C11.12 10.14 11.08 9.99 11.02 9.86C10.95 9.74 10.44 8.49 10.23 7.98C10.02 7.48 9.81 7.55 9.66 7.54C9.51 7.54 9.34 7.42 9.05 7.42Z"/>
        </svg>
        <span>{isArabic ? 'واتساب' : 'WhatsApp'}</span>
      </a>
    </div>
  </body>
</html>

<style>
  /* Accessible Skip to Content link */
  .skip-to-content {
    position: absolute;
    top: -100px;
    left: var(--space-3);
    background-color: var(--color-gold);
    color: var(--color-deep-navy);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    font-size: 0.875rem;
    font-weight: var(--font-weight-subheading);
    z-index: 9999;
    text-decoration: none;
    transition: top 0.2s ease;
  }

  .skip-to-content:focus {
    top: var(--space-2);
  }

  /* Language Notice Banner */
  .lang-preview-banner {
    background-color: #FFF8EB;
    border-bottom: 1px solid rgba(196, 154, 60, 0.35);
    padding: 10px 0;
    font-family: var(--font-family-base);
    color: #8A6726;
  }

  .preview-banner-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-align: center;
    flex-wrap: wrap;
  }

  .preview-badge {
    display: inline-block;
    background-color: var(--color-gold, #C49A3C);
    color: var(--color-deep-navy, #0D1B33);
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 2px 10px;
    border-radius: var(--radius-pill, 9999px);
  }

  .preview-message {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
  }

  @media (max-width: 640px) {
    .preview-message {
      font-size: 0.8125rem;
    }
  }

  /* Mobile Sticky Action Bar (PDF Pages 11 & 12) */
  .mobile-sticky-action-bar {
    display: none;
  }

  @media (max-width: 768px) {
    .mobile-sticky-action-bar {
      display: grid;
      grid-template-columns: 1.3fr 1fr;
      gap: 10px;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 995;
      background: #FFFFFF;
      padding: 10px 16px;
      border-top: 1px solid rgba(15, 35, 64, 0.12);
      box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.08);
      box-sizing: border-box;
    }

    .btn-mobile-estimate {
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: #0F2340;
      color: #FFFFFF;
      font-size: 0.875rem;
      font-weight: 600;
      padding: 12px 14px;
      border-radius: 6px;
      text-decoration: none;
      text-align: center;
      white-space: nowrap;
    }

    .btn-mobile-wa {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      background-color: #25D366;
      color: #FFFFFF;
      font-size: 0.875rem;
      font-weight: 600;
      padding: 12px 14px;
      border-radius: 6px;
      text-decoration: none;
      text-align: center;
      white-space: nowrap;
    }
  }
</style>
